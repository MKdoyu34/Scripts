SendMessage("Thx for using my Universal TCO Fly Script!", "#C8C8C8")
SendMessage("Game name: " .. game.Name, "#C8C8C8")

task.wait(0.05)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local CurrentCamera = workspace.CurrentCamera

local PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts")
local PlayerModule = PlayerScripts:WaitForChild("PlayerModule")
local ControlModule = require(PlayerModule:WaitForChild("ControlModule"))

local isAirborne = false
local lastJumpTime = time()
local defaultGravity = workspace.Gravity

local character, Humanoid, HumanoidRootPart
local renderConnection

local function disableFly()
	LocalPlayer:SetAttribute("Flying", false)
	isAirborne = false
	if Humanoid then
		Humanoid.PlatformStand = false
	end
	if HumanoidRootPart then
		HumanoidRootPart.Running.Volume = 0.65
	end
	workspace.Gravity = defaultGravity
end

local function setupCharacter(newCharacter)
	if renderConnection then
		renderConnection:Disconnect()
		renderConnection = nil
	end

	isAirborne = false
	lastJumpTime = time()
	workspace.Gravity = defaultGravity
	LocalPlayer:SetAttribute("Flying", false)

	task.wait(0.5)

	character = newCharacter
	Humanoid = character:WaitForChild("Humanoid")
	HumanoidRootPart = character:WaitForChild("HumanoidRootPart")

	CurrentCamera.FieldOfView = 70

	Humanoid.Died:Connect(function()
		disableFly()
		SendMessage("Fly has been disabled you died, Say /Fly to Re-Enable it again!", "#C8C8C8")
	end)

	Humanoid:GetPropertyChangedSignal("Jump"):Connect(function()
		if LocalPlayer:GetAttribute("Flying") == true then
			Humanoid.Jump = false
		end
	end)

	renderConnection = RunService.RenderStepped:Connect(function()
		if LocalPlayer:GetAttribute("Flying") ~= true or not isAirborne then return end

		workspace.Gravity = 1

		HumanoidRootPart.AssemblyLinearVelocity = HumanoidRootPart.AssemblyLinearVelocity / 1.1
		HumanoidRootPart.AssemblyAngularVelocity = HumanoidRootPart.AssemblyAngularVelocity / 1.1

		local moveVector = ControlModule:GetMoveVector()
		local sum = Vector3.zero

		if moveVector.X > 0.5 then
			sum += CurrentCamera.CFrame.RightVector
		elseif moveVector.X < -0.5 then
			sum -= CurrentCamera.CFrame.RightVector
		end

		if moveVector.Z > 0.5 then
			sum -= CurrentCamera.CFrame.LookVector
		elseif moveVector.Z < -0.5 then
			sum += CurrentCamera.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.E) then
			sum += CurrentCamera.CFrame.UpVector
		elseif UserInputService:IsKeyDown(Enum.KeyCode.Q) then
			sum -= CurrentCamera.CFrame.UpVector
		end

		HumanoidRootPart.AssemblyLinearVelocity += sum * (Humanoid.WalkSpeed / 10 * 2.5)

		local pos = character:GetPivot().Position
		character:PivotTo(CFrame.new(pos, pos + CurrentCamera.CFrame.LookVector))
	end)
end

LocalPlayer.Chatted:Connect(function(message)
	local msg = message:lower()
	if msg == "/fly" then
		LocalPlayer:SetAttribute("Flying", true)
		SendMessage("Fly Enabled!", "#C8C8C8")
	elseif msg == "/unfly" then
		disableFly()
		SendMessage("Fly Disabled!", "#C8C8C8")
	end
end)

LocalPlayer:GetAttributeChangedSignal("Flying"):Connect(function()
	if LocalPlayer:GetAttribute("Flying") ~= true then
		disableFly()
	end
end)

UserInputService.JumpRequest:Connect(function()
	if LocalPlayer:GetAttribute("Flying") ~= true then return end
	if not (time() - lastJumpTime > 0.5) then return end
	if not Humanoid or not HumanoidRootPart then return end

	if not isAirborne then
		isAirborne = true
		Humanoid.PlatformStand = true
		HumanoidRootPart.Running.Volume = 0
		HumanoidRootPart.AssemblyLinearVelocity += Vector3.new(0, Humanoid.JumpHeight * 2.5, 0)
	else
		isAirborne = false
		Humanoid.PlatformStand = false
		HumanoidRootPart.Running.Volume = 0.65
		workspace.Gravity = defaultGravity
	end

	lastJumpTime = time()
end)

LocalPlayer.CharacterAdded:Connect(setupCharacter)
if LocalPlayer.Character then
	setupCharacter(LocalPlayer.Character)
end

task.wait(0.05)

SendMessage("Fly script Executed! Say /Fly to get Started.", "#C8C8C8")
SendMessage("Enjoy flying :D", "#C8C8C8")

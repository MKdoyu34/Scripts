---------------------------------------------------------------
-- Capability detection (every executor call guarded)
---------------------------------------------------------------
local function tryGlobal(name)
	local env = nil
	pcall(function()
		env = getfenv(0)
	end)
	if type(env) ~= "table" then
		env = _G
	end
	local ok, value = pcall(function()
		return env[name]
	end)
	if ok and value ~= nil then
		return value
	end
	return nil
end

-- HTTP: prefer request, then syn.request, then http_request
local HttpFunc = nil
do
	local candidate = tryGlobal("request")
	if type(candidate) == "function" then
		HttpFunc = candidate
	else
		local syn = tryGlobal("syn")
		if type(syn) == "table" and type(syn.request) == "function" then
			HttpFunc = syn.request
		else
			candidate = tryGlobal("http_request")
			if type(candidate) == "function" then
				HttpFunc = candidate
			end
		end
	end
end

local ReadFileFn   = tryGlobal("readfile")
if type(ReadFileFn) ~= "function" then ReadFileFn = nil end
local WriteFileFn  = tryGlobal("writefile")
if type(WriteFileFn) ~= "function" then WriteFileFn = nil end
local ListFilesFn  = tryGlobal("listfiles")
if type(ListFilesFn) ~= "function" then ListFilesFn = nil end
local MakeFolderFn = tryGlobal("makefolder")
if type(MakeFolderFn) ~= "function" then MakeFolderFn = nil end
local IsFileFn     = tryGlobal("isfile")
if type(IsFileFn) ~= "function" then IsFileFn = nil end
local SetClipboardFn = tryGlobal("setclipboard")
if type(SetClipboardFn) ~= "function" then
	SetClipboardFn = tryGlobal("toclipboard")
	if type(SetClipboardFn) ~= "function" then SetClipboardFn = nil end
end
local IdentifyFn = tryGlobal("IdentifyExecutor")
if type(IdentifyFn) ~= "function" then
	IdentifyFn = tryGlobal("identifyexecutor")
	if type(IdentifyFn) ~= "function" then
		IdentifyFn = tryGlobal("getexecutorname")
		if type(IdentifyFn) ~= "function" then IdentifyFn = nil end
	end
end

local PersistenceAvailable = (ReadFileFn ~= nil) and (WriteFileFn ~= nil)

local function getExecutorName()
	if IdentifyFn then
		local ok, name, version = pcall(IdentifyFn)
		if ok and type(name) == "string" and #name > 0 then
			if type(version) == "string" and #version > 0 then
				return name .. " " .. version
			end
			return name
		end
	end
	return "Unknown"
end


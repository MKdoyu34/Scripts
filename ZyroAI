---------------------------------------------------------------
-- Small UI helpers
---------------------------------------------------------------
local function new(className, props, parent)
	local ok, inst = pcall(function()
		return Instance.new(className)
	end)
	if not ok or not inst then
		return nil
	end
	if props then
		for key, value in pairs(props) do
			pcall(function()
				inst[key] = value
			end)
		end
	end
	if parent then
		pcall(function()
			inst.Parent = parent
		end)
	end
	return inst
end

local function addCorner(inst, scaleRadius)
	return new("UICorner", {
		CornerRadius = UDim.new(scaleRadius, 0),
	}, inst)
end

local function addStroke(inst, color, transparency, thickness)
	return new("UIStroke", {
		Color = color,
		Transparency = transparency or 0,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, inst)
end

local function addPadding(inst, scale)
	return new("UIPadding", {
		PaddingTop = UDim.new(scale, 0),
		PaddingBottom = UDim.new(scale, 0),
		PaddingLeft = UDim.new(scale, 0),
		PaddingRight = UDim.new(scale, 0),
	}, inst)
end

local function tween(inst, info, props)
	local ok, tw = pcall(function()
		return TweenService:Create(inst, info, props)
	end)
	if ok and tw then
		tw:Play()
		return tw
	end
	return nil
end

local function connectSafe(signal, handler)
	local ok, conn = pcall(function()
		return signal:Connect(handler)
	end)
	if ok then
		return conn
	end
	return nil
end

local function viewportSize()
	local cam = WorkspaceService.CurrentCamera
	if cam then
		return cam.ViewportSize
	end
	return Vector2.new(1280, 720)
end

local function hoverColor(button, normal, hovered)
	connectSafe(button.MouseEnter, function()
		tween(button, TweenInfo.new(0.15), { BackgroundColor3 = hovered })
	end)
	connectSafe(button.MouseLeave, function()
		tween(button, TweenInfo.new(0.15), { BackgroundColor3 = normal })
	end)
end

local function makeTextLabel(props, parent)
	props.BackgroundTransparency = 1
	props.Font = props.Font or FONT_MAIN
	props.TextColor3 = props.TextColor3 or Theme.PrimaryText
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return new("TextLabel", props, parent)
end

local function truncate(str, maxLen)
	if #str <= maxLen then
		return str
	end
	return string.sub(str, 1, maxLen - 1) .. "…"
end


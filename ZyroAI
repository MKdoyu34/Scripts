local function validateAndSaveGenSettings()
	local conv = getActiveConversation()
	if not conv then return end
	local meta = modelMeta(State.selectedModel)
	local changes = 0

	local mtRaw = string.gsub(MaxTokensInput.Text, "%s", "")
	if mtRaw == "" then
		if conv.settings.maxTokens ~= nil then
			conv.settings.maxTokens = nil
			changes += 1
		end
	else
		local n = tonumber(mtRaw)
		if n and n == math.floor(n) and n >= 1 and n <= meta.maxTokens then
			if conv.settings.maxTokens ~= n then
				conv.settings.maxTokens = n
				changes += 1
			end
		else
			Notifications.push({
				title = "Invalid max tokens",
				description = "Must be a positive integer ≤ " .. meta.maxTokens .. ".",
				status = "warning",
			})
		end
	end

	local tRaw = string.gsub(TempInput.Text, "%s", "")
	if tRaw == "" then
		if conv.settings.temperature ~= nil then
			conv.settings.temperature = nil
			changes += 1
		end
	else
		local n = tonumber(tRaw)
		if n and n >= meta.tempMin and n <= meta.tempMax then
			if conv.settings.temperature ~= n then
				conv.settings.temperature = n
				changes += 1
			end
		else
			Notifications.push({
				title = "Invalid temperature",
				description = "Must be between " .. meta.tempMin .. " and " .. meta.tempMax .. ".",
				status = "warning",
			})
		end
	end

	if changes > 0 then
		saveConversation(conv)
	end
	syncGenPanel()
end

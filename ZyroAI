			SortOrder = Enum.SortOrder.LayoutOrder,
		}, page)
		pages[name] = page
		connectSafe(btn.MouseButton1Click, function()
			for n, p in pairs(pages) do p.Visible = (n == name) end
			for n, b in pairs(tabButtons) do
				local active = (n == name)
				b.TextColor3 = active and Theme.PrimaryText or Theme.MutedText
				tween(b, TweenInfo.new(0.12), {
					BackgroundColor3 = active and Theme.SelectedBackground or Theme.SecondaryBackground,
				})
			end
		end)
		return page
	end

	local settingsPage = makeTab("Settings", 1)
	local profilePage  = makeTab("Profile", 2)
	local geminiPage   = makeTab("Gemini", 3)

	-- helpers for rows
	local function pageLabel(text, page, order)
		return makeTextLabel({
			Text = text,
			Font = FONT_BOLD,
			TextSize = 11,
			TextColor3 = Theme.MutedText,
			Size = UDim2.new(1, 0, 0.06, 0),
			LayoutOrder = order,
			ZIndex = 153,
		}, page)
	end
	local function pageInput(placeholder, page, order, masked)
		local box = new("TextBox", {
			BackgroundColor3 = Theme.SecondaryBackground,
			Text = "",
			PlaceholderText = placeholder,
			PlaceholderColor3 = Theme.PlaceholderText,
			TextColor3 = Theme.PrimaryText,
			Font = FONT_MAIN,
			TextSize = 12,
			Size = UDim2.new(1, 0, 0.075, 0),
			ClearTextOnFocus = false,
			LayoutOrder = order,
			ZIndex = 153,
		}, page)
		addCorner(box, 0.1)
		addStroke(box, Theme.PrimaryBorder, 0)
		new("UIPadding", { PaddingLeft = UDim.new(0.04, 0) }, box)
		return box
	end
	local function pageButton(text, page, order, primary)
		local b = new("TextButton", {
			Text = text,
			Font = FONT_BOLD,
			TextSize = 12,
			TextColor3 = primary and Theme.TextOnAccent or Theme.SecondaryText,
			BackgroundColor3 = primary and Theme.PrimaryButton or Theme.SecondaryButton,
			Size = UDim2.new(1, 0, 0.07, 0),
			AutoButtonColor = false,
			LayoutOrder = order,
			ZIndex = 153,
		}, page)
		addCorner(b, 0.12)
		hoverColor(b, primary and Theme.PrimaryButton or Theme.SecondaryButton,
			primary and Theme.PrimaryButtonHover or Theme.HoverBackground)
		return b
	end

	---- Settings tab ----
	pageLabel("interface", settingsPage, 1)
	local enterToggle = pageButton("Enter sends message: " .. (State.prefs.enterToSend ~= false and "On" or "Off"), settingsPage, 2)
	connectSafe(enterToggle.MouseButton1Click, function()
		State.prefs.enterToSend = not (State.prefs.enterToSend ~= false)
		enterToggle.Text = "Enter sends message: " .. (State.prefs.enterToSend and "On" or "Off")
		saveSettings()
	end)

	pageLabel("persistence", settingsPage, 3)
	makeTextLabel({
		Text = State.persistenceOk
			and "Persistence is available. Conversations and settings are stored as files in the executor workspace."
			or  "Persistence is unavailable: readfile/writefile were not detected.",
		TextSize = 11,
		TextColor3 = State.persistenceOk and Theme.SecondaryText or Theme.Warning,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0.09, 0),
		LayoutOrder = 4,
		ZIndex = 153,
	}, settingsPage)
	local clearBtn = pageButton("Clear all saved data", settingsPage, 5)
	connectSafe(clearBtn.MouseButton1Click, function()
		if not PersistenceAvailable then
			Notifications.push({
				title = "Persistence unavailable",
				description = "File functions missing; nothing stored locally by Zyro AI.",
				status = "warning",
			})
			return
		end
		for _, conv in ipairs(State.conversations) do
			deleteConversationFile(conv.id)
		end
		State.conversations = {}
		State.apiKey = ""
		saveSettings()
		safeWrite(PROFILE_PATH, HttpService:JSONEncode({ aiName = "" }))
		doNewChat()
		Notifications.push({
			title = "Data cleared",
			description = "Saved conversations and settings were removed.",
			status = "info",
		})
	end)

	---- Profile tab ----
	pageLabel("name for gemini", profilePage, 1)
	local nameInput = pageInput("What should Gemini call you?", profilePage, 2)
	nameInput.Text = State.profile.aiName
		local saveNameBtn = pageButton("Save name", profilePage, 3, true)
	connectSafe(saveNameBtn.MouseButton1Click, function()
		State.profile.aiName = string.gsub(nameInput.Text or "", "^%s*(.-)%s*$", "%1")
		saveProfile()
		Notifications.push({
			title = "Profile saved",
			description = "Your name preference was saved.",
			status = "success",
		})
	end)
	pageLabel("roblox identity", profilePage, 4)
	local username, displayName = getRobloxIdentity()
	makeTextLabel({
		Text = "Username: " .. username .. "\nDisplay name: " .. displayName,
		TextSize = 12,
		TextColor3 = Theme.SecondaryText,
		Size = UDim2.new(1, 0, 0.1, 0),
		TextWrapped = true,
		LayoutOrder = 5,
		ZIndex = 153,
	}, profilePage)

	---- Gemini tab ----
	pageLabel("gemini api key", geminiPage, 1)
	local keyInput = pageInput("Paste API key…", geminiPage, 2)
	local keyStatus = makeTextLabel({
		Text = #State.apiKey > 0 and ("Stored: " .. maskKey(State.apiKey)) or "No key stored.",
		TextSize = 11,
		TextColor3 = Theme.MutedText,
		Size = UDim2.new(1, 0, 0.05, 0),
		LayoutOrder = 3,
		ZIndex = 153,
	}, geminiPage)
	local saveKeyBtn = pageButton("Save / Update key", geminiPage, 4, true)
	connectSafe(saveKeyBtn.MouseButton1Click, function()
		local k = string.gsub(keyInput.Text or "", "%s", "")
		if #k < 8 then
			Notifications.push({
				title = "Key not saved",
				description = "That doesn't look like a valid API key.",
				status = "warning",
			})
			return
		end
		State.apiKey = k
		saveSettings()
		keyInput.Text = ""
		keyStatus.Text = "Stored: " .. maskKey(k)
		Notifications.push({
			title = "API key saved",
			description = "The key is stored in plain text in your executor workspace. Masking in the UI does not make local storage secure, and this file is not encrypted.",
			status = "info",
			duration = 8,
		})
		-- refresh model list with the new key
		task.spawn(function()
			local ids, err = fetchModels()
			if ids then
				State.fetchedModels = ids
				State.modelsFetched = true
				refreshModelDropdown()
			elseif err then
				Notifications.push({
					title = "Model fetch failed",
					description = err,
					status = "error",
					duration = 6,
				})
			end
		end)
	end)

	pageLabel("models", geminiPage, 5)
	local refreshModelsBtn = pageButton("Refresh model list", geminiPage, 6)
	connectSafe(refreshModelsBtn.MouseButton1Click, function()
		refreshModelsBtn.Text = "Fetching…"
		task.spawn(function()
			local ids, err = fetchModels()
			refreshModelsBtn.Text = "Refresh model list"
			if ids then
				State.fetchedModels = ids
				State.modelsFetched = true
				refreshModelDropdown()
				Notifications.push({
					title = "Models updated",
					description = tostring(#ids) .. " models support generateContent.",
					status = "success",
				})
			else
				State.modelsFetched = false
				Notifications.push({
					title = "Model fetch failed",
					description = err or "Unknown error.",
					status = "error",
					duration = 6,
				})
			end
		end)
	end)

	pageLabel("selected model", geminiPage, 7)
	local meta = modelMeta(State.selectedModel)
	makeTextLabel({
		Text = modelLabel(State.selectedModel)
			.. "\nMax output tokens: " .. tostring(meta.maxTokens)
			.. "\nTemperature range: " .. meta.tempMin .. " – " .. meta.tempMax
			.. "\nThinking: " .. (meta.thinking and "supported" or "not supported")
			.. "\nStatus: " .. (State.modelStatus[State.selectedModel] == "unavailable" and "confirmed unavailable"
				or State.modelStatus[State.selectedModel] == "ok" and "working"
				or (State.modelsFetched == false and "failed to load (unknown)" or "unknown")),
		TextSize = 11,
		TextColor3 = Theme.SecondaryText,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0.16, 0),
		LayoutOrder = 8,
		ZIndex = 153,
	}, geminiPage)

	-- open on Settings tab
	for n, p in pairs(pages) do p.Visible = (n == "Settings") end
	tabButtons["Settings"].TextColor3 = Theme.PrimaryText
	tabButtons["Settings"].BackgroundColor3 = Theme.SelectedBackground
end

connectSafe(SettingsButton.MouseButton1Click, openSettings)

--== SECTION 14: Boot sequence ==--

loadAll()
applySidebarState(false)

-- open most recent conversation or create a new one
local ordered = sortedConversations()
if #ordered > 0 then
	openConversation(ordered[1].id)
else
	doNewChat()
end

-- Notifications
Notifications.push({
	title = "Welcome",
	description = "Thank you for using Zyro AI!",
	status = "info",
	duration = 4.5,
})
do
	local username, displayName = getRobloxIdentity()
	Notifications.push({
		title = "User Information",
		description = "Executor: " .. getExecutorName()
			.. "  |  User: " .. username
			.. "  |  Display: " .. displayName,
		status = "info",
		duration = 5,
	})
end
local loadingEntry = Notifications.push({
	title = "Loading Zyro AI...",
	description = "Loading Zyro AI by Author...",
	status = "loading",
	duration = 30,
})
task.delay(2, function()
	Notifications.dismissEntry(loadingEntry)
end)

-- API compatibility notice (only functions the script actually uses)
do
	local missing = {}
	local function need(name, present, essential)
		if not present then
			table.insert(missing, name .. (essential and " (ESSENTIAL)" or " (OPTIONAL)"))
		end
	end
	need("request/syn.request/http_request", HttpFunc ~= nil, true)
	need("readfile", ReadFileFn ~= nil, true)
	need("writefile", WriteFileFn ~= nil, true)
	need("listfiles", ListFilesFn ~= nil, false)
	need("makefolder", MakeFolderFn ~= nil, false)
	need("isfile", IsFileFn ~= nil, false)
	need("setclipboard", SetClipboardFn ~= nil, false)
	need("IdentifyExecutor", IdentifyFn ~= nil, false)

	local msg
	if #missing == 0 then
		msg = "Missing APIs: None."
	else
		msg = "Missing APIs: " .. table.concat(missing, ", ") .. "."
	end
	Notifications.push({
		title = "API Compatibility",
		description = msg,
		status = #missing == 0 and "success" or "warning",
		duration = 7,
	})
end

-- Fetch live models on boot if a key exists
if #State.apiKey > 0 then
	task.spawn(function()
		local ids, err = fetchModels()
		if ids then
			State.fetchedModels = ids
			State.modelsFetched = true
			refreshModelDropdown()
		else
			State.modelsFetched = false
		end
	end)
end

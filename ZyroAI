local messageIdCounter = 0

local function renderInlineMarkdown(text)
	-- Returns TextLabel-compatible rich text. We use Roblox RichText.
	local function esc(s)
		s = string.gsub(s, "&", "&amp;")
		s = string.gsub(s, "<", "&lt;")
		s = string.gsub(s, ">", "&gt;")
		return s
	end
	local out = esc(text)
	-- inline code first (single backticks, not part of fences — fences handled by block splitter)
	out = string.gsub(out, "`([^`\n]+)`", function(code)
		return '<font face="Code" color="rgb(200,180,255)">' .. code .. "</font>"
	end)
	-- bold then italic
	out = string.gsub(out, "%*%*([^%*]+)%*%*", "<b>%1</b>")
	out = string.gsub(out, "__([^_]+)__", "<b>%1</b>")
	out = string.gsub(out, "%*([^%*\n]+)%*", "<i>%1</i>")
	out = string.gsub(out, "_([^_\n]+)_", "<i>%1</i>")
	-- links [text](url) — show text in accent; url not clickable in TextLabel
	out = string.gsub(out, "%[([^%]]+)%]%(([^%)]+)%)", function(t, u)
		return '<font color="rgb(167,139,250)">' .. t .. "</font>"
	end)
	-- strikethrough for... not needed for messages
	return out
end


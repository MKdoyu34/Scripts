local function refreshModelDropdown()
	for _, child in ipairs(ModelList:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local order = 0
	local function addModelRow(id)
		order += 1
		local unavailable = State.modelStatus[id] == "unavailable"
		local isSelected = id == State.selectedModel
		local row = new("TextButton", {
			Text = "",
			BackgroundColor3 = isSelected and Theme.SelectedBackground or Theme.ElevatedSurface,
			Size = UDim2.new(1, 0, 0.095, 0),
			AutoButtonColor = false,
			LayoutOrder = order,
			ZIndex = 72,
		}, ModelList)
		local label = makeTextLabel({
			Text = modelLabel(id),
			TextSize = 12,
			TextColor3 = unavailable and Theme.MutedText or Theme.SecondaryText,
			Position = UDim2.new(0.06, 0, 0, 0),
			Size = UDim2.new(0.9, 0, 1, 0),
			ZIndex = 73,
		}, row)
		if unavailable then
			-- strikethrough line
			new("Frame", {
				BackgroundColor3 = Theme.MutedText,
				BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0.06, 0, 0.5, 0),
				Size = UDim2.new(0.6, 0, 0.03, 0),
				ZIndex = 74,
			}, row)
		end
		connectSafe(row.MouseEnter, function()
			if not isSelected then
				tween(row, TweenInfo.new(0.12), { BackgroundColor3 = Theme.HoverBackground })
			end
		end)
		connectSafe(row.MouseLeave, function()
			if not isSelected then
				tween(row, TweenInfo.new(0.12), { BackgroundColor3 = Theme.ElevatedSurface })
			end
		end)
		connectSafe(row.MouseButton1Click, function()
			State.selectedModel = id
			saveSettings()
			ModelButton.Text = modelLabel(id) .. "  ▾"
			ModelDropdown.Visible = false
			refreshModelDropdown()
			syncGenPanel()
		end)
	end

	-- working models first (never confirmed unavailable), then a non-working section
	local ids = {}
	if State.fetchedModels then
		for _, id in ipairs(State.fetchedModels) do
			table.insert(ids, id)
		end
	else
		for _, m in ipairs(KNOWN_MODELS) do
			table.insert(ids, m.id)
		end
	end
	-- ensure current selection is present even if not in the list
	local found = false
	for _, id in ipairs(ids) do
		if id == State.selectedModel then
			found = true
			break
		end
	end
	if not found then
		table.insert(ids, 1, State.selectedModel)
	end

	local working, nonWorking = {}, {}
	for _, id in ipairs(ids) do
		if State.modelStatus[id] == "unavailable" then
			table.insert(nonWorking, id)
		else
			table.insert(working, id)
		end
	end
	for _, id in ipairs(working) do
		addModelRow(id)
	end
	if #nonWorking > 0 then
		order += 1
		makeTextLabel({
			Text = "Non-working Models",
			Font = FONT_BOLD,
			TextSize = 10,
			TextColor3 = Theme.MutedText,
			Size = UDim2.new(1, 0, 0.08, 0),
			Position = UDim2.new(0, 0, 0, 0),
			LayoutOrder = order,
			ZIndex = 72,
			TextXAlignment = Enum.TextXAlignment.Center,
		}, ModelList)
		for _, id in ipairs(nonWorking) do
			addModelRow(id)
		end
	end
end


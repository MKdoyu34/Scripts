local function setBusy(busy)
	State.busy = busy
	if busy then
		tween(SendButton, TweenInfo.new(0.15), { BackgroundColor3 = Theme.DisabledButton })
	else
		tween(SendButton, TweenInfo.new(0.15), { BackgroundColor3 = Theme.PrimaryButton })
	end
end

local function sendMessage()
	if State.busy then return end
	local text = InputBox.Text or ""
	local trimmed = string.gsub(text, "^%s*(.-)%s*$", "%1")
	if trimmed == "" then return end
	if #State.apiKey == 0 then
		Notifications.push({
			title = "API key missing",
			description = "Add your Gemini API key in Settings → Gemini.",
			status = "warning",
		})
		return
	end

	local conv = getActiveConversation()
	if not conv then
		doNewChat()
		conv = getActiveConversation()
		if not conv then return end
	end

	setBusy(true)
	InputBox.Text = ""
	autosizeComposer()

	conv.messages[#conv.messages + 1] = {
		role = "user",
		text = text, -- complete text to Gemini
		time = os.time(),
		id = "u" .. tostring(messageIdCounter + 1),
	}
	-- title new chats from the first message
	if conv.title == "New Chat" then
		conv.title = truncate(trimmed, 34)
		ConvTitle.Text = conv.title
		refreshHistory()
	end
	saveConversation(conv)

	hideEmptyState()
	addMessageBubble(conv.messages[#conv.messages])
	scrollToBottomIfNeeded()
	showTyping()

	task.spawn(function()
		local reply, err = geminiGenerate(conv, text)
		hideTyping()
		setBusy(false)
		if reply then
			conv.messages[#conv.messages + 1] = {
				role = "model",
				text = reply,
				time = os.time(),
			}
			saveConversation(conv)
			addMessageBubble(conv.messages[#conv.messages])
			scrollToBottomIfNeeded()
		else
			Notifications.push({
				title = "Gemini request failed",
				description = err or "Unknown error.",
				status = "error",
				duration = 6,
			})
		end
	end)
end


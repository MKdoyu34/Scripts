-- Generic lerped drag with viewport clamping.
local function attachDrag(handle, dragRegion)
	local dragging = false
	local dragStart = Vector2.zero
	local frameStart = Vector2.zero
	local targetVec = Vector2.new(0, 0)
	local converged = true
	local renderConn = nil
	local lastInputPos = Vector2.zero

	local function toVec(pos)
		return Vector2.new(pos.X.Scale, pos.Y.Scale)
	end

	local function clampTarget(vec)
		local vp = viewportSize()
		local absSize = handle.AbsoluteSize
		local anchor = handle.AnchorPoint
		-- keep the whole frame inside the viewport (in pixels)
		local px = vec.X * vp.X
		local py = vec.Y * vp.Y
		local minX = absSize.X * anchor.X
		local maxX = vp.X - absSize.X * (1 - anchor.X)
		local minY = absSize.Y * anchor.Y
		local maxY = vp.Y - absSize.Y * (1 - anchor.Y)
		if maxX < minX then maxX = minX end
		if maxY < minY then maxY = minY end
		px = math.clamp(px, minX, maxX)
		py = math.clamp(py, minY, maxY)
		return Vector2.new(px / vp.X, py / vp.Y)
	end

	local function updateTarget()
		if not dragging then return end
		local vp = viewportSize()
		local delta = lastInputPos - dragStart
		local newVec = Vector2.new(
			frameStart.X + delta.X / vp.X,
			frameStart.Y + delta.Y / vp.Y
		)
		targetVec = clampTarget(newVec)
		converged = false
		if not renderConn then
			renderConn = connectSafe(RunService.RenderStepped, function(dt)
				local current = toVec(handle.Position)
				local nextPos = current:Lerp(targetVec, 0.2)
				if (nextPos - targetVec).Magnitude < 0.0001 or converged then
					handle.Position = UDim2.new(targetVec.X, 0, targetVec.Y, 0)
					converged = true
					if renderConn then
						renderConn:Disconnect()
						renderConn = nil
					end
				else
					handle.Position = UDim2.new(nextPos.X, 0, nextPos.Y, 0)
				end
			end)
		end
	end

	connectSafe(dragRegion.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			lastInputPos = dragStart
			frameStart = toVec(handle.Position)
			targetVec = clampTarget(frameStart)
			converged = false
		end
	end)

	connectSafe(UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			lastInputPos = Vector2.new(input.Position.X, input.Position.Y)
			updateTarget()
		end
	end)

	connectSafe(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	-- Re-clamp on viewport resize
	local cam = WorkspaceService.CurrentCamera
	if cam then
		connectSafe(cam:GetPropertyChangedSignal("ViewportSize"), function()
			local current = toVec(handle.Position)
			local clamped = clampTarget(current)
			targetVec = clamped
			handle.Position = UDim2.new(clamped.X, 0, clamped.Y, 0)
		end)
	end
end


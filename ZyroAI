-- Fade edges (top / bottom / left) respond to scroll
local function makeFade(anchor, position, size, rotation)
	local f = new("Frame", {
		BackgroundColor3 = Theme.WindowBackground,
		BorderSizePixel = 0,
		AnchorPoint = anchor,
		Position = position,
		Size = size,
		ZIndex = 14,
	}, Content)
	local grad = new("UIGradient", {
		Rotation = rotation,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, f)
	return f, grad
end
local topFade = makeFade(Vector2.new(0, 0), UDim2.new(0, 0, 0.075, 0), UDim2.new(1, 0, 0.05, 0), 90)
local bottomFade = makeFade(Vector2.new(0, 1), UDim2.new(0, 0, 0.86, 0), UDim2.new(1, 0, 0.05, 0), -90)
local leftFade = makeFade(Vector2.new(0, 0), UDim2.new(0, 0, 0.075, 0), UDim2.new(0.03, 0, 0.785, 0), 0)

local function updateFades()
	local maxScroll = Feed.CanvasSize.Y.Offset - Feed.AbsoluteWindowSize.Y
	if maxScroll <= 0 then
		topFade.Visible = false
		bottomFade.Visible = false
	else
		topFade.Visible = Feed.CanvasPosition.Y > 8
		bottomFade.Visible = Feed.CanvasPosition.Y < maxScroll - 8
	end
	leftFade.Visible = false -- kept subtle; only show if content overflows horizontally (never for now)
end
connectSafe(Feed:GetPropertyChangedSignal("CanvasPosition"), updateFades)
connectSafe(Feed:GetPropertyChangedSignal("CanvasSize"), updateFades)

local function feedNearBottom()
	local maxScroll = Feed.CanvasSize.Y.Offset - Feed.AbsoluteWindowSize.Y
	if maxScroll <= 0 then return true end
	return Feed.CanvasPosition.Y >= maxScroll - 60
end

local function scrollToBottomIfNeeded()
	if feedNearBottom() then
		task.defer(function()
			Feed.CanvasPosition = Vector2.new(0, math.max(0, Feed.CanvasSize.Y.Offset))
		end)
	end
end


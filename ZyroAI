local function modelMeta(id)
	for _, m in ipairs(KNOWN_MODELS) do
		if m.id == id then
			return m
		end
	end
	-- Unknown model: conservative defaults
	return { id = id, label = id, thinking = false, maxTokens = 8192, tempMin = 0, tempMax = 2 }
end

local function modelLabel(id)
	local m = modelMeta(id)
	if m.label ~= m.id then
		return m.label
	end
	return id
end

local function newConversation(title)
	return {
		id       = HttpService:GenerateGUID(false),
		title    = title or "New Chat",
		pinned   = false,
		created  = os.time(),
		messages = {}, -- {role="user"|"model", text=string, time=number}
		settings = {
			maxTokens     = nil,  -- nil = API default
			temperature   = nil,
			thinkingLevel = "low",
		},
	}
end

local function getActiveConversation()
	for _, c in ipairs(State.conversations) do
		if c.id == State.activeConvId then
			return c
		end
	end
	return nil
end

-- Pinned chats sort above unpinned; recency within each group.
local function sortedConversations()
	local arr = {}
	for _, c in ipairs(State.conversations) do
		table.insert(arr, c)
	end
	table.sort(arr, function(a, b)
		if a.pinned ~= b.pinned then
			return a.pinned
		end
		return (a.created or 0) > (b.created or 0)
	end)
	return arr
end

---------------------------------------------------------------
-- Persistence (detect every function before use)
---------------------------------------------------------------
local function safeRead(path)
	if not ReadFileFn then return nil end
	local ok, content = pcall(ReadFileFn, path)
	if ok and type(content) == "string" then
		return content
	end
	return nil
end

local function safeWrite(path, content)
	if not WriteFileFn then return false end
	local ok = pcall(WriteFileFn, path, content)
	return ok
end

local function ensureFolders()
	if MakeFolderFn then
		pcall(MakeFolderFn, SAVE_FOLDER)
		pcall(MakeFolderFn, CONV_FOLDER)
	end
end

local function convPath(id)
	return CONV_FOLDER .. "/conv_" .. id .. ".json"
end

local function saveSettings()
	if not PersistenceAvailable then return end
	local payload = {
		apiKey        = State.apiKey,
		baseUrl       = State.baseUrl,
		selectedModel = State.selectedModel,
		prefs         = State.prefs,
		sidebarCollapsed = State.sidebarCollapsed,
		modelStatus   = State.modelStatus,
	}
	local ok, json = pcall(function()
		return HttpService:JSONEncode(payload)
	end)
	if ok then
		pcall(safeWrite, SETTINGS_PATH, json)
	end
end

local function saveProfile()
	if not PersistenceAvailable then return end
	local ok, json = pcall(function()
		return HttpService:JSONEncode(State.profile)
	end)
	if ok then
		pcall(safeWrite, PROFILE_PATH, json)
	end
end

local function saveConversation(conv)
	if not PersistenceAvailable or not conv then return end
	local payload = {
		id       = conv.id,
		title    = conv.title,
		pinned   = conv.pinned,
		created  = conv.created,
		settings = conv.settings,
		messages = conv.messages,
	}
	local ok, json = pcall(function()
		return HttpService:JSONEncode(payload)
	end)
	if ok then
		pcall(safeWrite, convPath(conv.id), json)
	end
end

local function deleteConversationFile(id)
	-- No delfile in the approved API list; overwriting with a tombstone the
	-- loader ignores keeps us within the detected function set.
	if not PersistenceAvailable then return end
	pcall(safeWrite, convPath(id), HttpService:JSONEncode({ deleted = true, id = id }))
end

local function loadAll()
	if not PersistenceAvailable then
		return
	end
	ensureFolders()

	do -- settings
		local raw = safeRead(SETTINGS_PATH)
		if raw then
			local ok, data = pcall(function()
				return HttpService:JSONDecode(raw)
			end)
			if ok and type(data) == "table" then
				if type(data.apiKey) == "string" then State.apiKey = data.apiKey end
				if type(data.baseUrl) == "string" and #data.baseUrl > 0 then State.baseUrl = data.baseUrl end
				if type(data.selectedModel) == "string" and #data.selectedModel > 0 then State.selectedModel = data.selectedModel end
				if type(data.prefs) == "table" then
					for k, v in pairs(data.prefs) do
						State.prefs[k] = v
					end
				end
				State.sidebarCollapsed = data.sidebarCollapsed == true
				if type(data.modelStatus) == "table" then
					for k, v in pairs(data.modelStatus) do
						if v == "ok" or v == "unavailable" then
							State.modelStatus[k] = v
						end
					end
				end
			end
		end
	end

	do -- profile
		local raw = safeRead(PROFILE_PATH)
		if raw then
			local ok, data = pcall(function()
				return HttpService:JSONDecode(raw)
			end)
			if ok and type(data) == "table" and type(data.aiName) == "string" then
				State.profile.aiName = data.aiName
			end
		end
	end

	do -- conversations
		local files = nil
		if ListFilesFn then
			local ok, result = pcall(ListFilesFn, CONV_FOLDER)
			if ok and type(result) == "table" then
				files = result
			end
		end
		if files then
			for _, path in ipairs(files) do
				if type(path) == "string" and string.match(path, "conv_.+%.json$") then
					local raw = safeRead(path)
					if raw then
						local ok, data = pcall(function()
							return HttpService:JSONDecode(raw)
						end)
						if ok and type(data) == "table" and not data.deleted
							and type(data.id) == "string" and type(data.messages) == "table" then
							local conv = {
								id       = data.id,
								title    = type(data.title) == "string" and data.title or "New Chat",
								pinned   = data.pinned == true,
								created  = tonumber(data.created) or os.time(),
								messages = {},
								settings = {
									maxTokens     = tonumber(data.settings and data.settings.maxTokens) or nil,
									temperature   = tonumber(data.settings and data.settings.temperature) or nil,
									thinkingLevel = (data.settings and data.settings.thinkingLevel == "high") and "high" or "low",
								},
							}
							for _, m in ipairs(data.messages) do
								if type(m) == "table" and type(m.text) == "string"
									and (m.role == "user" or m.role == "model") then
									table.insert(conv.messages, {
										role = m.role,
										text = m.text,
										time = tonumber(m.time) or os.time(),
									})
								end
							end
							table.insert(State.conversations, conv)
						end
					end
				end
			end
		end
	end
end

--== SECTION 3: Gemini API integration ==--

local function maskKey(key)
	if #key <= 8 then
		return string.rep("•", #key)
	end
	return string.sub(key, 1, 4) .. string.rep("•", 8) .. string.sub(key, -4)
end

-- Returns ok:boolean, responseTable|nil, errString|nil
local function httpRequest(opts)
	if not HttpFunc then
		return false, nil, "No HTTP function available (request / syn.request / http_request missing)."
	end
	local ok, response = pcall(HttpFunc, opts)
	if not ok then
		return false, nil, "HTTP request failed: " .. tostring(response)
	end
	if type(response) ~= "table" or response.StatusCode == nil then
		return false, nil, "Executor returned an incompatible response shape (missing StatusCode)."
	end
	return true, response, nil
end

local function apiErrorMessage(response, rawBody)
	local code = tonumber(response and response.StatusCode) or 0
	-- Try to pull Google's message field out of an error body
	local detail = nil
	if type(rawBody) == "string" and #rawBody > 0 then
		local ok, data = pcall(function()
			return HttpService:JSONDecode(rawBody)
		end)
		if ok and type(data) == "table" and type(data.error) == "table"
			and type(data.error.message) == "string" then
			detail = data.error.message
		end
	end
	if code == 401 or code == 403 then
		return "Invalid or unauthorized API key (HTTP " .. code .. "). Check your key in Settings → Gemini."
	elseif code == 429 then
		return "Rate limit or quota exceeded (HTTP 429). Wait and try again, or check your quota."
	elseif code == 404 then
		return "Model not found (HTTP 404). The selected model may be deprecated — pick another model."
	elseif code >= 500 then
		return "Gemini server error (HTTP " .. code .. "). Try again later."
	elseif code == 0 then
		return "Network failure or timeout. Check your connection."
	end
	if detail then
		return "Gemini error (HTTP " .. code .. "): " .. detail
	end
	return "Unexpected response from Gemini (HTTP " .. code .. ")."
end

-- Fire a generateContent request. Yields. Returns text|nil, errString|nil
local function geminiGenerate(conv, userText)
	if #State.apiKey == 0 then
		return nil, "No API key configured. Open Settings → Gemini to add one."
	end
	local contents = {}
	local history = conv.messages
	-- Cap history to keep payloads reasonable
	local startIndex = math.max(1, #history - 19)
	for i = startIndex, #history do
		local m = history[i]
		table.insert(contents, {
			role = m.role,
			parts = { { text = m.text } },
		})
	end
	table.insert(contents, {
		role = "user",
		parts = { { text = userText } },
	})

	local generationConfig = {}
	if conv.settings.maxTokens then
		generationConfig.maxOutputTokens = conv.settings.maxTokens
	end
	if conv.settings.temperature then
		generationConfig.temperature = conv.settings.temperature
	end
	local meta = modelMeta(State.selectedModel)
	if meta.thinking and conv.settings.thinkingLevel == "low" then
		-- Lowest supported thinking level: minimize thinking budget where supported.
		generationConfig.thinkingConfig = { thinkingBudget = 0 }
	end

	local payload = {
		contents = contents,
	}
	if next(generationConfig) ~= nil then
		payload.generationConfig = generationConfig
	end
	if #State.profile.aiName > 0 then
		payload.systemInstruction = {
			parts = { { text = "The user's name is " .. State.profile.aiName .. ". Address them by this name when natural." } },
		}
	end

	local encodeOk, body = pcall(function()
		return HttpService:JSONEncode(payload)
	end)
	if not encodeOk then
		return nil, "Failed to encode request."
	end

	local url = string.format("%s/v1beta/models/%s:generateContent",
		State.baseUrl, State.selectedModel)

	local ok, response, err = httpRequest({
		Url = url,
		Method = "POST",
		Headers = {
			["Content-Type"]   = "application/json",
			["x-goog-api-key"] = State.apiKey,
		},
		Body = body,
	})
	if not ok then
		return nil, err
	end
	if response.Success ~= true or (tonumber(response.StatusCode) or 0) >= 400 then
		local code = tonumber(response.StatusCode) or 0
		if code == 404 then
			State.modelStatus[State.selectedModel] = "unavailable"
			saveSettings()
		end
		return nil, apiErrorMessage(response, response.Body)
	end
	if type(response.Body) ~= "string" then
		return nil, "Malformed response from Gemini (non-string body)."
	end
	local decodeOk, data = pcall(function()
		return HttpService:JSONDecode(response.Body)
	end)
	if not decodeOk or type(data) ~= "table" then
		return nil, "Malformed JSON from Gemini."
	end
	if type(data.candidates) ~= "table" or #data.candidates == 0 then
		return nil, "Gemini returned no candidates. The prompt may have been blocked."
	end
	local parts = {}
	for _, candidate in ipairs(data.candidates) do
		if type(candidate) == "table"
			and type(candidate.content) == "table"
			and type(candidate.content.parts) == "table" then
			for _, part in ipairs(candidate.content.parts) do
				if type(part) == "table" and type(part.text) == "string" then
					table.insert(parts, part.text)
				end
			end
		end
	end
	if #parts == 0 then
		return nil, "Gemini returned an empty reply."
	end
	State.modelStatus[State.selectedModel] = "ok"
	return table.concat(parts, ""), nil
end

-- Fetch the live model list. Yields. Returns list|nil, err|nil
local function fetchModels()
	if #State.apiKey == 0 then
		return nil, "No API key configured."
	end
	local url = State.baseUrl .. "/v1beta/models"
	local ok, response, err = httpRequest({
		Url = url,
		Method = "GET",
		Headers = { ["x-goog-api-key"] = State.apiKey },
	})
	if not ok then
		return nil, err
	end
	if response.Success ~= true or (tonumber(response.StatusCode) or 0) >= 400 then
		return nil, apiErrorMessage(response, response.Body)
	end
	local decodeOk, data = pcall(function()
		return HttpService:JSONDecode(response.Body)
	end)
	if not decodeOk or type(data) ~= "table" or type(data.models) ~= "table" then
		return nil, "Malformed model list from Gemini."
	end
	local ids = {}
	for _, m in ipairs(data.models) do
		if type(m) == "table" and type(m.name) == "string"
			and type(m.supportedGenerationMethods) == "table" then
			local id = string.gsub(m.name, "^models/", "")
			local canGenerate = false
			for _, method in ipairs(m.supportedGenerationMethods) do
				if method == "generateContent" then
					canGenerate = true
					break
				end
			end
			if canGenerate then
				table.insert(ids, id)
			end
		end
	end
	table.sort(ids)
	-- Any model previously marked unavailable that came back in the list stays

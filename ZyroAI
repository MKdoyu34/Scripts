-- Split model text into segments: {kind="text"|"code", text, lang}
local function splitMarkdown(src)
	local segments = {}
	local pos = 1
	while true do
		local fs, fe, lang = string.find(src, "```(%w*)\n?", pos)
		if not fs then break end
		local cs, ce = string.find(src, "\n?```", fe + 1)
		if not cs then
			-- unterminated fence: treat the rest as plain text (malformed markdown safety)
			break
		end
		if fs > pos then
			table.insert(segments, { kind = "text", text = string.sub(src, pos, fs - 1) })
		end
		table.insert(segments, {
			kind = "code",
			text = string.sub(src, fe + 1, cs - 1),
			lang = lang or "",
		})
		pos = ce + 1
	end
	if pos <= #src then
		table.insert(segments, { kind = "text", text = string.sub(src, pos) })
	end
	if #segments == 0 then
		table.insert(segments, { kind = "text", text = src })
	end
	return segments
end

local function renderTextSegment(container, text, order)
	-- Split into blocks: headings, lists, tables, paragraphs
	local lines = {}
	for line in string.gmatch(text .. "\n", "(.-)\n") do
		table.insert(lines, line)
	end
	local i = 1
	local sub = order
	while i <= #lines do
		local line = lines[i]
		-- table block: consecutive lines starting with |
		if string.match(line, "^%s*|") then
			local rows = {}
			while i <= #lines and string.match(lines[i], "^%s*|") do
				-- skip separator rows |---|
				local strippedRow = string.gsub(string.gsub(lines[i], "\\|", ""), ":+", ""):gsub("%s", "")
				if not string.match(strippedRow, "^%-+$") then
					table.insert(rows, lines[i])
				end
				i += 1
			end
			sub += 1
			local tbl = new("Frame", {
				BackgroundColor3 = Theme.SecondaryBackground,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = sub,
				ZIndex = 12,
			}, container)
			addCorner(tbl, 0.05)
			addStroke(tbl, Theme.CodeBlockBorder, 0)
			new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, tbl)
			for r, rowLine in ipairs(rows) do
				local cells = {}
				for cell in string.gmatch(rowLine, "|([^|]*)") do
					table.insert(cells, (string.gsub(cell, "^%s*(.-)%s*$", "%1")))
				end
				local rowFrame = new("Frame", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0.028, 0),
					LayoutOrder = r,
					ZIndex = 13,
				}, tbl)
				new("UIListLayout", {
					FillDirection = Enum.FillDirection.Horizontal,
					SortOrder = Enum.SortOrder.LayoutOrder,
				}, rowFrame)
				for c, cellText in ipairs(cells) do
					makeTextLabel({
						Text = renderInlineMarkdown(cellText),
						RichText = true,
						TextSize = 11,
						Font = r == 1 and FONT_BOLD or FONT_MAIN,
						TextColor3 = r == 1 and Theme.PrimaryText or Theme.SecondaryText,
						TextXAlignment = Enum.TextXAlignment.Left,
						Size = UDim2.new(1 / math.max(#cells, 1), 0, 1, 0),
						TextTruncate = Enum.TextTruncate.AtEnd,
						LayoutOrder = c,
						ZIndex = 14,
					}, rowFrame)
				end
			end
		elseif string.match(line, "^%s*#") then
			local level = #(string.match(line, "^%s*(#+)") or "")
			local headingText = string.gsub(line, "^%s*#+%s*", "")
			sub += 1
			makeTextLabel({
				Text = renderInlineMarkdown(headingText),
				RichText = true,
				Font = FONT_BOLD,
				TextSize = math.max(18 - level * 2, 13),
				TextColor3 = Theme.PrimaryText,
				Size = UDim2.new(1, 0, math.max(26 - level * 2, 18) / 700, 0),
				LayoutOrder = sub,
				ZIndex = 12,
			}, container)
			i += 1
		elseif string.match(line, "^%s*[-*]%s+") or string.match(line, "^%s*%d+%.%s+") then
			local itemText = string.gsub(line, "^%s*[-*]%s+", "")
			itemText = string.gsub(itemText, "^%s*%d+%.%s+", "")
			sub += 1
			makeTextLabel({
				Text = "  •  " .. renderInlineMarkdown(itemText),
				RichText = true,
				TextSize = 13,
				TextColor3 = Theme.SecondaryText,
				Size = UDim2.new(1, 0, 0.026, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				TextWrapped = true,
				LayoutOrder = sub,
				ZIndex = 12,
			}, container)
			i += 1
		elseif string.gsub(line, "%s", "") == "" then
			i += 1 -- skip blank lines
		else
			-- gather a paragraph (consecutive non-empty, non-special lines)
			local para = { line }
			i += 1
			while i <= #lines do
				local l = lines[i]
				if string.gsub(l, "%s", "") == "" then
					i += 1
					break
				end
				if string.match(l, "^%s*#") or string.match(l, "^%s*[-*]%s+")
					or string.match(l, "^%s*%d+%.%s+") or string.match(l, "^%s*|")
					or string.match(l, "^%s*```") then
					break
				end
				table.insert(para, l)
				i += 1
			end
			sub += 1
			makeTextLabel({
				Text = renderInlineMarkdown(table.concat(para, " ")),
				RichText = true,
				TextSize = 13,
				TextColor3 = Theme.SecondaryText,
				TextWrapped = true,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = sub,
				ZIndex = 12,
			}, container)
		end
	end
	return sub
end

local function renderMessageContent(container, text, orderStart)
	local segments = splitMarkdown(text)
	local order = orderStart
	for _, seg in ipairs(segments) do
		if seg.kind == "code" then
			order += 1
			makeCodeBlock(seg.text, seg.lang, container, order)
		else
			order = renderTextSegment(container, seg.text, order)
		end
	end
end


local function addMessageBubble(msg)
	messageIdCounter += 1
	local isUser = msg.role == "user"

	local holder = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(0.9, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = messageIdCounter,
		ZIndex = 11,
	}, Feed)

	local bubble = new("Frame", {
		BackgroundColor3 = isUser and Theme.UserMessageBackground or Theme.ZyroMessageBackground,
		AnchorPoint = isUser and Vector2.new(1, 0) or Vector2.new(0, 0),
		Position = isUser and UDim2.new(1, 0, 0, 0) or UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(isUser and 0.75 or 0.92, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		ZIndex = 12,
	}, holder)
	addCorner(bubble, 0.05)
	if isUser then
		addStroke(bubble, Theme.UserMessageBorder, 0)
	else
		addStroke(bubble, Theme.SecondaryBorder, 0)
	end
	addPadding(bubble, 0.03)

	local inner = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 13,
	}, bubble)
	new("UIListLayout", {
		Padding = UDim.new(0.02, 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, inner)

	local text = msg.text or ""
	local isLong = isUser and #text >= 300
	local msgKey = msg.id or ("msg" .. tostring(messageIdCounter))

	if isLong then
		local preview = truncate(text, 280)
		local expanded = State.uiExpanded[msgKey] == true
		local label = makeTextLabel({
			Text = expanded and text or preview,
			TextSize = 13,
			TextColor3 = Theme.PrimaryText,
			TextWrapped = true,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 1,
			ZIndex = 14,
		}, inner)
		local toggle = new("TextButton", {
			Text = expanded and "Show less" or "Show more",
			Font = FONT_BOLD,
			TextSize = 11,
			TextColor3 = Theme.PrimaryAccent,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0.022, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 2,
			ZIndex = 14,
		}, inner)
		connectSafe(toggle.MouseButton1Click, function()
			State.uiExpanded[msgKey] = not State.uiExpanded[msgKey]
			local nowExpanded = State.uiExpanded[msgKey]
			label.Text = nowExpanded and text or preview
			toggle.Text = nowExpanded and "Show less" or "Show more"
		end)
	else
		renderMessageContent(inner, text, 0)
	end

	return holder
end

local TypingBubble = nil
local function showTyping()
	if TypingBubble then return end
	messageIdCounter += 1
	TypingBubble = new("Frame", {
		BackgroundColor3 = Theme.ZyroMessageBackground,
		Size = UDim2.new(0.18, 0, 0.035, 0),

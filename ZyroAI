	local dots = {}
	for i = 1, 3 do
		local d = new("Frame", {
			BackgroundColor3 = Theme.Loading,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0.2 + (i - 1) * 0.25, 0, 0.5, 0),

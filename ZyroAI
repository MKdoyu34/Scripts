-- Notification manager
local Notifications = {}
do
	local CARD_H_SCALE = 0.085  -- of viewport height
	local GAP_SCALE    = 0.012
	local stack = {}           -- ordered oldest -> newest
	local container = new("Frame", {
		Name = "NotificationRoot",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(0.985, 0, 0.98, 0),
		Size = UDim2.new(0.24, 0, 0.6, 0),
		ZIndex = 80,
	}, ScreenGui)

	local function relayout(animated)
		-- stack[1] is oldest (top of stack); newest sits at the bottom
		local total = #stack
		for i, entry in ipairs(stack) do
			local indexFromBottom = total - i
			local yOffset = -(indexFromBottom * (CARD_H_SCALE + GAP_SCALE)) / 0.6
			local target = UDim2.new(1, 0, 1, yOffset)
			if animated then
				tween(entry.frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { Position = target })
			else
				entry.frame.Position = target
			end
		end
	end

	local function dismiss(entry, instant)
		if entry.dead then return end
		entry.dead = true
		if entry.progressTween then
			pcall(function() entry.progressTween:Cancel() end)
		end
		for i, e in ipairs(stack) do
			if e == entry then
				table.remove(stack, i)
				break
			end
		end
		local function destroy()
			if entry.frame then
				pcall(function() entry.frame:Destroy() end)
			end
		end
		if instant then
			destroy()
			relayout(false)
		else
			tween(entry.frame, TweenInfo.new(0.3), {
				BackgroundTransparency = 1,
				Position = entry.frame.Position + UDim.new(0.25, 0),
			})
			for _, d in ipairs(entry.frame:GetDescendants()) do
				pcall(function()
					if d:IsA("GuiObject") then
						tween(d, TweenInfo.new(0.3), { TextTransparency = 1, BackgroundTransparency = 1 })
					end
				end)
			end
			task.delay(0.32, destroy)
			relayout(true)
		end
	end

	function Notifications.push(opts)
		-- opts: title, description, status ("success"|"warning"|"error"|"info"|"loading"), duration
		local duration = opts.duration or 4.5
		local statusColor = Theme.Info
		if opts.status == "success" then
			statusColor = Theme.Success
		elseif opts.status == "warning" then
			statusColor = Theme.Warning
		elseif opts.status == "error" then
			statusColor = Theme.Error
		elseif opts.status == "loading" then
			statusColor = Theme.Loading
			duration = math.max(duration, 30)
		end

		local frame = new("Frame", {
			BackgroundColor3 = Theme.ElevatedSurface,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, 0, 1, 0),
			Size = UDim2.new(1, 0, CARD_H_SCALE / 0.6, 0),
			ZIndex = 80,
			ClipsDescendants = true,
		}, container)
		addCorner(frame, 0.1)
		addStroke(frame, Theme.PrimaryBorder, 0)

		local dot = new("Frame", {
			BackgroundColor3 = statusColor,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0.05, 0, 0.28, 0),
			Size = UDim2.new(0.025, 0, 0.14, 0),
			ZIndex = 81,
		}, frame)
		addCorner(dot, 0.5)

		makeTextLabel({
			Text = opts.title or "",
			Font = FONT_BOLD,
			TextSize = 13,
			Position = UDim2.new(0.1, 0, 0.08, 0),
			Size = UDim2.new(0.85, 0, 0.4, 0),
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 81,
		}, frame)

		makeTextLabel({
			Text = opts.description or "",
			TextSize = 11,
			TextColor3 = Theme.SecondaryText,
			Position = UDim2.new(0.1, 0, 0.45, 0),
			Size = UDim2.new(0.85, 0, 0.45, 0),
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 81,
		}, frame)

		-- progress bar (2–3 px: use thin scale of card height)
		local barTrack = new("Frame", {
			BackgroundColor3 = Theme.SecondaryBorder,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0.04, 0),
			BorderSizePixel = 0,
			ZIndex = 81,
		}, frame)
		local bar = new("Frame", {
			BackgroundColor3 = statusColor,
			Size = UDim2.new(1, 0, 1, 0),
			BorderSizePixel = 0,
			ZIndex = 82,
		}, barTrack)

		local entry = { frame = frame, dead = false, progressTween = nil }
		-- slide in
		frame.Position = UDim2.new(1.3, 0, 1, 0)
		tween(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), { Position = UDim2.new(1, 0, 1, 0) })

		table.insert(stack, entry)
		while #stack > 4 do
			dismiss(stack[1], false)
		end
		task.defer(relayout, true)

		entry.progressTween = tween(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
			Size = UDim2.new(0, 0, 1, 0),
		})
		task.delay(duration, function()
			dismiss(entry, false)
		end)

		return entry
	end

	function Notifications.dismissEntry(entry)
		if entry then
			dismiss(entry, false)
		end
	end
end


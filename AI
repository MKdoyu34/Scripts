-- OPEN / CLOSE
--------------------------------------------------------------------------------
local function openPanelPosition()
	return UDim2.new(1, -CONFIG.PanelMargin, 0.5, 0)
end

local function closedPanelPosition()
	return UDim2.new(1, panelWidth + 8, 0.5, 0)
end

local function openTogglePosition()
	return UDim2.new(1, -(CONFIG.PanelMargin + panelWidth + CONFIG.ToggleGap), 0.5, 0)
end

local function closedTogglePosition()
	return UDim2.new(1, -CONFIG.ToggleMargin, 0.5, 0)
end

local function setOpen(open)
	uiToken += 1
	local token = uiToken
	isOpen = open

	if open then
		panel.Visible = true
	end

	local panelTween = tween(panel, { Position = open and openPanelPosition() or closedPanelPosition() }, CONFIG.OpenDuration)
	tween(toggleButton, { Position = open and openTogglePosition() or closedTogglePosition() }, CONFIG.OpenDuration)

	toggleButton.Text = open and "X" or "AI"

	panelTween.Completed:Connect(function()
		if token == uiToken and not isOpen then
			panel.Visible = false
		end
	end)

	if open then
		task.defer(scrollToBottom)
	end
end

toggleButton.MouseButton1Click:Connect(function()
	setOpen(not isOpen)
end)


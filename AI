local function showNotice(text, color)
	noticeLabel.Text = text
	noticeLabel.TextColor3 = color
end

--[[
	HOOK POINT 1 of 2
	Replace the body of `sendRequest` with a real call, e.g.
		RemoteEvent:FireServer(text)
	or
		HttpService:RequestAsync({...})
	and call `handleIncomingMessage(reply)` when the answer arrives.
]]
local function sendRequest(text)
	return nil
end

--[[
	HOOK POINT 2 of 2
	Call this from your backend callback to push an AI reply into the chat.
]]
local function handleIncomingMessage(text)
	addMessage("bot", text)
end

local function onSend()
	local text = inputBox.Text
	if text == nil or text:match("^%s*$") then
		showNotice("Type a message first", Color.TextDim)
		task.delay(2, function()
			showNotice(noticeDefault, Color.Offline)
		end)
		return
	end

	local reply = sendRequest(text)
	if reply then
		handleIncomingMessage(reply)
		return
	end

	showNotice("Backend not connected \u{2014} send is disabled for now", Color.Offline)
	task.delay(3, function()
		showNotice(noticeDefault, Color.Offline)
	end)
end

sendButton.MouseButton1Click:Connect(onSend)

--------------------------------------------------------------------------------
-- LAYOUT / RESPONSIVE
--------------------------------------------------------------------------------
local function reflowMessages()
	for _, record in ipairs(messageRecords) do
		if record.kind == "message" then
			local rowWidth = panelWidth - CONFIG.RowPadding * 2
			local maxInnerWidth = rowWidth - CONFIG.AvatarSize - CONFIG.AvatarGap - CONFIG.BubblePadX * 2
			local innerWidth, textHeight = measureMessage(record.text, maxInnerWidth)
			local bubbleWidth = innerWidth + CONFIG.BubblePadX * 2
			local bubbleHeight =
				CONFIG.BubblePadTop + textHeight + 2 + CONFIG.TimeLineHeight + CONFIG.BubblePadBottom

			record.row.Size = UDim2.new(1, -CONFIG.RowPadding * 2, 0, bubbleHeight)
			record.bubble.Size = UDim2.fromOffset(bubbleWidth, bubbleHeight)
			record.textLabel.Size = UDim2.new(1, -CONFIG.BubblePadX * 2, 0, textHeight)
			record.timeLabel.Position = UDim2.fromOffset(CONFIG.BubblePadX, CONFIG.BubblePadTop + textHeight + 2)
		end
	end
end

local function applyLayout()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)

	local width = CONFIG.PanelWidth
	-- Keep enough room on the left for the toggle button to sit beside the panel.
	local maxWidth = viewport.X - CONFIG.ToggleRoom
	if maxWidth < width then
		width = math.max(CONFIG.MinPanelWidth, maxWidth)
	end

	if width ~= panelWidth then
		panelWidth = width
		panel.Size = UDim2.new(0, panelWidth, CONFIG.PanelHeightScale, 0)
		reflowMessages()
	end

	panel.Position = isOpen and openPanelPosition() or closedPanelPosition()
	toggleButton.Position = isOpen and openTogglePosition() or closedTogglePosition()
end

local camera = workspace.CurrentCamera
if camera then
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(applyLayout)
end

applyLayout()


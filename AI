		Font = FontBold,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		Parent = avatar,
	})
	return avatar
end

local function addMessage(role, text, timestamp)
	local isUser = role == "user"
	local rowWidth = panelWidth - CONFIG.RowPadding * 2
	local maxBubbleWidth = rowWidth - CONFIG.AvatarSize - CONFIG.AvatarGap
	local maxInnerWidth = maxBubbleWidth - CONFIG.BubblePadX * 2
	local innerWidth, textHeight = measureMessage(text, maxInnerWidth)
	local bubbleWidth = innerWidth + CONFIG.BubblePadX * 2
	local bubbleHeight =
		CONFIG.BubblePadTop + textHeight + 2 + CONFIG.TimeLineHeight + CONFIG.BubblePadBottom

	messageOrder += 1
	local row = create("Frame", {
		Name = "MessageRow",
		Size = UDim2.new(1, -CONFIG.RowPadding * 2, 0, bubbleHeight),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = messageOrder,
	})

	local bubble = create("Frame", {
		Name = "Bubble",
		AnchorPoint = isUser and Vector2.new(1, 0) or Vector2.new(0, 0),
		Position = isUser
			and UDim2.new(1, -(CONFIG.AvatarSize + CONFIG.AvatarGap), 0, 0)
			or UDim2.fromOffset(CONFIG.AvatarSize + CONFIG.AvatarGap, 0),
		Size = UDim2.fromOffset(bubbleWidth, bubbleHeight),
		BackgroundColor3 = isUser and Color.BubbleUser or Color.BubbleBot,
		BorderSizePixel = 0,
		Parent = row,
	})
	round(bubble, 14)

	local textLabel = create("TextLabel", {
		Name = "Text",
		Size = UDim2.new(1, -CONFIG.BubblePadX * 2, 0, textHeight),
		Position = UDim2.fromOffset(CONFIG.BubblePadX, CONFIG.BubblePadTop),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = Color.Text,
		TextSize = CONFIG.MessageTextSize,
		Font = Font,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Parent = bubble,
	})

	local timeLabel = create("TextLabel", {
		Name = "Time",
		Size = UDim2.new(1, -CONFIG.BubblePadX * 2, 0, CONFIG.TimeLineHeight),
		Position = UDim2.fromOffset(CONFIG.BubblePadX, CONFIG.BubblePadTop + textHeight + 2),
		BackgroundTransparency = 1,
		Text = timestamp or os.date("%H:%M"),
		TextColor3 = isUser and Color3.fromRGB(206, 210, 255) or Color.TextDim,
		TextSize = 10,
		Font = Font,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextYAlignment = Enum.TextYAlignment.Center,
		Parent = bubble,
	})

	local avatar
	if isUser then
		avatar = buildAvatar("YOU", Color3.fromRGB(52, 58, 92), 9)
		avatar.AnchorPoint = Vector2.new(1, 0)
		avatar.Position = UDim2.new(1, -CONFIG.AvatarSize, 0, 0)
	else
		avatar = buildAvatar("AI", Color.Accent, 11)
		avatar.Position = UDim2.fromOffset(0, 0)
	end
	avatar.Parent = row

	row.Parent = messageArea
	table.insert(messageRecords, {
		kind = "message",
		row = row,
		bubble = bubble,
		textLabel = textLabel,
		timeLabel = timeLabel,
		text = text,
	})
	scrollToBottom()
	return row
end

local function addSystemMessage(text)
	local width = TextService:GetTextSize(text, 11, FontMedium).X
	local pillWidth = math.ceil(width) + 28

	messageOrder += 1
	local row = create("Frame", {

local function clearChat()
	for _, record in ipairs(messageRecords) do
		record.row:Destroy()
	end
	table.clear(messageRecords)
	messageOrder = 0
	addSystemMessage("New session started")
	addMessage("bot", "Fresh chat! What would you like to work on?")
end

newChatButton.MouseButton1Click:Connect(clearChat)


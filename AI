--------------------------------------------------------------------------------
-- SMALL HELPERS
--------------------------------------------------------------------------------
local function create(className, properties, children)
	local instance = Instance.new(className)
	if properties then
		for property, value in pairs(properties) do
			instance[property] = value
		end
	end
	if children then
		for _, child in ipairs(children) do
			if child then
				child.Parent = instance
			end
		end
	end
	return instance
end

local function round(instance, radius)
	create("UICorner", {
		CornerRadius = UDim.new(0, radius or 12),
		Parent = instance,
	})
	return instance
end

local function circle(instance)
	create("UICorner", {
		CornerRadius = UDim.new(1, 0),
		Parent = instance,
	})
	return instance
end

local function tween(instance, goals, duration)
	local animation = TweenService:Create(
		instance,
		TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		goals
	)
	animation:Play()
	return animation
end

local function measureHeight(text, width)
	local _, height = TextService:GetTextSize(text, CONFIG.MessageTextSize, Font, width)
	return math.ceil(height)
end

--[[
	Returns the inner text width and the text height for a bubble.
	Short messages get a compact (shrink to fit) bubble; long ones wrap
	inside the maximum bubble width.
]]
local function measureMessage(text, maxInnerWidth)
	local singleLine = TextService:GetTextSize(text, CONFIG.MessageTextSize, Font, 0)
	if singleLine.X <= maxInnerWidth then
		return math.ceil(singleLine.X) + 1, math.ceil(singleLine.Y)
	end
	return maxInnerWidth, measureHeight(text, maxInnerWidth)
end


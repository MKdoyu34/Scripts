local function buildAvatar(label, background, textSize)
	local avatar = create("Frame", {
		Size = UDim2.fromOffset(CONFIG.AvatarSize, CONFIG.AvatarSize),
		BackgroundColor3 = background,
		BorderSizePixel = 0,
	})

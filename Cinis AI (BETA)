local Theme = { name = "Moonlight", current = THEMES.Moonlight }
local themeBindings = {} -- { { inst, prop, key } } auto-updated on theme switch
local themeHooks = {} -- custom update functions (gradients, icons, labels)

local function bindTheme(inst, prop, key)
    table.insert(themeBindings, { inst = inst, prop = prop, key = key })
    inst[prop] = Theme.current[key]
end

local function onTheme(fn)
    table.insert(themeHooks, fn)
end

-- Shared namespace tables (keep the main chunk's local count low)
local UI = {} -- GUI instances shared across sections
local Fn = {} -- functions shared across sections

function Fn.applyTheme(name)
    local theme = THEMES[name] or THEMES.Moonlight
    Theme.name = theme == THEMES.Sunset and "Sunset" or "Moonlight"
    Theme.current = theme
    for _, binding in ipairs(themeBindings) do
        pcall(function()
            binding.inst[binding.prop] = theme[binding.key]
        end)
    end
    for _, hook in ipairs(themeHooks) do
        pcall(hook, theme)
    end
    Settings.theme = Theme.name
    saveSettings()
end


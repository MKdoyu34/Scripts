        corner(box, 8)
        stroke(box, "Stroke", 1, 0.7)
        create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = box })
        on(box.Focused, function()
            box.Text = Settings.keys[provider] or ""
        end)
        on(box.FocusLost, function()
            Settings.keys[provider] = box.Text or ""
            box.Text = maskKey(Settings.keys[provider])
            saveSettings()
        end)
    end

    -- ---------- Custom models manager ----------
    sectionTitle("Models", 5)
    local modelsCard = card(6)
    makeLabel({
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        Text = "Add models yourself (display name, model ID, provider). Custom models also need an OpenAI-compatible base URL.",
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 1,
        Parent = modelsCard,
    }, "TextDim")

    local editingUid = nil
    local formProvider = "OpenAI"

    local nameBox = fieldBox(modelsCard, 2, "Display name (e.g. GPT-4o mini)")
    local idBox = fieldBox(modelsCard, 3, "Model ID (e.g. gpt-4o-mini)")

    local providerRow = create("Frame", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        LayoutOrder = 4,
        Parent = modelsCard,
    })
    local providerBtn = create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Theme.current.InputBg,
        Text = "",
        AutoButtonColor = true,
        Parent = providerRow,
    })
    bindTheme(providerBtn, "BackgroundColor3", "InputBg")
    corner(providerBtn, 8)
    stroke(providerBtn, "Stroke", 1, 0.7)
    local providerLabel = makeLabel({
        Position = UDim2.fromOffset(8, 0),
        Size = UDim2.new(1, -30, 1, 0),
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Text = "OpenAI",
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = providerBtn,
    })
    local providerChevron = iconLabel(providerBtn, 14, ICONS.chevronDown)
    providerChevron.AnchorPoint = Vector2.new(1, 0.5)
    providerChevron.Position = UDim2.new(1, -8, 0.5, 0)

    local baseUrlBox = fieldBox(modelsCard, 5, "Base URL - Custom provider only")
    local authBox = fieldBox(modelsCard, 6, "Auth header - Custom provider only")

    local function setCustomFieldsEnabled(enabled)
        baseUrlBox.Text = enabled and baseUrlBox.Text or ""
        authBox.Text = enabled and authBox.Text or ""
        baseUrlBox.PlaceholderText = enabled and "Base URL, OpenAI-compatible (required)" or "Base URL - Custom provider only"
        authBox.PlaceholderText = enabled and "Auth header, e.g. x-api-key: value (optional)" or "Auth header - Custom provider only"
        baseUrlBox.TextTransparency = enabled and 0 or 0.5
        authBox.TextTransparency = enabled and 0 or 0.5
    end

    on(providerBtn.Activated, function()
        local items = {}
        for _, provider in ipairs(CONFIG.providers) do
            table.insert(items, { id = provider, label = provider })
        end
        Fn.openDropdown(providerBtn, 240, items, function(id)
            formProvider = id
            providerLabel.Text = id
            setCustomFieldsEnabled(id == "Custom")
        end, formProvider)
    end)

    local formButtons = create("Frame", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        LayoutOrder = 7,
        Parent = modelsCard,
    })
    local saveModelBtn = create("TextButton", {
        Size = UDim2.fromOffset(130, 32),
        BackgroundColor3 = Theme.current.Accent,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        Text = "Add Model",
        AutoButtonColor = true,
        Parent = formButtons,
    })
    bindTheme(saveModelBtn, "BackgroundColor3", "Accent")
    bindTheme(saveModelBtn, "TextColor3", "OnAccent")
    corner(saveModelBtn, 8)
    local cancelEditBtn = create("TextButton", {
        Position = UDim2.fromOffset(140, 0),
        Size = UDim2.fromOffset(70, 32),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Text = "Cancel",
        AutoButtonColor = false,
        Visible = false,
        Parent = formButtons,
    })
    bindTheme(cancelEditBtn, "TextColor3", "TextDim")
    local formError = makeLabel({
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        Text = "",
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        Visible = false,
        LayoutOrder = 8,
        Parent = modelsCard,
    }, "ErrorText")

    local modelList = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        LayoutOrder = 9,
        Parent = modelsCard,
    })
    create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = modelList })

    local function clearForm()
        editingUid = nil
        nameBox.Text = ""
        idBox.Text = ""
        formProvider = "OpenAI"
        providerLabel.Text = "OpenAI"
        baseUrlBox.Text = ""
        authBox.Text = ""
        setCustomFieldsEnabled(false)
        saveModelBtn.Text = "Add Model"
        cancelEditBtn.Visible = false
        formError.Visible = false
    end

    local function refreshModelRows()
        for _, child in ipairs(modelList:GetChildren()) do
            if child:IsA("Frame") then
                child:Destroy()
            end
        end
        if #Settings.models == 0 then
            makeLabel({
                Size = UDim2.new(1, 0, 0, 18),
                Font = Enum.Font.Gotham,
                TextSize = 11,
                Text = "No models yet - add one above.",
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = modelList,
            }, "TextDim")
            return
        end
        for index, model in ipairs(Settings.models) do
            local row = create("Frame", {
                Size = UDim2.new(1, 0, 0, 38),
                BackgroundColor3 = Theme.current.InputBg,
                LayoutOrder = index,
                Parent = modelList,
            })
            bindTheme(row, "BackgroundColor3", "InputBg")
            corner(row, 8)
            makeLabel({
                Position = UDim2.fromOffset(10, 4),
                Size = UDim2.new(1, -70, 0, 15),
                Font = Enum.Font.GothamMedium,
                TextSize = 12,
                Text = model.name,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = row,
            })
            makeLabel({
                Position = UDim2.fromOffset(10, 20),
                Size = UDim2.new(1, -70, 0, 12),
                Font = Enum.Font.Gotham,
                TextSize = 10,
                Text = model.provider .. " - " .. model.modelId,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = row,
            }, "TextDim")
            local editBtn = iconButton(row, 16, ICONS.pencil)
            editBtn.AnchorPoint = Vector2.new(1, 0.5)
            editBtn.Position = UDim2.new(1, -30, 0.5, 0)
            local deleteBtn = iconButton(row, 16, ICONS.trash)
            deleteBtn.AnchorPoint = Vector2.new(1, 0.5)
            deleteBtn.Position = UDim2.new(1, -10, 0.5, 0)

            on(editBtn.Activated, function()
                editingUid = model.uid
                nameBox.Text = model.name
                idBox.Text = model.modelId
                formProvider = model.provider
                providerLabel.Text = model.provider
                setCustomFieldsEnabled(model.provider == "Custom")
                baseUrlBox.Text = model.baseUrl or ""
                authBox.Text = model.authHeader or ""
                saveModelBtn.Text = "Save Changes"
                cancelEditBtn.Visible = true
                formError.Visible = false
            end)
            on(deleteBtn.Activated, function()
                for i, saved in ipairs(Settings.models) do
                    if saved.uid == model.uid then
                        table.remove(Settings.models, i)
                        break
                    end
                end
                if Settings.activeModel == model.uid then
                    Settings.activeModel = nil
                end
                if editingUid == model.uid then
                    clearForm()
                end
                saveSettings()
                refreshModelRows()
                Fn.updateModelHeader()
            end)
        end
    end
    function Fn.refreshModelRows()
        refreshModelRows()
    end

    local function submitForm()
        local name = (nameBox.Text or ""):match("^%s*(.-)%s*$")
        local modelId = (idBox.Text or ""):match("^%s*(.-)%s*$")
        local baseUrl = (baseUrlBox.Text or ""):match("^%s*(.-)%s*$")
        local auth = (authBox.Text or ""):match("^%s*(.-)%s*$")
        local function fail(message)
            formError.Text = message
            formError.Visible = true
        end
        if name == "" or modelId == "" then
            return fail("Display name and model ID are required.")
        end
        if formProvider == "Custom" then
            if baseUrl == "" then
                return fail("A base URL is required for Custom models.")
            end
            if baseUrl:sub(1, 7) ~= "http://" and baseUrl:sub(1, 8) ~= "https://" then
                return fail("Base URL must start with http:// or https://")
            end
        end
        if editingUid then
            for _, model in ipairs(Settings.models) do
                if model.uid == editingUid then
                    model.name = name
                    model.modelId = modelId
                    model.provider = formProvider
                    model.baseUrl = formProvider == "Custom" and baseUrl or ""
                    model.authHeader = formProvider == "Custom" and auth or ""
                    break
                end
            end
        else
            local model = {
                uid = HttpService:GenerateGUID(false),
                name = name,
                modelId = modelId,
                provider = formProvider,
                baseUrl = formProvider == "Custom" and baseUrl or "",
                authHeader = formProvider == "Custom" and auth or "",
            }
            table.insert(Settings.models, model)
            if not Settings.activeModel then
                Settings.activeModel = model.uid
            end
        end
        saveSettings()
        clearForm()
        refreshModelRows()
        Fn.updateModelHeader()
    end
    on(saveModelBtn.Activated, submitForm)
    on(cancelEditBtn.Activated, clearForm)
end


    local pending = false

    local function setPending(value)
        pending = value
        sendBtn.ImageTransparency = value and 0.55 or 0
        sendBtn.AutoButtonColor = not value
    end

    local function buildHistory()
        local messages = {}
        if Session.activeChat then
            for _, msg in ipairs(Session.activeChat.messages) do
                if msg.role == "user" or msg.role == "assistant" then
                    table.insert(messages, { role = msg.role, content = msg.content })
                end
            end
        end
        if #messages > CONFIG.historyLimit then
            local trimmed = {}
            for i = #messages - CONFIG.historyLimit + 1, #messages do
                table.insert(trimmed, messages[i])
            end
            messages = trimmed
        end
        return messages
    end

    local function sendMessage()
        if pending then
            return
        end
        local text = (inputBox.Text or ""):match("^%s*(.-)%s*$")
        if text == "" then
            return
        end
        local model = getActiveModel()
        if not model then
            welcome.Visible = false
            renderMessage("error", "No model selected. Add one from the model menu or Settings first.")
            scrollToBottom()
            return
        end

        local chat = Session.activeChat
        if not chat then
            chat = {
                uid = HttpService:GenerateGUID(false),
                title = #text > 32 and (text:sub(1, 32) .. "...") or text,
                messages = {},
            }
            table.insert(Chats, 1, chat)
            Session.activeChat = chat
            Settings.lastChat = chat.uid
            saveSettings()
        end

        table.insert(chat.messages, { role = "user", content = text })
        welcome.Visible = false
        renderMessage("user", text)
        inputBox.Text = ""
        saveChats()
        Fn.refreshChatList()
        scrollToBottom()

        setPending(true)
        Session.pendingChatUid = chat.uid
        setTyping(true)
        task.spawn(function()
            local reply, err = Fn.callModel(model, buildHistory())
            if Session.shutdown then
                return
            end
            setPending(false)
            setTyping(false)
            Session.pendingChatUid = nil
            if reply then
                table.insert(chat.messages, { role = "assistant", content = reply })
            else
                table.insert(chat.messages, { role = "error", content = tostring(err) })
            end
            saveChats()
            if Session.activeChat == chat then
                renderMessage(reply and "assistant" or "error", reply or err)
                scrollToBottom()
            end
        end)
    end

    on(sendBtn.Activated, sendMessage)
    on(inputBox.FocusLost, function(enterPressed)
        if enterPressed then
            task.defer(function()
                if not Session.shutdown then
                    sendMessage()
                    pcall(function()
                        inputBox:CaptureFocus()
                    end)
                end
            end)
        end
    end)
end


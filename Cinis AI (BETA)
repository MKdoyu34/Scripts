local connections = {}

local function on(signal, handler)
    local conn = signal:Connect(handler)
    table.insert(connections, conn)
    return conn
end

local function create(className, props, children)
    local inst = Instance.new(className)
    for key, value in pairs(props or {}) do
        if key ~= "Parent" then
            inst[key] = value
        end
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    if props and props.Parent then
        inst.Parent = props.Parent
    end
    return inst
end

local function corner(parent, radius)
    return create("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

local function stroke(parent, colorKey, thickness, transparency)
    local s = create("UIStroke", {
        Thickness = thickness or 1,
        Transparency = transparency == nil and 0.3 or transparency,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
    bindTheme(s, "Color", colorKey or "Stroke")
    return s
end

local function makeLabel(props, colorKey)
    local inst = create("TextLabel", props)
    bindTheme(inst, "TextColor3", colorKey or "Text")
    return inst
end

-- The Cinis AI logo: letter "C" in an accent rounded square with a gradient
local function makeLogo(size, parent)
    local holder = create("Frame", {
        Size = UDim2.fromOffset(size, size),
        BackgroundColor3 = Theme.current.Accent,
        Parent = parent,
    })
    bindTheme(holder, "BackgroundColor3", "Accent")
    corner(holder, math.max(6, math.floor(size * 0.3)))
    local gradient = create("UIGradient", { Parent = holder })
    local function paintGradient(theme)
        gradient.Color = ColorSequence.new(theme.GradientA, theme.GradientB)
    end
    paintGradient(Theme.current)
    onTheme(paintGradient)
    makeLabel({
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.GothamBlack,
        Text = "C",
        TextScaled = true,
        Parent = holder,
    }, "OnAccent")
    return holder
end

local function iconButton(parent, size, iconId)
    local btn = create("ImageButton", {
        Size = UDim2.fromOffset(size, size),
        BackgroundTransparency = 1,
        Image = iconId,
        ImageTransparency = 0.15,
        AutoButtonColor = false,
        Parent = parent,
    })
    bindTheme(btn, "ImageColor3", "Icon")
    on(btn.MouseEnter, function()
        btn.ImageTransparency = 0
    end)
    on(btn.MouseLeave, function()
        btn.ImageTransparency = 0.15
    end)
    return btn
end


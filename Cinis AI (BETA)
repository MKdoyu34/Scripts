-- HTTP: prefer request, fall back to http_request (Delta / Arceus X)
local httpRequest = nil
if type(request) == "function" then
    httpRequest = request
elseif type(http_request) == "function" then
    httpRequest = http_request
end

-- File system helpers; nil when the executor does not expose them
local FS = {
    write = (type(writefile) == "function") and writefile or nil,
    read = (type(readfile) == "function") and readfile or nil,
    exists = (type(isfile) == "function") and isfile or nil,
    folderExists = (type(isfolder) == "function") and isfolder or nil,
    mkdir = (type(makefolder) == "function") and makefolder or nil,
}
FS.available = (FS.write ~= nil) and (FS.read ~= nil)

-- Pick the safest available parent for the ScreenGui
local function resolveGuiParent()
    local candidates = {}
    if type(gethui) == "function" then
        table.insert(candidates, function()
            local ok, ui = pcall(gethui)
            return ok and ui or nil
        end)
    end
    table.insert(candidates, function()
        return game:GetService("CoreGui")
    end)
    table.insert(candidates, function()
        return LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
    end)
    for _, attempt in ipairs(candidates) do
        local ok, target = pcall(attempt)
        if ok and target then
            local writable = pcall(function()
                local probe = Instance.new("Folder")
                probe.Name = "CinisAICheck"
                probe.Parent = target
                probe:Destroy()
            end)
            if writable then
                return target
            end
        end
    end
    return nil
end


    -- ---------- API keys (masked on screen, saved locally) ----------
    sectionTitle("API Keys", 3)
    local keysCard = card(4)
    local function maskKey(key)
        if type(key) ~= "string" or key == "" then
            return ""
        end
        return string.rep("*", math.min(#key, 26))
    end
    for index, provider in ipairs(CONFIG.providers) do
        local row = create("Frame", {
            Size = UDim2.new(1, 0, 0, 32),
            BackgroundTransparency = 1,
            LayoutOrder = index,
            Parent = keysCard,
        })
        makeLabel({
            Size = UDim2.new(0, 130, 1, 0),
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            Text = provider,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = row,
        })
        local box = create("TextBox", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.new(1, -140, 0, 28),
            BackgroundColor3 = Theme.current.InputBg,
            Text = maskKey(Settings.keys[provider]),
            PlaceholderText = "Paste " .. provider .. " API key",
            Font = Enum.Font.Gotham,
            TextSize = 12,
            ClearTextOnFocus = false,
            Parent = row,
        })
        bindTheme(box, "BackgroundColor3", "InputBg")
        bindTheme(box, "TextColor3", "Text")

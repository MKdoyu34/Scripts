-- 11. INITIALIZATION
-- ===========================================================================
Fn.applyTheme(Settings.theme)
Fn.refreshChatList()
Fn.refreshModelRows()
Fn.updateModelHeader()
Fn.layoutWindow(false)

if Settings.lastChat then
    for _, chat in ipairs(Chats) do
        if chat.uid == Settings.lastChat then
            Fn.openChat(chat)
            break
        end
    end
end

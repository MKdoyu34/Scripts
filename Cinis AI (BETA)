-- ===========================================================================
-- 7. PROVIDERS & HTTP (OpenAI / Google DeepMind / Anthropic / Custom)
-- ===========================================================================
do
    -- Google and Anthropic reject consecutive same-role messages; merge them
    local function mergeAlternating(messages)
        local merged = {}
        for _, msg in ipairs(messages) do
            local last = merged[#merged]
            if last and last.role == msg.role then
                last.content = last.content .. "\n\n" .. msg.content
            else
                table.insert(merged, { role = msg.role, content = msg.content })
            end
        end
        return merged
    end

    local function httpErrorText(resp)
        local body = resp and (resp.Body or resp.body)
        if type(body) == "string" and body ~= "" then
            local ok, decoded = pcall(function()
                return HttpService:JSONDecode(body)
            end)
            if ok and type(decoded) == "table" and decoded.error then
                local detail = (type(decoded.error) == "table" and decoded.error.message) or decoded.error
                return tostring(detail)
            end
        end
        local code = resp and resp.StatusCode
        return "HTTP request failed" .. (code and (" (status " .. tostring(code) .. ")") or "")
    end

    -- Returns replyText, nil on success or nil, errorMessage on failure
    function Fn.callModel(model, messages)
        if type(httpRequest) ~= "function" then
            return nil, "This executor exposes no request/http_request function."
        end
        local provider = model.provider
        local key = Settings.keys[provider] or ""
        local url, headers, body

        if provider == "Google DeepMind" then
            url = "https://generativelanguage.googleapis.com/v1beta/models/" .. model.modelId .. ":generateContent"
            if key ~= "" then
                url = url .. "?key=" .. key
            end
            headers = { ["Content-Type"] = "application/json" }
            local contents = {}
            for _, msg in ipairs(mergeAlternating(messages)) do
                table.insert(contents, {
                    role = msg.role == "assistant" and "model" or "user",
                    parts = { { text = msg.content } },
                })
            end
            body = {
                system_instruction = { parts = { { text = CONFIG.systemPrompt } } },
                contents = contents,
            }
        elseif provider == "Anthropic" then
            url = "https://api.anthropic.com/v1/messages"
            headers = {
                ["Content-Type"] = "application/json",
                ["x-api-key"] = key,
                ["anthropic-version"] = "2023-06-01",
            }
            body = {
                model = model.modelId,
                max_tokens = 2048,
                system = CONFIG.systemPrompt,
                messages = mergeAlternating(messages),
            }
        else -- OpenAI, and Custom (OpenAI-compatible)
            url = (provider == "Custom" and model.baseUrl) or "https://api.openai.com/v1/chat/completions"
            if provider == "Custom" and (url == nil or url == "") then
                return nil, "This Custom model has no base URL. Edit it in Settings."
            end
            headers = { ["Content-Type"] = "application/json" }
            if key ~= "" then
                headers["Authorization"] = "Bearer " .. key
            end
            if provider == "Custom" and model.authHeader and model.authHeader ~= "" then
                local headerName, headerValue = model.authHeader:match("^%s*([^:]+)%s*:%s*(.-)%s*$")
                if headerName and headerName ~= "" then
                    headers[headerName] = headerValue
                end
            end
            local payload = { { role = "system", content = CONFIG.systemPrompt } }
            for _, msg in ipairs(messages) do
                table.insert(payload, { role = msg.role, content = msg.content })
            end
            body = { model = model.modelId, messages = payload }
        end

        local ok, resp = pcall(httpRequest, {
            Url = url,
            Method = "POST",
            Headers = headers,
            Body = HttpService:JSONEncode(body),
        })
        if not ok then
            return nil, "Request failed: " .. tostring(resp)
        end
        if type(resp) == "table" and resp.Success == false then
            return nil, httpErrorText(resp)
        end
        local raw = type(resp) == "table" and (resp.Body or resp.body) or resp
        if type(raw) ~= "string" or raw == "" then
            return nil, "Empty response body."
        end

        local decoded
        local decodeOk = pcall(function()
            decoded = HttpService:JSONDecode(raw)
        end)
        if not decodeOk or type(decoded) ~= "table" then
            return nil, "Could not decode the API response."
        end

        local text = nil
        if provider == "Google DeepMind" then
            if decoded.error then
                return nil, tostring(decoded.error.message or "Google API error")
            end
            local candidate = decoded.candidates and decoded.candidates[1]
            if candidate and candidate.content and candidate.content.parts then
                local chunks = {}
                for _, part in ipairs(candidate.content.parts) do
                    table.insert(chunks, tostring(part.text or ""))
                end
                text = table.concat(chunks)
            end
        elseif provider == "Anthropic" then
            if decoded.error then
                return nil, tostring(decoded.error.message or "Anthropic API error")
            end
            if type(decoded.content) == "table" then
                local chunks = {}
                for _, part in ipairs(decoded.content) do
                    if part.type == "text" then
                        table.insert(chunks, tostring(part.text or ""))
                    end
                end
                text = table.concat(chunks)
            end
        else -- OpenAI-style
            if decoded.error then
                return nil, tostring((type(decoded.error) == "table" and decoded.error.message) or "OpenAI-style API error")
            end
            local choice = decoded.choices and decoded.choices[1]
            if choice and choice.message then
                text = tostring(choice.message.content or "")
            end
        end

        if text and text ~= "" then
            return text
        end
        return nil, "The API returned no reply text."
    end
end


-- ===========================================================================
local Settings = {
    theme = "Moonlight",
    keys = { ["OpenAI"] = "", ["Google DeepMind"] = "", ["Anthropic"] = "", ["Custom"] = "" },
    models = {}, -- user-maintained: { uid, name, modelId, provider, baseUrl, authHeader }
    activeModel = nil, -- uid of the selected model
    lastChat = nil, -- uid of the last opened chat
    sidebarCollapsed = false,
}
local Chats = {} -- { { uid, title, messages = { { role, content } } } }
local Session = { activeChat = nil, pendingChatUid = nil, shutdown = false }

local function getActiveModel()
    if not Settings.activeModel then
        return nil
    end
    for _, model in ipairs(Settings.models) do
        if model.uid == Settings.activeModel then
            return model
        end
    end
    return nil
end

local function readJson(file)
    if not FS.available then
        return nil
    end
    local ok, result = pcall(function()
        if FS.exists and FS.exists(file) then
            local raw = FS.read(file)
            if type(raw) == "string" and raw ~= "" then
                return HttpService:JSONDecode(raw)
            end
        end
        return nil
    end)
    if ok then
        return result
    end
    return nil
end

local function writeJson(file, data)
    if not FS.available then
        return
    end
    pcall(function()
        if FS.folderExists and not FS.folderExists(CONFIG.folder) and FS.mkdir then
            FS.mkdir(CONFIG.folder)
        end
        FS.write(file, HttpService:JSONEncode(data))
    end)
end

local function saveSettings()
    writeJson(CONFIG.settingsFile, Settings)
end

local function saveChats()
    writeJson(CONFIG.chatsFile, Chats)
end

-- Load and sanitise saved data (bad fields fall back to defaults)
local function loadState()
    local saved = readJson(CONFIG.settingsFile)
    if type(saved) == "table" then
        Settings.theme = (saved.theme == "Sunset" or saved.theme == "Moonlight") and saved.theme or "Moonlight"
        if type(saved.keys) == "table" then
            for _, provider in ipairs(CONFIG.providers) do
                Settings.keys[provider] = tostring(saved.keys[provider] or "")
            end
        end
        if type(saved.models) == "table" then
            for _, model in ipairs(saved.models) do
                if type(model) == "table" and type(model.modelId) == "string" and model.modelId ~= "" then
                    table.insert(Settings.models, {
                        uid = tostring(model.uid or HttpService:GenerateGUID(false)),
                        name = tostring(model.name or model.modelId),
                        modelId = model.modelId,
                        provider = (table.find(CONFIG.providers, model.provider) and model.provider) or "OpenAI",
                        baseUrl = tostring(model.baseUrl or ""),
                        authHeader = tostring(model.authHeader or ""),
                    })
                end
            end
        end
        Settings.activeModel = type(saved.activeModel) == "string" and saved.activeModel or nil
        Settings.lastChat = type(saved.lastChat) == "string" and saved.lastChat or nil
        Settings.sidebarCollapsed = saved.sidebarCollapsed == true
    end

    local savedChats = readJson(CONFIG.chatsFile)
    if type(savedChats) == "table" then
        for _, chat in ipairs(savedChats) do
            if type(chat) == "table" and type(chat.messages) == "table" then
                local clean = {
                    uid = tostring(chat.uid or HttpService:GenerateGUID(false)),
                    title = tostring(chat.title or "New Chat"),
                    messages = {},
                }
                for _, msg in ipairs(chat.messages) do
                    if type(msg) == "table" and type(msg.content) == "string"
                        and (msg.role == "user" or msg.role == "assistant" or msg.role == "error") then
                        table.insert(clean.messages, { role = msg.role, content = msg.content })
                    end
                end
                table.insert(Chats, clean)
            end
        end
    end
end

loadState()


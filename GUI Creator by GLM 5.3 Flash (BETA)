	-- MODEL SWITCHING + AUTO RECOVERY (switch-models / continue-task)
	function AI.switchModel(reason)
		local p = activeProvider()
		local list = modelList(p)
		if #list < 2 then
			local startIdx = 1
			for i, pr in ipairs(AIState.providers) do
				if pr.id == p.id then startIdx = i break end
			end
			for off = 1, #AIState.providers do
				local cand = AIState.providers[(startIdx - 1 + off) % #AIState.providers + 1]
				if cand ~= p and (cand.key or "") ~= "" and #modelList(cand) > 0 then
					AIState.activeId = cand.id
					persistAISettings()
					updateModelButton()
					AI.addMessage("trace", ("switch-models: %s exhausted → provider %s / %s"):format(
						p.name, cand.name, activeModel(cand)))
					return true
				end
			end
			notify("switch-models: no alternative model or provider with a key.", "warn", 3)
			return false
		end
		local idx = 1
		for i, m in ipairs(list) do
			if m == p.model then idx = i break end
		end
		idx = (idx % #list) + 1
		p.model = list[idx]
		persistAISettings()
		updateModelButton()
		if reason then
			AI.addMessage("trace", ("switch-models (%s) → %s"):format(reason, p.model))
		end
		return true
	end
	function AI.setModelByName(name)
		local p = activeProvider()
		for _, m in ipairs(modelList(p)) do
			if m:lower() == tostring(name):lower() then
				p.model = m
				persistAISettings()
				updateModelButton()
				AI.addMessage("info", "Model set to " .. m)
				return
			end
		end
		AI.addMessage("error", "Model '" .. tostring(name) .. "' not in list — use /model or Fetch Models in Providers.")
	end
	function AI.stop()
		AIState.gen += 1
		AIState.busyCount = 0
		setThinking(false)
		AI.addMessage("info", "Stopped.")
	end
	function AI.continueTask()
		if AIState.busyCount > 0 then
			notify("AI is busy — press Stop first.", "warn", 2.5)
			return
		end
		if not AIState.pending then
			notify("Nothing to continue — the last task finished.", "info", 2.5)
			return
		end
		AIState.messages = AIState.pending
		AIState.pending = nil
		AIState.gen += 1
		AI.addMessage("info", "continue-task: resuming…")
		task.spawn(function() pcall(AI.runTurn) end)
	end
	local function snapshot()
		return cloneMessages(AIState.messages)
	end
	local function looksLikeToolsError(err)
		local e = tostring(err):lower()
		return e:find("tool", 1, true) ~= nil
			or e:find("function call", 1, true) ~= nil
			or e:find("unsupported", 1, true) ~= nil
			or e:find("not supported", 1, true) ~= nil
	end
	-- AGENT LOOP
	function AI.runTurn()
		local provider = activeProvider()
		if not provider then return end
		if (provider.key or "") == "" and provider.compat ~= "google" then
			AI.addMessage("error", "No API key for " .. provider.name .. " — open Providers (AI CHAT header) and paste your key.")
			return
		end
		local steps = 0
		while steps < MAX_AGENT_STEPS do
			provider = activeProvider()
			local includeTools = AIState.agentMode and not AIState.codeMode
			local decoded, err = aiRequest(provider, AIState.messages, includeTools)
			if not decoded then
				if err == "cancelled" then
					AI.addMessage("info", "Stopped.")
					return
				end
				if AIState.autoSwitch then
					AI.addMessage("trace", "error: " .. firstLine(err) .. " — switch-models → continue-task")
					for _ = 1, math.min(#modelList(provider), 4) do
						if not AI.switchModel(nil) then break end
						provider = activeProvider()
						decoded, err = aiRequest(provider, AIState.messages, includeTools)
						if decoded then break end
						if err == "cancelled" then
							AI.addMessage("info", "Stopped.")
							return
						end
					end
					if not decoded and not AIState.codeMode and looksLikeToolsError(err) then
						AIState.codeMode = true
						persistAISettings()
						AI.addMessage("trace", "provider rejected native tools — falling back to Code Mode for this session")
						decoded, err = aiRequest(provider, AIState.messages, false)
					end
				end
				if not decoded then
					AIState.pending = snapshot()
					AI.addMessage("error", firstLine(err))
					addContinueHint()
					return
				end
				AI.addMessage("trace", "continue-task: recovered on " .. activeModel(provider))
			end
			steps += 1
			local text, toolCalls = parseAIResponse(decoded, provider.compat)
			local assistantEntry = { role = "assistant", content = text, toolCalls = nil }
			if AIState.codeMode and AIState.agentMode then
				local codeBlock = extractToolBlock(text)
				if codeBlock then
					assistantEntry.toolCalls = { { name = "codemode", args = { code = codeBlock } } }
				end
			end
			if toolCalls and #toolCalls > 0 then
				assistantEntry.toolCalls = toolCalls
			end
			table.insert(AIState.messages, assistantEntry)
			if assistantEntry.content and assistantEntry.content ~= "" then
				AI.addMessage("assistant", assistantEntry.content)
			end
			if assistantEntry.toolCalls then
				local results = {}
				for _, tc in ipairs(assistantEntry.toolCalls) do
					AI.addTrace("tool " .. tc.name .. "(" .. firstLine(safeJsonEncode(tc.args or {})) .. ")")
					local output
					if tc.name == "codemode" then
						output = runCodeModeBlock(tc.args and tc.args.code or "")
					else
						output = execTool(tc)
					end
					AI.addTrace("→ " .. firstLine(output))
					results[#results + 1] = {
						id = tc.id,
						name = (tc.name == "codemode") and "codemode" or tc.name,
						output = cap(output, MAX_TOOL_CHARS),
					}
				end
				table.insert(AIState.messages, { role = "tool", results = results })
			else
				AIState.pending = nil
				return
			end
		end
		AIState.pending = snapshot()
		AI.addMessage("info", "Agent step limit reached — press Continue Task or send 'continue'.")
		addContinueHint()
	end
	local handleCommand
	function AI.send(rawText)
		local text = tostring(rawText or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if text == "" then return end
		if AIState.busyCount > 0 then
			notify("AI is busy — press Stop to cancel first.", "warn", 2.5)
			return
		end
		if text:sub(1, 1) == "/" then
			handleCommand(text)
			return
		end
		AI.addMessage("user", text)
		table.insert(AIState.messages, { role = "user", content = cap(text, MAX_CONTENT_CHARS) })
		AIState.gen += 1
		task.spawn(function() pcall(AI.runTurn) end)
	end
	handleCommand = function(text)
		local cmd, arg = text:match("^/(%S+)%s*(.-)$")
		cmd = (cmd or ""):lower()
		if cmd == "help" then
			AI.addMessage("info", table.concat({
				"Commands:",
				"/switch-model [name] — next (or named) model; runs automatically on API errors",
				"/continue — resume an interrupted task (continue-task)",
				"/stop — cancel the current request",
				"/agent — toggle agent mode (tool use)",
				"/codemode — toggle Code Mode backend (model writes tool code)",
				"/autoswitch — toggle auto switch-models on error",
				"/model — pick a model from a list",
				"/clear — clear chat and history",
			}, "\n"))
		elseif cmd == "switch-model" or cmd == "switch-models" then
			if arg and arg ~= "" then
				AI.setModelByName(arg)
			else
				AI.switchModel("manual /switch-model")
			end
		elseif cmd == "continue" or cmd == "continue-task" then
			AI.continueTask()
		elseif cmd == "stop" then
			AI.stop()
		elseif cmd == "agent" then
			AIState.agentMode = not AIState.agentMode
			refreshAgentButton()
			persistAISettings()
			AI.addMessage("info", "Agent mode: " .. (AIState.agentMode and "On" or "Off"))
		elseif cmd == "codemode" then
			AIState.codeMode = not AIState.codeMode
			persistAISettings()
			AI.addMessage("info", "Backend: " .. (AIState.codeMode and "Code Mode" or "Native Tools"))
		elseif cmd == "autoswitch" then
			AIState.autoSwitch = not AIState.autoSwitch
			persistAISettings()
			AI.addMessage("info", "AutoSwitch: " .. (AIState.autoSwitch and "On" or "Off"))
		elseif cmd == "model" then
			AI.showModelPopup()
		elseif cmd == "clear" then
			Editor.clearAIChat()
		else
			AI.addMessage("error", "Unknown command '" .. tostring(cmd) .. "' — try /help")
		end
	end
	function AI.showModelPopup()
		local p = activeProvider()
		local items = {}
		for _, m in ipairs(modelList(p)) do
			table.insert(items, { id = m, label = m })
		end
		local anchor = findModelButton()
		local okPos, pos = pcall(function() return anchor.AbsolutePosition end)
		local okSize, size = pcall(function() return anchor.AbsoluteSize end)
		Popup.open(
			(okPos and pos) or UI.chatColumn.AbsolutePosition,
			(okSize and size) or Vector2.new(64, 18),
			items, activeModel(p),
			function(id)
				p.model = id
				persistAISettings()
				updateModelButton()
				AI.addMessage("info", "Model → " .. id)
			end)
	end
	function AI.fetchModels(provider)
		provider = provider or activeProvider()
		if not provider then return end
		local url, headers
		if provider.compat == "google" then
			url = provider.base:gsub("/$", "") .. "/models?key=" .. (provider.key or "")
			headers = { ["Content-Type"] = "application/json" }
		elseif provider.compat == "anthropic" then
			url = provider.base:gsub("/$", "") .. "/models?limit=100"
			headers = { ["x-api-key"] = provider.key or "", ["anthropic-version"] = "2023-06-01" }
		else
			url = provider.base:gsub("/$", "") .. "/models"
			headers = { ["Authorization"] = "Bearer " .. (provider.key or "") }
		end
		local res, err = httpJSON(url, "GET", headers, nil)
		if not res or res.status < 200 or res.status >= 300 then
			notify("Model fetch failed: " .. (err or (res and extractProviderError(res.status, res.body)) or "unknown"),
				"error", 3.5)
			return
		end
		local okDecode, decoded = pcall(function() return HttpService:JSONDecode(res.body) end)
		if not okDecode or type(decoded) ~= "table" then
			notify("Model list JSON decode failed.", "error", 3)
			return
		end
		local list = {}
		if provider.compat == "google" then
			for _, m in ipairs(decoded.models or {}) do
				if type(m.name) == "string" then
					table.insert(list, m.name:gsub("^models/", ""))
				end
			end
		else
			for _, m in ipairs(decoded.data or decoded.models or {}) do
				if type(m.id) == "string" then table.insert(list, m.id) end
			end
		end
		if #list == 0 then
			notify("Provider returned no models.", "warn", 3)
			return
		end
		table.sort(list)
		provider.models = list
		if provider.model == "" or not table.find(list, provider.model) then
			provider.model = list[1]
		end
		persistAISettings()
		updateModelButton()
		notify(("Fetched %d models for %s."):format(#list, provider.name), "success", 3)
	end

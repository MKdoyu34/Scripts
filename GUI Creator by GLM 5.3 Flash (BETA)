-- AI ASSISTANT — multi-provider (OpenAI / Google DeepMind / Anthropic + custom)
-- //////////////////////////////////////////////////////////////////////////
do
	local AI = {
		settings = { instructions = "", thinking = "dynamic", temperature = 0.8, context = true, allowRunLua = false },
		providers = {},
		activeProvider = "openai",
		history = {},
		waiting = false,
		fetching = {},
	}
	Editor.AI = AI
	local AI_SETTINGS_FILE = "GUI_CREATOR_AI.json"
	local DEFAULT_PROVIDERS = {
		{ id = "openai", displayName = "OpenAI", baseUrl = "https://api.openai.com/v1", compat = "openai" },
		{ id = "google-deepmind", displayName = "Google DeepMind", baseUrl = "https://generativelanguage.googleapis.com/v1beta", compat = "gemini" },
		{ id = "anthropic", displayName = "Anthropic", baseUrl = "https://api.anthropic.com/v1", compat = "anthropic" },
	}
	local COMPAT_OPTIONS = {
		{ id = "openai", label = "OpenAI-Compatible" },
		{ id = "anthropic", label = "Anthropic-Compatible" },
		{ id = "gemini", label = "Gemini-Compatible" },
	}
	local function compatLabel(id)
		for _, o in ipairs(COMPAT_OPTIONS) do
			if o.id == id then return o.label end
		end
		return tostring(id)
	end
	local function normalizeBaseUrl(u)
		local s = tostring(u or ""):gsub("^%s+", ""):gsub("%s+$", "")
		s = s:gsub("/+$", "")
		return s
	end
	for _, def in ipairs(DEFAULT_PROVIDERS) do
		table.insert(AI.providers, {
			id = def.id, displayName = def.displayName, baseUrl = def.baseUrl,
			compat = def.compat, builtin = true, apiKey = "", model = nil, models = nil,
		})
	end
	local function findProvider(id)
		for _, p in ipairs(AI.providers) do
			if p.id == id then return p end
		end
		return nil
	end
	local function getActiveProvider()
		return findProvider(AI.activeProvider) or AI.providers[1]
	end
	local function providerNameTaken(name, exceptId)
		local lower = tostring(name):lower()
		for _, p in ipairs(AI.providers) do
			if p.id ~= exceptId and p.displayName:lower() == lower then return true end
		end
		return false
	end
	local function providerBaseTaken(base, exceptId)
		local norm = normalizeBaseUrl(base):lower()
		for _, p in ipairs(AI.providers) do
			if p.id ~= exceptId and normalizeBaseUrl(p.baseUrl):lower() == norm then return true end
		end
		return false
	end
	local function prettyModelId(id)
		local out = {}
		for token in tostring(id):gmatch("[^%-_%s/]+") do
			local lower = token:lower()
			if lower == "gpt" then token = "GPT"
			elseif lower == "chatgpt" then token = "ChatGPT"
			elseif lower == "claude" then token = "Claude"
			elseif lower == "gemini" then token = "Gemini"
			elseif lower == "ai" then token = "AI"
			elseif lower:match("^o%d") then token = token:upper()
			else token = token:sub(1, 1):upper() .. token:sub(2) end
			out[#out + 1] = token
		end
		if #out == 0 then return tostring(id) end
		return table.concat(out, " ")
	end
	local function modelDisplayName(entry, modelId)
		if not modelId then return nil end
		if entry.models then
			for _, m in ipairs(entry.models) do
				if m.id == modelId then return m.name or prettyModelId(m.id) end
			end
		end
		return prettyModelId(modelId)
	end
	-- ---------------- persistence
	local function saveAiSettings()
		if not FS.writefile then return end
		local provs = {}
		for _, p in ipairs(AI.providers) do
			local rec = { id = p.id, builtin = p.builtin, apiKey = p.apiKey, model = p.model }
			if not p.builtin then
				rec.displayName = p.displayName
				rec.baseUrl = p.baseUrl
				rec.compat = p.compat
			end
			if p.models then
				local capped = {}
				for i = 1, math.min(#p.models, 250) do
					capped[i] = { id = p.models[i].id, name = p.models[i].name }
				end
				rec.models = capped
			end
			table.insert(provs, rec)
		end
		local payload = {
			version = 2,
			activeProvider = AI.activeProvider,
			instructions = AI.settings.instructions,
			thinking = AI.settings.thinking,
			temperature = AI.settings.temperature,
			context = AI.settings.context,
			allowRunLua = AI.settings.allowRunLua,
			providers = provs,
		}
		pcall(function() FS.writefile(AI_SETTINGS_FILE, HttpService:JSONEncode(payload)) end)
	end
	local function loadAiSettings()
		if not FS.readfile then return end
		if FS.isfile then
			local ok, exists = pcall(FS.isfile, AI_SETTINGS_FILE)
			if ok and not exists then return end
		end
		local okRead, raw = pcall(FS.readfile, AI_SETTINGS_FILE)
		if not okRead or type(raw) ~= "string" or raw == "" then return end
		local okDecode, data = pcall(function() return HttpService:JSONDecode(raw) end)
		if not (okDecode and type(data) == "table") then return end
		local s = AI.settings
		if type(data.instructions) == "string" then s.instructions = data.instructions end
		if type(data.thinking) == "string" then s.thinking = data.thinking end
		if type(data.temperature) == "number" then s.temperature = data.temperature end
		if type(data.context) == "boolean" then s.context = data.context end
		if type(data.allowRunLua) == "boolean" then s.allowRunLua = data.allowRunLua end
		if type(data.providers) == "table" then
			for _, rec in ipairs(data.providers) do
				if type(rec) == "table" and type(rec.id) == "string" then
					if rec.builtin then
						local p = findProvider(rec.id)
						if p and p.builtin then
							if type(rec.apiKey) == "string" then p.apiKey = rec.apiKey end
							if type(rec.model) == "string" and rec.model ~= "" then p.model = rec.model end
							if type(rec.models) == "table" then p.models = rec.models end
						end
					else
						-- custom provider: validate + dedupe (defaults can never be re-added)
						local name = tostring(rec.displayName or "")
						local base = normalizeBaseUrl(rec.baseUrl)
						local compat = tostring(rec.compat or "openai")
						local validCompat = (compat == "openai" or compat == "anthropic" or compat == "gemini")
						if name ~= "" and base ~= "" and validCompat
							and not findProvider(rec.id)
							and not providerNameTaken(name)
							and not providerBaseTaken(base) then
							local entry = {
								id = rec.id, displayName = name, baseUrl = base, compat = compat,
								builtin = false,
								apiKey = type(rec.apiKey) == "string" and rec.apiKey or "",
								model = (type(rec.model) == "string" and rec.model ~= "") and rec.model or nil,
								models = type(rec.models) == "table" and rec.models or nil,
							}
							table.insert(AI.providers, entry)
						end
					end
				end
			end
		end
		if type(data.activeProvider) == "string" and findProvider(data.activeProvider) then
			AI.activeProvider = data.activeProvider
		end
	end
	loadAiSettings()
	-- ---------------- HTTP helper
	local function httpJson(url, method, bodyTable, extraHeaders)
		if not Executor.http then
			return nil, "This executor has no HTTP API (request / http_request missing)."
		end
		local headers = { ["Content-Type"] = "application/json" }
		if extraHeaders then
			for k, v in pairs(extraHeaders) do headers[k] = v end
		end
		local opts = { Url = url, Method = method or "GET", Headers = headers }
		if bodyTable ~= nil then
			local okEnc, payload = pcall(function() return HttpService:JSONEncode(bodyTable) end)
			if not okEnc then return nil, "JSON encode failed: " .. tostring(payload) end
			opts.Body = payload
		end
		local ok, res = pcall(Executor.http, opts)
		if not ok then return nil, tostring(res) end
		if type(res) ~= "table" then return nil, "Invalid HTTP response object." end
		local okFlag = res.Success
		if okFlag == nil then okFlag = res.success end
		if okFlag == nil then okFlag = res.ResponseSuccess end
		if okFlag == false then
			local errMsg = res.ErrorMessage or res.errorMessage or res.Exception or res.error
			return nil, "HTTP request failed" .. (errMsg and (": " .. tostring(errMsg)) or ".")
		end
		local bodyText = res.Body or res.body or ""
		local code = tonumber(res.StatusCode or res.statusCode) or 0
		return { body = bodyText, code = code }
	end

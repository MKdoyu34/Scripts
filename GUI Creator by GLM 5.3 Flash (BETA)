	local function parseNumTokens(text)
		local nums = {}
		for token in tostring(text):gmatch("%-?%d+%.?%d*") do
			table.insert(nums, tonumber(token))
		end
		return nums
	end
	local function coercePropValue(inst, propName, raw)
		if type(raw) == "number" or type(raw) == "boolean" then return raw end
		if type(raw) == "table" then
			local nums = {}
			for _, v in ipairs(raw) do
				if type(v) == "number" then table.insert(nums, v) end
			end
			if #nums == 4 then return UDim2.new(nums[1], nums[2], nums[3], nums[4])
			elseif #nums == 3 then return Color3.fromRGB(nums[1], nums[2], nums[3])
			elseif #nums == 2 then return UDim2.new(nums[1], nums[2], 0, 0) end
			return raw
		end
		if type(raw) ~= "string" then return raw end
		if raw:sub(1, 1) == "#" and #raw >= 7 then
			local okHex, hexColor = pcall(Color3.fromHex, raw:sub(2, 8))
			if okHex then return hexColor end
		end
		local compact = raw:gsub("[%s{}%[%]]", "")
		local isNumericList = false
		if compact ~= "" and not compact:find("%a") then
			isNumericList = true
			for _, part in ipairs(string.split(compact, ",")) do
				if part == "" or part:match("^%-?%d+%.?%d*$") == nil then
					isNumericList = false
					break
				end
			end
		end
		local nums = isNumericList and parseNumTokens(compact) or {}
		local current
		pcall(function() current = inst[propName] end)
		if #nums == 4 then
			return UDim2.new(nums[1], nums[2], nums[3], nums[4])
		elseif #nums == 3 then
			if typeof(current) == "Color3" then return Color3.fromRGB(nums[1], nums[2], nums[3]) end
			return Vector3.new(nums[1], nums[2], nums[3])
		elseif #nums == 2 then
			if typeof(current) == "Vector2" then return Vector2.new(nums[1], nums[2]) end
			return UDim2.new(nums[1], nums[2], 0, 0)
		elseif #nums == 1 then
			return nums[1]
		end
		if typeof(current) == "EnumItem" then
			local valueName = raw:gsub("^Enum%.", ""):gsub("^%w+%.", "")
			local item = current.EnumType[valueName]
			if item then return item end
		end
		return raw
	end
	local function applyPropsToInstance(inst, props)

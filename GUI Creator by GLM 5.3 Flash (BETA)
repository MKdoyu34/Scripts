		parse = function(data)
			if type(data) ~= "table" then return nil, nil, "Malformed API response." end
			if type(data.error) == "table" then
				return nil, nil, tostring(data.error.message or data.error.code or "API error")
			end
			local ch = type(data.choices) == "table" and data.choices[1]
			if type(ch) ~= "table" then return nil, nil, "No choices returned." end
			local msg = type(ch.message) == "table" and ch.message or {}
			local text = type(msg.content) == "string" and msg.content or ""
			local calls = {}
			if type(msg.tool_calls) == "table" then
				for _, tc in ipairs(msg.tool_calls) do
					if type(tc) == "table" and type(tc["function"]) == "table" then
						local f = tc["function"]
						local args = {}
						if type(f.arguments) == "string" and f.arguments ~= "" then
							local okD, decoded = pcall(function() return HttpService:JSONDecode(f.arguments) end)
							if okD and type(decoded) == "table" then args = decoded end
						end
						toolCallSeq += 1
						calls[#calls + 1] = {
							name = tostring(f.name or ""), args = args,
							id = tostring(tc.id or ("call_" .. toolCallSeq)),
						}
					end
				end
			end
			if text == "" and #calls == 0 then
				return nil, nil, "Empty response" .. (ch.finish_reason and (" (" .. tostring(ch.finish_reason) .. ")") or "")
			end
			return text, calls, nil
		end,
	}
	Adapters.anthropic = {

-- SAVE / LOAD (verified writefile, normalized listfiles, confirm dialogs)
local function ensureSaveFolder()
	if not FS.makefolder then return end
	local ok, exists = pcall(FS.isfolder, SAVE_DIR)
	if ok and exists then return end
	pcall(FS.makefolder, SAVE_DIR)
end
local function verifiedWrite(path, content)
	if not FS.writefile then return false, "writefile is not available on this executor" end
	local ok, err = pcall(FS.writefile, path, content)
	if not ok then return false, tostring(err) end
	if FS.isfile then
		local okExists, exists = pcall(FS.isfile, path)
		if not (okExists and exists) then return false, "file not found after write" end
	end
	if FS.readfile then
		local okRead, back = pcall(FS.readfile, path)
		if not okRead or back ~= content then return false, "write verification failed" end
	end
	return true
end
local function listSaveFiles()
	local out = {}
	if not FS.listfiles then return out, "listfiles is not available on this executor" end
	ensureSaveFolder()
	local ok, paths = pcall(FS.listfiles, SAVE_DIR)
	if not ok or type(paths) ~= "table" then return out, "listfiles failed" end
	for _, path in ipairs(paths) do
		local normalized = tostring(path):gsub("\\", "/")
		local fileName = normalized:match("([^/]+)$") or normalized
		if fileName:match("%.json$") or fileName:match("%.sgc$") then
			table.insert(out, { path = path, name = fileName:gsub("%.[^%.]+$", "") })
		end
	end
	table.sort(out, function(a, b) return a.name:lower() < b.name:lower() end)
	return out
end
local function collectSaveData()
	local guis = getProjectScreenGuis()
	if #guis == 0 then return nil end
	local payload = { app = "StudioGUI Creator", version = 1.7, savedAt = os.time(), guis = {} }
	local function serialize(inst)
		local node = { class = inst.ClassName, name = inst.Name, props = {}, children = {} }
		for _, propName in ipairs(exportPropertyNameList(inst.ClassName)) do
			if propName ~= "Parent" and propIsWritable(inst, propName) then
				local ok, value = pcall(function() return inst[propName] end)
				if ok then
					local ptype = resolvePropertyType(inst, propName)
					if ptype and ptype ~= "object" then
						local text = formatValue(ptype, value)
						if text and #text <= 100000 then
							table.insert(node.props, { p = propName, t = ptype, v = text })
						end
					end
				end
			end
		end
		for _, child in ipairs(treeChildren(inst)) do
			table.insert(node.children, serialize(child))
		end
		return node
	end
	for _, sg in ipairs(guis) do
		table.insert(payload.guis, serialize(sg))
	end
	return payload
end
local function rebuildFromNode(node, parent)
	if type(node) ~= "table" or type(node.class) ~= "string" then return nil end
	local ok, inst = pcall(Instance.new, node.class)
	if not ok or not inst then return nil end
	inst.Name = tostring(node.name or node.class)
	for _, pr in ipairs(node.props or {}) do
		if type(pr) == "table" and type(pr.p) == "string" and pr.p ~= "Parent" then
			local value = pr.t and parsePropertyValue(pr.t, tostring(pr.v))
			if value ~= nil then
				pcall(function() inst[pr.p] = value end)
			end
		end
	end
	pcall(function() inst.Parent = parent end)
	for _, childNode in ipairs(node.children or {}) do
		rebuildFromNode(childNode, inst)
	end
	return inst
end
local function loadProjectData(payload)
	if type(payload) ~= "table" or type(payload.guis) ~= "table" then
		return false, "not a valid StudioGUI Creator save"
	end
	Editor.select(nil)
	for _, sg in ipairs(getProjectScreenGuis()) do
		pcall(function() sg:Destroy() end)
	end
	local count = 0
	for _, node in ipairs(payload.guis) do
		local inst = rebuildFromNode(node, PROJECT_PARENT)
		if inst then
			pcall(function() inst:SetAttribute(PROJECT_ATTRIBUTE, true) end)
			count += 1
		end
	end
	invalidateExplorer()
	if count == 0 then
		ensureProjectIntegrity()
		invalidateExplorer()
		return false, "no instances could be rebuilt"
	end
	return true, ("%d ScreenGui(s) rebuilt"):format(count)
end
local function saveProjectToFile(fileName)
	if not fileName or fileName == "" then return end
	if not fileName:match("^[%w%-_ %[%]%(%)]+$") then
		notify("File name can only use letters, numbers, spaces and - _ [ ] ( ).", "warn", 3.5)
		return
	end
	local payload = collectSaveData()
	if not payload then
		notify("Nothing to save — create a GUI first.", "warn", 2.5)
		return
	end
	ensureSaveFolder()
	local path = SAVE_DIR .. "/" .. fileName .. ".json"
	local ok, err = verifiedWrite(path, safeJsonEncode(payload))
	notify(ok and ("Saved '" .. fileName .. "' (verified).") or ("Save failed: " .. tostring(err)),
		ok and "success" or "error", 3.5)
end
local function loadProjectFromFile(path)
	if not (FS.readfile and FS.isfile) then
		notify("readfile/isfile unavailable on this executor.", "warn", 3)
		return
	end
	local okExists, exists = pcall(FS.isfile, path)
	if not (okExists and exists) then
		notify("File no longer exists.", "warn", 2.5)
		return
	end
	local okRead, raw = pcall(FS.readfile, path)
	if not okRead or type(raw) ~= "string" then
		notify("Could not read save file.", "error", 3)
		return
	end
	local okDecode, payload = pcall(function() return HttpService:JSONDecode(raw) end)
	if not okDecode then
		notify("Save file is corrupted (JSON decode failed).", "error", 3)
		return
	end
	local ok, message = loadProjectData(payload)
	notify(ok and ("Loaded: " .. message) or ("Load failed: " .. message),
		ok and "success" or "error", 3.5)
end

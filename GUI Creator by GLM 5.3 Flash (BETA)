local function parseColorText(text)
	local s = tostring(text):gsub("^%s+", ""):gsub("%s+$", ""):gsub("^#", ""):gsub("%s", "")
	local r, g, b = s:match("^(%d+),(%d+),(%d+)$")
	if r then
		return Color3.fromRGB(tonumber(r) or 0, tonumber(g) or 0, tonumber(b) or 0)
	end
	if #s == 6 and s:match("^%x+$") then
		local rr = tonumber(s:sub(1, 2), 16)
		local gg = tonumber(s:sub(3, 4), 16)
		local bb = tonumber(s:sub(5, 6), 16)
		if rr and gg and bb then return Color3.fromRGB(rr, gg, bb) end
	end
	return nil
end
local function parseNumberList(text, count)
	local tokens = {}
	for token in tostring(text):gmatch("[^,%s]+") do
		tokens[#tokens + 1] = token
	end
	if #tokens ~= count then return nil end
	local nums = {}
	for i, token in ipairs(tokens) do
		local n = tonumber(token)
		if not n then return nil end
		nums[i] = n
	end
	return nums
end
local function parseAssetText(text)
	local s = tostring(text):gsub("^%s+", ""):gsub("%s+$", "")
	if s == "" then return "" end
	if s:match("^rbxassetid://") or s:match("^rbxasset://") or s:match("^rbxthumb://") then return s end
	if s:match("^%d+$") then return "rbxassetid://" .. s end
	return nil
end
local function parseEnumText(enumType, text)
	local name = tostring(text):gsub("^%s+", ""):gsub("%s+$", ""):gsub("^Enum%.%w+%.?", "")
	if name == "" then return nil end
	local ok, item = pcall(function() return Enum[enumType][name] end)
	if ok and item then return item end
	return nil
end
local function formatValue(ptype, value)
	local ok, result = pcall(function()
		if ptype == "color" then
			return ("%d, %d, %d"):format(
				math.floor(value.R * 255 + 0.5), math.floor(value.G * 255 + 0.5), math.floor(value.B * 255 + 0.5))
		elseif ptype == "udim2" then
			return ("%s, %s, %s, %s"):format(trimNum(value.X.Scale), trimNum(value.X.Offset), trimNum(value.Y.Scale), trimNum(value.Y.Offset))
		elseif ptype == "udim" then
			return ("%s, %s"):format(trimNum(value.Scale), trimNum(value.Offset))
		elseif ptype == "vector2" then
			return ("%s, %s"):format(trimNum(value.X), trimNum(value.Y))
		elseif ptype == "vector3" then
			return ("%s, %s, %s"):format(trimNum(value.X), trimNum(value.Y), trimNum(value.Z))
		elseif ptype == "colorsequence" then
			local parts = {}
			for _, kp in ipairs(value.Keypoints) do
				table.insert(parts, ("%s, %d, %d, %d"):format(trimNum(kp.Time),
					math.floor(kp.Value.R * 255 + 0.5), math.floor(kp.Value.G * 255 + 0.5), math.floor(kp.Value.B * 255 + 0.5)))
			end
			return table.concat(parts, "; ")
		elseif ptype == "numbersequence" then
			local parts = {}
			for _, kp in ipairs(value.Keypoints) do
				table.insert(parts, ("%s, %s, %s"):format(trimNum(kp.Time), trimNum(kp.Value), trimNum(kp.Envelope)))
			end
			return table.concat(parts, "; ")
		elseif ptype == "rect" then
			return ("%s, %s, %s, %s"):format(trimNum(value.Min.X), trimNum(value.Min.Y), trimNum(value.Max.X), trimNum(value.Max.Y))
		elseif ptype == "cframe" then
			local c = { value:GetComponents() }
			local parts = {}
			for i = 1, 12 do parts[i] = trimNum(c[i]) end
			return table.concat(parts, ", ")
		elseif ptype == "brickcolor" then
			return value.Name
		elseif ptype == "font" then
			return value.Family
		elseif ptype:sub(1, 5) == "enum:" then
			return value.Name
		elseif ptype == "bool" then
			return value and "true" or "false"
		elseif ptype == "number" then
			return trimNum(value)
		end
		return tostring(value)
	end)
	return ok and result or ""
end
local function parsePropertyValue(ptype, text)
	if ptype == "string" or ptype == "source" then
		return tostring(text)
	elseif ptype == "number" then
		return tonumber(text)
	elseif ptype == "color" then
		return parseColorText(text)
	elseif ptype == "udim2" then
		local nums = parseNumberList(text, 4)
		if not nums then return nil end
		return UDim2.new(nums[1], nums[2], nums[3], nums[4])
	elseif ptype == "udim" then
		local nums = parseNumberList(text, 2)
		if not nums then
			local single = parseNumberList(text, 1)
			if single then nums = { 0, single[1] } end
		end
		if not nums then return nil end
		return UDim.new(nums[1], nums[2])
	elseif ptype == "vector2" then
		local nums = parseNumberList(text, 2)
		if not nums then return nil end
		return Vector2.new(nums[1], nums[2])
	elseif ptype == "vector3" then
		local nums = parseNumberList(text, 3)
		if not nums then return nil end
		return Vector3.new(nums[1], nums[2], nums[3])
	elseif ptype == "rect" then
		local nums = parseNumberList(text, 4)
		if not nums then return nil end
		return Rect.new(nums[1], nums[2], nums[3], nums[4])
	elseif ptype == "cframe" then
		local nums = parseNumberList(text, 12)
		if not nums then return nil end
		return CFrame.new(table.unpack(nums, 1, 12))
	elseif ptype == "brickcolor" then
		local s = tostring(text):gsub("^%s+", ""):gsub("%s+$", "")
		local n = tonumber(s)
		if n then
			local ok, bc = pcall(BrickColor.new, n)
			if ok then return bc end
			return nil
		end
		local ok, bc = pcall(BrickColor.new, s)
		if ok then return bc end
		return nil
	elseif ptype == "font" then
		local s = tostring(text):gsub("^%s+", ""):gsub("%s+$", "")
		if s == "" then return nil end
		local ok, f = pcall(Font.new, s)
		if ok then return f end
		return nil
	elseif ptype == "colorsequence" then
		local stops = {}
		for chunk in tostring(text):gmatch("[^;]+") do
			local nums = parseNumberList(chunk, 4)
			if not nums then return nil end
			table.insert(stops, {
				t = math.clamp(nums[1], 0, 1),
				c = Color3.fromRGB(
					math.clamp(math.floor(nums[2] + 0.5), 0, 255),
					math.clamp(math.floor(nums[3] + 0.5), 0, 255),
					math.clamp(math.floor(nums[4] + 0.5), 0, 255)),
			})
		end
		if #stops < 2 then return nil end
		table.sort(stops, function(a, b) return a.t < b.t end)
		stops[1].t = 0
		stops[#stops].t = 1
		local keypoints = {}
		for _, stop in ipairs(stops) do
			table.insert(keypoints, ColorSequenceKeypoint.new(stop.t, stop.c))
		end
		return ColorSequence.new(keypoints)
	elseif ptype == "numbersequence" then
		local stops = {}
		for chunk in tostring(text):gmatch("[^;]+") do
			local nums = parseNumberList(chunk, 3)
			if not nums then return nil end
			table.insert(stops, { t = math.clamp(nums[1], 0, 1), v = nums[2], e = nums[3] })
		end
		if #stops < 2 then return nil end
		table.sort(stops, function(a, b) return a.t < b.t end)
		stops[1].t = 0
		stops[#stops].t = 1
		local keypoints = {}
		for _, stop in ipairs(stops) do
			table.insert(keypoints, NumberSequenceKeypoint.new(stop.t, stop.v, stop.e))
		end
		return NumberSequence.new(keypoints)
	elseif ptype == "asset" then
		return parseAssetText(text)
	elseif ptype:sub(1, 5) == "enum:" then
		return parseEnumText(ptype:sub(6), text)
	end
	return nil
end
local function applyProperty(obj, propName, text, ptype)
	local value = parsePropertyValue(ptype, text)
	if value == nil then
		notify(("Invalid value for %s"):format(propName), "error", 2.5)
		return false
	end
	local ok = pcall(function() obj[propName] = value end)
	if not ok then
		notify(("Failed to set %s"):format(propName), "error", 2.5)
		return false
	end
	return true
end
local function afterPropertyChange(obj, propName)
	if propName == "Name" then
		invalidateExplorer()
		updateStatus()
	end
end
-- VALUE TYPE RESOLUTION (shared with save/load + AI tools)
local STRUCTURAL_TYPES = {
	udim2 = "UDim2", udim = "UDim", vector2 = "Vector2", vector3 = "Vector3",
	color = "Color3", colorsequence = "ColorSequence", numbersequence = "NumberSequence",
	rect = "Rect", cframe = "CFrame", brickcolor = "BrickColor", font = "Font",
	bool = "boolean", number = "number", string = "string",
}
local function inferValueType(value)
	local kind = typeof(value)
	if kind == "string" then return "string"
	elseif kind == "number" then return "number"
	elseif kind == "boolean" then return "bool"
	elseif kind == "Color3" then return "color"
	elseif kind == "UDim2" then return "udim2"
	elseif kind == "UDim" then return "udim"
	elseif kind == "Vector2" then return "vector2"
	elseif kind == "Vector3" then return "vector3"
	elseif kind == "ColorSequence" then return "colorsequence"
	elseif kind == "NumberSequence" then return "numbersequence"
	elseif kind == "Rect" then return "rect"
	elseif kind == "CFrame" then return "cframe"
	elseif kind == "BrickColor" then return "brickcolor"
	elseif kind == "Font" then return "font"
	elseif kind == "EnumItem" then return "enum:" .. value.EnumType.Name
	end
	return "object"
end
local function typeForProp(className, propName)
	local classOverride = CLASS_PROP_TYPES[className]
	if classOverride and classOverride[propName] then return classOverride[propName] end
	return PROP_TYPES[propName]
end
local function resolvePropertyType(obj, propName)
	local declared = typeForProp(obj.ClassName, propName)
	local ok, value = pcall(function() return obj[propName] end)
	if not ok then return nil end
	if declared then
		local expectedKind = STRUCTURAL_TYPES[declared]
		if expectedKind and typeof(value) ~= expectedKind then
			return inferValueType(value)
		end
		if declared:sub(1, 5) == "enum:" and typeof(value) == "EnumItem" then
			local actualEnum = value.EnumType.Name
			if actualEnum ~= declared:sub(6) then
				return "enum:" .. actualEnum
			end
		end
		return declared
	end
	return inferValueType(value)
end
-- WRITABILITY PROBE (excludes read-only / security-locked properties)
local writableCache = {}
local function propIsWritable(obj, propName)
	if propName == "Name" or propName == "Source" then return true end
	if propName == "Parent" then return false end
	local key = obj.ClassName .. "." .. propName
	local cached = writableCache[key]
	if cached ~= nil then return cached end
	local okRead, value = pcall(function() return obj[propName] end)
	if not okRead then
		writableCache[key] = false
		return false
	end
	local okWrite = pcall(function() obj[propName] = value end)
	writableCache[key] = okWrite
	return okWrite
end

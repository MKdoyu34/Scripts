local function ensureSaveFolder()
	if not FS.writefile then return false end
	if FS.makefolder then pcall(FS.makefolder, SAVE_DIR) end
	if FS.isfolder then
		local ok, exists = pcall(FS.isfolder, SAVE_DIR)
		if ok and exists then return true end
		if FS.makefolder then
			pcall(FS.makefolder, SAVE_DIR)
			local ok2, exists2 = pcall(FS.isfolder, SAVE_DIR)
			if ok2 and exists2 then return true end
		end
		-- Best effort: some executors misreport isfolder; writes may still work.
		return true
	end
	return true
end
local function fileExists(path)
	if not FS.isfile then return false end
	local ok, exists = pcall(FS.isfile, path)
	return ok and exists == true
end
-- THE one real file writer. Verification is advisory where the executor's
-- read-back APIs are unreliable, so good writes are never falsely rejected.
local function writeSaveFileBytes(path, content)
	if not FS.writefile then
		return false, "writefile is not available on this executor"
	end
	if type(content) ~= "string" or #content == 0 then
		return false, "refusing to write empty content"
	end
	if FS.makefolder then pcall(FS.makefolder, SAVE_DIR) end
	local okWrite, werr = pcall(FS.writefile, path, content)
	if not okWrite and FS.makefolder then
		pcall(FS.makefolder, SAVE_DIR)
		okWrite, werr = pcall(FS.writefile, path, content)
	end
	if not okWrite then
		return false, "writefile error: " .. tostring(werr)
	end
	local verified = false
	if FS.isfile then
		local okChk, exists = pcall(FS.isfile, path)
		if okChk and exists == false then
			return false, "writefile reported success but the file does not exist on disk"
		end
		if okChk and exists == true then verified = true end
	end
	if FS.readfile then
		local okRead, back = pcall(FS.readfile, path)
		if okRead and type(back) == "string" then
			if #back ~= #content then
				return false, ("file truncated (wrote %d bytes, read back %d)"):format(#content, #back)
			end
			verified = true
		end
	end
	return true, ("%d bytes written%s"):format(#content, verified and " and verified" or " (unverified)")
end

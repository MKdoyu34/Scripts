							content = tostring(r.response or ""),
						}
					end
					if #blocks > 0 then push("user", blocks) end
				elseif e.role == "model" then
					local blocks = {}
					if type(e.text) == "string" and e.text ~= "" then
						blocks[#blocks + 1] = { type = "text", text = e.text }
					end
					for _, c in ipairs(e.calls or {}) do
						blocks[#blocks + 1] = { type = "tool_use", id = c.id or c.name, name = c.name, input = c.args or {} }
					end
					if #blocks > 0 then push("assistant", blocks) end

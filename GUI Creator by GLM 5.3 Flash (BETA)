	local function sanitizeHistory(messages, compat, includeTools)
		local kept = {}
		for _, m in ipairs(messages) do table.insert(kept, m) end
		while #kept > MAX_HISTORY do table.remove(kept, 1) end
		while #kept > 2 and kept[1] and kept[1].role ~= "user" do table.remove(kept, 1) end
		if #kept == 0 then table.insert(kept, { role = "user", content = "Continue." }) end
		local out = {}
		for _, m in ipairs(kept) do
			if m.role == "user" then
				table.insert(out, { role = "user", content = cap(m.content, MAX_CONTENT_CHARS) })
			elseif m.role == "assistant" then
				local text = cap(m.content or "", MAX_CONTENT_CHARS)
				local hasCalls = includeTools and m.toolCalls and #m.toolCalls > 0
				if text ~= "" or hasCalls then
					table.insert(out, {
						role = "assistant", content = text ~= "" and text or nil,
						toolCalls = hasCalls and m.toolCalls or nil,
					})
				end
			elseif m.role == "tool" then
				if includeTools then
					table.insert(out, { role = "tool", results = m.results })
				else
					table.insert(out, { role = "user", content = "[tool results]\n" .. toolResultsText(m) })
				end
			end
		end
		if compat ~= "openai" then
			local merged = {}
			for _, m in ipairs(out) do
				local last = merged[#merged]
				if last and last.role == m.role and m.role == "user" then
					last.content = cap((last.content or "") .. "\n" .. (m.content or ""), MAX_CONTENT_CHARS)
					last.toolResults = (last.toolResults or 0) + (m.toolResults or 0)
					if m.rawToolResults then
						last.rawToolResults = last.rawToolResults or {}
						for _, r in ipairs(m.rawToolResults) do table.insert(last.rawToolResults, r) end
					end
				else
					local copy = { role = m.role, content = m.content, toolCalls = m.toolCalls, results = m.results }
					table.insert(merged, copy)
				end
			end
			out = merged
		end
		return out
	end
	local function buildOpenAICompat(messages, provider, includeTools)
		local msgs = { { role = "system", content = buildSystemPrompt() } }
		for _, m in ipairs(sanitizeHistory(messages, "openai", includeTools)) do
			if m.role == "user" then
				msgs[#msgs + 1] = { role = "user", content = m.content }
			elseif m.role == "assistant" then
				local entry = { role = "assistant", content = m.content or "" }
				if m.toolCalls then
					local tcs = {}
					for i, tc in ipairs(m.toolCalls) do
						tcs[i] = {
							id = tc.id or ("call_" .. i .. "_" .. tostring(tc.name)),
							type = "function",
							["function"] = { name = tc.name, arguments = safeJsonEncode(tc.args or {}) },
						}
					end
					entry.tool_calls = tcs
					if entry.content == "" then entry.content = nil end
				end
				msgs[#msgs + 1] = entry
			elseif m.role == "tool" then
				for _, r in ipairs(m.results or {}) do
					msgs[#msgs + 1] = { role = "tool", tool_call_id = r.id or ("call_" .. tostring(r.name)), content = r.output or "" }
				end
			end
		end
		local payload = { model = activeModel(provider), messages = msgs, max_tokens = 4096 }
		if includeTools then
			payload.tools = toolSchemas("openai")
			payload.tool_choice = "auto"
		end
		return payload
	end
	local function buildAnthropic(messages, provider, includeTools)
		local msgs = {}
		for _, m in ipairs(sanitizeHistory(messages, "anthropic", includeTools)) do
			if m.role == "user" then
				msgs[#msgs + 1] = { role = "user", content = { { type = "text", text = m.content or "" } } }
			elseif m.role == "assistant" then
				local content = {}
				if m.content and m.content ~= "" then
					table.insert(content, { type = "text", text = m.content })
				end
				if m.toolCalls then
					for _, tc in ipairs(m.toolCalls) do
						table.insert(content, { type = "tool_use", id = tc.id or ("toolu_" .. tostring(tc.name)), name = tc.name, input = tc.args or {} })
					end
				end
				if #content == 0 then table.insert(content, { type = "text", text = "…" }) end
				msgs[#msgs + 1] = { role = "assistant", content = content }
			elseif m.role == "tool" then
				local content = {}
				for _, r in ipairs(m.results or {}) do
					table.insert(content, {
						type = "tool_result",
						tool_use_id = r.id or ("toolu_" .. tostring(r.name)),
						content = r.output or "",
					})
				end
				if #content > 0 then msgs[#msgs + 1] = { role = "user", content = content } end
			end
		end
		local payload = {
			model = activeModel(provider), max_tokens = 4096,
			system = buildSystemPrompt(), messages = msgs,
		}
		if includeTools then payload.tools = toolSchemas("anthropic") end
		return payload
	end
	local function buildGoogle(messages, provider, includeTools)
		local contents = {}
		for _, m in ipairs(sanitizeHistory(messages, "google", includeTools)) do
			if m.role == "user" then
				contents[#contents + 1] = { role = "user", parts = { { text = m.content or "" } } }
			elseif m.role == "assistant" then
				local parts = {}
				if m.content and m.content ~= "" then table.insert(parts, { text = m.content }) end
				if m.toolCalls then
					for _, tc in ipairs(m.toolCalls) do
						table.insert(parts, { functionCall = { name = tc.name, args = tc.args or {} } })
					end
				end
				if #parts == 0 then table.insert(parts, { text = "…" }) end
				contents[#contents + 1] = { role = "model", parts = parts }
			elseif m.role == "tool" then
				local parts = {}
				for _, r in ipairs(m.results or {}) do
					table.insert(parts, {
						functionResponse = {
							name = r.name or "tool",
							response = { result = r.output or "" },
						},
					})
				end
				if #parts > 0 then contents[#contents + 1] = { role = "user", parts = parts } end
			end
		end
		local payload = {
			systemInstruction = { parts = { { text = buildSystemPrompt() } } },
			contents = contents,
			generationConfig = { maxOutputTokens = 8192 },
		}
		if includeTools then payload.tools = { { functionDeclarations = toolSchemas("google") } } end
		return payload
	end
	local function providerRequest(provider, messages, includeTools)
		local key = provider.key or ""
		if provider.compat == "anthropic" then
			local url = provider.base:gsub("/$", "") .. "/messages"
			local headers = {
				["Content-Type"] = "application/json",
				["x-api-key"] = key,
				["anthropic-version"] = "2023-06-01",
			}
			return url, headers, buildAnthropic(messages, provider, includeTools)
		elseif provider.compat == "google" then
			local url = provider.base:gsub("/$", "")
				.. "/models/" .. tostring(activeModel(provider)) .. ":generateContent?key=" .. key
			local headers = { ["Content-Type"] = "application/json" }
			return url, headers, buildGoogle(messages, provider, includeTools)
		else
			local url = provider.base:gsub("/$", "") .. "/chat/completions"
			local headers = {
				["Content-Type"] = "application/json",
				["Authorization"] = "Bearer " .. key,
			}
			return url, headers, buildOpenAICompat(messages, provider, includeTools)
		end
	end
	local function parseAIResponse(decoded, compat)
		local textParts, toolCalls = {}, {}
		if compat == "anthropic" then
			for _, part in ipairs(decoded.content or {}) do
				if part.type == "text" then
					table.insert(textParts, part.text or "")
				elseif part.type == "tool_use" then
					table.insert(toolCalls, { id = part.id, name = part.name, args = part.input or {} })
				end
			end
		elseif compat == "google" then
			local cand = decoded.candidates and decoded.candidates[1]
			local parts = (cand and cand.content and cand.content.parts) or {}
			for _, part in ipairs(parts) do
				if part.text then
					table.insert(textParts, part.text)
				elseif part.functionCall then
					table.insert(toolCalls, { name = part.functionCall.name, args = part.functionCall.args or {} })
				end
			end
		else
			local choice = decoded.choices and decoded.choices[1]
			local msg = (choice and choice.message) or {}
			if type(msg.content) == "string" then table.insert(textParts, msg.content) end
			if type(msg.tool_calls) == "table" then
				for i, tc in ipairs(msg.tool_calls) do
					local args = {}
					local fnTable = tc["function"]
					local raw = fnTable and fnTable.arguments
					if type(raw) == "table" then
						args = raw
					elseif type(raw) == "string" and #raw > 0 then
						local okA, t = pcall(function() return HttpService:JSONDecode(raw) end)
						if okA and type(t) == "table" then args = t else args = { _raw = raw } end
					end
					table.insert(toolCalls, {
						id = tc.id or ("call_" .. i .. "_" .. tostring((fnTable and fnTable.name) or "tool")),
						name = (fnTable and fnTable.name) or "unknown",
						args = args,
					})
				end
			end
		end
		return table.concat(textParts, "\n"), toolCalls
	end
	-- REQUEST LIFECYCLE (watchdog + generation tokens: fixes stuck "think" state)
	local chatRefs = {}
	local function setThinking(on, label)
		if chatRefs.stopBtn then chatRefs.stopBtn.Visible = on end
		if UI.statusLeft then
			if on then
				UI.statusLeft.Text = "AI is thinking… (" .. tostring(label or "request") .. ") — Stop to cancel"
			else
				updateStatus()
			end
		end
	end
	local function aiRequest(provider, messages, includeTools)
		local key = provider.key or ""
		if key == "" and provider.compat ~= "google" then
			return nil, "No API key set for " .. provider.name .. " — open Providers and paste your key."
		end
		local url, headers, payload = providerRequest(provider, messages, includeTools)
		AIState.busyCount += 1
		setThinking(true, provider.name .. " / " .. activeModel(provider))
		local myGen = AIState.gen
		local watchdogDone = false
		local watchdog = task.delay(90, function()
			if AIState.gen == myGen and AIState.busyCount > 0 and not watchdogDone then
				AIState.busyCount = 0
				setThinking(false)
				AI.addMessage("error", "Request timed out (90s watchdog). The executor HTTP call hung — try again, or /switch-model.")
			end
		end)
		local ok, res = pcall(httpJSON, url, "POST", headers, payload)
		pcall(function() task.cancel(watchdog) end)
		watchdogDone = true
		AIState.busyCount = math.max(0, AIState.busyCount - 1)
		if AIState.gen ~= myGen then return nil, "cancelled" end
		setThinking(false)
		if not ok then return nil, tostring(res) end
		if type(res) ~= "table" then return nil, "malformed HTTP response" end
		if res.status < 200 or res.status >= 300 then
			return nil, extractProviderError(res.status, res.body)
		end
		local okDecode, decoded = pcall(function() return HttpService:JSONDecode(res.body) end)
		if not okDecode or type(decoded) ~= "table" then
			return nil, "provider response was not valid JSON"
		end
		return decoded
	end

	Adapters.gemini = {
		build = function(entry, hist, sys, withTools, minimal)
			local contents = {}
			for _, e in ipairs(sanitizeHistory(hist)) do
				if e.role == "tool" then
					local parts = {}
					for _, r in ipairs(e.results or {}) do
						parts[#parts + 1] = {
							functionResponse = { name = tostring(r.name), response = { result = tostring(r.response or "") } },
						}
					end
					if #parts > 0 then contents[#contents + 1] = { role = "user", parts = parts } end
				elseif e.role == "model" then
					local parts = {}
					if type(e.text) == "string" and e.text ~= "" then
						parts[#parts + 1] = { text = e.text }
					end
					for _, c in ipairs(e.calls or {}) do
						parts[#parts + 1] = { functionCall = { name = c.name, args = c.args or {} } }
					end
					if #parts > 0 then contents[#contents + 1] = { role = "model", parts = parts } end
				else
					contents[#contents + 1] = { role = "user", parts = { { text = tostring(e.text or "") } } }
				end
			end
			local merged = {}
			for _, c in ipairs(contents) do
				local last = merged[#merged]
				local plain = #c.parts == 1 and type(c.parts[1].text) == "string"
				if plain and last and last.role == c.role
					and #last.parts == 1 and type(last.parts[1].text) == "string" then
					last.parts[1].text = last.parts[1].text .. "\n" .. c.parts[1].text
				else
					merged[#merged + 1] = c
				end
			end
			local genConfig = {}
			if not minimal then
				genConfig.temperature = math.clamp(tonumber(AI.settings.temperature) or 0.8, 0, 2)
				local think = AI.settings.thinking or "dynamic"
				if think == "dynamic" then
					genConfig.thinkingConfig = { thinkingBudget = -1 }
				elseif think == "off" then
					genConfig.thinkingConfig = { thinkingBudget = 0 }
				else
					genConfig.thinkingConfig = { thinkingLevel = think }
				end
			end
			local body = {
				systemInstruction = { parts = { { text = sys } } },
				contents = merged,
				generationConfig = genConfig,
			}
			if withTools then
				local decls = toolDeclarations()
				if decls then body.tools = { { functionDeclarations = decls } } end
			end
			return {
				url = ("%s/models/%s:generateContent?key=%s"):format(entry.baseUrl, entry.model, entry.apiKey),
				headers = {},
				body = body,
			}
		end,
		parse = function(data)
			if type(data) ~= "table" then return nil, nil, "Malformed API response." end
			if type(data.error) == "table" then
				return nil, nil, tostring(data.error.message or data.error.status or "API error")
			end
			local feedback = data.promptFeedback
			if type(feedback) == "table" and type(feedback.blockReason) == "string" then
				return nil, nil, "Blocked by safety filter: " .. feedback.blockReason
			end
			local cands = data.candidates
			if type(cands) ~= "table" or type(cands[1]) ~= "table" then
				return nil, nil, "No candidates returned."
			end
			local chunks, calls = {}, {}
			local content = cands[1].content
			if type(content) == "table" and type(content.parts) == "table" then
				for _, part in ipairs(content.parts) do
					if type(part) == "table" then
						if type(part.text) == "string" then
							chunks[#chunks + 1] = part.text
						elseif type(part.functionCall) == "table" then
							local fc = part.functionCall
							if type(fc.name) == "string" and fc.name ~= "" then
								toolCallSeq += 1
								calls[#calls + 1] = {
									name = fc.name,
									args = (type(fc.args) == "table" and fc.args) or {},
									id = "call_" .. toolCallSeq,
								}
							end
						end
					end
				end
			end
			if #chunks == 0 and #calls == 0 then
				local reason = cands[1].finishReason
				return nil, nil, "Empty response" .. (reason and (" (" .. tostring(reason) .. ")") or "")
			end
			return table.concat(chunks, ""), calls, nil
		end,
	}

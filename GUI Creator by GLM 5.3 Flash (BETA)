		local guis = getProjectScreenGuis()
		local parts = splitPathString(path)
		if #parts == 0 then
			return guis[1] or nil, "no project ScreenGui found"
		end
		local root = nil
		for _, sg in ipairs(guis) do
			if sg.Name == parts[1] then root = sg break end
		end
		if not root then root = guis[1] end
		if not root then return nil, "no project ScreenGui found" end
		local current = root
		for i = 2, #parts do
			local child = current:FindFirstChild(parts[i])
			if not child then
				return nil, ("'%s' not found under '%s'"):format(parts[i], current.Name)
			end
			current = child
		end
		return current
	end
	local function pathOf(inst)
		if typeof(inst) ~= "Instance" then return "" end
		local parts = {}
		local current = inst
		local hops = 0
		while current and hops < 24 do
			hops += 1
			table.insert(parts, 1, current.Name)
			if current:IsA("ScreenGui") and current:GetAttribute(PROJECT_ATTRIBUTE) == true then
				break
			end
			current = current.Parent
		end
		return table.concat(parts, "/")
	end
	-- TOOL IMPLEMENTATIONS
	local function toolTree()
		local lines = {}
		local function walk(inst, depth, prefix)
			for _, child in ipairs(treeChildren(inst)) do
				lines[#lines + 1] = prefix .. child.Name .. " (" .. child.ClassName .. ")"
				if depth < 6 then walk(child, depth + 1, prefix .. "  ") end
			end
		end
		for _, sg in ipairs(getProjectScreenGuis()) do
			lines[#lines + 1] = sg.Name .. " (" .. sg.ClassName .. ")"
			walk(sg, 1, "  ")
		end
		local text = table.concat(lines, "\n")
		if text == "" then text = "(empty — no project ScreenGui)" end
		return cap(text, 4000)
	end
	local function toolProps(path)
		local inst, err = resolveInstancePath(path)
		if not inst then return "error: " .. tostring(err) end
		local names = {}
		local groups = CLASS_GROUPS[inst.ClassName] or FALLBACK_GROUP_KEYS
		for _, g in ipairs(groups) do
			for _, p in ipairs(PROP_GROUPS[g] or {}) do names[p] = true end
		end
		local fetched = PropFetcher.getProperties(inst.ClassName)
		if fetched then
			for _, p in ipairs(fetched) do names[p] = true end
		end
		local pairsList = {}
		for propName in pairs(names) do
			local ok, value = pcall(function() return inst[propName] end)
			if ok then
				local ptype = resolvePropertyType(inst, propName)
				if ptype and ptype ~= "object" then
					table.insert(pairsList, { n = propName, v = formatValue(ptype, value) })
				end
			end
		end
		table.sort(pairsList, function(a, b) return a.n < b.n end)
		local lines = {}
		for i, entry in ipairs(pairsList) do
			if i > 80 then
				table.insert(lines, "...[truncated]")
				break
			end
			table.insert(lines, entry.n .. " = " .. entry.v)
		end
		return cap(table.concat(lines, "\n"), MAX_TOOL_CHARS)
	end
	local function toolCreate(class, parentPath, name, propsTable)
		class = tostring(class or "")
		if class == "" then return "error: class is required" end
		local parent
		if parentPath == nil or parentPath == "" or parentPath == "new" then
			parent = createProjectScreenGui()
		elseif class == "ScreenGui" then
			parent = PROJECT_PARENT
		else
			local okP
			okP, parent = pcall(resolveInstancePath, parentPath)
			if not okP or not parent then return "error: " .. tostring(parent) end
		end
		local okInst, inst = pcall(Instance.new, class)
		if not okInst or not inst then return "error: cannot create class '" .. class .. "'" end
		inst.Name = (name and tostring(name) ~= "" and tostring(name)) or uniqueName(class)
		if not propsTable and SPAWN_DEFAULTS[class] then
			pcall(SPAWN_DEFAULTS[class], inst, 24, 24)
		end
		if type(propsTable) == "table" then
			for propName, value in pairs(propsTable) do
				local ptype = typeForProp(class, propName)
				if not ptype then
					local okV, v = pcall(function() return inst[propName] end)
					if okV then ptype = inferValueType(v) end
				end
				if ptype and ptype ~= "object" then
					local parsed = parsePropertyValue(ptype, tostring(value))
					if parsed ~= nil then
						pcall(function() inst[propName] = parsed end)
					end
				end
			end
		end
		local okParent = pcall(function() inst.Parent = parent end)
		if not okParent then
			pcall(function() inst:Destroy() end)
			return "error: cannot parent " .. class .. " under " .. parent.ClassName
		end
		invalidateExplorer()
		return "created " .. pathOf(inst)
	end
	local function toolSet(path, propName, value)
		local inst, err = resolveInstancePath(path)
		if not inst then return "error: " .. tostring(err) end
		local ptype = typeForProp(inst.ClassName, propName)
		if not ptype then
			local okV, v = pcall(function() return inst[propName] end)
			ptype = okV and inferValueType(v) or nil
		end
		if not ptype or ptype == "object" then return "error: unknown property '" .. propName .. "'" end
		local parsed = parsePropertyValue(ptype, tostring(value))
		if parsed == nil then
			return ("error: cannot parse '%s' as %s"):format(tostring(value), ptype)
		end
		local ok = pcall(function() inst[propName] = parsed end)
		if not ok then return "error: failed to set " .. propName end
		if propName == "Name" then invalidateExplorer() end
		return ("set %s.%s = %s"):format(pathOf(inst), propName, tostring(value))
	end
	local function toolDelete(path)

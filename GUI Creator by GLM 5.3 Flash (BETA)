	local function fetchModels(entry, silent)
		local key = tostring(entry.apiKey or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if entry.builtin and key == "" then
			if not silent then notify("Paste the " .. entry.displayName .. " API key first.", "warn", 3) end
			return false
		end
		if AI.fetching[entry.id] then return true end
		AI.fetching[entry.id] = true
		if rebuildSettings then pcall(rebuildSettings) end
		task.spawn(function()
			local url, headers
			if entry.compat == "openai" then
				url = entry.baseUrl .. "/models"
				headers = key ~= "" and { Authorization = "Bearer " .. key } or {}
			elseif entry.compat == "anthropic" then
				url = entry.baseUrl .. "/models"
				headers = { ["x-api-key"] = key, ["anthropic-version"] = "2023-06-01",
					["anthropic-dangerous-direct-browser-access"] = "true" }
			else
				url = entry.baseUrl .. "/models?key=" .. key
				headers = {}
			end
			local res, err = httpJson(url, "GET", nil, headers)
			AI.fetching[entry.id] = nil
			if not res then
				if not silent then notify("Model fetch failed: " .. tostring(err), "error", 4) end
				if rebuildSettings then pcall(rebuildSettings) end
				return
			end
			local okDecode, data = pcall(function() return HttpService:JSONDecode(res.body or "") end)
			if not (okDecode and type(data) == "table") then
				if not silent then
					notify(("Model fetch returned HTTP %s with an unreadable body."):format(tostring(res.code)), "error", 4)
				end
				if rebuildSettings then pcall(rebuildSettings) end
				return
			end
			if type(data.error) == "table" then
				if not silent then
					notify("API error: " .. tostring(data.error.message or data.error.status or data.error.type), "error", 4.5)
				end
				if rebuildSettings then pcall(rebuildSettings) end
				return
			end
			local list = {}
			if entry.compat == "gemini" then
				for _, m in ipairs(type(data.models) == "table" and data.models or {}) do
					if type(m) == "table" and type(m.name) == "string" then
						local supported = false
						for _, method in ipairs(type(m.supportedGenerationMethods) == "table" and m.supportedGenerationMethods or {}) do
							if method == "generateContent" then supported = true end
						end
						if supported then
							local id = m.name:gsub("^models/", "")
							local name = (type(m.displayName) == "string" and m.displayName ~= "") and m.displayName or prettyModelId(id)
							table.insert(list, { id = id, name = name })
						end
					end
				end
			else
				for _, m in ipairs(type(data.data) == "table" and data.data or {}) do
					if type(m) == "table" and type(m.id) == "string" then
						local name = (type(m.display_name) == "string" and m.display_name ~= "") and m.display_name or prettyModelId(m.id)
						table.insert(list, { id = m.id, name = name })
					end
				end
			end
			table.sort(list, function(a, b) return a.id < b.id end)
			while #list > 250 do table.remove(list) end
			entry.models = list
			saveAiSettings()
			if rebuildSettings then pcall(rebuildSettings) end
			if refreshChatStatus then pcall(refreshChatStatus) end
			if not silent then
				if #list == 0 then
					notify("The key works but returned no models.", "warn", 4)
				else
					notify(("Fetched %d model(s) for %s."):format(#list, entry.displayName), "success", 2.5)
				end
			end
		end)
		return true
	end

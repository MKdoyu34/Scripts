			Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 13,
		}, row)
		if ptype == "bool" then
			-- BOOLEAN DROPDOWN: lists the only valid options (true / false).
			local btn = makeDropdownButton(row)
			local function refresh()
				local ok, value = pcall(function() return obj[propName] end)
				if not ok then return end
				btn.Text = value and "true" or "false"
				btn.BackgroundColor3 = value and THEME.Good or THEME.Control
				btn.TextColor3 = value and Color3.fromRGB(255, 255, 255) or THEME.Text

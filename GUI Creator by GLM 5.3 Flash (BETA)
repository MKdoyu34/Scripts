	local function splitCodeBlocks(text)
		local segments = {}
		local rest = tostring(text or "")
		while #rest > 0 do
			local s = rest:find("```", 1, true)
			if not s then
				table.insert(segments, { type = "text", text = rest })
				break
			end
			if s > 1 then table.insert(segments, { type = "text", text = rest:sub(1, s - 1) }) end
			local tail = rest:sub(s + 3)
			local nl = tail:find("\n", 1, true)
			local lang, code, closeS
			if nl then
				lang = tail:sub(1, nl - 1):gsub("%s+", "")
				closeS = tail:find("```", nl + 1, true)
				if closeS then code = tail:sub(nl + 1, closeS - 1) end
			end
			if not closeS then
				table.insert(segments, { type = "text", text = rest:sub(s) })
				break
			end
			table.insert(segments, { type = "code", lang = lang or "", code = code or "" })
			rest = tail:sub(closeS + 3)
		end
		return segments
	end
	local function addChatMessage(kind, text)
		for _, seg in ipairs(splitCodeBlocks(text)) do
			if seg.type == "code" then
				if seg.lang == "tool" then
					addTextRow("trace", "· tool code block executed (Code Mode)")
				else
					addCodeRow(seg.code, seg.lang)
				end
			elseif tostring(seg.text):gsub("%s+", "") ~= "" then
				addTextRow(kind, seg.text)
			end
		end
		scrollChatToBottom()
	end

			if type(data.error) == "table" then
				return nil, nil, tostring(data.error.message or data.error.type or "API error")
			end
			if type(data.content) ~= "table" then
				return nil, nil, "No content returned" .. (data.stop_reason and (" (" .. tostring(data.stop_reason) .. ")") or "")
			end
			local chunks, calls = {}, {}
			for _, block in ipairs(data.content) do

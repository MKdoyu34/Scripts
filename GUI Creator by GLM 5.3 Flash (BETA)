	function Notifications.show(text, kind, duration)
		local barColor = styleForKind[kind] or styleForKind.info
		toastSequence += 1
		local toast = create("Frame", {
			Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = THEME.PanelAlt,
			BorderSizePixel = 0, ZIndex = 100, LayoutOrder = toastSequence,
		}, holder)
		create("UICorner", { CornerRadius = UDim.new(0, 6) }, toast)
		create("UIStroke", { Color = THEME.Stroke, Thickness = 1 }, toast)
		create("Frame", {
			Size = UDim2.new(0, 3, 1, -8), Position = UDim2.fromOffset(6, 4),
			BackgroundColor3 = barColor, BorderSizePixel = 0, ZIndex = 101,
		}, toast)
		create("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 0),
			Size = UDim2.new(1, -24, 1, 0), Text = tostring(text), TextColor3 = THEME.Text,
			Font = Enum.Font.GothamMedium, TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 101,
		}, toast)
		task.delay(duration or 3, function()
			if not toast.Parent then return end
			pcall(function()
				TweenService:Create(toast, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
				for _, d in ipairs(toast:GetDescendants()) do
					if d:IsA("TextLabel") then
						TweenService:Create(d, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
					elseif d:IsA("Frame") then
						TweenService:Create(d, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
					elseif d:IsA("UIStroke") then
						TweenService:Create(d, TweenInfo.new(0.3), { Transparency = 1 }):Play()
					end
				end
			end)
			task.delay(0.32, function() pcall(function() toast:Destroy() end) end)
		end)
		local kids = {}
		for _, c in ipairs(holder:GetChildren()) do
			if c:IsA("Frame") then table.insert(kids, c) end
		end
		while #kids > 5 do
			local oldest = table.remove(kids, 1)
			pcall(function() oldest:Destroy() end)
		end
	end
end

	local GROUP_TITLES = {
		base = "Appearance", text = "Text", button = "Button", textbox = "TextBox",
		image = "Image", video = "VideoFrame", scroll = "Scrolling", viewport = "ViewportFrame",
		corner = "UICorner", stroke = "UIStroke", gradient = "UIGradient",
		list = "UIListLayout", grid = "UIGridLayout", table = "UITableLayout",
		page = "UIPageLayout", padding = "UIPadding", scale = "UIScale",
		sizeconstraint = "UISizeConstraint", textsize = "UITextSizeConstraint",
		aspectratio = "UIAspectRatioConstraint", canvas = "CanvasGroup", screengui = "ScreenGui",
		script = "Script", value = "Value", sound = "Sound",
	}
	-- Central gate: type must be editable AND the property must accept writes.
	local function tryAddProp(obj, propName, shown)
		if shown[propName] then return end
		local ptype = resolvePropType(obj, propName)
		if not ptype or ptype == "object" then return end
		if not propIsWritable(obj, propName) then return end
		shown[propName] = true
		addPropRow(obj, propName, ptype)
	end
	function PropPanel.build(obj)
		clearRows()
		placeholder.Visible = (obj == nil)
		scroll.Visible = (obj ~= nil)
		if not obj then return end
		addSection("Data")
		local nameType = resolvePropType(obj, "Name") or "string"
		addPropRow(obj, "Name", nameType)
		local shown = { Name = true }
		local groups = CLASS_GROUPS[obj.ClassName] or FALLBACK_GROUP_KEYS
		for _, groupKey in ipairs(groups) do
			local propList = PROP_GROUPS[groupKey]
			if propList then
				addSection(GROUP_TITLES[groupKey] or groupKey)
				for _, propName in ipairs(propList) do
					if propName == "Source" and (obj:IsA("LocalScript") or obj:IsA("ModuleScript")) then
						addFunctionRow(obj)
						shown.Source = true
					else
						tryAddProp(obj, propName, shown)
					end
				end
			end
		end
		local fetched = PropFetcher.getProperties(obj.ClassName)
		if fetched then
			local extraCount = 0
			for _, propName in ipairs(fetched) do
				if not shown[propName] then
					local ptype = resolvePropType(obj, propName)
					if ptype and ptype ~= "object" and propIsWritable(obj, propName) then
						extraCount += 1
						break
					end
				end
			end
			if extraCount > 0 then
				addSection("All Properties (API)")
				for _, propName in ipairs(fetched) do
					tryAddProp(obj, propName, shown)
				end
			end
		elseif PropFetcher.status == "loading" then
			addSection("All Properties (fetching API dump...)")
		end
	end
	function PropPanel.refresh(propName)
		local refresh = rows[propName]
		if refresh then pcall(refresh) end
	end
	function PropPanel.init()
		scroll = UI.makeScrollList(UI.propertiesColumn, 24)
		placeholder = create("TextLabel", {
			Size = UDim2.new(1, -16, 1, -30), Position = UDim2.fromOffset(8, 24),
			BackgroundTransparency = 1,
			Text = "Select an instance in the viewport or Workspace\nto edit its properties.",
			TextColor3 = THEME.TextDim, Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 12,
		}, UI.propertiesColumn)
	end
end

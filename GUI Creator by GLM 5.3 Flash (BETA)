local function serializeValue(value)
	local kind = typeof(value)
	if kind == "string" or kind == "number" or kind == "boolean" then
		return value
	elseif kind == "EnumItem" then
		return { ct = "Enum", et = value.EnumType.Name, en = value.Name }
	elseif kind == "Color3" then
		return { ct = "Color3", r = value.R, g = value.G, b = value.B }
	elseif kind == "UDim2" then
		return { ct = "UDim2", xs = value.X.Scale, xo = value.X.Offset, ys = value.Y.Scale, yo = value.Y.Offset }
	elseif kind == "UDim" then
		return { ct = "UDim", s = value.Scale, o = value.Offset }
	elseif kind == "Vector2" then
		return { ct = "Vector2", x = value.X, y = value.Y }
	elseif kind == "Vector3" then
		return { ct = "Vector3", x = value.X, y = value.Y, z = value.Z }
	elseif kind == "Rect" then
		return { ct = "Rect", x0 = value.Min.X, y0 = value.Min.Y, x1 = value.Max.X, y1 = value.Max.Y }
	elseif kind == "CFrame" then
		return { ct = "CFrame", c = { value:GetComponents() } }
	elseif kind == "BrickColor" then
		return { ct = "BrickColor", n = value.Number }
	elseif kind == "Font" then
		return { ct = "Font", f = value.Family, w = value.Weight.Name, s = value.Style.Name }
	elseif kind == "ColorSequence" then
		local pts = {}
		for _, kp in ipairs(value.Keypoints) do
			table.insert(pts, { t = kp.Time, r = kp.Value.R, g = kp.Value.G, b = kp.Value.B })
		end
		return { ct = "ColorSequence", pts = pts }
	elseif kind == "NumberSequence" then
		local pts = {}
		for _, kp in ipairs(value.Keypoints) do
			table.insert(pts, { t = kp.Time, v = kp.Value, e = kp.Envelope })
		end
		return { ct = "NumberSequence", pts = pts }
	end
	return nil
end

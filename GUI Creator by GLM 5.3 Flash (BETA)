	local function toolRunLua(code)
		code = tostring(code or "")
		if code == "" then return "error: empty code" end
		local fn, err = compileLua(code)
		if not fn then return "error: compile failed: " .. tostring(err) end
		showGatePopup(code)
		local t0 = os.clock()
		while runLuaGate.decision == nil and os.clock() - t0 < 120 do
			task.wait(0.1)
		end
		local decision = runLuaGate.decision
		runLuaGate.decision = nil
		if decision ~= "allow" then return "error: run_lua denied by user" end
		local out, runErr = executeSandboxed(code)
		if not out then return "error: " .. tostring(runErr) end
		return cap(out, MAX_TOOL_CHARS)
	end
	local function parsePropsJSON(text)
		if text == nil or text == "" then return nil end
		if type(text) == "table" then return text end
		local ok, t = pcall(function() return HttpService:JSONDecode(tostring(text)) end)
		if ok and type(t) == "table" then return t end
		local fn = compileLua("return " .. tostring(text))
		if fn then
			local okR, res = pcall(fn)
			if okR and type(res) == "table" then return res end
		end
		return nil
	end

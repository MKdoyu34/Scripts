-- //////////////////////////////////////////////////////////////////////////
-- AUTO PROPERTY FETCHER (official API dump, cached)
-- //////////////////////////////////////////////////////////////////////////
local PropFetcher = { status = "loading", lastError = nil, _props = nil, _super = nil }
do
	local DUMP_URL   = "https://raw.githubusercontent.com/MaximumADHD/Roblox-Client-Tracker/roblox/API-Dump.json"
	local CACHE_FILE = "GUI_CREATOR_API_CACHE.json"
	local CACHE_TTL  = 7 * 24 * 60 * 60
	local BAD_TAGS = { Hidden = true, Deprecated = true, NotScriptable = true, ReadOnly = true }
	local function fetchText(url)
		local ok, res = pcall(function() return game:HttpGet(url, true) end)
		if ok and type(res) == "string" and #res > 0 then return res end
		ok, res = pcall(function() return HttpService:GetAsync(url) end)
		if ok and type(res) == "string" and #res > 0 then return res end
		if Executor.http then
			local okReq, resp = pcall(Executor.http, { Url = url, Method = "GET" })
			if okReq and type(resp) == "table" and type(resp.Body) == "string" and #resp.Body > 0 then
				return resp.Body
			end
		end
		return nil, "no working HTTP method (game:HttpGet / GetAsync / request all failed)"
	end
	local function parseDump(rawJson)
		local okDecode, dump = pcall(function() return HttpService:JSONDecode(rawJson) end)
		if not okDecode or typeof(dump) ~= "table" or typeof(dump.Classes) ~= "table" then
			return nil, "API dump JSON decode failed (or no Classes array)"
		end
		local props, super = {}, {}
		for _, classData in ipairs(dump.Classes) do
			if type(classData.Name) == "string" then
				super[classData.Name] = classData.Superclass
				if typeof(classData.Members) == "table" then
					local list = {}
					for _, member in ipairs(classData.Members) do
						if member.MemberType == "Property" and type(member.Name) == "string" then
							local bad = false
							if typeof(member.Tags) == "table" then
								for _, tag in ipairs(member.Tags) do
									if BAD_TAGS[tag] then bad = true; break end
								end
							end
							if not bad then table.insert(list, member.Name) end
						end
					end
					props[classData.Name] = list
				end
			end
		end
		return props, super
	end
	local function applyParsed(props, super)
		PropFetcher._props = props
		PropFetcher._super = super
		PropFetcher.status = "ready"
		PropFetcher.lastError = nil
		task.defer(function()
			if PropPanel and PropPanel.build and State and State.selected then
				pcall(PropPanel.build, State.selected)
			end
		end)
	end
	local function readCachePayload()
		if not (FS.isfile and FS.readfile) then return nil end
		local okExists, exists = pcall(FS.isfile, CACHE_FILE)
		if not (okExists and exists) then return nil end
		local okRead, raw = pcall(FS.readfile, CACHE_FILE)
		if not okRead or type(raw) ~= "string" then return nil end
		local okDecode, payload = pcall(function() return HttpService:JSONDecode(raw) end)
		if not okDecode or type(payload) ~= "table" then return nil end
		return payload
	end
	local function writeCachePayload(props, super)
		if not FS.writefile then return end
		pcall(function()
			FS.writefile(CACHE_FILE, HttpService:JSONEncode({ fetchedAt = os.time(), props = props, super = super }))
		end)
	end
	local function ensureLoaded()
		local payload = readCachePayload()
		if payload and type(payload.fetchedAt) == "number"
			and (os.time() - payload.fetchedAt) < CACHE_TTL
			and type(payload.props) == "table" and type(payload.super) == "table" then
			applyParsed(payload.props, payload.super)
			return
		end
		local raw, fetchErr = fetchText(DUMP_URL)
		if not raw then
			PropFetcher.status = "failed"
			PropFetcher.lastError = tostring(fetchErr)
			return
		end
		local props, superMap = parseDump(raw)
		if not props then
			PropFetcher.status = "failed"
			PropFetcher.lastError = tostring(superMap)
			return
		end
		applyParsed(props, superMap)
		writeCachePayload(props, superMap)
	end
	function PropFetcher.getClassProperties(className)
		if not (PropFetcher._props and PropFetcher._super) then return nil end
		local seen, out = {}, {}
		local current = className
		local hops = 0
		while current and current ~= "<<<ROOT>>>" and hops < 32 do
			hops += 1
			local list = PropFetcher._props[current]
			if list then
				for _, propName in ipairs(list) do
					if not seen[propName] then
						seen[propName] = true
						table.insert(out, propName)
					end
				end
			end
			current = PropFetcher._super[current]
		end
		table.sort(out)
		return out
	end
	function PropFetcher.getProperties(className)
		if PropFetcher.status ~= "ready" then return nil end
		return PropFetcher.getClassProperties(className)
	end
	task.spawn(function()
		task.wait(0.5)
		ensureLoaded()
		if PropFetcher.status == "failed" and PropFetcher.lastError then
			warn("[StudioGUI Creator] Auto property fetch unavailable: " .. PropFetcher.lastError)
		end
	end)
end

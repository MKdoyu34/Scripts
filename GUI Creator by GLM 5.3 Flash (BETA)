	-- ---------------- AGENT SEND / RECEIVE
	local function setWaiting(waitingNow)
		AI.waiting = waitingNow and true or false
		sendButton.Text = AI.waiting and "..." or "Send"
		if AI.waiting then
			chatStatus.Text = ("Agent mode — working with %s..."):format(getActiveProvider().displayName)
		else
			refreshChatStatus()
		end
	end
	local function sendChat()
		if AI.waiting then return end
		local text = tostring(inputBox.Text):gsub("^%s+", ""):gsub("%s+$", "")
		if text == "" then return end
		local entry = getActiveProvider()
		if entry.builtin and (entry.apiKey or "") == "" then
			notify("Add the " .. entry.displayName .. " API key in Providers first.", "warn", 3.5)
			Editor.openAISettings()
			return
		end
		if not entry.model then
			notify("Fetch models and pick one for " .. entry.displayName .. " in Providers first.", "warn", 3.5)
			Editor.openAISettings()
			return
		end
		local adapter = Adapters[entry.compat]
		if not adapter then
			notify("Unknown compatibility type: " .. tostring(entry.compat), "error", 3)
			return
		end
		table.insert(AI.history, { role = "user", text = text })
		addChatMessage("user", text)
		inputBox.Text = ""
		setWaiting(true)
		task.spawn(function()
			local function requestRound(withTools, minimal)
				local req = adapter.build(entry, AI.history, buildSystemPrompt(), withTools, minimal)
				local res, err = httpJson(req.url, "POST", req.body, req.headers)
				if not res then return nil, nil, tostring(err) end
				local okD, data = pcall(function() return HttpService:JSONDecode(res.body or "") end)
				if not (okD and type(data) == "table") then
					return nil, nil, ("Unreadable response (HTTP %s)."):format(tostring(res.code))
				end
				return adapter.parse(data)
			end
			-- Retry chain: models that reject tools or optional params get a
			-- second chance with a stripped-down request.
			local function smartRequest()
				local r, c, e = requestRound(true, false)
				if e then
					local low = tostring(e):lower()
					if low:find("tool", 1, true) or low:find("function", 1, true) then
						r, c, e = requestRound(false, false)
					elseif low:find("temperature", 1, true) or low:find("thinking", 1, true)
						or low:find("reasoning", 1, true) or low:find("max_tokens", 1, true)
						or low:find("unsupported", 1, true) or low:find("unknown", 1, true)
						or low:find("invalid", 1, true) then
						r, c, e = requestRound(true, true)
						if e then
							local l2 = tostring(e):lower()
							if l2:find("tool", 1, true) or l2:find("function", 1, true) then
								r, c, e = requestRound(false, true)
							end
						end
					end
				end
				return r, c, e
			end
			local rounds = 0
			local runStarted = os.clock()
			local timeline, timelineCtx = addAgentTimeline()
			local answered = false
			local function finishAnswered(ok)
				if answered then return end
				answered = true
				local row = addAgentStep(timeline, timelineCtx, "Answered")
				row.finish(ok, formatDuration(os.clock() - runStarted))
			end
			local function trimHistory()
				while #AI.history > 40 do table.remove(AI.history, 1) end
			end
			while true do
				chatStatus.Text = ("Agent mode — thinking (%d tool round(s) so far)..."):format(rounds)
				local thought = addAgentStep(timeline, timelineCtx, "Thought")
				local t0 = os.clock()
				local reply, calls, perr = smartRequest()
				if perr then
					thought.finish(false, formatDuration(os.clock() - t0))
					finishAnswered(false)
					setWaiting(false)
					addChatMessage("error", tostring(perr))
					return
				end
				thought.finish(true, formatDuration(os.clock() - t0))
				if type(calls) ~= "table" or #calls == 0 then
					setWaiting(false)
					finishAnswered(true)
					local finalText = tostring(reply or "")
					table.insert(AI.history, { role = "model", text = finalText:sub(1, 6000) })
					trimHistory()
					addChatMessage("model", finalText ~= "" and finalText or "(empty response)")
					return
				end
				rounds += 1
				local narration = tostring(reply or "")
				if narration:match("%S") then addChatMessage("model", narration) end
				table.insert(AI.history, { role = "model", text = narration, calls = calls })
				local results = {}
				for _, call in ipairs(calls) do
					chatStatus.Text = ("Agent mode — running %s..."):format(tostring(call.name))
					local step = addAgentStep(timeline, timelineCtx, tostring(call.name))
					local tTool = os.clock()
					local result = runAiTool(call)
					local okTool = not tostring(result):match("^ERROR")
					step.finish(okTool, formatDuration(os.clock() - tTool))
					if not okTool then
						local short = tostring(result):gsub("[\r\n]+", " ")
						if #short > 240 then short = short:sub(1, 237) .. "..." end
						addChatMessage("error", ("%s(%s) failed: %s"):format(
							tostring(call.name), summarizeArgs(call.args), short))
					end
					table.insert(results, { name = call.name, id = call.id, response = result })
				end
				table.insert(AI.history, { role = "tool", results = results })
				trimHistory()
				if rounds >= MAX_TOOL_ROUNDS then
					chatStatus.Text = "Agent mode — wrapping up..."
					local wrap = addAgentStep(timeline, timelineCtx, "Thought (wrap-up)")
					local tWrap = os.clock()
					table.insert(AI.history, { role = "user",
						text = "Tool round limit reached — summarize what you changed in plain text now (no more tool calls)." })
					local finalText, _, e2 = requestRound(false, true)
					setWaiting(false)
					finalText = tostring(finalText or e2 or "")
					wrap.finish(finalText ~= "", formatDuration(os.clock() - tWrap))
					finishAnswered(finalText ~= "")
					table.insert(AI.history, { role = "model", text = finalText:sub(1, 6000) })
					trimHistory()
					addChatMessage("model", finalText ~= "" and finalText or "(tools finished — no summary returned)")
					return
				end
				task.wait(0.05)
			end
		end)
	end
	sendButton.Activated:Connect(sendChat)
	inputBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			sendChat()
			task.defer(function() pcall(function() inputBox:CaptureFocus() end) end)
		end
	end)

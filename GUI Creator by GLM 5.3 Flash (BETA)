local function create(class, props, parent)
	local inst = Instance.new(class)
	if props then
		for key, value in pairs(props) do
			pcall(function() inst[key] = value end)
		end
	end
	if parent then
		pcall(function() inst.Parent = parent end)
	end
	return inst
end
local function trimNum(n)
	local num = tonumber(n)
	if not num or num ~= num then return "0" end
	if num == math.huge then return "math.huge" end
	if num == -math.huge then return "-math.huge" end
	if num == math.floor(num) and math.abs(num) < 1e15 then
		return string.format("%d", num)
	end
	return tostring(num)
end
local function luaQuote(s)
	local out = tostring(s):gsub("\\", "\\\\"):gsub("\"", "\\\"")
		:gsub("\n", "\\n"):gsub("\r", "\\r"):gsub("\t", "\\t")
	out = out:gsub("%c", function(c) return string.format("\\%03d", string.byte(c)) end)
	return "\"" .. out .. "\""
end
local function safeJsonEncode(t)
	local ok, s = pcall(function() return HttpService:JSONEncode(t) end)
	if ok and type(s) == "string" then return s end
	return "{}"
end
local defaultInstances = {}
local function defaultInstanceOf(className)

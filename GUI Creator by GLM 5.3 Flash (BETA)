	local function extractToolBlock(text)
		local rest = tostring(text or "")
		while true do
			local s = rest:find("```", 1, true)
			if not s then return nil end
			local tail = rest:sub(s + 3)
			local nl = tail:find("\n", 1, true)
			local lang = nl and tail:sub(1, nl - 1):gsub("%s+", "") or ""
			local closeS = tail:find("```", (nl or 0) + 1, true)
			if closeS and lang == "tool" then
				return tail:sub((nl or 0) + 1, closeS - 1)
			end
			if not closeS then return nil end
			rest = tail:sub(closeS + 3)
		end
	end
	local function runCodeModeBlock(code)
		local out, err = executeSandboxed(code, { tool = toolAPI() })
		if not out then return "error: " .. tostring(err) end
		return cap(out, MAX_TOOL_CHARS)
	end
	-- HTTP LAYER (normalized across executors)
	local function httpJSON(url, method, headers, bodyTable)
		local payload = bodyTable and safeJsonEncode(bodyTable) or nil
		if Executor.http then
			local ok, resp = pcall(Executor.http, {
				Url = url, Method = method or "GET", Headers = headers, Body = payload,
			})
			if ok then
				if type(resp) == "table" then
					return {
						status = tonumber(resp.StatusCode or resp.code or resp.Status) or 0,
						body = tostring(resp.Body or resp.body or ""),
					}
				end
				return { status = 200, body = tostring(resp) }
			end
		end
		if method == "GET" then
			local okG, bodyG = pcall(function() return game:HttpGet(url, true) end)
			if okG and type(bodyG) == "string" and #bodyG > 0 then
				return { status = 200, body = bodyG }
			end
			local okH, bodyH = pcall(function() return HttpService:GetAsync(url, false, headers) end)
			if okH and type(bodyH) == "string" and #bodyH > 0 then
				return { status = 200, body = bodyH }
			end
		else
			local okP, bodyP = pcall(function()
				return HttpService:PostAsync(url, payload or "{}", Enum.HttpContentType.ApplicationJson, false, headers)
			end)
			if okP and type(bodyP) == "string" then
				return { status = 200, body = bodyP }
			end
		end
		return nil, "no working HTTP method on this executor (request/HttpGet/PostAsync all failed)"
	end
	local function extractProviderError(status, body)
		local msg
		local ok, decoded = pcall(function() return HttpService:JSONDecode(body) end)
		if ok and type(decoded) == "table" then
			local e = decoded.error
			if type(e) == "table" and e.message then msg = tostring(e.message)
			elseif type(e) == "string" then msg = e
			elseif type(decoded.message) == "string" then msg = decoded.message
			end
		end
		if not msg or msg == "" then
			msg = (#body > 0 and body:sub(1, 300)) or "no response body"
		end
		return ("HTTP %s: %s"):format(status, msg)
	end
	-- TOOL SCHEMAS PER PROVIDER FORMAT
	local function toolSchemas(compat)
		local function stringType() return compat == "google" and "STRING" or "string" end
		local function objectType() return compat == "google" and "OBJECT" or "object" end
		local out = {}
		for _, tool in ipairs(TOOLS) do
			local properties = {}
			for _, paramName in ipairs(tool.params) do
				properties[paramName] = { type = stringType(), description = paramName }
			end
			local reqCount = math.min(#tool.params, 2)
			local required = nil
			if reqCount > 0 then
				required = { unpack(tool.params, 1, reqCount) }
			end
			local schema
			if compat == "anthropic" then
				schema = {
					name = tool.name,
					description = tool.description,
					input_schema = {
						type = "object",
						properties = properties,
						required = required,
					},
				}
			elseif compat == "google" then
				schema = {
					name = tool.name,
					description = tool.description,
					parameters = {
						type = objectType(),
						properties = properties,
						required = required,
					},
				}
			else
				schema = {
					type = "function",
					["function"] = {
						name = tool.name,
						description = tool.description,
						parameters = {
							type = "object",
							properties = properties,
							required = required,
						},
					},
				}
			end
			table.insert(out, schema)
		end
		return out
	end

	local function toolDeclarations()
		local decls = {}
		for name, tool in pairs(AI_TOOLS) do
			if name ~= "run_lua" or AI.settings.allowRunLua then
				local decl = { name = name, description = tool.description }
				if type(tool.parameters) == "table" then decl.parameters = tool.parameters end
				table.insert(decls, decl)
			end
		end
		if #decls == 0 then return nil end
		table.sort(decls, function(a, b) return a.name < b.name end)
		return decls
	end
	local function runAiTool(call)
		if type(call) ~= "table" or type(call.name) ~= "string" then
			return "ERROR: malformed tool call."
		end
		local tool = AI_TOOLS[call.name]
		if not tool then return "ERROR: unknown tool '" .. call.name .. "'" end
		if call.name == "run_lua" and not AI.settings.allowRunLua then
			return "ERROR: run_lua is disabled — enable 'Allow AI to run code' in AI Settings."
		end
		local args = (type(call.args) == "table" and call.args) or {}
		local ok, result = pcall(tool.run, args)
		if not ok then return "ERROR: " .. tostring(result) end
		if result == nil or result == "" then return "ok" end
		return tostring(result)
	end
	local function summarizeArgs(args)
		if type(args) ~= "table" then return "" end
		local text = safeJsonEncode(args)
		if #text > 140 then text = text:sub(1, 137) .. "..." end
		return text
	end
	-- ---------------- HISTORY SANITIZER (provider-neutral)
	-- Neutral entries: {role="user",text} | {role="model",text,calls} | {role="tool",results}
	local function sanitizeHistory(hist)
		local out, seen, started = {}, {}, false
		for _, e in ipairs(hist) do
			if not started then
				if e.role == "user" and type(e.text) == "string" and not e.toolResults then
					started = true
				else
					continue
				end
			end
			if e.role == "model" and type(e.calls) == "table" and #e.calls > 0 then
				for _, c in ipairs(e.calls) do seen[c.id or c.name] = true end
				out[#out + 1] = e
			elseif e.role == "tool" then
				local ok = true
				for _, r in ipairs(e.results or {}) do
					if not seen[r.id or r.name] then ok = false; break end
				end
				if ok then out[#out + 1] = e end
			else
				out[#out + 1] = e
			end
		end
		while #out > 0 do
			local last = out[#out]
			if last.role == "model" and type(last.calls) == "table" and #last.calls > 0 then
				table.remove(out)
			else
				break
			end
		end
		return out
	end

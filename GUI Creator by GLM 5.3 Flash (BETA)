				local ok, value = pcall(function() return obj[propName] end)
				if not ok then return end
				Popup.open(btn.AbsolutePosition, btn.AbsoluteSize,
					{ { id = "true", label = "true" }, { id = "false", label = "false" } },
					value and "true" or "false",
					function(id)
						local applied = pcall(function() obj[propName] = (id == "true") end)
						if applied then
							afterPropertyChange(obj, propName)
						else
							notify(("Failed to set %s"):format(propName), "error", 2.5)
						end
						refresh()
					end)
			end)
			refresh()
			rows[propName] = refresh
		elseif ptype == "source" then
			local box = create("TextBox", {
				Position = UDim2.fromOffset(134, 3), Size = UDim2.new(1, -140, 1, -9),
				BackgroundColor3 = THEME.Control, TextColor3 = THEME.Text, Font = Enum.Font.Code,
				TextSize = 12, Text = "", MultiLine = true, TextWrapped = false,
				TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
				ClearTextOnFocus = false, BorderSizePixel = 0, ZIndex = 13,
			}, row)
			create("UICorner", { CornerRadius = UDim.new(0, 4) }, box)
			create("UIStroke", { Color = THEME.Stroke, Thickness = 1 }, box)
			create("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 4) }, box)
			local function refresh()
				if box:IsFocused() then return end
				local ok, value = pcall(function() return obj[propName] end)
				if ok then box.Text = tostring(value) end
			end
			box.FocusLost:Connect(function()
				local applied = applyProperty(obj, propName, box.Text, "source")
				if applied then afterPropertyChange(obj, propName) end
				refresh()
			end)
			refresh()
			rows[propName] = refresh
		elseif ptype:sub(1, 5) == "enum:" then
			local btn = makeDropdownButton(row)
			local function refresh()
				local ok, value = pcall(function() return obj[propName] end)
				if not ok or typeof(value) ~= "EnumItem" then return end
				btn.Text = value.Name
			end
			btn.Activated:Connect(function()
				local ok, value = pcall(function() return obj[propName] end)
				if not ok or typeof(value) ~= "EnumItem" then return end
				local okItems, enumItems = pcall(function() return value.EnumType:GetEnumItems() end)
				if not okItems then return end
				local items = {}
				for _, item in ipairs(enumItems) do
					table.insert(items, { id = item.Name, label = item.Name })
				end
				Popup.open(btn.AbsolutePosition, btn.AbsoluteSize, items, value.Name, function(id)
					local item = value.EnumType[id]
					if item then
						local applied = pcall(function() obj[propName] = item end)
						if applied then
							afterPropertyChange(obj, propName)
						else
							notify(("Failed to set %s"):format(propName), "error", 2.5)
						end
					end
					refresh()
				end)
			end)
			refresh()
			rows[propName] = refresh
		else

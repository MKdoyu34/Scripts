local function applyAiCode(code)
    if type(code) ~= "string" or not code:match("%S") then
        return
    end
    local chunk, compileErr = compileWithBot(code, "AIChatBot_Snippet", nil)
    if not chunk then
        notify("Snippet error: " .. tostring(compileErr), "error", 5)
        return
    end
    task.spawn(function()
        local t0 = os.clock()
        local ok, runErr = pcall(chunk)
        if ok then
            notify("Snippet applied.", "success", 2.5)
        else
            notify("Snippet runtime error: " .. shortErr(runErr), "error", 5)
        end
        if onCodeApplied then
            pcall(onCodeApplied, code, ok, ok and "ok" or ("ERROR: " .. shortErr(runErr)), os.clock() - t0)
        end
    end)
end


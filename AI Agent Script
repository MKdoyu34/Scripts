-- //////////////////////////////////////////////////////////////////////////
-- CHAT RENDERING (bubbles, code blocks with Copy / Apply, workflow trace)
-- //////////////////////////////////////////////////////////////////////////

-- //////////////////////////////////////////////////////////////////////////
-- MARKDOWN — AI replies are rendered as real UI: # headings, **bold**,
-- *italic*, ~~strike~~, ==highlight==, `inline code`, [links](url), bare
-- URLs, - / * / 1. lists (nested), - [ ] task lists, > quotes, --- rules and
-- | tables |. Fenced ``` code blocks keep their own Copy / Apply boxes.
-- Inline formatting becomes Roblox RichText; anything that would produce
-- broken markup falls back to the plain (escaped) text.
-- //////////////////////////////////////////////////////////////////////////

local Markdown = {}
do
    local LINK = "#6CB4FF"
    local DIM = "#9696A2"
    local CODE_FG = "#E8C58C"
    local CODE_BG = "#121216"
    local BODY_SIZE = 13

    function Markdown.escape(s)
        return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
    end

    -- Tags must close in reverse order, or Roblox shows the raw markup.
    function Markdown.valid(rich)
        local stack = {}
        for closing, tag, selfClose in rich:gmatch("<(/?)(%a+)[^>]-(/?)>") do
            tag = tag:lower()
            if selfClose == "/" or tag == "br" then
                -- self-contained
            elseif closing == "/" then
                if stack[#stack] ~= tag then
                    return false
                end
                table.remove(stack)
            else
                table.insert(stack, tag)
            end
        end
        return #stack == 0
    end

    local function codeSpan(code)
        return ('<mark color="%s" transparency="0"><font face="RobotoMono" color="%s">%s</font></mark>')
            :format(CODE_BG, CODE_FG, Markdown.escape(code))
    end

    -- One run of inline Markdown → RichText.
    function Markdown.inline(raw, size)
        size = size or BODY_SIZE
        local stash = {}
        local function keep(rich)
            table.insert(stash, rich)
            return "\1" .. #stash .. "\2"
        end
        local s = tostring(raw or "")
        s = s:gsub("``%s?(.-)%s?``", function(code) return keep(codeSpan(code)) end)
        s = s:gsub("`([^`\n]+)`", function(code) return keep(codeSpan(code)) end)
        s = s:gsub("\\([%*_`~%[%]#>=|\\!%-%+%.])", function(c) return keep(Markdown.escape(c)) end)
        s = Markdown.escape(s)
        s = s:gsub("&lt;[Bb][Rr]%s*/?&gt;", "\n")
        -- images, links, autolinks, bare URLs
        s = s:gsub("!%[([^%]\n]*)%]%(([^%)%s]+)[^%)\n]*%)", function(alt)
            return keep(('<font color="%s">[image: %s]</font>'):format(DIM, (alt ~= "") and alt or "image"))
        end)
        s = s:gsub("%[([^%]\n]+)%]%(([^%)%s]+)[^%)\n]*%)", function(text, url)
            local host = url:match("^%a+://([^/%?#]+)")
            local tail = ""
            if host then
                host = host:gsub("^www%.", "")
                if host ~= text then
                    tail = ('<font color="%s" size="%d"> (%s)</font>'):format(DIM, math.max(9, size - 2), host)
                end
            end
            return keep(('<font color="%s"><u>%s</u></font>'):format(LINK, text) .. tail)
        end)
        s = s:gsub("&lt;(https?://[^%s]-)&gt;", function(url)
            return keep(('<font color="%s"><u>%s</u></font>'):format(LINK, url))
        end)
        s = s:gsub("https?://[^%s\1\2]+", function(url)
            local trail = ""
            while true do
                local t = url:match("&gt;$") or url:match("&lt;$") or url:match("[%.,;:!%?%)%]'\"]$")
                if not t or #t >= #url then break end
                trail = t .. trail
                url = url:sub(1, #url - #t)
            end
            return keep(('<font color="%s"><u>%s</u></font>'):format(LINK, url)) .. trail
        end)
        -- emphasis
        s = s:gsub("%*%*%*([^%s%*][^\n]-)%*%*%*", "<b><i>%1</i></b>")
        s = s:gsub("%*%*([^%s%*][^\n]-)%*%*", "<b>%1</b>")
        s = s:gsub("%f[_%w]__([^%s_][^\n]-)__%f[^_%w]", "<b>%1</b>")
        s = s:gsub("%*([^%s%*][^\n%*]-)%*", "<i>%1</i>")
        s = s:gsub("%f[_%w]_([^%s_][^\n_]-)_%f[^_%w]", "<i>%1</i>")
        s = s:gsub("~~([^%s~][^\n~]-)~~", "<s>%1</s>")
        s = s:gsub("==([^%s=][^\n=]-)==", '<mark color="#6B5A1E" transparency="0.25">%1</mark>')
        -- restore protected pieces (twice: links can hold stashed pieces)
        for _ = 1, 2 do
            s = s:gsub("\1(%d+)\2", function(i) return stash[tonumber(i)] or "" end)
        end
        if not Markdown.valid(s) then
            return Markdown.escape(raw)
        end
        return s
    end

    -- User bubbles: plain text, but @commands are highlighted.
    function Markdown.userRich(raw)
        local s = Markdown.escape(raw)
        local names = AI.mentionNames or {}
        s = (" " .. s):gsub("(%s)@([%a][%w%-]*)", function(space, name)
            if names[name:lower()] then
                return ('%s<font color="%s"><b>@%s</b></font>'):format(space, LINK, name)
            end
            return space .. "@" .. name
        end):sub(2)
        return s
    end

    ---------------------------------------------------------------------
    -- Block parsing
    ---------------------------------------------------------------------
    local function splitRow(line)
        local s = trim(line)
        s = s:gsub("^|", ""):gsub("|$", "")
        local cells = {}
        for cell in (s .. "|"):gmatch("(.-)|") do
            table.insert(cells, trim(cell))
        end
        return cells
    end

    local function separatorAligns(line)
        if not line or not line:find("-", 1, true) or not line:find("|", 1, true) and not line:match("^%s*:?%-%-%-") then
            return nil
        end
        local aligns = {}
        for _, cell in ipairs(splitRow(line)) do
            if not cell:match("^:?%-+:?$") then
                return nil
            end
            local left, right = cell:sub(1, 1) == ":", cell:sub(-1) == ":"
            table.insert(aligns, (left and right) and "center" or (right and "right" or "left"))
        end
        return (#aligns > 0) and aligns or nil
    end

    local function isRule(line)
        local s = line:gsub("%s", "")
        return #s >= 3 and (s:match("^%-+$") or s:match("^%*+$") or s:match("^_+$")) ~= nil
    end

    local function listMarker(line)
        local indent, box, rest = line:match("^(%s*)[%-%*%+]%s+%[([ xX])%]%s+(.*)$")
        if indent then
            return { indent = #indent:gsub("\t", "    "), task = (box ~= " "), isTask = true, text = rest }
        end
        local ind2, rest2 = line:match("^(%s*)[%-%*%+•]%s+(.*)$")
        if ind2 then
            return { indent = #ind2:gsub("\t", "    "), text = rest2 }
        end
        local ind3, num, rest3 = line:match("^(%s*)(%d+)[%.%)]%s+(.*)$")
        if ind3 then
            return { indent = #ind3:gsub("\t", "    "), number = num, text = rest3 }
        end
        return nil
    end

    function Markdown.parse(text)
        local lines = {}
        for line in (tostring(text):gsub("\r\n", "\n"):gsub("\r", "\n") .. "\n"):gmatch("(.-)\n") do
            table.insert(lines, line)
        end
        local blocks, para = {}, nil
        local function flush()
            if para then
                table.insert(blocks, { type = "p", text = table.concat(para, "\n") })
                para = nil
            end
        end
        local i, n = 1, #lines
        while i <= n do
            local line = lines[i]
            local heading, htext = line:match("^%s?%s?%s?(#+)%s+(.-)%s*#*%s*$")
            if line:match("^%s*$") then
                flush()
                i += 1
            elseif heading and #heading <= 6 then
                flush()
                table.insert(blocks, { type = "h", level = #heading, text = htext })
                i += 1
            elseif isRule(line) and not listMarker(line) then
                flush()
                table.insert(blocks, { type = "hr" })
                i += 1
            elseif line:find("|", 1, true) and separatorAligns(lines[i + 1]) then
                flush()
                local aligns = separatorAligns(lines[i + 1])
                local rows = { splitRow(line) }
                i += 2
                while i <= n and lines[i]:find("|", 1, true) and not lines[i]:match("^%s*$") do
                    table.insert(rows, splitRow(lines[i]))
                    i += 1
                end
                table.insert(blocks, { type = "table", rows = rows, aligns = aligns })
            elseif line:match("^%s*>") then
                flush()
                local quote = {}
                while i <= n and lines[i]:match("^%s*>") do
                    table.insert(quote, (lines[i]:gsub("^%s*>%s?", "")))
                    i += 1
                end
                table.insert(blocks, { type = "quote", text = table.concat(quote, "\n") })
            elseif listMarker(line) then
                flush()
                local items = {}
                while i <= n do
                    local cur = lines[i]
                    local item = listMarker(cur)
                    if item then
                        table.insert(items, item)
                        i += 1
                    elseif #items > 0 and cur:match("^%s%s+%S") then
                        -- indented continuation of the previous item
                        local last = items[#items]
                        last.text = last.text .. "\n" .. trim(cur)
                        i += 1
                    else
                        break
                    end
                end
                -- relative nesting levels from the distinct indents used
                local distinct, levels = {}, {}
                for _, it in ipairs(items) do
                    distinct[it.indent] = true
                end
                local sorted = {}
                for width in pairs(distinct) do
                    table.insert(sorted, width)
                end
                table.sort(sorted)
                for index, width in ipairs(sorted) do
                    levels[width] = math.min(index - 1, 4)
                end
                for _, it in ipairs(items) do
                    it.level = levels[it.indent] or 0
                end
                table.insert(blocks, { type = "list", items = items })
            else
                para = para or {}
                table.insert(para, line)
                i += 1
            end
        end
        flush()
        return blocks
    end

    ---------------------------------------------------------------------
    -- Rendering
    ---------------------------------------------------------------------
    local function richLabel(parent, rich, props)
        props = props or {}
        return create("TextLabel", {
            Name = props.Name or "Text",
            Size = props.Size or UDim2.new(1, 0, 0, 0),
            Position = props.Position or UDim2.new(),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Text = rich,
            RichText = true,
            TextWrapped = true,
            TextColor3 = props.color or THEME.Text,
            Font = props.font or Enum.Font.Gotham,
            TextSize = props.size or BODY_SIZE,
            TextXAlignment = props.align or Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            LayoutOrder = props.order or 0,
            ZIndex = props.ZIndex or 64,
        }, parent)
    end

    local BULLETS = { "•", "◦", "▪", "•", "◦" }
    local HEADING_SIZE = { 18, 16, 14, 13, 13, 12 }

    local function renderList(parent, block, order, z)
        local list = create("Frame", {
            Name = "List",
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            LayoutOrder = order,
            ZIndex = z,
        }, parent)
        create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, list)
        for index, item in ipairs(block.items) do
            local indent = item.level * 16
            local markerWidth = item.number and math.max(18, 7 * #item.number + 6) or 14
            local row = create("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                LayoutOrder = index,
                ZIndex = z,
            }, list)
            if item.isTask then
                Icons.image(row, item.task and "square-check" or "square", {
                    Size = UDim2.fromOffset(13, 13),
                    Position = UDim2.fromOffset(indent, 2),
                    color = item.task and THEME.Good or THEME.TextDim,
                    ZIndex = z + 1,
                })
                markerWidth = 18
            else
                create("TextLabel", {
                    Position = UDim2.fromOffset(indent, 0),
                    Size = UDim2.fromOffset(markerWidth, 16),
                    BackgroundTransparency = 1,
                    Text = item.number and (item.number .. ".") or BULLETS[item.level + 1],
                    TextColor3 = item.number and THEME.TextDim or THEME.Accent:Lerp(THEME.Text, 0.35),
                    Font = item.number and Enum.Font.GothamMedium or Enum.Font.GothamBold,
                    TextSize = BODY_SIZE,
                    TextXAlignment = item.number and Enum.TextXAlignment.Right or Enum.TextXAlignment.Center,
                    TextYAlignment = Enum.TextYAlignment.Top,
                    ZIndex = z + 1,
                }, row)
            end
            local textX = indent + markerWidth + 6
            local rich = Markdown.inline(item.text)
            if item.isTask and item.task then
                rich = ('<font color="%s">%s</font>'):format(DIM, rich)
            end
            richLabel(row, rich, {
                Position = UDim2.fromOffset(textX, 0),
                Size = UDim2.new(1, -textX, 0, 0),
                ZIndex = z + 1,
            })
        end
    end

    local function renderTable(parent, block, order, z)
        local columns = 0
        for _, r in ipairs(block.rows) do
            columns = math.max(columns, #r)
        end
        columns = math.max(columns, 1)
        local holder = create("Frame", {
            Name = "Table",
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = THEME.Stroke,
            BorderSizePixel = 0,
            LayoutOrder = order,
            ZIndex = z,
        }, parent)
        create("UICorner", { CornerRadius = UDim.new(0, 5) }, holder)
        create("UIPadding", {
            PaddingTop = UDim.new(0, 1), PaddingBottom = UDim.new(0, 1),
            PaddingLeft = UDim.new(0, 1), PaddingRight = UDim.new(0, 1),
        }, holder)
        create("UIListLayout", { Padding = UDim.new(0, 1), SortOrder = Enum.SortOrder.LayoutOrder }, holder)
        local alignMap = {
            left = Enum.TextXAlignment.Left,
            center = Enum.TextXAlignment.Center,
            right = Enum.TextXAlignment.Right,
        }
        for rIndex, cells in ipairs(block.rows) do
            local header = (rIndex == 1)
            local row = create("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = header and THEME.Control or ((rIndex % 2 == 0) and THEME.CodeBg or Color3.fromRGB(26, 26, 31)),
                BorderSizePixel = 0,
                LayoutOrder = rIndex,
                ZIndex = z + 1,
            }, holder)
            if rIndex == 1 or rIndex == #block.rows then
                create("UICorner", { CornerRadius = UDim.new(0, 4) }, row)
            end
            create("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal,
                SortOrder = Enum.SortOrder.LayoutOrder,
            }, row)
            for c = 1, columns do
                local cellText = cells[c] or ""
                local rich = Markdown.inline(cellText, 12)
                if header then
                    rich = "<b>" .. rich .. "</b>"
                end

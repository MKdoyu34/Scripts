-- PROVIDER ADAPTERS: build(ctx) -> url, headers, body ; parse(data) -> result
-- result = { text, calls = {{id, nativeId?, name, args}}, raw, thoughts, err }
---------------------------------------------------------------------------
local Adapters = {}

-- Gemini ------------------------------------------------------------------
local function cleanGeminiParts(parts, keepSignedThoughts)
    local out = {}
    for _, part in ipairs(type(parts) == "table" and parts or {}) do
        if type(part) == "table" and (part.thought ~= true or (keepSignedThoughts and part.thoughtSignature ~= nil)) then
            local copy = deepCopy(part)
            if type(copy.functionCall) == "table" and type(copy.functionCall.args) == "table"
                and next(copy.functionCall.args) == nil then
                copy.functionCall.args = nil   -- {} would encode as []
            end
            table.insert(out, copy)
        end
    end
    return out
end

Adapters.gemini = {
    build = function(ctx)
        local contents = {}
        for _, item in ipairs(ctx.items) do
            if item.kind == "text" then
                local last = contents[#contents]
                if item.nudge and last and last.role == "user" then
                    table.insert(last.parts, { text = item.text })
                else
                    table.insert(contents, {
                        role = (item.role == "model") and "model" or "user",
                        parts = { { text = item.text } },
                    })
                end
            elseif item.kind == "raw" then
                local parts = cleanGeminiParts(item.entry.raw, ctx.compat.keepThoughtParts)
                if #parts > 0 then
                    table.insert(contents, { role = "model", parts = parts })
                end
            elseif item.kind == "results" then
                local parts = {}
                for _, tr in ipairs(item.entry.toolResults) do
                    local response = {
                        name = tostring(tr.name),
                        response = { result = tostring(tr.response or "") },
                    }
                    if tr.nativeId ~= nil then
                        response.id = tr.nativeId
                    end
                    table.insert(parts, { functionResponse = response })
                end
                if #parts > 0 then
                    table.insert(contents, { role = "user", parts = parts })
                end
            end
        end
        local gen = {}
        if not ctx.compat.noTemperature then
            gen.temperature = ctx.temperature
        end
        if ctx.think then
            gen.thinkingConfig = ctx.think
        end
        local body = {
            systemInstruction = { parts = { { text = ctx.system } } },
            contents = contents,
        }
        if next(gen) ~= nil then
            body.generationConfig = gen
        end
        if ctx.tools then
            local decls = {}
            for _, d in ipairs(toolDeclarationList()) do
                local decl = { name = d.name, description = d.description }
                if type(d.parameters) == "table" then
                    decl.parameters = d.parameters   -- Gemini rejects empty OBJECT schemas
                end
                table.insert(decls, decl)
            end
            if #decls > 0 then
                body.tools = { { functionDeclarations = decls } }
                if ctx.toolMode == "none" then
                    body.toolConfig = { functionCallingConfig = { mode = "NONE" } }
                end
            end
        end
        local model = tostring(ctx.model):gsub("^models/", "")
        return ("%s/models/%s:generateContent"):format(ctx.base, model), ctx.headers, body
    end,

    parse = function(data)
        local apiErr = apiErrorText(data)
        if apiErr then
            return { err = apiErr }
        end
        local feedback = data.promptFeedback
        if type(feedback) == "table" and type(feedback.blockReason) == "string" then
            return { err = "Blocked by safety filter: " .. feedback.blockReason }
        end
        local cands = data.candidates
        if type(cands) ~= "table" or type(cands[1]) ~= "table" then
            return { err = "No candidates returned." }
        end
        local chunks, calls, thoughts, raw = {}, {}, {}, nil
        local content = cands[1].content
        if type(content) == "table" and type(content.parts) == "table" then
            raw = content.parts
            for _, part in ipairs(content.parts) do
                if type(part) == "table" then
                    if part.thought == true then
                        if type(part.text) == "string" and part.text:match("%S") then
                            table.insert(thoughts, part.text)
                        end
                    elseif type(part.text) == "string" then
                        table.insert(chunks, part.text)
                    elseif type(part.functionCall) == "table" then
                        local fc = part.functionCall
                        if type(fc.name) == "string" and fc.name ~= "" then
                            table.insert(calls, {
                                id = fc.id or newCallId(),
                                nativeId = fc.id,
                                name = fc.name,
                                args = (type(fc.args) == "table" and fc.args) or {},
                            })
                        end
                    end
                end
            end
        end
        if #chunks == 0 and #calls == 0 then
            local reason = cands[1].finishReason
            return { err = "Empty response" .. (reason and (" (" .. tostring(reason) .. ")") or "") }
        end
        return {
            text = table.concat(chunks, ""),
            calls = calls,
            raw = raw,
            thoughts = table.concat(thoughts, "\n\n"),
        }
    end,
}

-- Anthropic ---------------------------------------------------------------
local function cleanAnthropicBlocks(blocks)
    local out = {}
    for _, block in ipairs(type(blocks) == "table" and blocks or {}) do
        if type(block) == "table" then
            local kind = block.type
            if kind == "text" then
                if type(block.text) == "string" and block.text:match("%S") then
                    table.insert(out, { type = "text", text = block.text })
                end
            elseif kind == "thinking" then
                table.insert(out, { type = "thinking", thinking = block.thinking or "", signature = block.signature })
            elseif kind == "redacted_thinking" then
                table.insert(out, { type = "redacted_thinking", data = block.data })
            elseif kind == "tool_use" then
                local input = deepCopy(block.input)
                if type(input) ~= "table" or next(input) == nil then
                    input = JSON_EMPTY_OBJECT
                end
                table.insert(out, { type = "tool_use", id = block.id, name = block.name, input = input })
            end
        end
    end
    return out
end

Adapters.anthropic = {
    build = function(ctx)
        local messages = {}
        local function push(role, block)
            local last = messages[#messages]
            if last and last.role == role then
                table.insert(last.content, block)
            else
                table.insert(messages, { role = role, content = { block } })
            end
        end
        for _, item in ipairs(ctx.items) do
            if item.kind == "text" then
                push((item.role == "model") and "assistant" or "user", { type = "text", text = item.text })
            elseif item.kind == "raw" then
                local blocks = cleanAnthropicBlocks(item.entry.raw)
                if #blocks == 0 then
                    blocks = { { type = "text", text = "(no text)" } }
                end
                for _, block in ipairs(blocks) do
                    push("assistant", block)
                end
            elseif item.kind == "results" then
                for _, tr in ipairs(item.entry.toolResults) do
                    local text = tostring(tr.response or "")
                    if text == "" then text = "ok" end
                    local block = { type = "tool_result", tool_use_id = tr.id, content = text }
                    if text:match("^ERROR") then
                        block.is_error = true
                    end
                    push("user", block)
                end
            end
        end
        local maxTokens = ctx.compat.maxTokens or CONFIG.MaxOutputTokens
        local body = {
            model = ctx.model,
            max_tokens = maxTokens,
            system = ctx.system,
            messages = messages,
        }
        local think = ctx.think
        if think then
            local cfg
            if think.mode == "adaptive" then
                cfg = { type = "adaptive" }
            else
                cfg = {
                    type = "enabled",
                    budget_tokens = math.max(1024, math.min(think.budget or 8000, maxTokens - 1024)),
                }
            end
            if not ctx.compat.noDisplay then
                cfg.display = "summarized"   -- Opus 4.7+ hides thinking unless asked
            end
            body.thinking = cfg
            if think.mode == "adaptive" and think.effort and not ctx.compat.noEffort then
                body.output_config = { effort = think.effort }
            end
        elseif not ctx.compat.noTemperature then
            body.temperature = math.clamp(ctx.temperature, 0, 1)
        end
        if ctx.tools then
            local tools = {}
            for _, d in ipairs(toolDeclarationList()) do
                table.insert(tools, {
                    name = d.name,
                    description = d.description,
                    input_schema = objectSchema(d.parameters),
                })
            end
            if #tools > 0 then
                body.tools = tools
                if ctx.toolMode == "none" then
                    body.tool_choice = { type = "none" }
                end
            end
        end
        return ctx.base .. "/messages", ctx.headers, body
    end,

    parse = function(data)
        local apiErr = apiErrorText(data)
        if apiErr then
            return { err = apiErr }
        end
        if type(data.content) ~= "table" then
            return { err = "Malformed response (no content)." }
        end
        local chunks, calls, thoughts = {}, {}, {}
        for _, block in ipairs(data.content) do
            if type(block) == "table" then
                if block.type == "text" and type(block.text) == "string" then
                    table.insert(chunks, block.text)
                elseif block.type == "thinking" then
                    if type(block.thinking) == "string" and block.thinking:match("%S") then
                        table.insert(thoughts, block.thinking)
                    end
                elseif block.type == "redacted_thinking" then
                    table.insert(thoughts, "(part of the reasoning was redacted by the provider)")
                elseif block.type == "tool_use" and type(block.name) == "string" then
                    if type(block.id) ~= "string" or block.id == "" then
                        block.id = newCallId()
                    end
                    table.insert(calls, {
                        id = block.id,
                        name = block.name,
                        args = (type(block.input) == "table" and block.input) or {},
                    })
                end
            end
        end
        if #chunks == 0 and #calls == 0 then
            local reason = data.stop_reason
            if reason == "refusal" then
                return { err = "The model declined this request (stop_reason: refusal)." }
            end
            if reason ~= "end_turn" then
                return { err = "Empty response" .. (reason and (" (" .. tostring(reason) .. ")") or "") }
            end
        end
        return {
            text = table.concat(chunks, ""),
            calls = calls,
            raw = data.content,
            thoughts = table.concat(thoughts, "\n\n"),
        }
    end,
}

-- OpenAI Responses API ------------------------------------------------------
Adapters.openai_responses = {
    build = function(ctx)
        local input = {}
        for _, item in ipairs(ctx.items) do
            if item.kind == "text" then
                table.insert(input, {
                    role = (item.role == "model") and "assistant" or "user",
                    content = item.text,
                })
            elseif item.kind == "raw" then
                for _, outItem in ipairs(type(item.entry.raw) == "table" and item.entry.raw or {}) do
                    if type(outItem) == "table" and type(outItem.type) == "string" then
                        local copy = deepCopy(outItem)
                        if copy.type ~= "reasoning" then
                            copy.id = nil       -- not persisted with store=false
                            copy.status = nil
                        end
                        table.insert(input, copy)
                    end
                end
            elseif item.kind == "results" then
                for _, tr in ipairs(item.entry.toolResults) do
                    table.insert(input, {
                        type = "function_call_output",
                        call_id = tr.id,
                        output = tostring(tr.response or ""),
                    })
                end
            end
        end
        local body = {
            model = ctx.model,
            instructions = ctx.system,
            input = input,
        }
        if not ctx.compat.noInclude then
            -- Stateless: reasoning comes back encrypted so it can be replayed.
            body.store = false
            body.include = { "reasoning.encrypted_content" }
        end
        if ctx.think then
            local reasoning = {}
            if ctx.think.effort then
                reasoning.effort = ctx.think.effort
            end
            if ctx.think.summary and not ctx.compat.noSummary then
                reasoning.summary = ctx.think.summary
            end
            if next(reasoning) ~= nil then
                body.reasoning = reasoning
            end
        end
        if not ctx.compat.noTemperature then
            body.temperature = ctx.temperature
        end
        if ctx.tools then
            local tools = {}
            for _, d in ipairs(toolDeclarationList()) do
                table.insert(tools, {
                    type = "function",
                    name = d.name,
                    description = d.description,
                    parameters = objectSchema(d.parameters),
                    strict = false,
                })
            end
            if #tools > 0 then
                body.tools = tools
                if ctx.toolMode == "none" then
                    body.tool_choice = "none"
                end
            end
        end
        return ctx.base .. "/responses", ctx.headers, body
    end,

    parse = function(data)
        local apiErr = apiErrorText(data)
        if apiErr then
            return { err = apiErr }
        end
        local output = data.output
        if type(output) ~= "table" then
            return { err = "Malformed response (no output)." }
        end
        local chunks, calls, thoughts = {}, {}, {}
        for _, item in ipairs(output) do
            if type(item) == "table" then
                if item.type == "reasoning" then
                    for _, s in ipairs(type(item.summary) == "table" and item.summary or {}) do
                        if type(s) == "table" and type(s.text) == "string" and s.text:match("%S") then
                            table.insert(thoughts, s.text)
                        end
                    end
                    for _, c in ipairs(type(item.content) == "table" and item.content or {}) do
                        if type(c) == "table" and type(c.text) == "string" and c.text:match("%S") then
                            table.insert(thoughts, c.text)
                        end
                    end
                elseif item.type == "message" then
                    for _, c in ipairs(type(item.content) == "table" and item.content or {}) do
                        if type(c) == "table" then
                            if c.type == "output_text" and type(c.text) == "string" then
                                table.insert(chunks, c.text)
                            elseif c.type == "refusal" and type(c.refusal) == "string" then
                                table.insert(chunks, c.refusal)
                            end
                        end
                    end
                elseif item.type == "function_call" and type(item.name) == "string" then
                    if type(item.call_id) ~= "string" or item.call_id == "" then
                        item.call_id = newCallId()
                    end
                    table.insert(calls, {
                        id = item.call_id,
                        name = item.name,
                        args = jsonDecode(item.arguments) or {},
                    })
                end
            end
        end
        if #chunks == 0 and #calls == 0 then
            local reason = (type(data.incomplete_details) == "table" and data.incomplete_details.reason) or data.status
            return { err = "Empty response" .. (reason and (" (" .. tostring(reason) .. ")") or "") }
        end
        return {
            text = table.concat(chunks, ""),
            calls = calls,
            raw = output,
            thoughts = table.concat(thoughts, "\n\n"),
        }
    end,
}

-- OpenAI-compatible Chat Completions (OpenRouter, Groq, DeepSeek, Ollama...) --
local function splitThinkTags(content)
    if type(content) ~= "string" then
        return "", nil
    end
    local found = {}
    local cleaned = content:gsub("<think>(.-)</think>", function(inner)
        table.insert(found, inner)
        return ""
    end)
    cleaned = cleaned:gsub("^%s+", "")
    return cleaned, (#found > 0) and table.concat(found, "\n\n") or nil
end

Adapters.openai_chat = {
    build = function(ctx)
        local messages = { { role = "system", content = ctx.system } }
        for _, item in ipairs(ctx.items) do
            if item.kind == "text" then
                table.insert(messages, {
                    role = (item.role == "model") and "assistant" or "user",
                    content = item.text,
                })
            elseif item.kind == "raw" then
                local raw = type(item.entry.raw) == "table" and item.entry.raw or {}
                local msg = { role = "assistant", content = (type(raw.content) == "string" and raw.content) or "" }
                if type(raw.tool_calls) == "table" and #raw.tool_calls > 0 then
                    msg.tool_calls = deepCopy(raw.tool_calls)
                end
                if ctx.compat.sendReasoning and type(raw.reasoning_content) == "string" then
                    msg.reasoning_content = raw.reasoning_content
                end
                table.insert(messages, msg)
            elseif item.kind == "results" then
                for _, tr in ipairs(item.entry.toolResults) do
                    table.insert(messages, {
                        role = "tool",
                        tool_call_id = tr.id,
                        content = tostring(tr.response or ""),
                    })
                end
            end
        end
        local body = { model = ctx.model, messages = messages }
        if not ctx.compat.noTemperature then
            body.temperature = ctx.temperature
        end
        if ctx.think and ctx.think.reasoning_effort then
            body.reasoning_effort = ctx.think.reasoning_effort
        end
        if ctx.tools then
            local tools = {}
            for _, d in ipairs(toolDeclarationList()) do
                table.insert(tools, {
                    type = "function",
                    ["function"] = {
                        name = d.name,
                        description = d.description,
                        parameters = objectSchema(d.parameters),
                    },
                })
            end
            if #tools > 0 then
                body.tools = tools
                if ctx.toolMode == "none" then
                    body.tool_choice = "none"
                end
            end
        end
        return ctx.base .. "/chat/completions", ctx.headers, body
    end,

    parse = function(data)
        local apiErr = apiErrorText(data)
        if apiErr then
            return { err = apiErr }
        end
        local choice = (type(data.choices) == "table") and data.choices[1] or nil
        if type(choice) ~= "table" or type(choice.message) ~= "table" then
            return { err = "No choices returned." }
        end
        local msg = choice.message
        local content = msg.content
        if type(content) == "table" then
            local pieces = {}
            for _, p in ipairs(content) do
                if type(p) == "table" and type(p.text) == "string" then
                    table.insert(pieces, p.text)
                end
            end
            content = table.concat(pieces, "")
        elseif type(content) ~= "string" then
            content = ""
        end
        local thoughts = {}
        local reasoning = msg.reasoning_content
        if type(reasoning) ~= "string" then
            reasoning = msg.reasoning
        end
        if type(reasoning) == "string" and reasoning:match("%S") then
            table.insert(thoughts, reasoning)
        elseif type(msg.reasoning_details) == "table" then
            for _, detail in ipairs(msg.reasoning_details) do
                if type(detail) == "table" then
                    local t = detail.text or detail.summary
                    if type(t) == "string" and t:match("%S") then
                        table.insert(thoughts, t)
                    end
                end
            end
        end
        local cleaned, tagged = splitThinkTags(content)
        if tagged then
            table.insert(thoughts, tagged)
        end
        local calls, toolCalls = {}, {}
        for _, tc in ipairs(type(msg.tool_calls) == "table" and msg.tool_calls or {}) do
            local fn = (type(tc) == "table") and tc["function"] or nil
            if type(fn) == "table" and type(fn.name) == "string" and fn.name ~= "" then
                local id = (type(tc.id) == "string" and tc.id ~= "") and tc.id or newCallId()
                local argsText, args
                if type(fn.arguments) == "table" then
                    args = fn.arguments
                    argsText = (next(args) == nil) and "{}" or (jsonEncode(args) or "{}")
                else
                    argsText = (type(fn.arguments) == "string" and fn.arguments ~= "") and fn.arguments or "{}"
                    args = jsonDecode(argsText) or {}
                end
                table.insert(toolCalls, { id = id, type = "function", ["function"] = { name = fn.name, arguments = argsText } })
                table.insert(calls, { id = id, name = fn.name, args = args })
            end
        end
        if not cleaned:match("%S") and #calls == 0 then
            local reason = choice.finish_reason
            return { err = "Empty response" .. (reason and (" (" .. tostring(reason) .. ")") or "") }
        end
        return {
            text = cleaned,
            calls = calls,
            raw = {
                content = cleaned,
                tool_calls = (#toolCalls > 0) and toolCalls or nil,
                reasoning_content = (type(reasoning) == "string") and reasoning or nil,
            },
            thoughts = table.concat(thoughts, "\n\n"),
        }
    end,
}


local cachedGameName = nil
task.spawn(function()
    local ok, info = pcall(function()
        return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    end)
    if ok and type(info) == "table" and type(info.Name) == "string" then
        cachedGameName = info.Name
    end
end)

local function yesNo(flag)
    return flag and "yes" or "no"
end

local function buildGameContext(full)
    local lines = {}
    local function section(fn)
        local ok, line = pcall(fn)
        if ok and type(line) == "string" and line ~= "" then
            table.insert(lines, line)
        end
    end
    section(function()
        return ("Game: %s  (PlaceId %s, GameId %s)"):format(
            cachedGameName or "name unknown", tostring(game.PlaceId), tostring(game.GameId))
    end)
    section(function()
        return ("Server: %d/%d players%s"):format(#Players:GetPlayers(), Players.MaxPlayers,
            full and ("  ·  JobId " .. tostring(game.JobId)) or "")
    end)
    section(function()
        local team = LocalPlayer.Team
        return ("You: %s (@%s, UserId %s)%s"):format(LocalPlayer.DisplayName, LocalPlayer.Name,
            tostring(LocalPlayer.UserId), team and ("  ·  Team " .. team.Name) or "")
    end)
    section(function()
        local hum, root = getHumanoid(), getRoot()
        if not hum and not root then
            return "Character: (not spawned)"
        end
        local bits = {}
        if hum then
            table.insert(bits, "Health " .. fmtNum(hum.Health) .. "/" .. fmtNum(hum.MaxHealth))
            table.insert(bits, "WalkSpeed " .. fmtNum(hum.WalkSpeed))
            if hum.UseJumpPower then
                table.insert(bits, "JumpPower " .. fmtNum(hum.JumpPower))
            else
                table.insert(bits, "JumpHeight " .. fmtNum(hum.JumpHeight))
            end
            if full then
                table.insert(bits, "RigType " .. hum.RigType.Name)
            end
        end
        if root then
            table.insert(bits, "Position " .. fmtVec3(root.Position))
        end
        return "Character: " .. table.concat(bits, "  ·  ")
    end)
    section(function()
        local cam = workspace.CurrentCamera
        if not cam then return nil end
        return ("Camera: Position %s  ·  FOV %s"):format(fmtVec3(cam.CFrame.Position), fmtNum(cam.FieldOfView))
    end)
    section(function()
        local guis = {}
        for _, child in ipairs(PlayerGui:GetChildren()) do
            if child:IsA("LayerCollector") then
                table.insert(guis, child.Name .. ((child.Enabled == false) and " (disabled)" or ""))
            end
        end
        local shown = {}
        for i = 1, math.min(#guis, 30) do
            shown[i] = guis[i]
        end
        return ("PlayerGui ScreenGuis (%d): %s%s"):format(#guis,
            (#shown > 0) and table.concat(shown, ", ") or "none",
            (#guis > #shown) and ", ..." or "")
    end)
    section(function()
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        local tools = {}
        local character = LocalPlayer.Character
        if character then
            local held = character:FindFirstChildOfClass("Tool")
            if held then
                table.insert(tools, held.Name .. " (equipped)")
            end
        end
        if backpack then
            for _, child in ipairs(backpack:GetChildren()) do
                if child:IsA("Tool") and #tools < 20 then
                    table.insert(tools, child.Name)
                end
            end
        end
        return "Tools: " .. ((#tools > 0) and table.concat(tools, ", ") or "none")
    end)
    if full then
        section(function()
            local lighting = game:GetService("Lighting")
            return ("World: Gravity %s  ·  ClockTime %s  ·  Workspace children %d  ·  StreamingEnabled %s"):format(
                fmtNum(workspace.Gravity), fmtNum(lighting.ClockTime), #workspace:GetChildren(),
                tostring(readProp(workspace, "StreamingEnabled")))
        end)
    end
    section(function()
        return ("Executor: %s  (http %s · files %s · clipboard %s · loadstring %s)"):format(
            Executor.name, yesNo(Executor.http), yesNo(FS.writefile and FS.readfile),
            yesNo(Executor.clipboard), yesNo(Executor.loadstring))
    end)
    section(function()
        return "Local time: " .. os.date("%Y-%m-%d %H:%M")
    end)
    return table.concat(lines, "\n")
end

-- //////////////////////////////////////////////////////////////////////////
-- BUILT-IN TOOLS — real Luau functions registered for (any provider's) function
-- calling. The model emits functionCall(name, args); we look the name up in
-- AI_TOOLS, RUN it, and feed the result back so the model can continue.
-- //////////////////////////////////////////////////////////////////////////

local AI_TOOLS = {}

local function registerTool(name, description, parameters, runFn)
    AI_TOOLS[name] = {
        description = description,
        parameters  = parameters,
        run         = runFn,
    }
end

local function strParam(description)
    return { type = "string", description = description }
end

local function findTarget(args, key)
    key = key or "path"
    local path = trim(args[key] or args.instance or "")
    if path == "" then
        return nil, "ERROR: missing '" .. key .. "' (e.g. 'Workspace/Baseplate'). Use list_children or search_instances first."
    end
    local inst = resolvePath(path)
    if not inst then
        return nil, "ERROR: no instance at '" .. path .. "'. Use list_children / search_instances to find the exact path."
    end
    if isOwnGui(inst) then
        return nil, "ERROR: '" .. path .. "' is the chatbot's own interface — off limits."
    end
    return inst, nil
end

local function isProtectedInstance(inst)
    if inst == game or inst == LocalPlayer or inst == PlayerGui or inst == workspace then
        return true
    end
    if inst == workspace.CurrentCamera or inst == workspace:FindFirstChildOfClass("Terrain") then
        return true
    end
    local parentIsGame = false
    pcall(function() parentIsGame = (inst.Parent == game) end)
    if parentIsGame then
        return true
    end
    return inst.Parent == LocalPlayer and (inst:IsA("Backpack") or inst.Name == "PlayerScripts")
end

local function clip(text, limit)
    text = tostring(text)
    if #text > limit then
        return text:sub(1, limit) .. ("\n... (truncated — %d chars total)"):format(#text)
    end
    return text
end


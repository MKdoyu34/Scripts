-- Color3 | "#RRGGBB" | "r,g,b" | {r,g,b} → Color3 (nil = default colour).
function Providers.parseColor(value)
    if typeof(value) == "Color3" then
        return value
    end
    if type(value) == "string" then
        local hex = value:gsub("^%s*#", ""):gsub("%s+$", "")
        if hex:match("^%x%x%x%x%x%x$") then
            local ok, c = pcall(Color3.fromHex, hex)
            if ok then return c end
        end
        local r, g, b = value:match("^%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*$")
        if r then
            return Color3.fromRGB(math.clamp(tonumber(r), 0, 255), math.clamp(tonumber(g), 0, 255), math.clamp(tonumber(b), 0, 255))
        end
    elseif type(value) == "table" then
        local r, g, b = tonumber(value.r or value[1]), tonumber(value.g or value[2]), tonumber(value.b or value[3])
        if r and g and b then
            return Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255))
        end
    end
    return nil
end

function Providers.subtitle(def)
    if def.subtitle then
        return def.subtitle
    end
    local host = tostring(def.baseUrl or ""):match("^%a+://([^/]+)") or ""
    return formatInfo(def.format).short .. ((host ~= "") and ("  ·  " .. host) or "")

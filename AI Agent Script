local function fetchModels(providerId, silent)
    local def = Providers.get(providerId or AI.settings.provider)
    if not def then
        return false
    end
    if not canFetch(def) then
        if not silent then
            if Providers.baseUrl(def) == "" then
                notify(def.name .. " has no Base URL — edit the provider first.", "warn", 3.5)
            else
                notify(("Paste your %s API key first."):format(def.name), "warn", 3)
            end
        end
        return false
    end
    if AI.fetching[def.id] then
        return true
    end
    AI.fetching[def.id] = true
    refreshModelControls()
    task.spawn(function()
        local okFetch, list, failure = pcall(fetchModelList, def)
        if not okFetch then
            list, failure = {}, tostring(list)
        end
        AI.fetching[def.id] = nil
        local isActive = (Providers.active().id == def.id)
        if failure and #list == 0 then
            AI.models[def.id] = nil
            if AI.openModelsWhenReady == def.id then
                AI.openModelsWhenReady = nil
            end
            if not silent then
                notify(("%s model fetch failed: %s"):format(def.name, redactSecrets(failure)), "error", 5)
            end
            if isActive then refreshModelControls() end
            return
        end
        AI.models[def.id] = list
        local current = Providers.model(def.id)
        if current and #list > 0 and not silent then
            local listed = false
            for _, entry in ipairs(list) do
                if entry.id == current then
                    listed = true
                    break
                end
            end
            if not listed then
                notify(("'%s' isn't in %s's list — pick another model if requests fail."):format(current, def.name), "warn", 4.5)
            end
        end
        if isActive then
            refreshModelControls()
            refreshStatusLabel()
        end
        refreshProviderCards()
        if #list == 0 then
            notify(def.name .. " answered but returned no models — type a model id manually.", "warn", 4.5)
        elseif not silent then
            notify(("Fetched %d model(s) from %s."):format(#list, def.name), "success", 2.5)
        end
        if AI.openModelsWhenReady == def.id then
            AI.openModelsWhenReady = nil
            if isActive and #list > 0 and AI.openModelList and W.settingsView.Visible then
                AI.openModelList()
                return
            end
        end
        if not current and #list > 0 and isActive then
            notify("Now pick a model — click Select Model in Settings.", "info", 4)
        end
    end)
    return true
end

local function selectProvider(id)
    local def = Providers.get(id)
    if not def then return end
    if AI.settings.provider ~= id then
        AI.settings.provider = id
        saveSettings()
        notify("Provider: " .. def.name, "info", 2)
    end
    refreshSettingsUi()
    if canFetch(def) and AI.models[id] == nil and not AI.fetching[id] then
        fetchModels(id, true)
    end
end


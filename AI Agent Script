function Icons.normalize(name)
    local s = tostring(name or ""):lower()
    s = s:gsub("^%s+", ""):gsub("%s+$", "")
    s = s:gsub("^lucide[:%-/]", "")
    s = s:gsub("[%s_]+", "-")
    return s
end

-- Accepts a Lucide name, "rbxassetid://123", "rbxthumb://..." or a bare id.
function Icons.id(name)
    local raw = tostring(name or "")
    if raw:match("^rbxassetid://%d+$") or raw:match("^rbxthumb://") or raw:match("^rbxasset://") then
        return raw
    end
    if raw:match("^%d+$") then
        return "rbxassetid://" .. raw
    end
    local key = Icons.normalize(raw)
    local embedded = Icons.ids[key]
    if embedded then
        return "rbxassetid://" .. tostring(embedded)
    end
    if Icons.full and Icons.full[key] then
        return Icons.full[key]
    end
    return nil
end

local function httpGetText(url)
    local ok, body = pcall(function() return game:HttpGet(url, true) end)
    if ok and type(body) == "string" and #body > 0 then
        return body
    end
    if Executor.http then
        local okReq, res = pcall(Executor.http, { Url = url, Method = "GET" })
        if okReq and type(res) == "table" then
            local text = res.Body or res.body
            if type(text) == "string" and #text > 0 then
                return text
            end
        end
    end
    return nil
end

-- Fetches the full Lucide map once; callbacks run when it's ready (or failed).
function Icons.loadFull(callback)
    if Icons.full or Icons.failed then
        if callback then task.spawn(callback, Icons.full ~= nil) end
        return
    end
    if callback then table.insert(Icons.waiters, callback) end
    if Icons.loading then return end
    Icons.loading = true
    task.spawn(function()
        local map, count = {}, 0
        for _, url in ipairs(CONFIG.LucideSources) do
            local src = httpGetText(url)
            if src then
                for iconName, assetId in src:gmatch('%["([%w%-_]+)"%]%s*=%s*"(rbxassetid://%d+)"') do
                    map[iconName] = assetId
                    count += 1
                end
                if count > 0 then break end
            end
        end
        Icons.loading = false
        if count > 0 then
            Icons.full = map
        else
            Icons.failed = true
        end
        local waiting = Icons.waiters
        Icons.waiters = {}
        for _, cb in ipairs(waiting) do
            task.spawn(cb, Icons.full ~= nil)
        end
    end)
end

-- LETTER ICONS (provider icons only): 1-2 characters — "N", "n", "AI", "7"
-- or an emoji — are drawn as text in the icon's colour. UI icons never opt
-- in, so names like "x" keep their real icon everywhere else.
function Icons.glyph(name)
    local raw = trim(tostring(name or ""))
    local len = utf8.len(raw)
    if len and len >= 1 and len <= 2 then
        return raw
    end
    return nil
end

function Icons.setGlyph(img, text)
    local label = img:FindFirstChild("Glyph")
    if text == nil then
        if label then label.Visible = false end
        return
    end
    if not label then
        label = create("TextLabel", {
            Name = "Glyph",
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Font = Enum.Font.GothamBlack,
            TextScaled = true,
            TextColor3 = img.ImageColor3,
            Text = "",
            ZIndex = img.ZIndex,
        }, img)
        img:GetPropertyChangedSignal("ImageColor3"):Connect(function()
            label.TextColor3 = img.ImageColor3
        end)
    end
    label.Text = text
    label.Visible = true
end

-- "brain-circuit" → "Brain Circuit" (icon dropdown labels).
function Icons.pretty(name)
    local s = tostring(name or ""):gsub("[%-_]+", " ")
    return (s:gsub("(%a)([%w]*)", function(first, rest) return first:upper() .. rest end))
end

-- Points an ImageLabel/ImageButton at an icon. Unknown names fetch the full
-- Lucide map first; if the name still can't be resolved, Icons.fallback is
-- used. Nothing is ever drawn ON the icon (the old version stamped the first
-- letter of the name — e.g. a "B" on the brain — whenever an icon hadn't
-- finished loading after 6 s, which always happened for icons that were
-- hidden at the time, like the ones inside the live "thinking" row).
-- onResolved(found) is optional (the provider editor uses it for its hint).
function Icons.apply(img, name, onResolved, allowGlyph)
    if not img then return end
    -- A token so an older, slower lookup can't overwrite a newer icon.
    local token = (tonumber(img:GetAttribute("IconToken")) or 0) + 1
    pcall(function() img:SetAttribute("IconToken", token) end)
    local glyph = allowGlyph and Icons.glyph(name)
    if glyph then
        img.Image = ""
        Icons.setGlyph(img, glyph)
        if onResolved then task.spawn(onResolved, true) end
        return
    end
    Icons.setGlyph(img, nil)
    local id = Icons.id(name)
    if id then
        img.Image = id
        if onResolved then task.spawn(onResolved, true) end
        return
    end
    img.Image = ""
    Icons.loadFull(function()
        if not img.Parent or img:GetAttribute("IconToken") ~= token then
            return
        end
        local later = Icons.id(name)
        img.Image = later or Icons.id(Icons.fallback) or ""
        if onResolved then onResolved(later ~= nil) end
    end)
end

-- Creates a tinted icon. props: Size, Position, AnchorPoint, color, ZIndex,
-- Rotation, LayoutOrder, Name, Visible, allowGlyph (letter icons).
function Icons.image(parent, name, props)
    props = props or {}
    local img = create("ImageLabel", {
        Name = props.Name or "Icon",
        BackgroundTransparency = 1,
        Size = props.Size or UDim2.fromOffset(16, 16),
        Position = props.Position or UDim2.new(),
        AnchorPoint = props.AnchorPoint or Vector2.zero,
        ImageColor3 = props.color or THEME.Text,
        ScaleType = Enum.ScaleType.Fit,
        Rotation = props.Rotation or 0,
        LayoutOrder = props.LayoutOrder or 0,
        Visible = props.Visible ~= false,
        ZIndex = props.ZIndex or 64,
    }, parent)
    Icons.apply(img, name, nil, props.allowGlyph)
    return img
end

-- The list popup (defined above) uses this for its icon rows.
ListPopup.makeIcon = Icons.image

-- //////////////////////////////////////////////////////////////////////////
-- 3x3 THINKING LOADER
-- The 9 cubes fade in, then light up in a smooth diagonal flow: each cube
-- eases up while its step is active and glides down afterwards, updated
-- every rendered frame (CONFIG.Loader: timing, attack, decay, pop).
-- //////////////////////////////////////////////////////////////////////////

local Loader = { active = {}, conn = nil, cache = nil, cacheSteps = nil }

do
    -- Easing helpers (kept local to this block).
    local function easeOut(x)      -- fast start, soft landing
        return 1 - (1 - x) ^ 3
    end
    local function smooth(x)       -- smoothstep: soft at both ends
        return x * x * (3 - 2 * x)
    end

    function Loader.size(cell, gap)
        local cfg = CONFIG.Loader
        cell = cell or cfg.Cell
        gap = gap or cfg.Gap
        return cell * 3 + gap * 2
    end

    -- Per-cube light windows for one cycle of CONFIG.Loader.Steps:
    --   windows[cube] = { {start, stop}, ... }   cycle = total seconds
    function Loader.timeline()
        local steps = CONFIG.Loader.Steps
        if Loader.cache and Loader.cacheSteps == steps then
            return Loader.cache
        end
        local windows, t = {}, 0
        for i = 1, 9 do
            windows[i] = {}
        end
        for _, step in ipairs(steps) do
            local hold = math.max(0.01, tonumber(step.hold) or 0.125)
            for _, index in ipairs(step.cells or {}) do
                if windows[index] then
                    table.insert(windows[index], { t, t + hold })
                end
            end
            t += hold
        end
        Loader.cache = { windows = windows, cycle = math.max(t, 0.05) }
        Loader.cacheSteps = steps
        return Loader.cache
    end

    -- Brightness (0..1) of one cube `e` seconds into the flow. A cube eases
    -- up while its step is active, then glides back down (Decay) — so each
    -- diagonal leaves a short, soft trail instead of blinking on/off.
    function Loader.level(windows, e, cycle)
        local cfg = CONFIG.Loader
        local attack = math.max(0.001, cfg.Attack or 0.05)
        local decay = math.max(0.001, cfg.Decay or 0.2)
        local base = e - (e % cycle)
        local best = 0
        for back = 0, 1 do               -- this cycle + the tail of the previous one
            local offset = base - back * cycle
            for _, w in ipairs(windows) do
                local s, f = offset + w[1], offset + w[2]
                if s >= 0 and e >= s then
                    local lv
                    if e < f then
                        lv = easeOut(math.min(1, (e - s) / attack))
                    else
                        local peak = easeOut(math.min(1, (f - s) / attack))
                        lv = peak * (1 - smooth(math.min(1, (e - f) / decay)))
                    end
                    if lv > best then
                        best = lv
                    end
                end
            end
        end
        return best
    end

    -- One shared per-frame update for every visible loader (RenderStepped →
    -- updates land exactly once per rendered frame = visibly smooth; the
    -- timing comes from os.clock, so it never drifts like task.wait chains).
    function Loader.step()
        local now = os.clock()
        local tl = Loader.timeline()
        local fadeIn = math.max(0.01, CONFIG.Loader.FadeIn or 0.18)
        for loader in pairs(Loader.active) do
            if not loader.alive or not loader.grid.Parent then
                Loader.active[loader] = nil
            else
                local age = now - loader.started
                if not loader.faded then
                    local f = math.clamp(age / fadeIn, 0, 1)
                    local transparency = 1 - smooth(f)
                    for _, cube in ipairs(loader.cubes) do
                        cube.BackgroundTransparency = transparency
                    end
                    if f >= 1 then
                        loader.faded = true
                    end
                end
                local e = age - fadeIn
                if e > 0 then
                    for i, cube in ipairs(loader.cubes) do
                        local lv = Loader.level(tl.windows[i], e, tl.cycle)
                        if math.abs(lv - loader.levels[i]) > 0.004 then
                            loader.levels[i] = lv
                            cube.BackgroundColor3 = loader.dim:Lerp(loader.lit, lv)
                            if loader.pop > 0 then
                                local px = loader.cell * (1 - loader.pop * (1 - lv))
                                cube.Size = UDim2.fromOffset(px, px)
                            end
                        end
                    end
                end
            end
        end
        if next(Loader.active) == nil and Loader.conn then
            pcall(function() Loader.conn:Disconnect() end)
            Loader.conn = nil
        end
    end

    local function ensureRunning()
        if Loader.conn then return end
        local ok, conn = pcall(function()
            return RunService.RenderStepped:Connect(Loader.step)
        end)
        if not ok or not conn then
            conn = RunService.Heartbeat:Connect(Loader.step)
        end
        Loader.conn = trackConnection(conn)
    end

    -- props: Position, AnchorPoint, ZIndex, LayoutOrder, cell, gap, pop,
    --        litColor, dimColor
    function Loader.new(parent, props)
        props = props or {}
        local cfg = CONFIG.Loader
        local cell = props.cell or cfg.Cell
        local gap = props.gap or cfg.Gap
        local size = Loader.size(cell, gap)
        local z = props.ZIndex or 66

        local grid = create("Frame", {
            Name = "ThinkingLoader",
            Size = UDim2.fromOffset(size, size),
            Position = props.Position or UDim2.new(),
            AnchorPoint = props.AnchorPoint or Vector2.zero,
            BackgroundTransparency = 1,
            LayoutOrder = props.LayoutOrder or 0,
            ZIndex = z,
        }, parent)

        local loader = {
            grid = grid,
            cubes = {},
            levels = {},
            cell = cell,
            pop = math.clamp(tonumber(props.pop or cfg.Pop) or 0, 0, 0.6),
            lit = props.litColor or THEME.Accent,
            dim = props.dimColor or THEME.Control,
            started = os.clock(),
            faded = false,
            alive = true,
        }
        for i = 1, 9 do
            local row, col = math.floor((i - 1) / 3), (i - 1) % 3
            local cube = create("Frame", {
                Name = "Cube" .. i,
                AnchorPoint = Vector2.new(0.5, 0.5),
                -- centred in its slot so an optional "pop" scales from the middle
                Position = UDim2.fromOffset(col * (cell + gap) + cell / 2, row * (cell + gap) + cell / 2),
                Size = UDim2.fromOffset(cell * (1 - loader.pop), cell * (1 - loader.pop)),
                BackgroundColor3 = loader.dim,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                ZIndex = z + 1,
            }, grid)
            create("UICorner", { CornerRadius = UDim.new(0, math.max(1, math.floor(cell / 4))) }, cube)
            loader.cubes[i] = cube
            loader.levels[i] = -1
        end
        if loader.pop == 0 then
            for _, cube in ipairs(loader.cubes) do
                cube.Size = UDim2.fromOffset(cell, cell)
            end
        end

        Loader.active[loader] = true
        ensureRunning()

        return {
            frame = grid,
            size = size,
            destroy = function()
                loader.alive = false
                Loader.active[loader] = nil
                pcall(function() grid:Destroy() end)
            end,
        }
    end
end


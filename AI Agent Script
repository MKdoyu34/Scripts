local Editor = { editingId = nil, format = "openai_chat", deleteArmed = false, color = nil }

local ICON_HINT = "Lucide name, 1-2 letters (e.g. N), or pick one"

local function setIconHint(text, isWarning)
    W.editIconHint.Text = text
    W.editIconHint.TextColor3 = isWarning and THEME.Warn or THEME.TextDim
end

local function previewEditorIcon()
    local name = trim(W.editIcon.Text)
    W.editIconPreview.ImageColor3 = Editor.color or THEME.Custom
    if name == "" then
        Icons.apply(W.editIconPreview, "server")
        setIconHint(ICON_HINT, false)
        return
    end
    if Icons.glyph(name) then
        Icons.apply(W.editIconPreview, name, nil, true)
        setIconHint(("Letter icon \"%s\""):format(name), false)
        return
    end
    Icons.apply(W.editIconPreview, name, function(found)
        if trim(W.editIcon.Text) ~= name then return end   -- user kept typing
        if found then
            setIconHint(ICON_HINT, false)
        else
            setIconHint(("Unknown icon — '%s' will be used"):format(Icons.fallback), true)
        end
    end)
end

-- Dropdown rows read  [icon]  Globe ........ globe  — the icon sits BESIDE
-- the name (separate objects), in the provider's colour.
local function openIconDropdown()
    local raw = trim(W.editIcon.Text)
    local current = Icons.glyph(raw) and raw or Icons.normalize(raw)
    if current == "" then
        current = "server"
    end
    local color = Editor.color or THEME.Custom
    local items, listed = {}, {}
    for _, iconName in ipairs(PROVIDER_ICON_CHOICES) do
        listed[iconName] = true
        table.insert(items, { id = iconName, label = Icons.pretty(iconName), hint = iconName, icon = iconName, iconColor = color })
    end
    -- Letter icon from the provider's name (e.g. "N" for "NovaAI").
    local initial = trim(W.editName.Text):match("^[%w]")
    if initial then
        initial = initial:upper()
        if initial ~= current then
            table.insert(items, 1, { id = initial, label = ("Letter \"%s\""):format(initial), hint = "from the name",
                icon = initial, iconColor = color, allowGlyph = true })
        end
    end
    -- A typed icon / letter that isn't in the list stays selectable at the top.
    if not listed[current] then
        local isGlyph = Icons.glyph(current) ~= nil
        table.insert(items, 1, {
            id = current,
            label = isGlyph and ("Letter \"%s\""):format(current) or Icons.pretty(current),
            hint = "typed",
            icon = current,
            iconColor = color,
            allowGlyph = isGlyph,
            bold = true,
        })
    end
    local pos = W.editIcon.AbsolutePosition
    local pickRight = W.editIconPick.AbsolutePosition.X + W.editIconPick.AbsoluteSize.X
    ListPopup.open(pos, Vector2.new(pickRight - pos.X, W.editIcon.AbsoluteSize.Y),
        items, current, function(id)
            W.editIcon.Text = id   -- the Text-changed signal refreshes the preview
        end, { width = 260 })
end


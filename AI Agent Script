registerTool("find_instance",
    "Read one instance: key properties, attributes and the list of its children.",
    {
        type = "object",
        properties = { path = strParam("Path like 'Workspace/Map/Door' or 'PlayerGui/HUD/Coins'") },
        required = { "path" },
    },
    function(args)
        local inst, err = findTarget(args)
        if err then return err end
        local out = { describeInstance(inst) }
        local okAttr, attrs = pcall(function() return inst:GetAttributes() end)
        if okAttr and type(attrs) == "table" and next(attrs) ~= nil then
            local list = {}
            for name, value in pairs(attrs) do
                table.insert(list, name .. "=" .. fmtValue(value))
            end
            table.sort(list)
            table.insert(out, "Attributes: " .. table.concat(list, ", "))
        end
        local okKids, kids = pcall(function() return inst:GetChildren() end)
        if okKids and #kids > 0 then
            local names = {}
            for i, child in ipairs(kids) do
                if i > 60 then
                    table.insert(names, ("... +%d more"):format(#kids - 60))
                    break
                end
                if not isOwnGui(child) then
                    table.insert(names, child.ClassName .. ":" .. child.Name)
                end
            end
            table.insert(out, ("Children (%d): %s"):format(#kids, table.concat(names, ", ")))
        end
        return table.concat(out, "\n")
    end)


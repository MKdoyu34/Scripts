    end)

registerTool("read_file",
    "Read a text file from the user's workspace. A bare name is enough when it's unique (e.g. 'notes' finds 'docs/notes.md'). Optional start_line / end_line read a slice.",
    {
        type = "object",
        properties = {
            path = strParam("File path relative to the workspace root, e.g. 'notes.md' or 'scripts/fly.lua'"),
            start_line = { type = "integer", description = "First line to return (1-based, optional)" },
            end_line = { type = "integer", description = "Last line to return (optional)" },
        },
        required = { "path" },
    },
    function(args)
        local path, findErr = Files.resolve(args.path or args.name or "")
        if not path then
            return "ERROR: " .. tostring(findErr) .. " Use list_files / search_files to find it."
        end
        local content, readErr = Files.read(path)
        if not content then
            return "ERROR: " .. tostring(readErr)
        end
        if not Files.isText(content) then
            return ("'%s' is a binary file (%s) — it can't be shown as text."):format(path, Files.formatSize(#content))
        end
        local total = Files.lineCount(content)
        local first, last = tonumber(args.start_line), tonumber(args.end_line)
        if first or last then
            first = math.clamp(math.floor(first or 1), 1, total)
            last = math.clamp(math.floor(last or total), first, total)
            local out, n = {}, 0
            for line in (content .. "\n"):gmatch("(.-)\n") do
                n += 1
                if n >= first and n <= last then
                    table.insert(out, line)
                end
                if n > last then break end
            end
            return ("-- %s  (lines %d-%d of %d)\n%s"):format(path, first, last, total, Files.clip(table.concat(out, "\n"), 20000))
        end
        return ("-- %s  (%d lines, %s)\n%s"):format(path, total, Files.formatSize(#content), Files.clip(content, 20000))
    end)

registerTool("write_file",
    "Create a new file or fully overwrite one in the user's workspace (missing folders are created). For small changes to an existing file prefer edit_file.",

            TextXAlignment = Enum.TextXAlignment.Right,
            ZIndex = 66,
        }, live)
        local liveRow = live   -- `live` is cleared by finish(); keep our own ref
        task.spawn(function()
            local t0 = os.clock()
            while liveRow.Parent and step.Parent do
                pcall(function() liveTimer.Text = formatDuration(os.clock() - t0) end)
                task.wait(0.1)
            end
        end)
    else
        task.spawn(function()
            local flip = false
            while pulsing and step.Parent do
                flip = not flip
                pcall(function()
                    dot.BackgroundColor3 = flip and THEME.Accent or THEME.ControlHover
                end)
                task.wait(0.3)
            end
        end)
    end

    -- Details panel (hidden until the arrow is clicked; built lazily).
    local details = create("Frame", {
        Name = "Details",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = THEME.CodeBg,
        BorderSizePixel = 0,
        Visible = false,
        LayoutOrder = 3,
        ZIndex = 65,
    }, step)
    create("UICorner", { CornerRadius = UDim.new(0, 5) }, details)
    create("UIStroke", { Color = THEME.Stroke, Thickness = 1 }, details)
    create("UIPadding", {
        PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
        PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
    }, details)
    create("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, details)

    local sections = {}   -- { title, text, code = bool, dim = bool }
    local built, expanded = false, false

    local function buildDetails()
        for _, child in ipairs(details:GetChildren()) do
            if child:IsA("GuiObject") then
                child:Destroy()
            end
        end
        for index, sec in ipairs(sections) do
            local titleRow = create("Frame", {
                Size = UDim2.new(1, 0, 0, 16),
                BackgroundTransparency = 1,
                LayoutOrder = index * 2 - 1,
                ZIndex = 66,
            }, details)
            create("TextLabel", {
                Size = UDim2.new(1, -24, 1, 0),
                BackgroundTransparency = 1,
                Text = sec.title,
                TextColor3 = THEME.TextDim,
                Font = Enum.Font.GothamBold,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 67,
            }, titleRow)
            if not sec.dim then
                local copyBtn = iconButton(titleRow, "copy", nil, {
                    AnchorPoint = Vector2.new(1, 0),
                    Position = UDim2.new(1, 0, 0, 0),
                    Size = UDim2.fromOffset(18, 16),
                    iconSize = 11,
                    color = THEME.CodeBg,
                    hoverColor = THEME.Control,
                    ZIndex = 67,
                })
                local textToCopy = sec.text
                copyBtn.Activated:Connect(function()
                    copyToClipboard(textToCopy, sec.title)
                end)
            end
            create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Text = sec.text,
                TextWrapped = true,
                RichText = false,
                TextColor3 = sec.dim and THEME.TextDim or (sec.code and Color3.fromRGB(200, 205, 215) or THEME.Text),
                Font = sec.code and Enum.Font.Code or Enum.Font.Gotham,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Top,
                LayoutOrder = index * 2,
                ZIndex = 67,
            }, details)
        end
        built = true
    end

    local function setExpanded(flag)
        expanded = flag and true or false
        if expanded and not built then
            buildDetails()
        end
        details.Visible = expanded
        if arrow then
            arrow.Rotation = expanded and 90 or 0
            arrow.ImageColor3 = expanded and THEME.Text or THEME.TextDim
        end
    end

    if expandable then
        header.Activated:Connect(function()
            setExpanded(not expanded)
        end)
        header.MouseEnter:Connect(function()
            if arrow and not expanded then arrow.ImageColor3 = THEME.Text end
        end)
        header.MouseLeave:Connect(function()
            if arrow and not expanded then arrow.ImageColor3 = THEME.TextDim end
        end)
    end

    if kind == "tool" and opts.call then
        local callText, callTitle = describeCall(opts.call)
        table.insert(sections, { title = opts.callTitle or callTitle, text = callText, code = true })
    end

    scrollChatToBottom()
    return {
        -- extra: { thoughts = string } or { result = string }
        finish = function(ok, durationText, extra)
            pulsing = false
            extra = extra or {}
            if liveLoader then
                liveLoader.destroy()
                liveLoader = nil
            end
            if live then
                pcall(function() live:Destroy() end)
                live = nil
            end
            header.Visible = true
            pcall(function()
                dot.BackgroundColor3 = ok and THEME.Good or THEME.Danger
                timeLabel.Text = durationText or formatDuration(0)
                timeLabel.TextColor3 = ok and THEME.TextDim or THEME.Danger
            end)
            if kind == "thought" then
                local thoughts = cleanThoughtText(extra.thoughts)
                if thoughts ~= "" then
                    table.insert(sections, { title = "What the AI thought", text = thoughts })
                else
                    table.insert(sections, {
                        title = "What the AI thought",
                        text = extra.noThoughtsText or "This model/provider didn't return a thought summary for this round (thinking may be off, hidden or not supported).",
                        dim = true,
                    })
                    textLabel.TextColor3 = THEME.TextDim
                end
                if extra.error then
                    table.insert(sections, { title = "Error", text = tostring(extra.error) })
                end
            elseif kind == "tool" and extra.result ~= nil then
                local result = tostring(extra.result)
                if #result > 6000 then
                    result = result:sub(1, 6000) .. "\n... (truncated)"
                end
                table.insert(sections, { title = ok and "Result" or "Result (error)", text = result, code = true })
            end
            built = false
            if expanded then
                buildDetails()
            end
            scrollChatToBottom()
        end,
    }
end


local function formatDuration(seconds)
    local s = tonumber(seconds)
    if not s or s ~= s or s < 0 then
        return "?"
    end
    if s < 60 then
        return string.format("%.1fs", s)
    end
    local mins = math.floor(s / 60)
    local secs = math.floor(s % 60 + 0.5)
    if secs >= 60 then
        mins += 1
        secs = 0
    end
    return string.format("%dm %02ds", mins, secs)
end

-- Human-readable view of a tool call (run_lua shows its raw Luau code).
local function describeCall(call)
    local args = (type(call) == "table" and type(call.args) == "table") and call.args or {}
    local name = (type(call) == "table" and tostring(call.name)) or "?"
    if name == "run_lua" and type(args.code) == "string" then
        return args.code, "Luau code the AI ran"
    end
    local keys = {}
    for k in pairs(args) do
        table.insert(keys, tostring(k))
    end
    table.sort(keys)
    if #keys == 0 then
        return name .. "()", "Call"
    end
    local lines = { name .. "(" }
    for _, k in ipairs(keys) do
        local v = args[k]
        local shown
        if type(v) == "table" then
            shown = jsonEncode(v) or "?"
        elseif type(v) == "string" then
            shown = string.format("%q", v)
        else
            shown = tostring(v)
        end
        if #shown > 2000 then
            shown = shown:sub(1, 2000) .. " ...(truncated)"
        end
        table.insert(lines, "  " .. k .. " = " .. shown)
    end
    table.insert(lines, ")")
    return table.concat(lines, "\n"), "Call"
end

local function cleanThoughtText(text)
    local s = tostring(text or "")
    s = s:gsub("%*%*", "")
    s = s:gsub("\r\n", "\n")
    s = s:gsub("^%s+", ""):gsub("%s+$", "")
    if #s > 8000 then
        s = s:sub(1, 8000) .. "\n... (truncated)"
    end
    return s
end


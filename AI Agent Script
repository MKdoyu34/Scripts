local function udimToArray(u)
    return { u.X.Scale, u.X.Offset, u.Y.Scale, u.Y.Offset }
end

local function arrayToUDim(a)
    if type(a) ~= "table" or #a ~= 4 then
        return nil
    end
    for i = 1, 4 do
        if type(a[i]) ~= "number" or a[i] ~= a[i] then
            return nil
        end
    end
    return UDim2.new(a[1], a[2], a[3], a[4])
end

local persistQueued = false
local function persistLayout()
    AI.settings.ui = {
        toggle = udimToArray(W.toggle.Position),
        window = udimToArray(W.window.Position),
        open = Toggle.on,
    }
    if persistQueued then return end
    persistQueued = true
    task.delay(0.6, function()
        persistQueued = false
        saveSettings()
    end)
end

-- The window keeps CONFIG.WindowSize. On small screens it shrinks down to
-- MinWindowSize, and below that the whole window is scaled (UIScale) so it
-- always fits — phones, rotation and tiny executor viewports included.
local windowFitScale = 1
local function fitWindowToViewport()
    local vp = viewportSize()
    local availW, availH = math.max(160, vp.X - 16), math.max(160, vp.Y - 16)
    local w = math.min(CONFIG.WindowSize.X, availW)
    local h = math.min(CONFIG.WindowSize.Y, availH)
    local scale = 1
    if w < CONFIG.MinWindowSize.X then
        scale = math.min(scale, availW / CONFIG.MinWindowSize.X)
        w = CONFIG.MinWindowSize.X
    end
    if h < CONFIG.MinWindowSize.Y then
        scale = math.min(scale, availH / CONFIG.MinWindowSize.Y)
        h = CONFIG.MinWindowSize.Y
    end
    windowFitScale = scale
    W.window.Size = UDim2.fromOffset(math.floor(w), math.floor(h))
    if not Toggle.animating then
        W.windowScale.Scale = scale
    end
    W.window.Position = clampUDim2(W.window, W.window.Position, false)
end

local function setAiOn(on, instant)
    on = on and true or false
    Toggle.on = on
    Toggle.animToken += 1
    local token = Toggle.animToken
    if on then
        Toggle.unread = 0
        W.window.Visible = true
        W.window.Position = clampUDim2(W.window, W.window.Position, false)
        if instant then
            W.windowScale.Scale = windowFitScale
        else
            Toggle.animating = true
            W.windowScale.Scale = windowFitScale * 0.92
            local tween = TweenService:Create(W.windowScale,
                TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = windowFitScale })
            tween.Completed:Connect(function()
                if Toggle.animToken == token then
                    Toggle.animating = false
                    W.windowScale.Scale = windowFitScale
                end
            end)
            tween:Play()
        end
        scrollChatToBottom()
    else
        ListPopup.close()
        if AI.closeComposerPopups then
            AI.closeComposerPopups()
        end
        pcall(function() W.inputBox:ReleaseFocus() end)
        if instant then
            W.window.Visible = false
        else
            Toggle.animating = true
            TweenService:Create(W.windowScale,
                TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = windowFitScale * 0.92 }):Play()
            task.delay(0.13, function()
                if Toggle.animToken == token then
                    W.window.Visible = false
                    Toggle.animating = false
                    W.windowScale.Scale = windowFitScale
                end
            end)
        end
    end
    refreshToggleVisual()
    persistLayout()
end


local function saveEditor()
    local name = trim(W.editName.Text)
    local url = trim(W.editUrl.Text):gsub("/+$", "")
    local icon = trim(W.editIcon.Text)
    if name == "" then
        notify("Give the provider a name.", "warn", 3)
        return
    end
    if not url:match("^https?://[%w%.%-_:%[%]]+") then
        notify("The Base URL must start with http:// or https:// (e.g. https://openrouter.ai/api/v1).", "warn", 4)
        return
    end
    if icon == "" then
        icon = "server"
    end
    local id = Editor.editingId
    local rec = id and Providers.get(id)
    if rec and not rec.official then
        local changedEndpoint = (rec.baseUrl ~= url) or (rec.format ~= Editor.format)
        rec.name = name
        rec.baseUrl = url
        rec.format = Editor.format
        rec.icon = icon
        rec.color = Editor.color
        if changedEndpoint then
            forgetProviderCaches(rec.id)
        end
    else
        rec = sanitizeCustom({ name = name, baseUrl = url, format = Editor.format, icon = icon, color = Editor.color })
        if not rec then
            notify("Couldn't create that provider.", "error", 3)
            return
        end
        table.insert(AI.custom, rec)
        AI.settings.provider = rec.id
        saveSettings()
    end
    local saved = saveCustomProviders()
    closeEditor()
    buildProviderCards()
    selectProvider(rec.id)
    notify(saved and ("Saved '%s' to %s."):format(rec.name, CONFIG.CustomFile)
        or ("'%s' kept for this session (writefile unavailable)."):format(rec.name),
        saved and "success" or "warn", 3)
end

local function deleteEditorProvider()
    local id = Editor.editingId
    local rec = id and Providers.get(id)
    if not rec or rec.official then
        closeEditor()
        return
    end
    if not Editor.deleteArmed then
        Editor.deleteArmed = true
        if W.editDeleteLabel then W.editDeleteLabel.Text = "Confirm?" end
        task.delay(3, function()
            if Editor.deleteArmed and Editor.editingId == id then
                Editor.deleteArmed = false
                if W.editDeleteLabel then W.editDeleteLabel.Text = "Delete" end
            end
        end)
        return
    end
    for index, entry in ipairs(AI.custom) do
        if entry.id == id then
            table.remove(AI.custom, index)
            break
        end
    end
    forgetProviderCaches(id)
    if AI.settings.provider == id then
        AI.settings.provider = "google"
    end
    saveCustomProviders()
    saveSettings()
    closeEditor()
    buildProviderCards()
    refreshSettingsUi()
    notify(("Deleted '%s'."):format(rec.name), "info", 2.5)
end


                create("UIPadding", {
                    PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 8),
                    PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
                }, holder)
                create("Frame", {
                    Position = UDim2.new(0, -10, 0, -2),
                    Size = UDim2.new(0, 3, 1, 4),
                    BackgroundColor3 = THEME.Accent,
                    BackgroundTransparency = 0.25,
                    BorderSizePixel = 0,
                    ZIndex = z + 1,
                }, holder)
                local inner = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    ZIndex = z + 1,
                }, holder)
                -- quotes may hold lists / headings too
                local okInner = pcall(Markdown.render, inner, block.text, z + 1)
                if not okInner then
                    richLabel(inner, Markdown.escape(block.text), { color = THEME.TextDim, ZIndex = z + 1 })
                end

    function()
        local myRoot = getRoot()
        local lines = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            local bits = { ("%s (@%s) UserId=%s"):format(plr.DisplayName, plr.Name, tostring(plr.UserId)) }
            if plr == LocalPlayer then
                table.insert(bits, "[YOU]")
            end
            if plr.Team then
                table.insert(bits, "Team=" .. plr.Team.Name)
            end
            pcall(function()
                local character = plr.Character
                local hum = character and character:FindFirstChildOfClass("Humanoid")
                local root = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)
                if hum then
                    table.insert(bits, "Health=" .. fmtNum(hum.Health) .. "/" .. fmtNum(hum.MaxHealth))
                end
                if root and myRoot and plr ~= LocalPlayer then
                    table.insert(bits, "Distance=" .. fmtNum(round((root.Position - myRoot.Position).Magnitude, 1)))
                end

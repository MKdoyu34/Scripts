registerTool("list_files",
    "List files and folders in the user's workspace (the executor workspace folder on their device; '' or '/' = its root). recursive=true walks sub-folders.",
    {
        type = "object",
        properties = {
            folder = strParam("Folder relative to the workspace root, e.g. '' (root), 'scripts', 'AI_CHATBOT_FILES'"),
            recursive = { type = "boolean", description = "Also list everything inside sub-folders (max 4 levels / 300 entries)" },
        },
    },
    function(args)
        local folder, err = Files.normalize(args.folder or "")
        if not folder then
            return "ERROR: " .. err
        end
        if folder ~= "" and not Files.isFolder(folder) then
            return "ERROR: no folder at '" .. folder .. "'. Call list_files with no folder to see the root."
        end
        local lines, truncated = {}, false
        if args.recursive == true or args.recursive == "true" then
            local _, cut = Files.walk(folder, 4, 300, function(entry)
                table.insert(lines, entry.folder and (entry.path .. "/") or entry.path)
                return false
            end)
            truncated = cut
        else
            local entries, listErr = Files.list(folder)
            if not entries then
                return "ERROR: " .. listErr
            end
            for _, entry in ipairs(entries) do
                table.insert(lines, entry.folder and (entry.name .. "/") or entry.name)
            end

-- Icon (+ optional text) button used across the UI.
local function iconButton(parent, iconName, text, props)
    props = props or {}
    local z = props.ZIndex or 63
    local base = props.color or THEME.Control
    local hover = props.hoverColor or ((base == THEME.Control) and THEME.ControlHover or base:Lerp(Color3.new(1, 1, 1), 0.12))
    local btn = create("TextButton", {
        Name = props.Name or "Button",
        Size = props.Size or UDim2.fromOffset(80, 22),
        Position = props.Position or UDim2.new(),
        AnchorPoint = props.AnchorPoint or Vector2.zero,
        BackgroundColor3 = base,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = props.LayoutOrder or 0,
        ZIndex = z,
    }, parent)
    create("UICorner", { CornerRadius = UDim.new(0, props.corner or 4) }, btn)
    local iconSize = props.iconSize or 14
    local icon = Icons.image(btn, iconName, {
        Size = UDim2.fromOffset(iconSize, iconSize),
        AnchorPoint = text and Vector2.new(0, 0.5) or Vector2.new(0.5, 0.5),
        Position = text and UDim2.new(0, 7, 0.5, 0) or UDim2.fromScale(0.5, 0.5),
        color = props.textColor or THEME.Text,
        ZIndex = z + 1,
    })
    local label
    if text then
        label = create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(iconSize + 12, 0),
            Size = UDim2.new(1, -(iconSize + 16), 1, 0),
            Text = text,
            TextColor3 = props.textColor or THEME.Text,
            Font = Enum.Font.GothamMedium,
            TextSize = props.textSize or 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = z + 1,
        }, btn)
    end
    -- setButtonColor() can change the base color later (e.g. Send <-> Stop).
    btn.MouseEnter:Connect(function()
        local custom = btn:GetAttribute("BaseColor")
        btn.BackgroundColor3 = custom and custom:Lerp(Color3.new(1, 1, 1), 0.12) or hover
    end)
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = btn:GetAttribute("BaseColor") or base
    end)
    return btn, icon, label
end

local function setButtonColor(btn, color)
    btn:SetAttribute("BaseColor", color)
    btn.BackgroundColor3 = color
end


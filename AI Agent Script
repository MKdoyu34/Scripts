local function create(class, props, parent)
    local inst = Instance.new(class)
    if props then
        for key, value in pairs(props) do
            pcall(function() inst[key] = value end)
        end
    end
    if parent then
        pcall(function() inst.Parent = parent end)
    end
    return inst
end

-- Single-value trim (gsub returns two values, which breaks tonumber(x, base)).
local function trim(value)
    local s = tostring(value or "")
    s = s:gsub("^%s+", "")
    s = s:gsub("%s+$", "")
    return s
end

local function trimNum(n)
    local num = tonumber(n)
    if not num or num ~= num then
        return "0"
    end
    if num == math.floor(num) and math.abs(num) < 1e15 then
        return string.format("%d", num)
    end
    return tostring(num)
end

local function round(n, places)
    local m = 10 ^ (places or 2)
    return math.floor((tonumber(n) or 0) * m + 0.5) / m
end

local function fmtNum(n)
    return trimNum(round(n, 3))
end

local Connections = {}
local function trackConnection(connection)

local function readJsonFile(path)
    if not FS.readfile then return nil end
    if FS.isfile then
        local ok, exists = pcall(FS.isfile, path)
        if ok and not exists then return nil end
    end
    local okRead, raw = pcall(FS.readfile, path)
    if not okRead or type(raw) ~= "string" or raw == "" then return nil end
    return jsonDecode(raw)
end

local function applySettingsData(data)
    local s = AI.settings
    -- v1.x layout (single Gemini key/model) → the Google DeepMind card.
    if type(data.apiKey) == "string" then s.providers.google.apiKey = trim(data.apiKey) end
    if type(data.model) == "string" and data.model ~= "" then s.providers.google.model = data.model end
    -- v2 layout
    if type(data.providers) == "table" then
        for _, def in ipairs(OFFICIAL_PROVIDERS) do
            local slot = data.providers[def.id]
            if type(slot) == "table" then
                local target = s.providers[def.id]
                if type(slot.apiKey) == "string" then target.apiKey = trim(slot.apiKey) end
                if type(slot.model) == "string" and slot.model ~= "" then target.model = slot.model end
            end
        end
    end
    if type(data.provider) == "string" and data.provider ~= "" then s.provider = data.provider end
    if type(data.instructions) == "string" then s.instructions = data.instructions end
    if type(data.thinking) == "string" then s.thinking = data.thinking end
    if type(data.temperature) == "number" then s.temperature = math.clamp(data.temperature, 0, 2) end
    if type(data.context) == "boolean" then s.context = data.context end
    if type(data.allowRunLua) == "boolean" then s.allowRunLua = data.allowRunLua end
    if type(data.ui) == "table" then s.ui = data.ui end
    if type(data.disabledTools) == "table" then
        local set = {}
        for k, v in pairs(data.disabledTools) do
            if type(k) == "string" and v == true then
                set[k] = true
            elseif type(k) == "number" and type(v) == "string" then
                set[v] = true
            end
        end
        s.disabledTools = set
    end
    if type(data.search) == "table" then
        local engine = data.search.engine
        s.search = {
            engine = (type(engine) == "string") and engine or "duckduckgo",
            key = (type(data.search.key) == "string") and trim(data.search.key) or "",
            url = (type(data.search.url) == "string") and trim(data.search.url) or "",
        }
    end
end

local function newProviderId()
    local guid = HttpService:GenerateGUID(false):gsub("%-", ""):lower()
    return "custom_" .. guid:sub(1, 10)
end

local function sanitizeCustom(rec)
    if type(rec) ~= "table" then return nil end
    local name = trim(rec.name or "")
    if name == "" then return nil end
    local fmt = formatInfo(rec.format).id
    local out = {
        id = (type(rec.id) == "string" and rec.id ~= "") and rec.id or newProviderId(),
        name = name,
        baseUrl = trim(rec.baseUrl or ""),
        format = fmt,
        icon = (type(rec.icon) == "string" and trim(rec.icon) ~= "") and trim(rec.icon) or "server",
        apiKey = type(rec.apiKey) == "string" and trim(rec.apiKey) or "",
        model = (type(rec.model) == "string" and rec.model ~= "") and rec.model or nil,
        color = Providers.parseColor(rec.color),
        official = false,
    }
    return out
end

do
    local data = readJsonFile(CONFIG.SettingsFile)
    if data then
        applySettingsData(data)
    else
        -- First run: import the key/model/prompt from StudioGUI Creator.
        local legacy = readJsonFile(CONFIG.LegacySettings)
        if legacy then
            legacy.ui = nil
            applySettingsData(legacy)
            AI.settings.provider = "google"
            AI.importedLegacy = true
            saveSettings()
        end
    end
    local custom = readJsonFile(CONFIG.CustomFile)
    if custom then
        local list = type(custom.providers) == "table" and custom.providers or custom
        local seen = {}
        for _, rec in ipairs(list) do
            local clean = sanitizeCustom(rec)
            if clean and not seen[clean.id] and not Providers.get(clean.id) then
                seen[clean.id] = true
                table.insert(AI.custom, clean)
            end
        end
    end
    if not Providers.get(AI.settings.provider) then
        AI.settings.provider = "google"
    end
end

-- //////////////////////////////////////////////////////////////////////////
-- HTTP helper (request / http_request / syn.request / http.request)
-- //////////////////////////////////////////////////////////////////////////

-- Keys never appear in errors / chat.
local function redactSecrets(text)
    local s = tostring(text or "")
    s = s:gsub("key=[%w%-_%.]+", "key=***")
    s = s:gsub("Bearer%s+[%w%-_%.]+", "Bearer ***")
    s = s:gsub("sk%-[%w%-_]+", "sk-***")
    s = s:gsub("AIza[%w%-_]+", "AIza***")
    s = s:gsub("tvly%-[%w%-_]+", "tvly-***")
    return s
end

local function httpJson(url, method, bodyTable, headers)
    if not Executor.http then
        return nil, "This executor has no HTTP API (request / http_request missing)."
    end
    local allHeaders = { ["Content-Type"] = "application/json" }
    if type(headers) == "table" then
        for k, v in pairs(headers) do
            allHeaders[k] = v
        end
    end
    local opts = {
        Url = url,
        Method = method or "GET",
        Headers = allHeaders,
    }
    if bodyTable ~= nil then
        local payload, encErr = jsonEncode(bodyTable)
        if not payload then
            return nil, "JSON encode failed: " .. tostring(encErr)
        end
        opts.Body = payload
    end
    local ok, res = pcall(Executor.http, opts)
    if not ok then
        return nil, "HTTP error: " .. redactSecrets(res)
    end
    if type(res) ~= "table" then
        return nil, "Invalid HTTP response object."
    end
    local okFlag = res.Success
    if okFlag == nil then okFlag = res.success end
    local bodyText = res.Body or res.body or ""
    local code = tonumber(res.StatusCode or res.statusCode) or 0
    -- Providers return JSON error bodies with non-2xx codes; let the caller
    -- read them instead of failing blindly.
    if okFlag == false and (type(bodyText) ~= "string" or bodyText == "") then
        local errMsg = res.ErrorMessage or res.errorMessage or res.StatusMessage or res.error
        return nil, redactSecrets(("HTTP request failed (%s)%s"):format(tostring(code),
            errMsg and (": " .. tostring(errMsg)) or "."))
    end
    return { body = bodyText, code = code }
end

-- Pulls a readable error out of any provider's JSON error shape.
local function apiErrorText(data)
    if type(data) ~= "table" then return nil end
    local e = data.error
    if type(e) == "string" and e ~= "" then
        return e
    end
    if type(e) == "table" then
        local msg = e.message or e.msg or e.status or e.type or e.code
        if msg ~= nil then
            return tostring(msg)
        end
        return "API error"
    end
    if data.type == "error" then
        return tostring(data.message or "API error")
    end
    if type(data.detail) == "string" then
        return data.detail
    end
    return nil
end

-- //////////////////////////////////////////////////////////////////////////
-- WORKSPACE FILES — the executor's workspace folder is the AI's "device".
-- Roblox executors only expose their own workspace folder to scripts
-- (readfile / writefile / listfiles are sandboxed there), so "/" below means
-- that folder's ROOT — every file and sub-folder in it is reachable.
-- Paths are "/"-separated and relative: "notes.md", "scripts/fly.lua".
-- The chatbot's own settings files hold your API keys and are locked.
-- //////////////////////////////////////////////////////////////////////////

local Files = { attachments = {}, index = nil, indexedAt = 0 }
do
    function Files.clip(text, limit)
        text = tostring(text)
        if #text > limit then
            return text:sub(1, limit) .. ("\n... (truncated — %d chars total)"):format(#text)
        end
        return text
    end

    function Files.errText(err)
        local text = tostring(err or "unknown error"):gsub("^.-:%d+: ", "")
        if #text > 120 then
            text = text:sub(1, 117) .. "..."
        end
        return text
    end

    function Files.today()
        local ok, t = pcall(os.date, "*t")
        if ok and type(t) == "table" and t.year then
            return ("%04d-%02d-%02d"):format(t.year, t.month, t.day)
        end
        return "today"
    end

    local LOCKED = {}
    LOCKED[CONFIG.SettingsFile:lower()] = true
    LOCKED[CONFIG.CustomFile:lower()] = true
    LOCKED[CONFIG.LegacySettings:lower()] = true

    -- "C:\foo", "..", absolute paths → error; "", "/", "." → root ("").
    function Files.normalize(raw)
        local s = trim(raw)
        s = s:gsub('^"(.*)"$', "%1"):gsub("^'(.*)'$", "%1")
        s = s:gsub("\\", "/")
        if s:find(":", 1, true) then
            return nil, "absolute device paths (like C:/...) can't be reached — executors only expose their workspace folder. Use a path relative to it, e.g. 'notes.md'."
        end
        s = s:gsub("/+", "/")
        s = s:gsub("^%./", "")
        s = s:gsub("^/+", "")
        s = s:gsub("^[Ww]orkspace/", "")
        s = s:gsub("/+$", "")
        if s == "." or s == "/" then
            s = ""
        end
        for segment in s:gmatch("[^/]+") do
            if segment == ".." then
                return nil, "'..' isn't allowed — paths are relative to the workspace root."
            end
        end
        return s
    end

    function Files.isLocked(path)
        local p = tostring(path or ""):lower()
        return LOCKED[p] == true
    end

    function Files.join(folder, name)
        if folder == nil or folder == "" then
            return name
        end
        return folder .. "/" .. name
    end

    function Files.parent(path)
        return path:match("^(.*)/[^/]+$") or ""
    end

    function Files.baseName(path)
        return tostring(path):match("([^/]+)$") or tostring(path)
    end

    function Files.extension(path)
        return (Files.baseName(path):match("%.([%w_]+)$") or ""):lower()
    end

    function Files.formatSize(bytes)
        bytes = tonumber(bytes) or 0
        if bytes < 1024 then
            return bytes .. " B"
        elseif bytes < 1024 * 1024 then
            return string.format("%.1f KB", bytes / 1024)
        end
        return string.format("%.1f MB", bytes / (1024 * 1024))
    end

    function Files.isFolder(path)
        if not FS.isfolder then return false end
        local ok, result = pcall(FS.isfolder, path)
        return ok and result == true
    end

    function Files.isFile(path)
        if FS.isfile then
            local ok, result = pcall(FS.isfile, path)
            if ok then
                return result == true
            end
        end
        if FS.readfile then
            local ok, content = pcall(FS.readfile, path)
            return ok and type(content) == "string"
        end
        return false
    end

    local function rawList(folder)
        if not FS.listfiles then
            return nil, "listfiles is not available on this executor."
        end
        local tries = (folder == "") and { "", ".", "/" } or { folder }
        for _, p in ipairs(tries) do
            local ok, res = pcall(FS.listfiles, p)
            if ok and type(res) == "table" then
                return res
            end
        end
        return nil, ("could not list '%s'."):format(folder == "" and "/" or folder)
    end

    -- Entries of ONE folder: { name, path, folder = bool }, folders first.
    function Files.list(folder)
        local raw, err = rawList(folder or "")
        if not raw then
            return nil, err
        end
        local out, seen = {}, {}
        for _, entry in ipairs(raw) do
            if type(entry) == "string" then
                local clean = entry:gsub("\\", "/")
                clean = clean:gsub("/+$", "")
                local name = clean:match("([^/]+)$")
                local path = name and Files.join(folder, name)
                if name and name ~= "." and name ~= ".." and not seen[name] and not Files.isLocked(path) then
                    seen[name] = true
                    local isDir = Files.isFolder(path) or Files.isFolder(entry)
                    table.insert(out, { name = name, path = path, folder = isDir })
                end
            end
        end
        table.sort(out, function(a, b)
            if a.folder ~= b.folder then
                return a.folder
            end
            return a.name:lower() < b.name:lower()
        end)
        return out
    end

    -- Breadth-first walk with limits. visit(entry, depth) returning true stops.
    function Files.walk(folder, maxDepth, maxEntries, visit)
        local queue = { { path = folder or "", depth = 0 } }
        local count, head = 0, 1
        while head <= #queue do
            local item = queue[head]
            head += 1
            local entries = Files.list(item.path)
            if entries then
                for _, entry in ipairs(entries) do
                    count += 1
                    if count > maxEntries then
                        return count, true
                    end
                    if visit(entry, item.depth) then
                        return count, false
                    end
                    if entry.folder and item.depth + 1 < maxDepth then
                        table.insert(queue, { path = entry.path, depth = item.depth + 1 })
                    end
                end
            end
            if count % 300 == 0 then
                task.wait()
            end
        end
        return count, false
    end

    -- Cached list of every file path (for @-autocomplete and the browser search).
    function Files.allFiles(forceRefresh)
        if Files.index and not forceRefresh and os.clock() - Files.indexedAt < 30 then
            return Files.index
        end
        local list = {}
        Files.walk("", 8, 4000, function(entry)
            if not entry.folder then
                table.insert(list, entry.path)
            end
        end)
        table.sort(list, function(a, b) return a:lower() < b:lower() end)
        Files.index = list
        Files.indexedAt = os.clock()
        return list
    end

    function Files.read(path)
        local p, err = Files.normalize(path)
        if not p then return nil, err end
        if p == "" then return nil, "that's the workspace root (a folder), not a file." end
        if Files.isLocked(p) then
            return nil, "'" .. p .. "' holds your API keys — the AI can't open it."
        end
        if not FS.readfile then return nil, "readfile is not available on this executor." end
        if Files.isFolder(p) then return nil, "'" .. p .. "' is a folder — list it instead." end
        local ok, content = pcall(FS.readfile, p)
        if not ok or type(content) ~= "string" then
            return nil, "no readable file at '" .. p .. "'."
        end
        return content, p
    end

    local function ensureFolders(path)
        if not FS.makefolder then return end
        local acc = ""
        for segment in Files.parent(path):gmatch("[^/]+") do
            acc = (acc == "") and segment or (acc .. "/" .. segment)
            if not Files.isFolder(acc) then
                pcall(FS.makefolder, acc)
            end
        end
    end

    function Files.write(path, content)
        local p, err = Files.normalize(path)
        if not p then return nil, err end
        if p == "" then return nil, "give a file path, e.g. 'notes.md'." end
        if Files.isLocked(p) then
            return nil, "'" .. p .. "' holds your API keys — it can't be overwritten from here."
        end
        if not FS.writefile then return nil, "writefile is not available on this executor." end
        content = tostring(content or "")
        ensureFolders(p)
        local ok, writeErr = pcall(FS.writefile, p, content)
        if not ok then
            return nil, "writefile failed: " .. Files.errText(writeErr)
        end
        Files.index = nil
        if FS.readfile then
            local okBack, back = pcall(FS.readfile, p)
            if not okBack or type(back) ~= "string" or #back ~= #content then
                return nil, "the file was written but could not be verified."
            end
        end
        return p
    end

    function Files.makeFolder(path)
        local p, err = Files.normalize(path)
        if not p then return nil, err end
        if p == "" then return nil, "give a folder path." end
        if not FS.makefolder then return nil, "makefolder is not available on this executor." end
        ensureFolders(p .. "/x")
        Files.index = nil
        return p
    end

    function Files.delete(path)
        local p, err = Files.normalize(path)
        if not p then return nil, err end
        if p == "" then return nil, "refusing to delete the workspace root." end
        if Files.isLocked(p) then return nil, "'" .. p .. "' holds your API keys — it can't be deleted from here." end
        if Files.isFolder(p) then
            if not FS.delfolder then return nil, "delfolder is not available on this executor." end
            local ok, e = pcall(FS.delfolder, p)
            if not ok then return nil, Files.errText(e) end
        else
            if not FS.delfile then return nil, "delfile is not available on this executor." end
            local ok, e = pcall(FS.delfile, p)
            if not ok then return nil, Files.errText(e) end
        end
        Files.index = nil
        return p
    end

    -- Best existing file for a typed path / bare name ("notes" → "docs/notes.md").
    function Files.resolve(query)
        local p, err = Files.normalize(query)
        if not p then return nil, err end
        if p == "" then return nil, "give a file path." end
        if Files.isFile(p) and not Files.isFolder(p) then
            return p
        end
        local lower = p:lower()
        local base = Files.baseName(lower)
        local stem = base:match("^(.*)%.[^%.]+$") or base
        local best, bestScore = nil, math.huge
        for _, path in ipairs(Files.allFiles()) do
            local pl = path:lower()
            local b = Files.baseName(pl)
            local score
            if pl == lower then
                score = 0
            elseif pl:sub(-(#lower + 1)) == "/" .. lower then
                score = 1
            elseif b == base then
                score = 2
            elseif (b:match("^(.*)%.[^%.]+$") or b) == stem then
                score = 3
            elseif b:find(base, 1, true) then
                score = 4
            end
            if score then
                score = score * 1000 + #path
                if score < bestScore then
                    best, bestScore = path, score
                end
            end
        end
        if best then
            return best
        end
        return nil, ("no file matching '%s' in the workspace."):format(p)
    end

    -- Name + (optional) content search. Returns { {path, folder, kind, hits} }.
    function Files.search(query, folder, inContent, maxResults)
        query = trim(query):lower()
        if query == "" then
            return nil, "empty search text."
        end
        maxResults = math.clamp(math.floor(tonumber(maxResults) or 25), 1, 100)
        local results, scanned = {}, 0
        Files.walk(folder or "", 8, 3000, function(entry)
            if #results >= maxResults then
                return true
            end
            if entry.name:lower():find(query, 1, true) then
                table.insert(results, { path = entry.path, folder = entry.folder, kind = "name" })
            elseif inContent and not entry.folder and FS.readfile and scanned < 400 then
                scanned += 1
                if scanned % 20 == 0 then
                    task.wait()
                end
                local okRead, content = pcall(FS.readfile, entry.path)
                if okRead and type(content) == "string" and #content <= 400000 and Files.isText(content) then
                    local hits, lineNo = {}, 0
                    for line in (content .. "\n"):gmatch("(.-)\r?\n") do
                        lineNo += 1
                        if line:lower():find(query, 1, true) then
                            table.insert(hits, { line = lineNo, text = trim(line):sub(1, 160) })
                            if #hits >= 3 then
                                break
                            end
                        end
                    end
                    if #hits > 0 then
                        table.insert(results, { path = entry.path, kind = "content", hits = hits })
                    end
                end
            end
            return false
        end)
        return results
    end

    function Files.formatSearch(query, results)
        if #results == 0 then
            return ("No files or contents match '%s'."):format(query)
        end
        local lines = { ("%d match(es) for '%s':"):format(#results, query) }
        for _, r in ipairs(results) do
            if r.kind == "name" then
                table.insert(lines, (r.folder and "[folder] " or "[file] ") .. r.path)
            else
                table.insert(lines, "[content] " .. r.path)
                for _, h in ipairs(r.hits) do
                    table.insert(lines, ("    line %d: %s"):format(h.line, h.text))
                end
            end
        end
        return table.concat(lines, "\n")
    end

    -- Heuristic: NUL bytes or lots of control characters = binary.
    function Files.isText(content)
        local sample = content:sub(1, 4000)
        if sample:find("\0", 1, true) then
            return false
        end
        local controls = select(2, sample:gsub("[%c]", "")) - select(2, sample:gsub("[\n\r\t]", ""))
        return controls <= #sample * 0.05
    end

    function Files.lineCount(content)
        return select(2, content:gsub("\n", "\n")) + 1
    end

    -- Fenced block the AI reads (used by @read-file and attachments).
    function Files.block(path, content, limit)
        limit = limit or 30000
        if not Files.isText(content) then
            return ("### File: `%s`  (%s, binary — not shown)"):format(path, Files.formatSize(#content))
        end
        local body = content
        local note = ""
        if #body > limit then
            body = body:sub(1, limit)
            note = ("\n(... truncated — showing the first %d of %d characters)"):format(limit, #content)
        end
        local lang = Files.extension(path)
        if lang == "txt" then lang = "" end
        return ("### File: `%s`  (%d lines, %s)\n```%s\n%s\n```%s"):format(
            path, Files.lineCount(content), Files.formatSize(#content), lang, body, note)
    end
end

-- //////////////////////////////////////////////////////////////////////////
-- WEB — search + page fetch through the executor's HTTP function.
-- Model APIs don't browse on their own (web search is a separate, often paid
-- server-side feature, and it's off by default), so the chatbot does it:
-- DuckDuckGo (free, no key) with a Wikipedia fallback, or Brave / Tavily /
-- SearXNG if you add a key / instance URL in Settings → Web search.
-- //////////////////////////////////////////////////////////////////////////

local Web = {}
do
    local UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"

    Web.ENGINES = {
        { id = "duckduckgo", label = "DuckDuckGo  (free, no key)", needs = nil },
        { id = "brave",      label = "Brave Search  (API key)",    needs = "key", placeholder = "Brave Search API key (api.search.brave.com)" },
        { id = "tavily",     label = "Tavily  (API key)",          needs = "key", placeholder = "Tavily API key (tvly-...)" },
        { id = "searxng",    label = "SearXNG  (your instance URL)", needs = "url", placeholder = "https://your-searxng.example.org" },
    }

    function Web.engineInfo(id)
        for _, e in ipairs(Web.ENGINES) do
            if e.id == id then return e end
        end
        return Web.ENGINES[1]
    end

    function Web.urlEncode(s)
        s = tostring(s or "")
        local ok, encoded = pcall(function() return HttpService:UrlEncode(s) end)
        if ok and type(encoded) == "string" then
            return encoded
        end
        return (s:gsub("[^%w%-_%.~]", function(c) return string.format("%%%02X", c:byte()) end))
    end

    function Web.urlDecode(s)
        s = tostring(s or ""):gsub("+", " ")
        return (s:gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end))
    end

    local ENTITIES = { amp = "&", lt = "<", gt = ">", quot = '"', apos = "'", nbsp = " ", mdash = "—",
        ndash = "–", hellip = "…", rsquo = "’", lsquo = "‘", rdquo = "”", ldquo = "“", copy = "©", reg = "®" }
    function Web.decodeEntities(s)
        s = tostring(s or "")
        s = s:gsub("&#[xX](%x+);", function(h)
            local n = tonumber(h, 16)
            local ok, ch = pcall(utf8.char, n or 32)
            return ok and ch or ""
        end)
        s = s:gsub("&#(%d+);", function(d)
            local ok, ch = pcall(utf8.char, tonumber(d) or 32)
            return ok and ch or ""
        end)
        s = s:gsub("&(%a+);", function(name) return ENTITIES[name:lower()] or ("&" .. name .. ";") end)
        return s
    end

    function Web.stripTags(html)
        local s = tostring(html or "")
        s = s:gsub("<!%-%-.-%-%->", " ")
        for _, tag in ipairs({ "script", "style", "noscript", "svg", "head", "template", "iframe" }) do
            s = s:gsub("<" .. tag .. "[^>]*>.-</" .. tag .. ">", " ")
            s = s:gsub("<" .. tag:upper() .. "[^>]*>.-</" .. tag:upper() .. ">", " ")
        end
        s = s:gsub("<[Bb][Rr]%s*/?>", "\n")
        s = s:gsub("<[Ll][Ii][^>]*>", "\n• ")
        s = s:gsub("<[Hh](%d)[^>]*>", function(level) return "\n\n" .. string.rep("#", tonumber(level) or 2) .. " " end)
        s = s:gsub("</?[PpDdTt][^>]*>", "\n")
        s = s:gsub("<[^>]+>", "")
        s = Web.decodeEntities(s)
        s = s:gsub("\r", "")
        s = s:gsub("[ \t\f\v]+", " ")
        s = s:gsub(" *\n *", "\n")
        s = s:gsub("\n\n\n+", "\n\n")
        return trim(s)
    end

    -- GET/POST through the executor. Returns body, status, headers.
    function Web.request(url, method, body, headers)
        if not Executor.http then
            return nil, "this executor has no HTTP function."
        end
        local h = { ["User-Agent"] = UA, ["Accept-Language"] = "en-US,en;q=0.9" }
        for k, v in pairs(headers or {}) do
            h[k] = v
        end
        local opts = { Url = url, Method = method or "GET", Headers = h }
        if body ~= nil then
            opts.Body = body
        end
        local ok, res = pcall(Executor.http, opts)
        if not ok then
            return nil, "HTTP error: " .. redactSecrets(res)
        end
        if type(res) ~= "table" then
            return nil, "invalid HTTP response."
        end
        local code = tonumber(res.StatusCode or res.statusCode) or 0
        local text = res.Body or res.body
        if type(text) ~= "string" then
            return nil, ("HTTP %d with no body."):format(code)
        end
        return text, code, res.Headers or res.headers or {}
    end

    local function addResult(list, seen, title, url, snippet)
        url = trim(url)
        if url == "" or seen[url] then return end
        seen[url] = true
        table.insert(list, {
            title = trim(Web.stripTags(title)),
            url = url,
            snippet = trim(Web.stripTags(snippet or "")),
        })
    end

    local function ddgHref(href)
        href = Web.decodeEntities(href)
        local target = href:match("[?&]uddg=([^&]+)")
        if target then
            href = Web.urlDecode(target)
        elseif href:sub(1, 2) == "//" then
            href = "https:" .. href
        end
        return href
    end

    local function searchDuckDuckGo(query, max)
        local list, seen = {}, {}
        local html = Web.request("https://html.duckduckgo.com/html/?q=" .. Web.urlEncode(query) .. "&kl=us-en")
        if html then
            local current
            for attrs, inner in html:gmatch("<a([^>]*)>(.-)</a>") do
                local href = attrs:match('href="([^"]+)"') or attrs:match("href='([^']+)'")
                if attrs:find("result__a", 1, true) and href and not href:find("duckduckgo.com/y.js", 1, true) then
                    current = #list + 1
                    addResult(list, seen, inner, ddgHref(href), "")
                    if #list < current then current = nil end
                elseif attrs:find("result__snippet", 1, true) and current and list[current] then
                    list[current].snippet = trim(Web.stripTags(inner))
                end
                if #list >= max then break end
            end
        end
        if #list == 0 then   -- lite endpoint (different markup)
            local lite = Web.request("https://lite.duckduckgo.com/lite/?q=" .. Web.urlEncode(query))
            if lite then
                for attrs, inner in lite:gmatch("<a([^>]*)>(.-)</a>") do
                    local href = attrs:match('href="([^"]+)"') or attrs:match("href='([^']+)'")
                    if attrs:find("result%-link") and href then
                        addResult(list, seen, inner, ddgHref(href), "")
                    end
                    if #list >= max then break end
                end
                local i = 0
                for snippet in lite:gmatch("<td[^>]-class=['\"]result%-snippet['\"][^>]*>(.-)</td>") do
                    i += 1
                    if list[i] then list[i].snippet = trim(Web.stripTags(snippet)) end
                end
            end
        end
        return list
    end

    local function searchWikipedia(query, max)
        local list, seen = {}, {}
        local body = Web.request(("https://en.wikipedia.org/w/api.php?action=query&list=search&format=json&utf8=1&srlimit=%d&srsearch=%s")
            :format(max, Web.urlEncode(query)), "GET", nil, { Accept = "application/json" })
        local data = body and jsonDecode(body)
        local hits = data and data.query and data.query.search
        if type(hits) == "table" then
            for _, hit in ipairs(hits) do
                if type(hit) == "table" and type(hit.title) == "string" then
                    addResult(list, seen, hit.title .. " — Wikipedia",
                        "https://en.wikipedia.org/wiki/" .. Web.urlEncode((hit.title:gsub(" ", "_"))),
                        tostring(hit.snippet or ""))
                end
            end
        end
        -- DuckDuckGo instant answer (short facts) as a bonus.
        local ia = Web.request("https://api.duckduckgo.com/?format=json&no_html=1&skip_disambig=1&q=" .. Web.urlEncode(query))
        local iaData = ia and jsonDecode(ia)
        if type(iaData) == "table" and type(iaData.AbstractText) == "string" and iaData.AbstractText ~= "" then
            table.insert(list, 1, {
                title = tostring(iaData.Heading or query) .. " (instant answer)",
                url = tostring(iaData.AbstractURL or ""),
                snippet = iaData.AbstractText,
            })
        end
        return list
    end

    local function searchBrave(query, max, key)
        local body, code = Web.request(("https://api.search.brave.com/res/v1/web/search?count=%d&q=%s"):format(max, Web.urlEncode(query)),
            "GET", nil, { Accept = "application/json", ["X-Subscription-Token"] = key })
        local data = body and jsonDecode(body)
        local list, seen = {}, {}
        local results = data and data.web and data.web.results
        if type(results) ~= "table" then
            return nil, ("Brave Search failed (HTTP %s)."):format(tostring(code))
        end
        for _, r in ipairs(results) do
            if type(r) == "table" then
                addResult(list, seen, tostring(r.title or ""), tostring(r.url or ""), tostring(r.description or ""))
            end
        end
        return list
    end

    local function searchTavily(query, max, key)
        local payload = jsonEncode({ api_key = key, query = query, max_results = max })
        local body, code = Web.request("https://api.tavily.com/search", "POST", payload,
            { ["Content-Type"] = "application/json", Authorization = "Bearer " .. key })
        local data = body and jsonDecode(body)
        local list, seen = {}, {}
        if type(data) ~= "table" or type(data.results) ~= "table" then
            return nil, ("Tavily failed (HTTP %s)."):format(tostring(code))
        end
        if type(data.answer) == "string" and data.answer ~= "" then
            table.insert(list, { title = "Tavily answer", url = "", snippet = data.answer })
        end
        for _, r in ipairs(data.results) do
            if type(r) == "table" then
                addResult(list, seen, tostring(r.title or ""), tostring(r.url or ""), tostring(r.content or ""))
            end
        end
        return list
    end

    local function searchSearx(query, max, base)
        base = trim(base):gsub("/+$", "")
        if base == "" then
            return nil, "no SearXNG URL set."
        end
        local body, code = Web.request(base .. "/search?format=json&q=" .. Web.urlEncode(query), "GET", nil, { Accept = "application/json" })
        local data = body and jsonDecode(body)
        local list, seen = {}, {}
        if type(data) ~= "table" or type(data.results) ~= "table" then
            return nil, ("SearXNG failed (HTTP %s) — is format=json enabled on the instance?"):format(tostring(code))
        end
        for _, r in ipairs(data.results) do
            if type(r) == "table" and #list < max then
                addResult(list, seen, tostring(r.title or ""), tostring(r.url or ""), tostring(r.content or ""))
            end
        end
        return list
    end

    -- Returns results, engineName  (results = { {title, url, snippet} }).
    function Web.search(query, max)
        query = trim(query)
        max = math.clamp(math.floor(tonumber(max) or 6), 1, 10)
        if query == "" then
            return nil, "empty search query."
        end
        local cfg = type(AI.settings.search) == "table" and AI.settings.search or {}
        local engine = Web.engineInfo(cfg.engine).id
        local notes = {}
        local list, err
        if engine == "brave" and trim(cfg.key or "") ~= "" then
            list, err = searchBrave(query, max, trim(cfg.key))
            if list and #list > 0 then return list, "Brave Search" end
            table.insert(notes, err or "Brave returned nothing")
        elseif engine == "tavily" and trim(cfg.key or "") ~= "" then
            list, err = searchTavily(query, max, trim(cfg.key))
            if list and #list > 0 then return list, "Tavily" end
            table.insert(notes, err or "Tavily returned nothing")
        elseif engine == "searxng" then
            list, err = searchSearx(query, max, cfg.url or "")
            if list and #list > 0 then return list, "SearXNG" end
            table.insert(notes, err or "SearXNG returned nothing")
        end
        list = searchDuckDuckGo(query, max)
        if #list > 0 then
            return list, "DuckDuckGo"
        end
        list = searchWikipedia(query, max)
        if #list > 0 then
            return list, "Wikipedia (DuckDuckGo was unavailable)"
        end
        table.insert(notes, "DuckDuckGo and Wikipedia returned nothing (blocked or no results)")
        return nil, table.concat(notes, "; ")
    end

    function Web.formatResults(query, list, engine)
        local lines = { ("Web results for \"%s\" (via %s, %s):"):format(query, engine, Files.today()) }
        for i, r in ipairs(list) do
            table.insert(lines, ("%d. %s"):format(i, r.title ~= "" and r.title or r.url))
            if r.url ~= "" then
                table.insert(lines, "   " .. r.url)
            end
            if r.snippet ~= "" then
                table.insert(lines, "   " .. Files.clip(r.snippet, 400))
            end
        end
        return table.concat(lines, "\n")
    end

    -- Returns title, text, contentType  or nil, err.
    function Web.fetch(url, maxChars)
        url = trim(url)
        if not url:match("^https?://") then
            if url:match("^[%w%-]+%.[%w%-%.]+") then
                url = "https://" .. url
            else
                return nil, "give a full URL (https://...)."
            end
        end
        maxChars = math.clamp(math.floor(tonumber(maxChars) or 8000), 500, 30000)
        local body, code, headers = Web.request(url, "GET", nil, { Accept = "text/html,application/xhtml+xml,application/json,text/plain;q=0.9,*/*;q=0.5" })
        if not body then
            return nil, code
        end
        local ctype = ""
        if type(headers) == "table" then
            for k, v in pairs(headers) do
                if tostring(k):lower() == "content-type" then
                    ctype = tostring(v):lower()
                end
            end
        end
        local title = ""
        local text
        if ctype:find("html", 1, true) or (ctype == "" and body:sub(1, 600):lower():find("<html", 1, true)) then
            title = trim(Web.stripTags(body:match("<[Tt][Ii][Tt][Ll][Ee][^>]*>(.-)</[Tt][Ii][Tt][Ll][Ee]>") or ""))
            local main = body:match("<[Mm][Aa][Ii][Nn][^>]*>(.-)</[Mm][Aa][Ii][Nn]>")
                or body:match("<[Aa][Rr][Tt][Ii][Cc][Ll][Ee][^>]*>(.-)</[Aa][Rr][Tt][Ii][Cc][Ll][Ee]>")
                or body:match("<[Bb][Oo][Dd][Yy][^>]*>(.-)</[Bb][Oo][Dd][Yy]>")
                or body
            text = Web.stripTags(main)
        else
            text = body
        end
        if code >= 400 then
            title = ("HTTP %d  %s"):format(code, title)
        end
        return title, Files.clip(text, maxChars), ctype
    end
end


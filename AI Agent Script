registerTool("set_properties",
    "Write properties straight onto a live instance (client-side).",
    {
        type = "object",
        properties = {
            path = strParam("Target path"),
            props = strParam("JSON object string, e.g. {\"Text\":\"Play\",\"BackgroundColor3\":\"40,160,80\",\"WalkSpeed\":32}"),
        },

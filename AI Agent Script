local function isOwnGui(inst)
    if typeof(inst) ~= "Instance" then return false end
    if inst == Overlay then return true end
    local ok, inside = pcall(function() return inst:IsDescendantOf(Overlay) end)
    return (ok and inside) and true or false
end

local function readProp(inst, name)
    local ok, value = pcall(function() return inst[name] end)
    if ok then return value end
    return nil
end

local function shortErr(err)
    local text = tostring(err or "unknown error")
    text = text:gsub("^.-:%d+: ", "")
    if #text > 100 then
        text = text:sub(1, 97) .. "..."
    end
    return text
end

local function getCharacter()
    return LocalPlayer.Character
end

local function getHumanoid()
    local character = LocalPlayer.Character
    return character and character:FindFirstChildOfClass("Humanoid") or nil
end

local function getRoot()
    local character = LocalPlayer.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
end

local function getOutputGui()
    local existing = PlayerGui:FindFirstChild(CONFIG.OutputGuiName)
    if existing and existing:IsA("ScreenGui") then
        return existing
    end
    return create("ScreenGui", {
        Name = CONFIG.OutputGuiName,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, PlayerGui)
end

-- Path shortcuts accepted as the FIRST path segment (case-insensitive).
local PATH_SHORTCUTS = {
    game          = function() return game end,
    datamodel     = function() return game end,
    me            = function() return LocalPlayer end,
    localplayer   = function() return LocalPlayer end,
    playergui     = function() return PlayerGui end,
    character     = getCharacter,
    char          = getCharacter,
    camera        = function() return workspace.CurrentCamera end,
    workspace     = function() return workspace end,
    backpack      = function() return LocalPlayer:FindFirstChildOfClass("Backpack") end,
    playerscripts = function() return LocalPlayer:FindFirstChild("PlayerScripts") end,
    output        = getOutputGui,
}

local function splitPath(path, pattern)
    local parts = {}
    for seg in path:gmatch(pattern) do
        seg = trim(seg)
        if seg ~= "" then
            table.insert(parts, seg)
        end
    end
    return parts
end

local function resolveSegments(parts)
    if #parts == 0 then
        return game
    end
    local first = parts[1]
    local node = nil
    local shortcut = PATH_SHORTCUTS[first:lower()]
    if shortcut then
        local ok, value = pcall(shortcut)
        if ok and typeof(value) == "Instance" then
            node = value
        end
    end
    if not node then
        local okChild, child = pcall(function() return game:FindFirstChild(first) end)
        if okChild and child then
            node = child
        else
            local okSvc, svc = pcall(function() return game:GetService(first) end)
            if okSvc and typeof(svc) == "Instance" then
                node = svc
            end
        end
    end
    if not node then
        return nil
    end
    for i = 2, #parts do
        local seg = parts[i]
        local nextNode = nil
        if node == Players and (seg == "LocalPlayer" or seg:lower() == "me") then
            nextNode = LocalPlayer
        else
            local ok, child = pcall(function() return node:FindFirstChild(seg) end)
            if ok then
                nextNode = child
            end
        end
        if not nextNode then
            return nil
        end
        node = nextNode
    end
    return node
end

-- "Workspace/Map/Door", "game.Workspace.Map", "PlayerGui/HUD", "Character/Head"
local function resolvePath(path)
    local p = trim(path):gsub("\\", "/")
    if p == "" then
        return nil
    end
    p = p:gsub([[^game:GetService%(%s*["']([^"']+)["']%s*%)]], "game/%1")
    local inst = resolveSegments(splitPath(p, "[^/]+"))
    if inst then
        return inst
    end
    if p:find(".", 1, true) and not p:find("/", 1, true) then
        return resolveSegments(splitPath(p, "[^%.]+"))
    end
    return nil
end

local function pathOf(inst)
    if typeof(inst) ~= "Instance" then
        return tostring(inst)
    end
    if inst == game then
        return "game"
    end
    local result
    local ok = pcall(function()
        local parts = {}
        local node = inst
        local character = LocalPlayer.Character
        while node and node ~= game do
            if node == PlayerGui then
                table.insert(parts, 1, "PlayerGui")
                result = table.concat(parts, "/")
                return
            elseif node == LocalPlayer then
                table.insert(parts, 1, "LocalPlayer")
                result = table.concat(parts, "/")
                return
            elseif character and node == character then
                table.insert(parts, 1, "Character")
                result = table.concat(parts, "/")
                return
            end
            table.insert(parts, 1, node.Name)
            node = node.Parent
        end
        if not node then
            result = "(not in game)/" .. table.concat(parts, "/")
        else
            result = table.concat(parts, "/")
        end
    end)
    if ok and result then
        return result
    end
    return inst.Name
end

---------------------------------------------------------------------------
-- Value formatting (what the AI reads)
---------------------------------------------------------------------------
local function fmtColor(c)
    return ("%d,%d,%d"):format(
        math.floor(c.R * 255 + 0.5),
        math.floor(c.G * 255 + 0.5),
        math.floor(c.B * 255 + 0.5))
end

local function fmtUdim2(u)
    return ("{%s,%s},{%s,%s}"):format(
        trimNum(round(u.X.Scale, 4)), trimNum(round(u.X.Offset, 2)),
        trimNum(round(u.Y.Scale, 4)), trimNum(round(u.Y.Offset, 2)))
end

local function fmtVec3(v)
    return ("%s,%s,%s"):format(trimNum(round(v.X, 2)), trimNum(round(v.Y, 2)), trimNum(round(v.Z, 2)))
end

local function fmtValue(v)
    local t = typeof(v)
    if t == "nil" then
        return "nil"
    elseif t == "string" then
        local s = v
        if #s > 200 then
            s = s:sub(1, 200) .. "..."
        end
        return ("%q"):format(s)
    elseif t == "number" then
        return fmtNum(v)
    elseif t == "boolean" then
        return tostring(v)
    elseif t == "Color3" then
        return fmtColor(v)
    elseif t == "UDim2" then
        return fmtUdim2(v)
    elseif t == "UDim" then
        return ("%s,%s"):format(trimNum(round(v.Scale, 4)), trimNum(round(v.Offset, 2)))
    elseif t == "Vector3" then
        return fmtVec3(v)
    elseif t == "Vector2" then
        return ("%s,%s"):format(fmtNum(v.X), fmtNum(v.Y))
    elseif t == "CFrame" then
        local rx, ry, rz = v:ToOrientation()
        return ("pos=%s rot=%s,%s,%s"):format(fmtVec3(v.Position),
            fmtNum(math.deg(rx)), fmtNum(math.deg(ry)), fmtNum(math.deg(rz)))
    elseif t == "EnumItem" then
        return tostring(v)
    elseif t == "BrickColor" then
        return "BrickColor(" .. v.Name .. ")"
    elseif t == "Instance" then
        return pathOf(v)
    elseif t == "NumberRange" then
        return ("%s..%s"):format(fmtNum(v.Min), fmtNum(v.Max))
    end
    return tostring(v)
end

-- One-line summary of an instance: path, class and its most useful props.
local function describeInstance(inst, path)
    local bits = { ("%s [%s]"):format(path or pathOf(inst), inst.ClassName) }
    local function add(label, value)
        if value ~= nil then
            table.insert(bits, label .. "=" .. tostring(value))
        end
    end
    local function p(name)
        return readProp(inst, name)
    end
    pcall(function()
        if inst:IsA("GuiObject") then
            add("Pos", fmtUdim2(inst.Position))
            add("Size", fmtUdim2(inst.Size))
            add("BG", fmtColor(inst.BackgroundColor3))
            if inst.BackgroundTransparency > 0 then
                add("BGT", fmtNum(inst.BackgroundTransparency))
            end
            if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                add("Text", ("%q"):format(tostring(inst.Text):sub(1, 80)))
                add("Font", inst.Font.Name)
                add("TextColor", fmtColor(inst.TextColor3))
                add("TextSize", trimNum(inst.TextSize))
            end
            if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
                add("Image", tostring(inst.Image))
            end
            add("Visible", tostring(inst.Visible))
        elseif inst:IsA("LayerCollector") then
            add("Enabled", tostring(inst.Enabled))
            if inst:IsA("ScreenGui") then
                add("DisplayOrder", trimNum(inst.DisplayOrder))
            end
        elseif inst:IsA("BasePart") then
            add("Pos", fmtVec3(inst.Position))
            add("Size", fmtVec3(inst.Size))
            add("Color", fmtColor(inst.Color))
            add("Material", inst.Material.Name)
            add("Anchored", tostring(inst.Anchored))
            add("CanCollide", tostring(inst.CanCollide))
            if inst.Transparency > 0 then
                add("Transparency", fmtNum(inst.Transparency))
            end
        elseif inst:IsA("Model") then
            local okPivot, pivot = pcall(function() return inst:GetPivot() end)
            if okPivot then
                add("Pivot", fmtVec3(pivot.Position))
            end
            if inst.PrimaryPart then
                add("PrimaryPart", inst.PrimaryPart.Name)
            end
        elseif inst:IsA("Humanoid") then
            add("Health", fmtNum(inst.Health) .. "/" .. fmtNum(inst.MaxHealth))
            add("WalkSpeed", fmtNum(inst.WalkSpeed))
            if inst.UseJumpPower then
                add("JumpPower", fmtNum(inst.JumpPower))
            else
                add("JumpHeight", fmtNum(inst.JumpHeight))
            end
        elseif inst:IsA("ValueBase") then
            add("Value", fmtValue(p("Value")))
        elseif inst:IsA("Sound") then
            add("SoundId", tostring(inst.SoundId))
            add("Playing", tostring(inst.Playing))
            add("Volume", fmtNum(inst.Volume))
        elseif inst:IsA("Light") then
            add("Brightness", fmtNum(inst.Brightness))
            add("Color", fmtColor(inst.Color))
            local range = p("Range")
            if range then add("Range", fmtNum(range)) end
        elseif inst:IsA("UICorner") then
            add("CornerRadius", fmtValue(inst.CornerRadius))
        elseif inst:IsA("UIStroke") then
            add("Color", fmtColor(inst.Color))
            add("Thickness", fmtNum(inst.Thickness))
        elseif inst:IsA("UIGradient") then
            local stops = {}
            for _, kp in ipairs(inst.Color.Keypoints) do
                table.insert(stops, fmtColor(kp.Value))
            end
            add("Colors", "{" .. table.concat(stops, ";") .. "}")
            add("Rotation", fmtNum(inst.Rotation))
        elseif inst:IsA("LuaSourceContainer") then
            local enabled = p("Enabled")
            if enabled ~= nil then
                add("Enabled", tostring(enabled))
            end
        elseif inst:IsA("Player") then
            add("DisplayName", inst.DisplayName)
            add("UserId", trimNum(inst.UserId))
            if inst.Team then
                add("Team", inst.Team.Name)
            end
        elseif inst:IsA("Camera") then
            add("Pos", fmtVec3(inst.CFrame.Position))
            add("FOV", fmtNum(inst.FieldOfView))
        elseif inst:IsA("Tool") then
            add("ToolTip", ("%q"):format(tostring(inst.ToolTip)))
        end
    end)
    local okKids, kidCount = pcall(function() return #inst:GetChildren() end)
    if okKids and kidCount > 0 then
        add("Children", trimNum(kidCount))
    end
    return table.concat(bits, "  ")
end

-- Indented tree for list_children (skips the chatbot's own GUI).
local function buildTree(root, maxDepth, maxNodes)
    local lines, count, truncated = {}, 0, false
    local function walk(inst, path, depth)
        if count >= maxNodes then
            truncated = true
            return
        end
        count += 1
        table.insert(lines, string.rep("  ", depth) .. describeInstance(inst, path))
        if depth >= maxDepth then
            return
        end
        local okKids, kids = pcall(function() return inst:GetChildren() end)
        if not okKids then
            return
        end
        for _, child in ipairs(kids) do
            if not isOwnGui(child) then
                local childPath = (path == "game") and child.Name or (path .. "/" .. child.Name)
                walk(child, childPath, depth + 1)
            end
        end
    end
    walk(root, pathOf(root), 0)
    if truncated then
        table.insert(lines, ("... (truncated at %d instances — list a deeper path)"):format(maxNodes))
    end
    return table.concat(lines, "\n")
end

---------------------------------------------------------------------------
-- Property coercion (JSON-friendly strings -> Roblox datatypes)
---------------------------------------------------------------------------
local NAMED_COLORS = {
    white = { 255, 255, 255 }, black = { 0, 0, 0 }, red = { 235, 50, 50 },
    green = { 50, 190, 80 }, blue = { 40, 110, 235 }, yellow = { 250, 210, 40 },
    orange = { 250, 140, 30 }, purple = { 150, 70, 220 }, pink = { 245, 110, 180 },
    gray = { 128, 128, 128 }, grey = { 128, 128, 128 }, cyan = { 40, 210, 240 },
    brown = { 130, 85, 45 },
}

local function toNumberList(raw)
    if type(raw) == "number" then
        return { raw }
    end
    if type(raw) == "table" then
        local nums = {}
        for _, v in ipairs(raw) do
            local n = tonumber(v)
            if n == nil then
                return nil
            end
            table.insert(nums, n)
        end
        return (#nums > 0) and nums or nil
    end
    if type(raw) ~= "string" then
        return nil
    end
    local s = trim(raw)
    s = s:gsub("^[%a_][%w_%.]*%s*%(", "")   -- UDim2.new( / Color3.fromRGB( / rgb(
    s = s:gsub("[%s{}%[%]%(%)]", "")
    if s == "" then
        return nil
    end
    local nums = {}
    for _, part in ipairs(string.split(s, ",")) do
        local n = tonumber(part)
        if n == nil then
            return nil
        end
        table.insert(nums, n)
    end
    return nums
end

local function parseColor(raw)
    if typeof(raw) == "Color3" then
        return raw
    end
    if type(raw) == "string" then
        local s = trim(raw)
        local hex = s:match("^#?(%x%x%x%x%x%x)$")
        if hex then
            local ok, c = pcall(Color3.fromHex, hex)
            if ok then
                return c
            end
        end
        local named = NAMED_COLORS[s:lower()]
        if named then
            return Color3.fromRGB(named[1], named[2], named[3])
        end
        if s:find("%a") and not s:find("%(") then
            local okBc, bc = pcall(BrickColor.new, s)
            if okBc and bc and bc.Name:lower() == s:lower() then
                return bc.Color
            end
        end
    end
    local nums = toNumberList(raw)
    if nums and #nums == 3 then
        if type(raw) == "string" and raw:find("Color3%.new") then
            return Color3.new(nums[1], nums[2], nums[3])
        end
        local unit, fraction = true, false
        for _, n in ipairs(nums) do
            if n > 1 then unit = false end
            if n ~= math.floor(n) then fraction = true end
        end
        if unit and fraction then
            return Color3.new(nums[1], nums[2], nums[3])
        end
        return Color3.fromRGB(nums[1], nums[2], nums[3])
    end
    return nil
end

local function findEnumItem(enumType, raw)
    if typeof(raw) == "EnumItem" then
        return raw
    end
    local okItems, items = pcall(function() return enumType:GetEnumItems() end)
    if not okItems then
        return nil
    end
    if type(raw) == "number" then
        for _, item in ipairs(items) do
            if item.Value == raw then
                return item
            end
        end
        return nil
    end
    local name = tostring(raw):match("([%w_]+)%s*$")
    if not name then
        return nil
    end
    local lower = name:lower()
    for _, item in ipairs(items) do
        if item.Name == name then
            return item
        end
    end
    for _, item in ipairs(items) do
        if item.Name:lower() == lower then
            return item
        end
    end
    local asNumber = tonumber(name)
    if asNumber then
        for _, item in ipairs(items) do
            if item.Value == asNumber then
                return item
            end
        end
    end
    return nil
end

local function coercePropValue(inst, propName, raw)
    local current = readProp(inst, propName)
    local ct = typeof(current)
    local s = (type(raw) == "string") and trim(raw) or nil

    if ct == "boolean" then
        if type(raw) == "boolean" then return raw end
        if type(raw) == "number" then return raw ~= 0 end
        if s then
            local l = s:lower()
            if l == "true" or l == "on" or l == "yes" or l == "1" then return true end
            if l == "false" or l == "off" or l == "no" or l == "0" then return false end
        end
        return raw
    elseif ct == "number" then
        return tonumber(raw) or raw
    elseif ct == "string" then
        if raw == nil then return "" end
        return tostring(raw)
    elseif ct == "EnumItem" then
        return findEnumItem(current.EnumType, raw) or raw
    elseif ct == "Color3" then
        return parseColor(raw) or raw
    elseif ct == "BrickColor" then
        if s then
            local okBc, bc = pcall(BrickColor.new, s)
            if okBc and bc and bc.Name:lower() == s:lower() then
                return bc
            end
        end
        local c = parseColor(raw)
        if c then
            return BrickColor.new(c)
        end
        return raw
    elseif ct == "UDim2" then
        local n = toNumberList(raw)
        if n and #n == 4 then
            return UDim2.new(n[1], n[2], n[3], n[4])
        elseif n and #n == 2 then
            local hint = s and s:lower() or ""
            if hint:find("fromscale") then
                return UDim2.fromScale(n[1], n[2])
            elseif hint:find("fromoffset") then
                return UDim2.fromOffset(n[1], n[2])
            end
            local scaleLike = math.abs(n[1]) <= 1 and math.abs(n[2]) <= 1
                and (n[1] ~= math.floor(n[1]) or n[2] ~= math.floor(n[2]))
            return scaleLike and UDim2.fromScale(n[1], n[2]) or UDim2.fromOffset(n[1], n[2])
        end
        return raw
    elseif ct == "UDim" then
        local n = toNumberList(raw)
        if n and #n == 2 then return UDim.new(n[1], n[2]) end
        if n and #n == 1 then return UDim.new(0, n[1]) end
        return raw
    elseif ct == "Vector2" then
        local n = toNumberList(raw)
        if n and #n == 2 then return Vector2.new(n[1], n[2]) end
        return raw
    elseif ct == "Vector3" then
        local n = toNumberList(raw)
        if n and #n == 3 then return Vector3.new(n[1], n[2], n[3]) end
        if n and #n == 1 then return Vector3.new(n[1], n[1], n[1]) end
        if s then
            local target = resolvePath(s)
            if target and target:IsA("BasePart") then return target.Position end
        end
        return raw
    elseif ct == "CFrame" then
        local n = toNumberList(raw)
        if n and #n == 3 then
            return CFrame.new(n[1], n[2], n[3])
        elseif n and #n == 6 then
            return CFrame.new(n[1], n[2], n[3])
                * CFrame.Angles(math.rad(n[4]), math.rad(n[5]), math.rad(n[6]))
        elseif n and #n == 12 then
            return CFrame.new(table.unpack(n))
        end
        if s then
            local target = resolvePath(s)
            if target and target:IsA("BasePart") then return target.CFrame end
            if target and target:IsA("Model") then return target:GetPivot() end
        end
        return raw
    elseif ct == "NumberRange" then
        local n = toNumberList(raw)
        if n and #n == 1 then return NumberRange.new(n[1]) end
        if n and #n == 2 then return NumberRange.new(n[1], n[2]) end
        return raw
    elseif ct == "NumberSequence" then
        local n = toNumberList(raw)
        if n and #n == 1 then return NumberSequence.new(n[1]) end
        if n and #n == 2 then return NumberSequence.new(n[1], n[2]) end
        return raw
    elseif ct == "ColorSequence" then
        if type(raw) == "table" and #raw == 2 and type(raw[1]) ~= "number" then
            local c1, c2 = parseColor(raw[1]), parseColor(raw[2])
            if c1 and c2 then return ColorSequence.new(c1, c2) end
        end
        if s and s:find("[;|]") then
            local a, b = s:match("^(.-)%s*[;|]%s*(.-)$")
            local c1, c2 = parseColor(a), parseColor(b)
            if c1 and c2 then return ColorSequence.new(c1, c2) end
        end
        local c = parseColor(raw)
        if c then return ColorSequence.new(c) end
        return raw
    elseif ct == "Instance" or current == nil then
        if s and s ~= "" then
            if s:lower() == "nil" then return nil end
            local target = resolvePath(s)
            if target then return target end
        end
    end
    -- Unknown / nil-valued property: best-effort generic conversion.
    if s and s:sub(1, 1) == "#" then
        local c = parseColor(s)
        if c then return c end
    end
    return raw
end

-- props may be a decoded table or a JSON object string.
local function decodeProps(raw)
    if type(raw) == "table" then
        return raw
    end
    if type(raw) == "string" and raw:match("%S") then
        local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if ok and type(data) == "table" then
            return data
        end
        return nil, "props must be a JSON object string, e.g. {\"Text\":\"Hi\",\"Size\":\"0,200,0,50\"}"
    end
    return {}
end

-- Returns applied count, failure list, and a pending "Parent" value.
local function applyProps(inst, props)
    local applied, failed, pendingParent = 0, {}, nil
    if type(props) ~= "table" then
        return applied, failed, nil
    end
    for propName, raw in pairs(props) do
        if type(propName) == "string" then
            if propName == "Parent" then
                pendingParent = raw
            else
                local okSet, setErr
                if propName == "Name" then
                    okSet, setErr = pcall(function() inst.Name = tostring(raw) end)
                else
                    local value = coercePropValue(inst, propName, raw)
                    okSet, setErr = pcall(function() inst[propName] = value end)
                end
                if okSet then
                    applied += 1
                else
                    table.insert(failed, propName .. " (" .. shortErr(setErr) .. ")")
                end
            end
        end
    end
    return applied, failed, pendingParent
end

---------------------------------------------------------------------------
-- Highlight (parts/models get a Highlight, GUI objects a temporary stroke)
---------------------------------------------------------------------------
local function highlightInstance(inst, seconds)
    if typeof(inst) ~= "Instance" then
        return false, "not an instance"
    end
    local duration = math.clamp(tonumber(seconds) or 4, 0.5, 30)
    if inst:IsA("BasePart") or inst:IsA("Model") then
        local hl = create("Highlight", {
            Name = "AIChatBot_Highlight",
            Adornee = inst,
            FillColor = THEME.Accent,
            FillTransparency = 0.5,
            OutlineColor = Color3.fromRGB(255, 255, 255),
            OutlineTransparency = 0,
            DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
        })
        local parented = pcall(function() hl.Parent = ProtectedParent end)
        if not parented or not hl.Parent then
            pcall(function() hl.Parent = inst end)
        end
        task.delay(duration, function()
            pcall(function() hl:Destroy() end)
        end)
        return true, ("Highlighted '%s' for %ss."):format(inst.Name, fmtNum(duration))
    elseif inst:IsA("GuiObject") then
        local stroke = create("UIStroke", {
            Name = "AIChatBot_Highlight",
            Color = THEME.Warn,
            Thickness = 3,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, inst)
        task.delay(duration, function()
            pcall(function() stroke:Destroy() end)
        end)
        return true, ("Outlined '%s' for %ss."):format(inst.Name, fmtNum(duration))
    end
    return false, "only BaseParts, Models and GuiObjects can be highlighted (got " .. inst.ClassName .. ")"
end


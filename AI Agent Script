-- One trace per agent run. traceGroup() returns the group new steps go into:
-- as soon as ANY other chat row (an AI response, an error, ...) was added
-- after the current group, a NEW group starts below it — so the chat reads
-- in real order:  workflow → response → workflow → response ...
local function newAgentTrace()
    return { body = nil, ctx = nil }
end

local function traceGroup(trace)
    if not trace.body or not trace.body.Parent or trace.ctx.chatOrder ~= messageOrder then
        trace.body, trace.ctx = addAgentTimeline()
    end
    return trace.body, trace.ctx
end


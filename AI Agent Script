registerTool("create_instance",
    "Create a real instance (Part, Frame, TextLabel, TextButton, UICorner, Highlight, Sound, PointLight, ...) and parent it.",
    {
        type = "object",
        properties = {
            class = strParam("Roblox class name, e.g. Part, Frame, TextButton, UICorner"),
            name = strParam("Name for the new instance"),
            parent_path = strParam("Parent path. Empty = 'Output' ScreenGui for GUI objects, Workspace for everything else."),
            props = strParam("JSON object string of initial properties, e.g. {\"Size\":\"0,200,0,50\",\"Text\":\"Hi\"}"),
        },
        required = { "class" },
    },
    function(args)
        local class = trim(args.class or args.class_name or "")
        if class == "" then
            return "ERROR: missing 'class'."
        end
        local props, propErr = decodeProps(args.props)
        if not props then
            return "ERROR: " .. propErr
        end
        local okNew, inst = pcall(Instance.new, class)
        if not okNew or typeof(inst) ~= "Instance" then
            return "ERROR: cannot create a '" .. class .. "' (" .. shortErr(inst) .. ")."
        end
        local parent
        local parentPath = trim(args.parent_path or "")
        if parentPath == "" and type(props.Parent) == "string" then
            parentPath = trim(props.Parent)
        end
        props.Parent = nil
        if parentPath ~= "" then
            parent = resolvePath(parentPath)
            if not parent or isOwnGui(parent) then
                pcall(function() inst:Destroy() end)
                return "ERROR: no usable instance at parent_path '" .. parentPath .. "'."
            end
        elseif inst:IsA("LayerCollector") and not inst:IsA("BillboardGui") and not inst:IsA("SurfaceGui") then
            parent = PlayerGui
        elseif inst:IsA("GuiObject") or inst:IsA("UIComponent") then
            parent = getOutputGui()
        else
            parent = workspace
        end
        if type(args.name) == "string" and trim(args.name) ~= "" then
            pcall(function() inst.Name = trim(args.name) end)
        end
        if inst:IsA("ScreenGui") then
            pcall(function() inst.ResetOnSpawn = false end)
        end
        local applied, failed = applyProps(inst, props)
        -- Parts with no explicit placement appear in front of the player.
        if inst:IsA("BasePart") and props.Position == nil and props.CFrame == nil then
            local root = getRoot()
            if root then
                pcall(function() inst.CFrame = root.CFrame * CFrame.new(0, 0, -8) end)
            end
        end
        local okParent, parentErr = pcall(function() inst.Parent = parent end)
        if not okParent then
            pcall(function() inst:Destroy() end)
            return "ERROR: could not parent into '" .. pathOf(parent) .. "': " .. shortErr(parentErr)
        end
        return ("Created %s '%s' — %d propert%s applied%s.  Path: %s"):format(
            class, inst.Name, applied, applied == 1 and "y" or "ies",
            #failed > 0 and ("; FAILED: " .. table.concat(failed, ", ")) or "",
            pathOf(inst))
    end)


-- JSON-schema object for providers that always need one (OpenAI, Anthropic).
local function objectSchema(parameters)
    if type(parameters) == "table" then
        return parameters
    end
    return { type = "object", properties = JSON_EMPTY_OBJECT }
end

local function runTool(call)
    if type(call) ~= "table" or type(call.name) ~= "string" then
        return "ERROR: malformed tool call."
    end
    local tool = AI_TOOLS[call.name]
    if not tool then
        return "ERROR: unknown tool '" .. call.name .. "'"
    end
    if call.name == "run_lua" and not AI.settings.allowRunLua then
        return "ERROR: run_lua is disabled — the user must enable 'Allow AI to run code' in Settings."
    end
    if not AI.toolEnabled(call.name) then
        return "ERROR: the user switched the '" .. call.name .. "' tool OFF (Settings → Tools). Ask them to enable it if you need it."
    end
    local args = (type(call.args) == "table" and call.args) or {}
    local ok, result = pcall(tool.run, args)
    if not ok then
        return "ERROR: " .. shortErr(result)
    end
    if result == nil or result == "" then
        return "ok"
    end
    return tostring(result)
end

local function summarizeArgs(args)
    if type(args) ~= "table" or next(args) == nil then
        return ""
    end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(args) end)
    local text = (ok and type(encoded) == "string") and encoded or "?"
    if #text > 140 then
        text = text:sub(1, 137) .. "..."
    end
    return text
end


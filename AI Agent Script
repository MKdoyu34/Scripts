local Bot = {}
Bot.player = LocalPlayer
function Bot.find(path)
    local inst = resolvePath(path)
    if isOwnGui(inst) then
        return nil
    end
    return inst
end
function Bot.path(inst) return pathOf(inst) end
function Bot.new(class, props, parent) return create(class, props, parent) end
function Bot.gui() return getOutputGui() end
function Bot.character() return getCharacter() end
function Bot.humanoid() return getHumanoid() end
function Bot.root() return getRoot() end
function Bot.notify(text, kind) notify(tostring(text), kind or "info", 3) end
function Bot.highlight(inst, seconds)
    if type(inst) == "string" then
        inst = resolvePath(inst)
    end
    return highlightInstance(inst, seconds)
end
GENV.AIBot = Bot

-- Compiles Luau with `bot` injected; optional print/warn capture.
local function compileWithBot(code, chunkName, captureLines)
    if not Executor.loadstring then
        return nil, "loadstring is not available on this executor"
    end
    local chunk, syntaxErr = Executor.loadstring(code, chunkName)
    if not chunk then
        return nil, "syntax — " .. tostring(syntaxErr)
    end
    pcall(function()
        local baseEnv = (type(getfenv) == "function" and getfenv(0)) or GENV
        local env = setmetatable({ bot = Bot, AIBot = Bot }, { __index = baseEnv })
        if captureLines then
            local function capture(prefix, realFn)
                return function(...)
                    local pieces = {}
                    for i = 1, select("#", ...) do
                        pieces[i] = tostring((select(i, ...)))
                    end
                    if #captureLines < 60 then
                        table.insert(captureLines, prefix .. table.concat(pieces, " "))
                    end
                    pcall(realFn, ...)
                end
            end
            env.print = capture("", print)
            env.warn = capture("[warn] ", warn)
        end
        setfenv(chunk, env)
    end)
    return chunk
end


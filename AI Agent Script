                child:Destroy()
            end
        end
        local query = trim(searchBox.Text):lower()
        pathLabel.Text = (query ~= "") and ("search: " .. query) or ("/" .. Browser.folder)
        upBtn.Visible = (query == "" and Browser.folder ~= "")
        local order = 0
        if not FS.listfiles then
            browserRow(1, "triangle-alert", THEME.Warn, "This executor has no listfiles()", nil, function() end)
            return
        end
        if query ~= "" then
            local all = Files.allFiles()
            for _, path in ipairs(all) do
                if path:lower():find(query, 1, true) then
                    order += 1
                    fileRow(order, path, path)
                    if order >= 150 then break end
                end
            end
            if order == 0 then
                browserRow(1, "search", THEME.TextDim, "No file names match.", nil, function() end)
            end
        else
            local entries, err = Files.list(Browser.folder)
            if not entries then
                browserRow(1, "triangle-alert", THEME.Warn, tostring(err), nil, function() end)
                return
            end
            for _, entry in ipairs(entries) do
                order += 1
                if entry.folder then
                    browserRow(order, "folder", THEME.Warn, entry.name, "open ›", function()
                        Browser.folder = entry.path
                        Composer.refreshBrowser()
                        list.CanvasPosition = Vector2.zero
                    end)
                else
                    fileRow(order, entry.path, entry.name)
                end
            end
            if order == 0 then
                browserRow(1, "folder-open", THEME.TextDim, "(empty folder)", nil, function() end)
            end
        end
        local n = #Files.attachments
        footer.Text = (n > 0) and (("%d file(s) attached — they go with your next message  ·  @ = insert @read-file"):format(n))
            or "Click a file to attach it  ·  @ = insert @read-file"
    end

    function Composer.openBrowser()
        ListPopup.close()
        hideSuggestions()
        local anchor = W.attachButton.AbsolutePosition
        local vp = viewportSize()
        local w, h = 330, 350
        local px = math.clamp(anchor.X, 8, math.max(8, vp.X - w - 8))
        local py = anchor.Y - h - 8
        if py < 8 then
            py = math.clamp(anchor.Y + 40, 8, math.max(8, vp.Y - h - 8))
        end
        panel.Position = UDim2.fromOffset(math.floor(px), math.floor(py))
        bCatcher.Visible = true
        panel.Visible = true
        Composer.refreshBrowser()
    end

    W.attachButton.Activated:Connect(function()
        if panel.Visible then
            closeBrowser()
        else
            Composer.openBrowser()
        end
    end)
    bCatcher.Activated:Connect(closeBrowser)
    closeBtn.Activated:Connect(closeBrowser)
    doneBtn.Activated:Connect(closeBrowser)
    upBtn.Activated:Connect(function()
        Browser.folder = Files.parent(Browser.folder)
        Composer.refreshBrowser()
    end)
    refreshBtn.Activated:Connect(function()
        Files.index = nil
        Composer.refreshBrowser()
    end)
    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        Composer.refreshBrowser()
    end)

    ------------------------------------------------------------------
    -- Tools grid (Settings → Tools): click a chip to enable / disable
    ------------------------------------------------------------------
    local toolChips = {}
    local GOOD_BG = Color3.fromRGB(30, 56, 40)

    local function toolNames()
        local names = {}
        for name in pairs(AI_TOOLS) do
            table.insert(names, name)
        end
        table.sort(names)
        return names
    end

    local function refreshToolGrid()
        local on, total = 0, 0
        for name, chip in pairs(toolChips) do
            total += 1
            local enabled = AI.toolAllowed(name)
            if enabled then on += 1 end
            chip.button.BackgroundColor3 = enabled and GOOD_BG or THEME.Control
            chip.stroke.Color = enabled and THEME.Good or THEME.Stroke
            chip.label.TextColor3 = enabled and THEME.Text or THEME.TextDim
            chip.icon.ImageColor3 = enabled and THEME.Good or THEME.TextDim
            chip.state.Text = enabled and "ON" or "OFF"
            chip.state.TextColor3 = enabled and THEME.Good or THEME.Danger
        end
        W.toolsCount.Text = ("%d of %d tools enabled  ·  run_lua also follows \"Allow AI to run code\""):format(on, total)
    end
    Composer.refreshToolGrid = refreshToolGrid

    local function setToolAllowed(name, enabled)
        if name == "run_lua" then
            AI.settings.allowRunLua = enabled and true or false
        else
            if type(AI.settings.disabledTools) ~= "table" then
                AI.settings.disabledTools = {}
            end
            AI.settings.disabledTools[name] = (not enabled) and true or nil
        end
    end

    local function afterToolChange()
        saveSettings()
        refreshToolGrid()
        refreshToggleButtons()
        refreshStatusLabel()
    end

    for order, name in ipairs(toolNames()) do
        local button = create("TextButton", {
            Name = "Tool_" .. name,
            BackgroundColor3 = THEME.Control,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = "",
            LayoutOrder = order,
            ZIndex = 63,
        }, W.toolGrid)
        create("UICorner", { CornerRadius = UDim.new(0, 5) }, button)
        local stroke = create("UIStroke", { Color = THEME.Stroke, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, button)
        local icon = Icons.image(button, AI.toolIcon(name), {
            Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 7, 0.5, 0), color = THEME.TextDim, ZIndex = 64,
        })
        local label = create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(24, 0),
            Size = UDim2.new(1, -56, 1, 0),
            Text = name,
            TextColor3 = THEME.Text,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 64,
        }, button)
        local state = create("TextLabel", {
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -7, 0, 0),
            Size = UDim2.fromOffset(28, 24),
            Text = "ON",
            Font = Enum.Font.GothamBold,
            TextSize = 9,
            TextXAlignment = Enum.TextXAlignment.Right,
            ZIndex = 64,
        }, button)
        toolChips[name] = { button = button, stroke = stroke, icon = icon, label = label, state = state }
        button.MouseEnter:Connect(function()
            local tool = AI_TOOLS[name]
            W.toolHint.Text = name .. " — " .. tostring(tool and tool.description or "")
        end)
        button.Activated:Connect(function()
            local enabled = not AI.toolAllowed(name)
            setToolAllowed(name, enabled)
            afterToolChange()
            if name == "run_lua" then
                notify(enabled and "run_lua ENABLED — the AI may execute Luau code directly."
                    or "run_lua DISABLED.", enabled and "warn" or "info", 3)
            end
        end)
    end
    W.toolsAllOn.Activated:Connect(function()
        AI.settings.disabledTools = {}
        afterToolChange()
        notify("All tools enabled (run_lua keeps its own switch).", "success", 2.5)
    end)
    W.toolsAllOff.Activated:Connect(function()
        local set = {}
        for name in pairs(AI_TOOLS) do
            if name ~= "run_lua" then
                set[name] = true
            end
        end
        AI.settings.disabledTools = set
        AI.settings.allowRunLua = false
        afterToolChange()
        notify("All tools disabled — the AI can only chat (and use your @-commands).", "info", 3)
    end)
    -- the "Allow AI to run code" button and the run_lua chip stay in sync
    W.allowLuaButton.Activated:Connect(function()
        task.defer(refreshToolGrid)
    end)

    ------------------------------------------------------------------
    -- Web search settings
    ------------------------------------------------------------------
    local SEARCH_HINTS = {
        duckduckgo = "Free, no key. Falls back to Wikipedia if DuckDuckGo blocks the request.",
        brave = "Key: api.search.brave.com (free tier). Falls back to DuckDuckGo on errors.",
        tavily = "Key: app.tavily.com (free tier, AI-friendly results). Falls back to DuckDuckGo.",
        searxng = "Your own SearXNG instance (enable format=json). Falls back to DuckDuckGo.",
    }
    local function searchCfg()
        if type(AI.settings.search) ~= "table" then
            AI.settings.search = { engine = "duckduckgo", key = "", url = "" }
        end
        return AI.settings.search
    end
    local function refreshSearchUi()
        local cfg = searchCfg()
        local info = Web.engineInfo(cfg.engine)
        W.searchEngineButton.Text = info.label
        local needs = info.needs
        W.searchKeyBox.TextEditable = (needs ~= nil)
        W.searchKeyBox.PlaceholderText = info.placeholder or "No key needed"
        if not W.searchKeyBox:IsFocused() then
            if needs == "key" then
                W.searchKeyBox.Text = maskKey(cfg.key or "")
            elseif needs == "url" then
                W.searchKeyBox.Text = tostring(cfg.url or "")
            else
                W.searchKeyBox.Text = ""
            end
        end
        W.searchHint.Text = SEARCH_HINTS[info.id] or ""
    end
    Composer.refreshSearchUi = refreshSearchUi
    W.searchEngineButton.Activated:Connect(function()
        local items = {}
        for _, e in ipairs(Web.ENGINES) do
            table.insert(items, { id = e.id, label = e.label, icon = (e.id == "duckduckgo") and "search" or "globe" })
        end
        ListPopup.open(W.searchEngineButton.AbsolutePosition, W.searchEngineButton.AbsoluteSize, items,
            Web.engineInfo(searchCfg().engine).id, function(id)
                searchCfg().engine = id
                saveSettings()
                refreshSearchUi()
            end)
    end)
    W.searchKeyBox.Focused:Connect(function()
        local cfg = searchCfg()
        if Web.engineInfo(cfg.engine).needs == "key" then
            W.searchKeyBox.Text = tostring(cfg.key or "")
        end
    end)
    W.searchKeyBox.FocusLost:Connect(function()
        local cfg = searchCfg()
        local needs = Web.engineInfo(cfg.engine).needs
        if needs == "key" then
            cfg.key = trim(W.searchKeyBox.Text)
        elseif needs == "url" then
            cfg.url = trim(W.searchKeyBox.Text)
        end
        saveSettings()
        refreshSearchUi()
    end)

    ------------------------------------------------------------------
    -- Provider editor: icon colour (R G B boxes · hex · colour wheel)
    ------------------------------------------------------------------
    local function setBoxes(c)
        local boxes = { W.editColorR, W.editColorG, W.editColorB }
        if c then
            local parts = { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
            for i, box in ipairs(boxes) do
                if not box:IsFocused() then box.Text = tostring(parts[i]) end
            end
            if not W.editColorHex:IsFocused() then W.editColorHex.Text = "#" .. c:ToHex():upper() end
        else
            for _, box in ipairs(boxes) do
                if not box:IsFocused() then box.Text = "" end
            end
            if not W.editColorHex:IsFocused() then W.editColorHex.Text = "" end
        end
    end

    function Editor.setColor(c)
        Editor.color = c
        setBoxes(c)
        local shown = c or THEME.Custom
        W.editColorSwatch.BackgroundColor3 = shown
        W.editIconPreview.ImageColor3 = shown
    end

    local function fromBoxes()
        local r, g, b = tonumber(trim(W.editColorR.Text)), tonumber(trim(W.editColorG.Text)), tonumber(trim(W.editColorB.Text))
        if not r and not g and not b then
            Editor.setColor(nil)
            return
        end
        local base = Editor.color or THEME.Custom
        r = math.clamp(math.floor(r or base.R * 255 + 0.5), 0, 255)
        g = math.clamp(math.floor(g or base.G * 255 + 0.5), 0, 255)
        b = math.clamp(math.floor(b or base.B * 255 + 0.5), 0, 255)
        Editor.setColor(Color3.fromRGB(r, g, b))
    end
    for _, box in ipairs({ W.editColorR, W.editColorG, W.editColorB }) do
        box.FocusLost:Connect(fromBoxes)
        box:GetPropertyChangedSignal("Text"):Connect(function()
            local clean = box.Text:gsub("[^%d]", ""):sub(1, 3)
            if clean ~= box.Text then
                box.Text = clean
            end
        end)
    end
    W.editColorHex.FocusLost:Connect(function()
        local hex = trim(W.editColorHex.Text):gsub("^#", "")
        if hex == "" then
            Editor.setColor(nil)
            return
        end
        if #hex == 3 then
            hex = hex:sub(1, 1):rep(2) .. hex:sub(2, 2):rep(2) .. hex:sub(3, 3):rep(2)
        end
        local ok, c = pcall(Color3.fromHex, hex)
        if ok and c and #hex == 6 then
            Editor.setColor(c)
        else
            notify("Use a hex colour like #4285F4.", "warn", 2.5)
            Editor.setColor(Editor.color)
        end
    end)
    local function openWheel()
        ColorPicker.open(W.editColorSwatch.AbsolutePosition, W.editColorSwatch.AbsoluteSize,
            Editor.color or THEME.Custom, function(c)
                Editor.setColor(c)
            end)
    end
    W.editColorSwatch.Activated:Connect(openWheel)
    W.editColorWheel.Activated:Connect(openWheel)


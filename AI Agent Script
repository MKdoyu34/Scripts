---------------------------------------------------------------------------
-- History (provider-neutral). Entries come in four shapes:
--   { role = "user",  text = "..." }                              user turn
--   { role = "model", text = "...", calls = {...}, thoughts = "...",
--     key = "<provider>|<model>", raw = <provider-native turn> }   model turn
--   { role = "model", text = "..." }                              synthetic
--   { role = "user",  toolResults = { {name, id, nativeId, response} },
--     key = "<provider>|<model>" }                                 tool results
-- `raw` is replayed EXACTLY while the same provider + model continues the
-- chat (keeps Gemini thought signatures, Claude thinking blocks and OpenAI
-- reasoning items intact). After a provider/model switch, old turns are
-- flattened to plain text so every provider can read the whole history.
---------------------------------------------------------------------------
local function isPlainUserTurn(msg)
    return msg.role == "user" and msg.toolResults == nil
end

-- Keeps the last MaxTurnsKept user turns; never splits a turn.
local function pruneHistory()
    local turns, start = 0, 1
    for i = #AI.history, 1, -1 do
        if isPlainUserTurn(AI.history[i]) then
            turns += 1
            if turns >= CONFIG.MaxTurnsKept then
                start = i
                break
            end
        end
    end
    if start > 1 then
        local kept = {}
        for i = start, #AI.history do
            table.insert(kept, AI.history[i])
        end
        AI.history = kept
    end
end

local callCounter = 0
local function newCallId()
    callCounter += 1
    return ("call_aicb_%d_%d"):format(os.time() % 100000, callCounter)
end

local function historyKey(def, model)
    return tostring(def.id) .. "|" .. tostring(model)
end

local function flattenCalls(calls)
    local parts = {}
    for _, c in ipairs(type(calls) == "table" and calls or {}) do
        table.insert(parts, tostring(c.name) .. "(" .. summarizeArgs(c.args) .. ")")
    end
    return table.concat(parts, ", ")
end

-- Canonical items every adapter understands:
--   { kind = "text", role = "user"|"model", text = "...", nudge = bool }
--   { kind = "raw", entry = <model entry> }         native replay
--   { kind = "results", entry = <results entry> }   native tool results
local function canonicalHistory(currentKey, nudge)
    local items = {}
    local function pushText(role, text)
        if type(text) ~= "string" or not text:match("%S") then return end
        local last = items[#items]
        if last and last.kind == "text" and last.role == role then
            last.text = last.text .. "\n\n" .. text
        else
            table.insert(items, { kind = "text", role = role, text = text })
        end
    end
    for _, msg in ipairs(AI.history) do
        local native = (msg.key ~= nil and msg.key == currentKey)
        if msg.role == "user" and type(msg.toolResults) == "table" then
            if native then
                table.insert(items, { kind = "results", entry = msg })
            else
                local lines = {}
                for _, tr in ipairs(msg.toolResults) do
                    table.insert(lines, ("%s -> %s"):format(tostring(tr.name), clip(tostring(tr.response or ""), 1500)))
                end
                pushText("user", "[Tool results from an earlier step]\n" .. table.concat(lines, "\n"))
            end
        elseif msg.role == "model" then
            if native and msg.raw ~= nil then
                table.insert(items, { kind = "raw", entry = msg })
            else
                local text = tostring(msg.text or "")
                if type(msg.calls) == "table" and #msg.calls > 0 then
                    text = (text:match("%S") and (text .. "\n") or "") .. "[I called tools: " .. flattenCalls(msg.calls) .. "]"
                end
                pushText("model", text)
            end
        elseif msg.role == "user" then
            pushText("user", msg.text)
        end
    end
    -- The conversation must open with a plain user turn.
    while #items > 0 and not (items[1].kind == "text" and items[1].role == "user") do
        table.remove(items, 1)
    end
    if nudge then
        table.insert(items, { kind = "text", role = "user", text = nudge, nudge = true })
    end
    return items
end

---------------------------------------------------------------------------
-- THINKING — ordered fallbacks for the chosen level. compat.thinkStep walks
-- down the list whenever a model rejects one; past the end = no thinking
-- parameters at all. Every variant asks for visible thoughts where the API
-- supports it (Gemini includeThoughts, Claude display:"summarized", OpenAI
-- reasoning.summary:"auto").
---------------------------------------------------------------------------
local GEMINI_BUDGET = { minimal = 512, low = 2048, medium = 8192, high = 24576 }
local CLAUDE_BUDGET = { minimal = 1024, low = 2048, medium = 6000, high = 12000 }

local function thinkingVariants(format, level)
    level = level or "dynamic"
    if format == "gemini" then
        if level == "dynamic" then
            return { { thinkingBudget = -1, includeThoughts = true } }
        elseif level == "off" then
            return { { thinkingBudget = 0 } }
        end
        return {
            { thinkingLevel = level, includeThoughts = true },
            { thinkingBudget = GEMINI_BUDGET[level] or -1, includeThoughts = true },
        }
    elseif format == "anthropic" then
        if level == "off" then
            return {}
        end
        local effort = nil
        if level ~= "dynamic" then
            effort = (level == "minimal") and "low" or level
        end
        return {
            { mode = "adaptive", effort = effort },
            { mode = "enabled", budget = CLAUDE_BUDGET[level] or 8000 },
        }
    elseif format == "openai_responses" then
        if level == "dynamic" then
            return { { summary = "auto" } }
        elseif level == "off" then
            return { { effort = "none" }, { effort = "minimal" } }
        elseif level == "minimal" then
            return { { effort = "minimal", summary = "auto" }, { effort = "low", summary = "auto" } }
        end
        return { { effort = level, summary = "auto" } }
    elseif format == "openai_chat" then
        if level == "dynamic" or level == "off" then
            return {}
        end
        return { { reasoning_effort = (level == "minimal") and "low" or level } }
    end
    return {}
end


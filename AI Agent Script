registerTool("edit_file",
    "Edit an existing workspace file by exact find & replace: old_text must match the file exactly once (include enough surrounding lines), or set replace_all. Empty old_text appends new_text to the end.",
    {
        type = "object",
        properties = {
            path = strParam("File path relative to the workspace root"),
            old_text = strParam("Exact text to find (copy it from read_file). Empty = append"),
            new_text = strParam("Replacement text"),
            replace_all = { type = "boolean", description = "Replace every occurrence instead of exactly one" },
        },
        required = { "path", "new_text" },
    },
    function(args)
        local path, findErr = Files.resolve(args.path or "")
        if not path then
            return "ERROR: " .. tostring(findErr) .. " (use write_file to create a new file)"
        end
        local content, readErr = Files.read(path)
        if not content then
            return "ERROR: " .. tostring(readErr)
        end
        local oldText = tostring(args.old_text or "")
        local newText = tostring(args.new_text or "")
        local result
        if oldText == "" then
            local sep = (content ~= "" and content:sub(-1) ~= "\n") and "\n" or ""
            result = content .. sep .. newText
        else
            local usesCRLF = content:find("\r\n", 1, true) ~= nil
            if usesCRLF and not oldText:find("\r\n", 1, true) then
                oldText = oldText:gsub("\n", "\r\n")
                newText = newText:gsub("\r?\n", "\r\n")
            end
            local count, from = 0, 1
            while true do
                local a, b = content:find(oldText, from, true)
                if not a then break end
                count += 1
                from = b + 1
            end
            if count == 0 then
                return "ERROR: old_text was not found in " .. path .. " (it must match exactly, including spaces / indentation). read_file it again and copy the exact lines."
            end
            if count > 1 and not (args.replace_all == true or args.replace_all == "true") then
                return ("ERROR: old_text appears %d times in %s — include more surrounding lines so it matches once, or set replace_all."):format(count, path)
            end
            local parts, pos = {}, 1
            while true do
                local a, b = content:find(oldText, pos, true)
                if not a then break end
                table.insert(parts, content:sub(pos, a - 1))
                table.insert(parts, newText)
                pos = b + 1
            end
            table.insert(parts, content:sub(pos))
            result = table.concat(parts)
            local saved, err = Files.write(path, result)
            if not saved then
                return "ERROR: " .. tostring(err)
            end
            return ("Edited %s — replaced %d occurrence(s); now %d lines (verified)."):format(path, count, Files.lineCount(result))
        end
        local saved, err = Files.write(path, result)
        if not saved then
            return "ERROR: " .. tostring(err)
        end
        return ("Appended to %s — now %d lines (verified)."):format(path, Files.lineCount(result))
    end)


registerTool("search_instances",
    "Search descendants by name (case-insensitive substring) and/or class (IsA). Returns matching paths with key properties.",
    {
        type = "object",
        properties = {
            query = strParam("Part of the name to look for, e.g. 'coin'. Optional when class_name is given."),
            class_name = strParam("Class filter using IsA, e.g. 'BasePart', 'RemoteEvent', 'TextLabel'. Optional."),
            root_path = strParam("Where to search (default: whole game). e.g. 'Workspace', 'PlayerGui'."),
            max_results = { type = "integer", description = "Max matches to return (default 25, max 100)." },
        },
    },
    function(args)
        local query = trim(args.query or ""):lower()
        local className = trim(args.class_name or "")
        if query == "" and className == "" then
            return "ERROR: give 'query' and/or 'class_name'."
        end
        local root = game
        if trim(args.root_path or "") ~= "" then
            local inst, err = findTarget(args, "root_path")
            if err then return err end
            root = inst
        end
        local maxResults = math.clamp(math.floor(tonumber(args.max_results) or 25), 1, 100)
        local okList, descendants = pcall(function() return root:GetDescendants() end)
        if not okList then
            return "ERROR: can't scan '" .. pathOf(root) .. "': " .. shortErr(descendants)
        end
        local found, scanned = {}, 0
        for i, inst in ipairs(descendants) do
            if i % 5000 == 0 then
                task.wait()
            end
            scanned = i
            local okMatch, isMatch = pcall(function()
                if className ~= "" and not inst:IsA(className) then
                    return false
                end
                if query ~= "" and not inst.Name:lower():find(query, 1, true) then
                    return false
                end
                return true
            end)
            if okMatch and isMatch and not isOwnGui(inst) then
                table.insert(found, describeInstance(inst))
                if #found >= maxResults then
                    break
                end
            end
        end
        if #found == 0 then
            return ("No matches in '%s' (%d instances scanned)."):format(pathOf(root), scanned)
        end
        return ("%d match(es)%s:\n%s"):format(#found,
            (#found >= maxResults) and " (limit reached — narrow the search)" or "",
            table.concat(found, "\n"))
    end)


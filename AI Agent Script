                if okSet then
                    applied += 1
                else
                    table.insert(failed, "Parent (" .. shortErr(setErr) .. ")")
                end
            else
                table.insert(failed, "Parent (invalid or protected target)")
            end
        end
        return ("Applied %d propert%s to '%s'%s."):format(applied, applied == 1 and "y" or "ies",
            pathOf(inst), #failed > 0 and (" — FAILED: " .. table.concat(failed, ", ")) or "")
    end)


    ------------------------------------------------------------------
    local baseRefresh = refreshSettingsUi
    refreshSettingsUi = function()
        baseRefresh()
        refreshToolGrid()
        refreshSearchUi()
    end
    refreshToolGrid()
    refreshSearchUi()
end)()


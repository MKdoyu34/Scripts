-- LIVE MODEL LISTS (nothing hardcoded — every list comes from the API)
---------------------------------------------------------------------------
local OPENAI_NON_CHAT = {
    "embed", "tts", "whisper", "dall%-e", "moderation", "davinci", "babbage",
    "transcribe", "realtime", "audio", "image", "sora", "computer%-use",
}

local function fetchModelList(def)
    local headers = Providers.headers(def)
    local base = Providers.baseUrl(def)
    local list, failure = {}, nil
    local function getJson(url)
        local res, err = httpJson(url, "GET", nil, headers)
        if not res then
            return nil, tostring(err)
        end
        local data = jsonDecode(res.body)
        if not data then
            return nil, ("HTTP %s with an unreadable body."):format(tostring(res.code))
        end
        local apiErr = apiErrorText(data)
        if apiErr then
            return nil, "API error: " .. apiErr
        end
        return data
    end

    if base == "" then
        return list, "This provider has no Base URL — edit it first."
    end

    if def.format == "gemini" then
        local pageToken, pages = nil, 0
        repeat
            pages += 1
            local url = base .. "/models?pageSize=1000"
            if pageToken then
                url ..= "&pageToken=" .. HttpService:UrlEncode(pageToken)
            end
            local data, err = getJson(url)
            if not data then
                failure = err
                break
            end
            for _, m in ipairs(type(data.models) == "table" and data.models or {}) do
                if type(m) == "table" and type(m.name) == "string" then
                    local supported = type(m.supportedGenerationMethods) ~= "table"
                    for _, method in ipairs(type(m.supportedGenerationMethods) == "table" and m.supportedGenerationMethods or {}) do
                        if method == "generateContent" then
                            supported = true
                        end
                    end
                    if supported then
                        local id = m.name:gsub("^models/", "")
                        local label = id
                        if type(m.displayName) == "string" and m.displayName ~= "" then
                            label = m.displayName .. "  ·  " .. id
                        end
                        table.insert(list, { id = id, label = label })
                    end
                end
            end
            pageToken = (type(data.nextPageToken) == "string" and data.nextPageToken ~= "") and data.nextPageToken or nil
        until not pageToken or pages >= 5
    elseif def.format == "anthropic" then
        local after, pages = nil, 0
        repeat
            pages += 1
            local url = base .. "/models?limit=1000"
            if after then
                url ..= "&after_id=" .. HttpService:UrlEncode(after)
            end
            local data, err = getJson(url)
            if not data then
                failure = err
                break
            end
            for _, m in ipairs(type(data.data) == "table" and data.data or {}) do
                if type(m) == "table" and type(m.id) == "string" then
                    local label = m.id
                    if type(m.display_name) == "string" and m.display_name ~= "" then
                        label = m.display_name .. "  ·  " .. m.id
                    end
                    table.insert(list, { id = m.id, label = label })
                end
            end
            after = (data.has_more == true and type(data.last_id) == "string") and data.last_id or nil
        until not after or pages >= 5
    else
        local data, err = getJson(base .. "/models")
        if not data then
            failure = err
        else
            local items = (type(data.data) == "table" and data.data)
                or (type(data.models) == "table" and data.models)
                or ((type(data[1]) == "table") and data)
                or {}
            for _, m in ipairs(items) do
                if type(m) == "table" then
                    local id = m.id or m.name or m.model
                    if type(id) == "string" and id ~= "" then
                        local keep = true
                        if def.official then
                            local lowered = id:lower()
                            for _, pattern in ipairs(OPENAI_NON_CHAT) do
                                if lowered:find(pattern) then
                                    keep = false
                                    break
                                end
                            end
                        end
                        if keep then
                            local label = id
                            if type(m.name) == "string" and m.name ~= "" and m.name ~= id then
                                label = m.name .. "  ·  " .. id
                            end
                            table.insert(list, { id = id, label = label })
                        end
                    end
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.id < b.id end)
    return list, failure
end

---------------------------------------------------------------------------
-- One model request with automatic compatibility fallbacks (thinking
-- params, temperature, summaries, tools, max_tokens rejected by the chosen
-- model) and one retry for overload / rate-limit errors.
---------------------------------------------------------------------------
local function compatFor(def, model)
    local key = historyKey(def, model)
    local c = AI.compat[key]
    if not c then
        c = { thinkStep = 1 }
        AI.compat[key] = c
    end
    return c
end

local function containsAny(haystack, ...)
    for _, needle in ipairs({ ... }) do
        if haystack:find(needle, 1, true) then
            return true
        end
    end
    return false
end

-- opts: tools (bool), toolMode ("none" forces text), nudge (extra user text)
local function requestRound(def, model, opts)
    opts = opts or {}
    local adapter = Adapters[def.format] or Adapters.openai_chat
    local compat = compatFor(def, model)
    local transientRetried = false
    for _ = 1, 8 do
        local variants = thinkingVariants(def.format, AI.settings.thinking)
        local think = variants[compat.thinkStep or 1]
        local ctx = {
            def = def,
            model = model,
            base = Providers.baseUrl(def),
            headers = Providers.headers(def),
            items = canonicalHistory(historyKey(def, model), opts.nudge),
            system = buildSystemPrompt(),
            tools = opts.tools and not compat.noTools,
            toolMode = opts.toolMode,
            think = think,
            temperature = tonumber(AI.settings.temperature) or 0.8,
            compat = compat,
        }
        local url, headers, body = adapter.build(ctx)
        local res, err = httpJson(url, "POST", body, headers)
        if not res then
            return { err = tostring(err) }
        end
        local data = jsonDecode(res.body)
        local result
        if data then
            result = adapter.parse(data)
        else
            result = { err = ("Unreadable response (HTTP %s)."):format(tostring(res.code)) }
        end
        if not result.err then
            result.text = result.text or ""
            result.calls = result.calls or {}
            result.thoughts = result.thoughts or ""
            return result
        end

        local message = redactSecrets(result.err)
        local lowered = message:lower()
        local code = tonumber(res.code) or 0
        local aboutSignature = containsAny(lowered, "thought_signature", "thought signature")
        if not transientRetried and (code == 429 or code == 500 or code == 502 or code == 503 or code == 529
            or containsAny(lowered, "overloaded", "unavailable", "rate limit")) then
            transientRetried = true
            task.wait(2.5)
        elseif aboutSignature and def.format == "gemini" and not compat.keepThoughtParts then
            compat.keepThoughtParts = true
        elseif def.format == "openai_responses" and not compat.noInclude
            and containsAny(lowered, "encrypted_content", "include", "store") then
            compat.noInclude = true
        elseif def.format == "openai_responses" and not compat.noSummary
            and containsAny(lowered, "verif") and containsAny(lowered, "summar", "reasoning") then
            compat.noSummary = true
            notify("Reasoning summaries aren't available for this key/model — thoughts will be hidden.", "warn", 4)
        elseif def.format == "anthropic" and not compat.noDisplay and containsAny(lowered, "display") then
            compat.noDisplay = true
        elseif def.format == "anthropic" and not compat.noEffort and containsAny(lowered, "effort", "output_config") then
            compat.noEffort = true
        elseif not compat.noTemperature and containsAny(lowered, "temperature") then
            compat.noTemperature = true
        elseif def.format == "anthropic" and containsAny(lowered, "max_tokens", "maximum allowed number of output tokens")
            and (compat.maxTokens or CONFIG.MaxOutputTokens) > 4096 then
            compat.maxTokens = ((compat.maxTokens or CONFIG.MaxOutputTokens) > 8192) and 8192 or 4096
        elseif def.format == "openai_chat" and not compat.sendReasoning and containsAny(lowered, "reasoning_content") then
            compat.sendReasoning = true
        elseif think ~= nil and not aboutSignature and containsAny(lowered, "thinking", "reasoning", "effort",
            "budget", "thought", "adaptive") then
            compat.thinkStep = (compat.thinkStep or 1) + 1
            if compat.thinkStep > #variants then
                notify("This model rejected the Thinking setting — continuing without it.", "warn", 3.5)
            end
        elseif opts.tools and not compat.noTools and not aboutSignature
            and (containsAny(lowered, "function_declaration", "function calling", "tool use", "tools are not supported",
                "tool_config", "does not support tools")
                or (lowered:find("tool", 1, true) and lowered:find("support", 1, true))) then
            compat.noTools = true
            notify("This model doesn't support tools — chatting without them.", "warn", 4)
        else
            return { err = message }
        end
    end
    return { err = "Request failed after compatibility retries." }
end


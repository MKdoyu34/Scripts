    function(args)
        local code = tostring(args.code or "")
        if not code:match("%S") then
            return "ERROR: empty code."
        end
        local captured = {}
        local chunk, compileErr = compileWithBot(code, "AIChatBot_Tool", captured)
        if not chunk then
            return "ERROR: " .. tostring(compileErr)
        end
        local results = table.pack(pcall(chunk))
        local printed = (#captured > 0) and ("\nOutput:\n" .. table.concat(captured, "\n")) or ""
        if not results[1] then
            return clip("ERROR: runtime — " .. tostring(results[2]) .. printed, 4000)
        end
        local returns = {}
        for i = 2, results.n do
            table.insert(returns, fmtValue(results[i]))
        end
        local out = "OK — code ran without errors."
        if #returns > 0 then
            out ..= "  Returned: " .. table.concat(returns, ", ")
        end
        return clip(out .. printed, 4000)
    end)

-- Per-tool switches (Settings → Tools). run_lua also needs "Allow AI to run
-- code". AI.forcedTools = tools an @-command needs for the current run.
function AI.toolAllowed(name)
    if name == "run_lua" then
        return AI.settings.allowRunLua == true
    end
    local off = AI.settings.disabledTools
    return not (type(off) == "table" and off[name] == true)
end

function AI.toolEnabled(name)
    if name ~= "run_lua" and type(AI.forcedTools) == "table" and AI.forcedTools[name] then
        return true
    end
    return AI.toolAllowed(name)
end


local function stopRun(reason)
    if not AI.waiting then return end
    AI.runId += 1
    setWaiting(false)
    addChatMessage("system", reason or "Stopped.")
end

-- AGENT pipeline (one user message -> many visible AI responses):
--   1. POST with the tool declarations in the provider's own format
--   2. each round is a "Thought" step: the 3x3 loader while waiting, then
--      an expandable row with the model's thought summary
--   3. text the model writes in that round is shown right away as its own
--      response; the steps after it start a NEW inline workflow group, so
--      the chat reads  workflow → response → workflow → response ...
--   4. tool calls run for real; each gets an expandable row with the exact
--      arguments / Luau code and the result
--   5. results go back to the model (max MaxToolRounds rounds)
--   6. the final text answer ends the run with an "Answered" row
local function sendChat()
    if AI.waiting then
        stopRun("Stopped — the reply in flight will be ignored.")
        return
    end
    local text = trim(W.inputBox.Text)
    if text == "" and #Files.attachments == 0 then return end
    local mentions = Mentions.parse(text)
    if Mentions.isOnlyHelp(mentions, text) then
        W.inputBox.Text = ""
        addChatMessage("user", text)
        addChatMessage("system", Mentions.helpText())
        return
    end
    local def = Providers.active()
    if Providers.needsKey(def) and Providers.key(def.id) == "" then
        notify(("Add your %s API key in Settings first."):format(def.name), "warn", 3.5)
        showSettings(true)
        return
    end
    if Providers.baseUrl(def) == "" then
        notify(def.name .. " has no Base URL — edit it in Settings.", "warn", 3.5)
        showSettings(true)
        return
    end
    local model = Providers.model(def.id)
    if not model then
        notify(("Pick a %s model in Settings first."):format(def.name), "warn", 3.5)
        showSettings(true)
        return
    end
    if not Executor.http then
        addChatMessage("error", ("This executor has no HTTP request function (request / http_request), so the AI can't reach %s."):format(def.name))
        return
    end

    -- A run interrupted after its tools ran leaves a tool-result turn last;
    -- close it with a short model turn so roles keep alternating.
    local last = AI.history[#AI.history]
    if last and last.role == "user" and last.toolResults then
        table.insert(AI.history, { role = "model", text = "(The previous run was interrupted before I could finish.)" })
    end
    local attachments = AI.takeAttachments and AI.takeAttachments() or {}
    if text == "" then
        text = (#attachments > 1) and "(see the attached files)" or "(see the attached file)"
    end
    local shownText = text
    if #attachments > 0 then
        shownText = text .. "\n📎 " .. table.concat(attachments, ",  ")
    end
    addChatMessage("user", shownText)
    W.inputBox.Text = ""
    AI.forcedTools = {}   -- tools an @-command needs (this run only)

    AI.runId += 1
    local myRun = AI.runId
    local function stale()
        return AI.runId ~= myRun
    end
    local function status(line)
        if not stale() then
            W.statusLabel.Text = line
        end
    end
    setWaiting(true)

    task.spawn(function()
        local key = historyKey(def, model)
        local rounds = 0
        local runStarted = os.clock()
        local trace = newAgentTrace()   -- groups are created lazily, in order
        local answered = false

        local function finishAnswered(ok)
            if answered then return end
            answered = true
            local group, groupCtx = traceGroup(trace)
            local row = addAgentStep(group, groupCtx, ok and "Answered" or "Failed", {
                kind = "final",
                icon = ok and "circle-check-big" or "circle-x",
            })
            row.finish(ok, formatDuration(os.clock() - runStarted))
        end
        local function fail(step, startedAt, message)
            step.finish(false, formatDuration(os.clock() - startedAt), { error = message })
            finishAnswered(false)
            setWaiting(false)
            addChatMessage("error", message)
        end
        local function deliverFinal(result)
            table.insert(AI.history, {
                role = "model",
                text = result.text,
                thoughts = result.thoughts,
                key = key,
                raw = result.raw,
            })
            setWaiting(false)
            finishAnswered(true)
            addChatMessage("model", (result.text ~= "") and result.text or "(empty response)")
        end
        local function thoughtStep(label, liveText)
            local group, groupCtx = traceGroup(trace)
            return addAgentStep(group, groupCtx, label, {
                kind = "thought",
                liveText = liveText or (Providers.label(def) .. " is thinking..."),
            })
        end

        -- 0) @-commands + attached files run first (each one is a workflow
        --    step); their results are attached to the user's message.
        local extras = {}
        local function preStep(label, icon, args, runner)
            local group, groupCtx = traceGroup(trace)
            local step = addAgentStep(group, groupCtx, label, {
                kind = "tool", icon = icon, call = { name = label, args = args },
            })
            local tStep = os.clock()
            local okRun, ok, shown, attach, forced = pcall(runner)
            if not okRun then
                ok, shown, attach, forced = false, "ERROR: " .. shortErr(ok), nil, nil
            end
            step.finish(ok == true, formatDuration(os.clock() - tStep), { result = tostring(shown or "") })
            if type(attach) == "string" and attach ~= "" then
                table.insert(extras, attach)
            end
            if type(forced) == "table" then
                for _, toolName in ipairs(forced) do
                    AI.forcedTools[toolName] = true
                end
            end
        end
        for _, m in ipairs(mentions) do
            if m.cmd.name ~= "help" then
                status(("Running @%s..."):format(m.cmd.name))
                preStep("@" .. m.cmd.name, m.cmd.icon, { input = m.argText }, function()
                    return Mentions.run(m)
                end)
                if stale() then return end
            end
        end
        for _, path in ipairs(attachments) do
            status("Attaching " .. path .. "...")
            preStep("attach", "paperclip", { path = path }, function()
                return Mentions.attachmentStep(path)
            end)
            if stale() then return end
        end
        local fullText = text
        if #extras > 0 then
            fullText = text .. "\n\n" .. table.concat(extras, "\n\n")
        end
        table.insert(AI.history, { role = "user", text = fullText })
        pruneHistory()

        while true do
            status(("Agent mode — %s is thinking (%d tool round(s) so far)..."):format(def.name, rounds))
            local thought = thoughtStep((rounds == 0) and "Thought" or ("Thought · round " .. (rounds + 1)),
                (rounds == 0) and (Providers.label(def) .. " is thinking...")
                    or ("%s is thinking · round %d..."):format(Providers.label(def), rounds + 1))
            local t0 = os.clock()
            local okReq, result = pcall(requestRound, def, model, { tools = true })
            if not okReq then
                result = { err = "Internal error: " .. shortErr(result) }
            end
            if stale() then
                thought.finish(false, "stopped", { thoughts = result.thoughts })
                return
            end
            if result.err then
                fail(thought, t0, result.err)
                return
            end
            thought.finish(true, formatDuration(os.clock() - t0), { thoughts = result.thoughts })

            if #result.calls == 0 then
                deliverFinal(result)
                return
            end

            -- The model narrated between tools: show it as its own response.
            -- (The tool steps below then open a new workflow group under it.)
            rounds += 1
            if result.text:match("%S") then
                addChatMessage("model", result.text)
            end

            local results = {}
            for _, call in ipairs(result.calls) do
                status(("Agent mode — running %s..."):format(call.name))
                local group, groupCtx = traceGroup(trace)
                local step = addAgentStep(group, groupCtx, call.name, { kind = "tool", call = call })
                local tTool = os.clock()
                local output = runTool(call)
                local okTool = not tostring(output):match("^ERROR")
                step.finish(okTool, formatDuration(os.clock() - tTool), { result = output })
                if not okTool then
                    local short = tostring(output):gsub("[\r\n]+", " ")
                    if #short > 240 then
                        short = short:sub(1, 237) .. "..."
                    end
                    addChatMessage("error", ("%s(%s) failed: %s"):format(call.name, summarizeArgs(call.args), short))
                end
                table.insert(results, {
                    name = call.name,
                    id = call.id,
                    nativeId = call.nativeId,
                    response = output,
                })
            end
            -- Call turn + results are stored together so history stays valid.
            table.insert(AI.history, {
                role = "model",
                text = result.text,
                calls = result.calls,
                thoughts = result.thoughts,
                key = key,
                raw = result.raw,
            })
            table.insert(AI.history, { role = "user", toolResults = results, key = key })
            if stale() then
                return
            end

            if rounds >= CONFIG.MaxToolRounds then
                status("Agent mode — wrapping up...")
                local wrap = thoughtStep("Thought (wrap-up)", Providers.label(def) .. " is wrapping up...")
                local tWrap = os.clock()
                local okWrap, final = pcall(requestRound, def, model, {
                    tools = true,
                    toolMode = "none",
                    nudge = "Tool round limit reached — summarize what you did in plain text now (no more tool calls).",
                })
                if not okWrap then
                    final = { err = "Internal error: " .. shortErr(final) }
                end
                if stale() then
                    wrap.finish(false, "stopped")
                    return
                end
                if final.err then
                    fail(wrap, tWrap, final.err)
                    return
                end
                wrap.finish(true, formatDuration(os.clock() - tWrap), { thoughts = final.thoughts })
                if #final.calls > 0 then
                    final.raw = nil   -- never store an unanswered call
                end
                if final.text == "" then
                    final.text = "(tools finished — no summary returned)"
                end
                deliverFinal(final)
                return
            end
            task.wait(0.05)
        end
    end)
end


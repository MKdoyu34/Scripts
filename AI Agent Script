local Mentions = {}
do
    Mentions.COMMANDS = {
        { name = "web-search",     icon = "globe",              args = "<query>",                desc = "Search the web, attach the results",     arg = "text" },
        { name = "fetch-url",      icon = "link",               args = "<url>",                  desc = "Download a web page, attach its text",   arg = "url" },
        { name = "read-file",      icon = "file-text",          args = "<path> [question]",      desc = "Attach a file from your workspace",      arg = "file" },
        { name = "ask-about-file", icon = "file-question-mark", args = "<path> <question>",      desc = "Attach a file and ask about it",         arg = "file" },
        { name = "edit-file",      icon = "file-pen",           args = "<path> <change>",        desc = "Have the AI edit a file",                arg = "file",
          tools = { "edit_file", "write_file", "read_file" } },
        { name = "add-file",       icon = "file-plus",          args = "<path> <what goes in it>", desc = "Have the AI create a new file",        arg = "newfile",
          tools = { "write_file", "make_folder" } },
        { name = "list-files",     icon = "folder-tree",        args = "[folder]",               desc = "Attach a folder listing",                arg = "folder" },
        { name = "search-files",   icon = "file-search",        args = "<text>",                 desc = "Find files by name or content",          arg = "text" },
        { name = "game-info",      icon = "gamepad-2",          args = "",                       desc = "Attach a live game snapshot",            arg = "none" },
        { name = "help",           icon = "circle-question-mark", args = "",                     desc = "Show this list (nothing is sent)",       arg = "none" },
    }
    local ALIASES = {
        search = "web-search", web = "web-search", websearch = "web-search", ["search-web"] = "web-search",
        fetch = "fetch-url", url = "fetch-url", ["read-url"] = "fetch-url",
        read = "read-file", ["ask-file"] = "ask-about-file", edit = "edit-file",
        ["new-file"] = "add-file", ["create-file"] = "add-file", ["write-file"] = "add-file",
        ls = "list-files", ["find-files"] = "search-files", ["find-file"] = "search-files",
    }
    Mentions.byName = {}
    AI.mentionNames = {}
    for _, c in ipairs(Mentions.COMMANDS) do
        Mentions.byName[c.name] = c
        AI.mentionNames[c.name] = true
    end
    for alias, target in pairs(ALIASES) do
        Mentions.byName[alias] = Mentions.byName[target]
        AI.mentionNames[alias] = true
    end

    -- Finds every known "@command" (at the start or after whitespace). Its
    -- argument text runs to the end of that line or to the next command.
    function Mentions.parse(text)
        local found = {}
        local s = " " .. tostring(text or "")
        local pos = 1
        while true do
            local a, b, name = s:find("%s@([%a][%w%-_]*)", pos)
            if not a then break end
            local cmd = Mentions.byName[name:lower()]
            if cmd then
                table.insert(found, { cmd = cmd, typed = name, from = a + 1, nameEnd = b })
            end
            pos = b + 1
        end
        for index, m in ipairs(found) do
            local stop = found[index + 1] and (found[index + 1].from - 1) or #s
            local rest = s:sub(m.nameEnd + 1, stop)
            local lineEnd = rest:find("\n", 1, true)
            if lineEnd then
                rest = rest:sub(1, lineEnd - 1)
            end
            m.argText = trim(rest)
        end
        return found
    end

    -- First token (quotes allowed for paths with spaces) + the rest.
    function Mentions.splitFirst(argText)
        local first, rest = argText:match('^"([^"]+)"%s*(.*)$')
        if not first then first, rest = argText:match("^'([^']+)'%s*(.*)$") end
        if not first then first, rest = argText:match("^(%S+)%s*(.*)$") end
        return first or "", rest or ""
    end

    function Mentions.helpText()
        local lines = { "**@-commands** — type them anywhere in a message; each runs first and attaches its result for the AI:", "" }
        for _, c in ipairs(Mentions.COMMANDS) do
            table.insert(lines, ("- `@%s%s` — %s"):format(c.name, (c.args ~= "") and (" " .. c.args) or "", c.desc))
        end
        table.insert(lines, "")
        table.insert(lines, "Example: `@read-file instructions_text.md how do i do this?`  ·  paths are relative to your executor's workspace folder (its root = `/`), quotes allow spaces: `@read-file \"my notes.txt\"`.")
        table.insert(lines, "The paperclip button next to the chat box browses / searches your workspace and attaches files. Type `@` for suggestions.")
        return table.concat(lines, "\n")
    end

    -- True when the message is nothing but @help.
    function Mentions.isOnlyHelp(found, text)
        if #found ~= 1 or found[1].cmd.name ~= "help" then
            return false
        end
        local without = (" " .. text):gsub("%s@[%a][%w%-_]*", "", 1)
        return trim(without) == ""
    end

    local function treeListing(folder, maxEntries)
        local lines = {}
        local _, cut = Files.walk(folder, 3, maxEntries, function(entry)
            table.insert(lines, entry.folder and (entry.path .. "/") or entry.path)
            return false
        end)
        table.sort(lines, function(a, b) return a:lower() < b:lower() end)
        return lines, cut
    end

    local function attachFile(path, note)
        local content, err = Files.read(path)
        if not content then
            return false, "ERROR: " .. tostring(err), nil
        end
        local block = Files.block(path, content, 30000)
        local shown = ("Attached %s (%d lines, %s)"):format(path, Files.lineCount(content), Files.formatSize(#content))
        return true, shown, (note and (note .. "\n") or "") .. block
    end

    -- Runs one parsed command → ok, shownResult (trace), attachment (for the AI), forcedTools
    function Mentions.run(m)
        local cmd, argText = m.cmd, m.argText or ""
        local name = cmd.name
        local tag = "[@" .. name .. "]"
        if name == "web-search" then
            local quoted = argText:match('^"([^"]+)"') or argText:match("^'([^']+)'")
            local query = quoted or argText
            if query == "" then
                return false, "ERROR: @web-search needs a query, e.g. @web-search roblox tween service", nil
            end
            local list, engine = Web.search(query, 6)
            if not list then
                local msg = "web search failed — " .. tostring(engine)
                return false, "ERROR: " .. msg, ("%s %s (tell the user; you may try the web_search tool)"):format(tag, msg)
            end
            local text = Web.formatResults(query, list, engine)
            return true, text, ("%s The user ran a web search. Use these results to answer and mention the URLs you rely on (fetch_url can open one for details):\n%s"):format(tag, text)
        elseif name == "fetch-url" then
            local url = Mentions.splitFirst(argText)
            if url == "" then
                return false, "ERROR: @fetch-url needs a URL, e.g. @fetch-url https://create.roblox.com/docs", nil
            end
            local title, text = Web.fetch(url, 12000)
            if not title then
                return false, "ERROR: " .. tostring(text), ("%s could not download %s: %s"):format(tag, url, tostring(text))
            end
            local block = ("%s Page the user attached: %s\nTitle: %s\n```text\n%s\n```"):format(tag, url, (title ~= "") and title or "(none)", text)
            return true, ("Downloaded %s — %s, %d chars"):format(url, (title ~= "") and title or "no title", #text), block
        elseif name == "read-file" or name == "ask-about-file" or name == "edit-file" then
            local query, rest = Mentions.splitFirst(argText)
            if query == "" then
                return false, ("ERROR: @%s needs a file path, e.g. @%s notes.md"):format(name, name), nil
            end
            local path, err = Files.resolve(query)
            if not path then
                return false, "ERROR: " .. tostring(err), ("%s the user referenced '%s' but no such file exists in their workspace — tell them."):format(tag, query)
            end
            local note
            if name == "ask-about-file" then
                note = ("%s The user is asking about this file%s"):format(tag, (rest ~= "") and (": " .. rest) or " (see their message).")
            elseif name == "edit-file" then
                note = ("%s The user wants you to EDIT `%s`%s. Apply it with edit_file (old_text must match the file exactly — copy from below) or write_file for a full rewrite, then say briefly what changed."):format(
                    tag, path, (rest ~= "") and (" — requested change: " .. rest) or " as described in their message")
            else
                note = ("%s File attached by the user%s:"):format(tag, (query ~= path) and (" ('" .. query .. "' → " .. path .. ")") or "")
            end
            local ok, shown, attach = attachFile(path, note)
            return ok, shown, attach or (tag .. " " .. shown), ok and cmd.tools or nil
        elseif name == "add-file" then
            local query, rest = Mentions.splitFirst(argText)
            local path, err = Files.normalize(query)
            if not path or path == "" then
                return false, "ERROR: " .. (err or "@add-file needs a file path, e.g. @add-file notes/todo.md a todo list"), nil
            end
            local exists = Files.isFile(path)
            local note = ("%s The user wants you to CREATE the file `%s` with write_file%s.%s Write the complete content, then confirm the path."):format(
                tag, path, (rest ~= "") and (" containing: " .. rest) or " (content as described in their message)",
                exists and " NOTE: that file already exists — overwriting replaces it; say so." or "")
            return true, ("%s %s"):format(exists and "Will overwrite" or "Will create", path), note, cmd.tools
        elseif name == "list-files" then
            local folder, err = Files.normalize(Mentions.splitFirst(argText))
            if not folder then
                return false, "ERROR: " .. err, nil
            end
            if folder ~= "" and not Files.isFolder(folder) then
                return false, "ERROR: no folder at '" .. folder .. "'", ("%s no folder '%s' exists."):format(tag, folder)
            end
            local lines, cut = treeListing(folder, 250)
            local shownFolder = (folder == "") and "/" or ("/" .. folder)
            local listing = (#lines > 0) and table.concat(lines, "\n") or "(empty)"
            return true, ("%s — %d entries%s"):format(shownFolder, #lines, cut and " (truncated)" or ""),
                ("%s Workspace listing of %s (folders end with /%s):\n%s"):format(tag, shownFolder, cut and ", truncated" or "", listing)
        elseif name == "search-files" then
            if argText == "" then
                return false, "ERROR: @search-files needs some text to look for", nil
            end
            local query = argText:match('^"([^"]+)"') or argText
            local results, err = Files.search(query, "", true, 30)
            if not results then
                return false, "ERROR: " .. tostring(err), nil
            end
            local text = Files.formatSearch(query, results)
            return true, text, ("%s Workspace search results:\n%s"):format(tag, text)
        elseif name == "game-info" then
            local tool = AI_TOOLS.get_game_info
            local ok, snapshot = pcall(tool.run, {})
            if not ok then
                return false, "ERROR: " .. tostring(snapshot), nil
            end
            return true, "Attached a live game snapshot", ("%s Live game snapshot:\n%s"):format(tag, tostring(snapshot))
        elseif name == "help" then
            return true, "Listed the @-commands", nil
        end
        return false, "ERROR: unknown command", nil
    end

    -- Paperclip attachments are sent like @read-file.
    function Mentions.attachmentStep(path)
        return attachFile(path, ("[attached file] The user attached `%s`:"):format(path))
    end
end


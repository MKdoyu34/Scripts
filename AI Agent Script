    },
    function(args)
        local inst, err = findTarget(args)
        if err then return err end
        local props, propErr = decodeProps(args.props)
        if not props then
            return "ERROR: " .. propErr
        end
        if next(props) == nil then
            return "ERROR: 'props' is empty."
        end
        local applied, failed, pendingParent = applyProps(inst, props)
        if pendingParent ~= nil then
            local target = nil
            local okResolve = true
            if type(pendingParent) == "string" and trim(pendingParent):lower() ~= "nil" then
                target = resolvePath(pendingParent)
                okResolve = target ~= nil and not isOwnGui(target)
            end
            if okResolve and not isProtectedInstance(inst) then

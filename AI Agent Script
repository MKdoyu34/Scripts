    local function currentColor()
        return Color3.fromHSV(state.h, state.s, state.v)
    end

    local function redraw(fire)
        local color = currentColor()
        shade.BackgroundTransparency = state.v
        local angle = state.h * 2 * math.pi
        marker.Position = UDim2.fromOffset(RADIUS + math.cos(angle) * state.s * RADIUS,
            RADIUS + math.sin(angle) * state.s * RADIUS)
        barGradient.Color = ColorSequence.new(Color3.fromHSV(state.h, state.s, 1), Color3.new(0, 0, 0))
        barMarker.Position = UDim2.fromScale(0.5, 1 - state.v)
        swatch.BackgroundColor3 = color
        hexLabel.Text = "#" .. color:ToHex():upper()
        if fire and state.onChange then
            pcall(state.onChange, color)
        end
    end

    -- Screen position of a pointer in the overlay's space (the overlay
    -- ignores the GUI inset, InputObject positions don't).
    local function pointer(input)
        if input and input.UserInputType == Enum.UserInputType.Touch then
            local inset = GuiService:GetGuiInset()
            return Vector2.new(input.Position.X, input.Position.Y) + inset
        end
        return UserInputService:GetMouseLocation()
    end

    local function applyPointer(pos)
        if state.dragging == "wheel" then
            local center = wheel.AbsolutePosition + wheel.AbsoluteSize / 2
            local d = pos - center
            local r = wheel.AbsoluteSize.X / 2
            local angle = math.atan2(d.Y, d.X)
            state.h = (angle / (2 * math.pi)) % 1
            state.s = math.clamp(d.Magnitude / math.max(1, r), 0, 1)
        elseif state.dragging == "bar" then
            local rel = (pos.Y - bar.AbsolutePosition.Y) / math.max(1, bar.AbsoluteSize.Y)
            state.v = 1 - math.clamp(rel, 0, 1)
        end
        redraw(true)
    end

    local function beginDrag(kind)
        return function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            state.dragging = kind
            state.dragInput = input
            applyPointer(pointer(input))
        end
    end
    wheelHit.InputBegan:Connect(beginDrag("wheel"))
    barHit.InputBegan:Connect(beginDrag("bar"))
    trackConnection(UserInputService.InputChanged:Connect(function(input)
        if not state.dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or (input.UserInputType == Enum.UserInputType.Touch and input == state.dragInput) then
            applyPointer(pointer(input))
        end
    end))
    trackConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            state.dragging = nil
            state.dragInput = nil
        end
    end))

    function ColorPicker.close()
        catcher.Visible = false
        panel.Visible = false
        state.dragging = nil
        state.onChange = nil
    end
    catcher.Activated:Connect(ColorPicker.close)
    doneBtn.Activated:Connect(ColorPicker.close)

    -- Opens the picker next to an anchor; onChange(Color3) fires live.
    function ColorPicker.open(anchorPos, anchorSize, color, onChange)
        local h, s, v = (color or Color3.new(1, 1, 1)):ToHSV()
        state.h, state.s, state.v = h, s, v
        state.onChange = onChange
        local size = panel.AbsoluteSize
        if size.X < 10 then size = Vector2.new(206, 206) end
        local vp = viewportSize()
        local px = anchorPos.X
        local py = anchorPos.Y + (anchorSize and anchorSize.Y or 26) + 6
        if px + size.X > vp.X - 8 then px = vp.X - 8 - size.X end
        if py + size.Y > vp.Y - 8 then py = anchorPos.Y - size.Y - 6 end
        panel.Position = UDim2.fromOffset(math.floor(math.max(8, px)), math.floor(math.max(8, py)))
        redraw(false)
        catcher.Visible = true
        panel.Visible = true
    end

    function ColorPicker.isOpen()
        return panel.Visible
    end
end



-- //////////////////////////////////////////////////////////////////////////
-- JSON HELPERS
-- //////////////////////////////////////////////////////////////////////////

-- Roblox encodes an empty Lua table as [] — some APIs need {} instead
-- (empty JSON-schema properties, empty tool inputs). Put this sentinel where
-- an empty object is required; jsonEncode swaps it for {}.
local JSON_EMPTY_OBJECT = "__AICB_EMPTY_OBJECT__"

local function jsonEncode(value)
    local ok, encoded = pcall(function() return HttpService:JSONEncode(value) end)
    if not ok or type(encoded) ~= "string" then
        return nil, tostring(encoded)
    end
    encoded = encoded:gsub('"' .. JSON_EMPTY_OBJECT .. '"', "{}")
    return encoded
end

local function jsonDecode(text)
    if type(text) ~= "string" or text == "" then
        return nil
    end
    local ok, data = pcall(function() return HttpService:JSONDecode(text) end)
    if ok and type(data) == "table" then
        return data
    end
    return nil
end

local function deepCopy(value, depth)
    depth = depth or 0
    if type(value) ~= "table" or depth > 30 then
        return value
    end
    local out = {}
    for k, v in pairs(value) do
        out[k] = deepCopy(v, depth + 1)
    end
    return out
end


-- //////////////////////////////////////////////////////////////////////////
-- DRAG / CLAMP HELPERS (mouse + touch, delta based — inset independent)
-- //////////////////////////////////////////////////////////////////////////

local lastPointer = Vector2.zero
local function inputScreenPos(inputObject)
    if inputObject then
        local ok, pos = pcall(function() return inputObject.Position end)
        if ok then
            local kind = typeof(pos)
            if kind == "Vector3" or kind == "Vector2" then
                lastPointer = Vector2.new(pos.X, pos.Y)
                return lastPointer
            end
        end
    end
    local ok, pos = pcall(function() return UserInputService:GetMouseLocation() end)
    if ok and typeof(pos) == "Vector2" then
        lastPointer = pos
    end
    return lastPointer
end

local function viewportSize()
    local size = Overlay.AbsoluteSize
    if size.X < 2 or size.Y < 2 then
        local camera = workspace.CurrentCamera
        if camera then
            size = camera.ViewportSize
        end
    end
    return size
end

-- Keeps `pos` (a UDim2 for `target`) on screen. The scale components are
-- preserved, so the toggle stays anchored to the right edge on resize.
--   keepFullyVisible = true  -> the whole object stays inside the screen
--   keepFullyVisible = false -> at least the title strip stays reachable
local function clampUDim2(target, pos, keepFullyVisible)
    local vp = viewportSize()
    local size = target.AbsoluteSize
    local anchor = target.AnchorPoint
    local x = vp.X * pos.X.Scale + pos.X.Offset - anchor.X * size.X
    local y = vp.Y * pos.Y.Scale + pos.Y.Offset - anchor.Y * size.Y
    local minX, maxX, minY, maxY
    if keepFullyVisible then
        minX, maxX = 0, vp.X - size.X
        minY, maxY = 0, vp.Y - size.Y
    else
        minX, maxX = -(size.X - 90), vp.X - 90
        minY, maxY = 0, vp.Y - 34
    end
    if maxX < minX then maxX = minX end
    if maxY < minY then maxY = minY end
    local cx = math.clamp(x, minX, maxX)
    local cy = math.clamp(y, minY, maxY)
    return UDim2.new(
        pos.X.Scale, math.floor(pos.X.Offset + (cx - x) + 0.5),
        pos.Y.Scale, math.floor(pos.Y.Offset + (cy - y) + 0.5))
end

local function isPointerDown(input)
    local kind = input.UserInputType
    return kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch
end

-- Generic drag controller. `handle` receives the press, `target` moves.
-- opts: threshold (px before it counts as a drag), keepFullyVisible,
--       onClick() (press + release without dragging), onDragEnd().
local function makeDraggable(handle, target, opts)
    opts = opts or {}
    local threshold = opts.threshold or 4
    local drag = nil

    local function finish()
        if not drag then return end
        local moved = drag.moved
        drag = nil
        if moved then
            if opts.onDragEnd then task.spawn(opts.onDragEnd) end
        elseif opts.onClick then
            task.spawn(opts.onClick)
        end
    end

    handle.InputBegan:Connect(function(input)
        if drag or not isPointerDown(input) then return end
        drag = {
            input  = input,
            touch  = input.UserInputType == Enum.UserInputType.Touch,
            start  = inputScreenPos(input),
            origin = target.Position,
            moved  = false,
        }
    end)

    trackConnection(UserInputService.InputChanged:Connect(function(input)
        if not drag then return end
        if drag.touch then
            if input ~= drag.input then return end
        elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end
        local delta = inputScreenPos(input) - drag.start
        if not drag.moved then
            if delta.Magnitude < threshold then return end
            drag.moved = true
        end
        local o = drag.origin
        target.Position = clampUDim2(target,
            UDim2.new(o.X.Scale, o.X.Offset + delta.X, o.Y.Scale, o.Y.Offset + delta.Y),
            opts.keepFullyVisible)
    end))

    trackConnection(UserInputService.InputEnded:Connect(function(input)
        if not drag then return end
        if drag.touch then
            if input ~= drag.input then return end
        elseif input.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end
        finish()
    end))
end


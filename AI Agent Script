-- list_children -------------------------------------------------------
registerTool("list_children",
    "Read part of the game tree: an instance and its descendants down to `depth`, each with class, key properties and exact path.",
    {
        type = "object",
        properties = {
            path = strParam("Root path, e.g. 'Workspace', 'PlayerGui', 'ReplicatedStorage'. Empty = game (all services)."),
            depth = { type = "integer", description = "How many levels to expand (1-4, default 1)." },
        },
    },
    function(args)
        local root = game
        if trim(args.path or "") ~= "" then
            local inst, err = findTarget(args)
            if err then return err end
            root = inst

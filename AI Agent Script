    function Composer.updateSuggestions()
        Composer.updateToken += 1
        local myToken = Composer.updateToken
        if not W.inputBox:IsFocused() then
            return
        end
        local token = currentToken()
        if not token then
            hideSuggestions()
            return
        end
        local items = {}
        if token.kind == "cmd" then
            for _, c in ipairs(Mentions.COMMANDS) do
                if c.name:sub(1, #token.partial) == token.partial or (#token.partial >= 2 and c.name:find(token.partial, 1, true)) then
                    table.insert(items, {
                        value = c.name,
                        icon = c.icon,
                        rich = ('<b>@%s</b> <font color="#9696A2">%s</font>'):format(c.name, Markdown.escape(c.args)),
                        desc = c.desc,
                        exact = (c.name == token.partial),
                    })
                end
            end
        else
            local partial = token.partial:lower()
            local all = Files.allFiles()
            if myToken ~= Composer.updateToken then return end
            local pool = all
            if token.kind == "folder" then
                local seen, folders = {}, {}
                for _, path in ipairs(all) do
                    local parent = Files.parent(path)
                    while parent ~= "" and not seen[parent] do
                        seen[parent] = true
                        table.insert(folders, parent)
                        parent = Files.parent(parent)
                    end
                end
                table.sort(folders)
                pool = folders
            end
            local scored = {}
            for _, path in ipairs(pool) do
                local pl = path:lower()
                local base = Files.baseName(pl)
                local score
                if partial == "" then
                    score = 3
                elseif pl == partial then
                    score = 0
                elseif base:sub(1, #partial) == partial or pl:sub(1, #partial) == partial then
                    score = 1
                elseif pl:find(partial, 1, true) then
                    score = 2
                end
                if score then
                    table.insert(scored, { path = path, score = score })
                end
            end
            table.sort(scored, function(a, b)
                if a.score ~= b.score then return a.score < b.score end
                return #a.path < #b.path
            end)
            for i = 1, math.min(7, #scored) do
                local path = scored[i].path
                table.insert(items, {
                    value = path,
                    icon = (token.kind == "folder") and "folder" or fileIcon(path),
                    rich = Markdown.escape(path),
                    exact = (path:lower() == partial),
                })
            end
            if #pool == 0 then
                table.insert(items, {
                    value = nil,
                    icon = "folder-open",
                    rich = '<font color="#9696A2">Your workspace folder is empty (or listfiles is unavailable).</font>',
                })
            end
        end
        if myToken ~= Composer.updateToken then return end
        Composer.token = token
        local previous = Composer.items[Composer.selected]
        Composer.items = items
        Composer.selected = 1
        if previous then
            for index, item in ipairs(items) do
                if item.value == previous.value then

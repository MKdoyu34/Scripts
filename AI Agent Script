-- Keep everything on screen when the viewport changes (rotation, resize).
trackConnection(Overlay:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
    fitWindowToViewport()
    W.toggle.Position = clampUDim2(W.toggle, W.toggle.Position, true)
end))

-- Watchdog: re-parent the overlay if anything ever removes it.
do
    local beat = 0
    trackConnection(RunService.Heartbeat:Connect(function()
        beat += 1
        if beat % 300 ~= 0 then return end
        if not Overlay.Parent then
            pcall(function() Overlay.Parent = resolveProtectedParent() end)
        end
    end))
end

-- Cleanup (called automatically when the script is executed again).
local function cleanup()
    AI.runId += 1
    for _, connection in ipairs(Connections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(Connections)
    pcall(function() Overlay:Destroy() end)
    if GENV.AIBot == Bot then
        GENV.AIBot = nil
    end
    if GENV.__AIChatBotCleanup == cleanup then
        GENV.__AIChatBotCleanup = nil
    end
end
GENV.__AIChatBotCleanup = cleanup

-- Small public API (handy for your own keybinds):
--   AIChatBot.toggle() / .open() / .close() / .destroy()
GENV.AIChatBot = {
    toggle  = function() setAiOn(not Toggle.on) end,
    open    = function() setAiOn(true) end,
    close   = function() setAiOn(false) end,
    destroy = cleanup,
}

-- //////////////////////////////////////////////////////////////////////////
-- BOOTSTRAP
-- //////////////////////////////////////////////////////////////////////////

task.wait()   -- one layout pass so AbsoluteSize values are real

do
    local ui = AI.settings.ui
    local savedWindowPos = nil
    if type(ui) == "table" then
        savedWindowPos = arrayToUDim(ui.window)
        local togglePos = arrayToUDim(ui.toggle)
        if togglePos then
            W.toggle.Position = togglePos
        end
    end
    fitWindowToViewport()
    if savedWindowPos then
        W.window.Position = savedWindowPos
    else
        local size = W.window.Size
        W.window.Position = UDim2.new(0.5, -math.floor(size.X.Offset * windowFitScale / 2),
            0.5, -math.floor(size.Y.Offset * windowFitScale / 2))
    end
    W.window.Position = clampUDim2(W.window, W.window.Position, false)
    W.toggle.Position = clampUDim2(W.toggle, W.toggle.Position, true)

    buildProviderCards()
    refreshSettingsUi()

    local def = Providers.active()
    local model = Providers.model(def.id)
    local keyMissing = Providers.needsKey(def) and Providers.key(def.id) == ""
    if AI.importedLegacy then
        addChatMessage("system", "Imported your Gemini API key, model and prompt from StudioGUI Creator (Google DeepMind card).")
    end
    if keyMissing then
        addChatMessage("system", ("Welcome! Open Settings, pick a provider card (OpenAI, Google DeepMind, Anthropic — or + Add provider), paste its API key, click Refresh and pick a model. Then just chat — the AI can also inspect and change the game client with its built-in tools. Click the arrow next to any Thought or tool step to see what the AI thought and ran. Tap the floating AI button to turn this window on/off (drag it to move it)."))
    elseif not model then
        addChatMessage("system", ("Pick a %s model in Settings to start chatting."):format(def.name))
    else
        addChatMessage("system", ("Ready — %s · %s. Ask anything, or ask the AI to look at or change something in the game."):format(def.name, model))
    end

    local needsSetup = keyMissing or not model
    showSettings(needsSetup)

    local startOpen = true
    if type(ui) == "table" and type(ui.open) == "boolean" then
        startOpen = ui.open
    end
    if needsSetup then
        startOpen = true
    end
    Toggle.unread = 0
    setAiOn(startOpen, true)
end

notify(CONFIG.Title .. " v" .. CONFIG.Version .. " loaded — " .. Executor.name, "success", 3.5)
print("[AI ChatBot] Ready. Tap the floating AI button (middle-right) to turn the chat ON/OFF; drag it or the window title bar to move them. Settings: provider cards (OpenAI / Google DeepMind / Anthropic / custom), API key, live model list, thinking, temperature, game context, run_lua gate, instructions.")

end -- main()


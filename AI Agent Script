-- Provider-neutral tool list (only the tools that are switched on).
-- Each provider adapter wraps it in its own wire format.
local function toolDeclarationList()
    local decls = {}
    for name, tool in pairs(AI_TOOLS) do
        if AI.toolEnabled(name) then
            table.insert(decls, {
                name = name,
                description = tool.description,
                parameters = tool.parameters,   -- nil for zero-argument tools
            })
        end
    end
    table.sort(decls, function(a, b) return a.name < b.name end)
    return decls

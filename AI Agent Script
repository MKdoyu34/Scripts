function SettingsUi.control(parent, class, props)
    local base = {
        BackgroundColor3 = THEME.Control,
        BorderSizePixel = 0,
        TextColor3 = THEME.Text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        ZIndex = 63,
    }
    for k, v in pairs(props) do
        if k ~= "NoStroke" and k ~= "Pad" then
            base[k] = v
        end
    end
    local inst = create(class, base, parent)
    create("UICorner", { CornerRadius = UDim.new(0, 5) }, inst)
    if not props.NoStroke then
        create("UIStroke", { Color = THEME.Stroke, Thickness = 1 }, inst)
    end
    if props.Pad then
        create("UIPadding", { PaddingLeft = UDim.new(0, props.Pad), PaddingRight = UDim.new(0, 6) }, inst)
    end
    return inst
end


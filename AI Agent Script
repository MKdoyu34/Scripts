local function maskKey(key)
    key = tostring(key or "")
    if key == "" then
        return ""
    end
    if #key <= 10 then
        return string.rep("•", #key)
    end
    return key:sub(1, 4) .. string.rep("•", 10) .. key:sub(-4)
end

-- Ready = has a key (when one is required), a base URL and a model.
local function providerReady(def)
    if Providers.needsKey(def) and Providers.key(def.id) == "" then
        return false
    end
    return Providers.baseUrl(def) ~= "" and Providers.model(def.id) ~= nil
end

local function canFetch(def)
    return Providers.baseUrl(def) ~= "" and (not Providers.needsKey(def) or Providers.key(def.id) ~= "")
end

local function refreshStatusLabel()
    if AI.waiting then return end
    local def = Providers.active()
    local model = Providers.model(def.id)
    local modelPart = model and ("Model: " .. model) or "Model: none — set in Settings"
    local ctxPart = AI.settings.context and "game context: on" or "game context: off"
    local luaPart = AI.settings.allowRunLua and "  ·  run_lua: on" or ""
    W.statusLabel.Text = def.name .. "  ·  " .. modelPart .. "  ·  " .. ctxPart .. luaPart
end

local function refreshModelControls()
    local def = Providers.active()
    local model = Providers.model(def.id)
    local list = AI.models[def.id]
    local fetching = AI.fetching[def.id]
    if not W.modelBox:IsFocused() then
        W.modelBox.Text = model or ""
    end
    W.modelBox.PlaceholderText = fetching and "Fetching models..." or "Type a model id, or click Select Model"
    if W.modelSelectLabel then
        W.modelSelectLabel.Text = fetching and "Fetching..." or "Select Model"
    end
    if list then
        W.modelCountLabel.Text = ("%d model(s) from %s — Select Model to choose, or type any id."):format(#list, def.name)
    elseif not canFetch(def) then
        W.modelCountLabel.Text = (Providers.baseUrl(def) == "") and "Set a Base URL for this provider first (pencil on its card)."
            or ("Paste your " .. def.name .. " API key, then click Select Model.")
    elseif fetching then
        W.modelCountLabel.Text = "Fetching the live model list from " .. def.name .. "..."
    else
        W.modelCountLabel.Text = "Click Select Model to fetch the live list — or type a model id."
    end
end

local function refreshKeyControls()
    local def = Providers.active()
    W.keyLabel.Text = def.name .. " API Key" .. (Providers.needsKey(def) and "" or "  (optional for local servers)")
    W.keyBox.PlaceholderText = def.keyPlaceholder or "Paste this provider's API key (leave empty if none is needed)"
    if def.keyHint then
        W.keyHint.Text = def.keyHint .. "  ·  saved in " .. CONFIG.SettingsFile
    else
        local base = Providers.baseUrl(def)
        W.keyHint.Text = ((base ~= "") and ("Endpoint: " .. base) or "No Base URL set") .. "  ·  saved in " .. CONFIG.CustomFile
    end
    if not W.keyBox:IsFocused() then
        W.keyBox.Text = maskKey(Providers.key(def.id))
    end
end


local function editSummary(ops)
	local counts = { create = 0, set = 0, delete = 0 }
	for _, op in ipairs(ops) do counts[op.action] += 1 end
	return string.format("Create %d objects · Set %d properties · Delete %d objects", counts.create, counts.set, counts.delete)
end

local function showPlan(data, ops)
	local names, lines = {}, {}
	for id, node in ipairs(data.nodes) do names[id] = node.props.Name or node.class end
	for i, op in ipairs(ops) do
		local name = names[op.id] or tostring(op.id)
		if op.action == "create" then
			names[op.id] = op.class
			lines[i] = "Create " .. op.class .. " #" .. op.id .. " under " .. (names[op.parent] or tostring(op.parent))
		elseif op.action == "set" then
			lines[i] = "Set " .. name .. "." .. op.property .. " = " .. quote(op.value)
			if op.property == "Name" then names[op.id] = op.value end
		else lines[i] = "Delete " .. name .. " #" .. op.id .. " and its children" end
	end
	return table.concat(lines, "\n")
end


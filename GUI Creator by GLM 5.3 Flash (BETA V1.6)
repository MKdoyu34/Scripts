	local ratio = math.min(1, math.max(0.1, (bounds.X - 12) / win.width), math.max(0.1, (bounds.Y - 12) / win.height))
	win.zoom.Scale = ratio
	local mx, my = math.max(0, (bounds.X - win.width * ratio) / 2), math.max(0, (bounds.Y - win.height * ratio) / 2)
	win.x, win.y = math.clamp(win.x, -mx, mx), math.clamp(win.y, -my, my)
	win.box.Position = dim(0.5, win.x, 0.5, win.y)

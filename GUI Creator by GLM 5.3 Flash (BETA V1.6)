	if apiLoading then return end
	apiLoading = true
	task.spawn(function()
		local ok, result = pcall(function()
			local fn = requestFn()
			local text
			if fn then text = responseBody(fn({ Url = API_DUMP, Method = "GET" })) else text = Http:GetAsync(API_DUMP) end
			local data = Http:JSONDecode(text)
			check(type(data) == "table" and type(data.Classes) == "table", "Invalid API dump")
			local indexed = {}
			for _, c in ipairs(data.Classes) do if type(c.Name) == "string" then indexed[c.Name] = c end end
			check(indexed.ScreenGui and indexed.Instance, "Incomplete API dump")
			return indexed
		end)
		apiLoading = false
		if not alive then return end
		if ok then
			apiClasses, apiCache = result, {}
			-- Do not destroy a focused property field while the user is typing.
			local focused = Input:GetFocusedTextBox()
			if not focused or not focused:IsDescendantOf(props) then refreshProperties() end
		end
		if showResult then toast(ok and "Roblox property metadata updated" or "API dump unavailable; using the local property catalog", ok and C.green or C.red) end
	end)
end
refreshAPI.Activated:Connect(function() loadApi(true) end)

refreshTree(); refreshProperties(); updateStatus()
main.box.Visible = true
fitWindow(main)
loadApi(false)

local apiClasses, apiCache = {}, {}

local function propertyNames(class)
	local cached = apiCache[class]
	if cached then return cached end
	local seen, out = {}, {}
	for name in pairs(propertyInfo(class)) do seen[name] = true; out[#out + 1] = name end
	local cd = apiClasses[class]
	for _ = 1, 32 do
		if not cd then break end
		for _, member in ipairs(cd.Members or {}) do
			if member.MemberType == "Property" and type(member.Name) == "string" and member.Name ~= "Parent" and not seen[member.Name] then
				local skip = false
				for _, tag in ipairs(member.Tags or {}) do
					if tag == "Hidden" or tag == "NotScriptable" or tag == "Deprecated" or tag == "NotBrowsable" then skip = true end
				end
				if not skip then seen[member.Name] = true; out[#out + 1] = member.Name end
			end
		end
		cd = apiClasses[cd.Superclass]
	end
	table.sort(out)
	apiCache[class] = out
	return out
end


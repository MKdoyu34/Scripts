local function submit()
	local text = trim(chatInput.Text)
	if text == "" then return end
	if busyGemini then toast("Wait for the current Gemini request or clear chat", C.red); return end
	if not key then toast("Set a Gemini API key first", C.red); return end
	if #text > 4000 then toast("Keep the Gemini prompt under 4,000 bytes", C.red); return end
	local got, data, ids = guarded(function() return snapshot(root) end)
	if not got then return end
	if dismissPlan then dismissPlan() end
	local started, selectedID = revision, ids[selected]
	cancelToken += 1
	local token = cancelToken
	local requestKey = key
	busyGemini, send.Text, chatInput.Text = true, "Wait…", ""
	geminiState.Text = "Contacting Gemini…"
	note("You", text)
	task.spawn(function()
		local began = os.clock()
		local ok, plan = pcall(function()
			local catalogText = {}
			for class in pairs(CATALOG) do
				local fields = {}
				for name in pairs(propertyInfo(class)) do fields[#fields + 1] = name end
				table.sort(fields); catalogText[#catalogText + 1] = class .. ": " .. table.concat(fields, ", ")
			end
			table.sort(catalogText)
			local encoded = Http:JSONEncode(data.nodes)
			check(#encoded <= 150000, "Project is too large to send to Gemini. Local editing and saves still work.")
			return geminiRequest(requestKey, history, "User request:\n" .. text .. "\n\nSelected ID: " .. selectedID
				.. "\nAllowed class properties:\n" .. table.concat(catalogText, "\n")
				.. "\nCurrent project nodes (IDs are 1-based array positions):\n" .. encoded)
		end)
		if not alive or token ~= cancelToken then return end
		geminiIdle()
		if not ok then note("Gemini error", tostring(plan), Color3.fromRGB(255, 164, 164)); return end
		note(string.format("Gemini %.1fs", os.clock() - began), plan.message)
		local function remember(result)
			history[#history + 1] = { role = "user", parts = { { text = text } } }
			history[#history + 1] = { role = "model", parts = { { text = plan.message .. " [Edit status: " .. result .. "]" } } }
			while #history > 8 do table.remove(history, 1); table.remove(history, 1) end
		end
		if #plan.operations == 0 then remember("no changes"); return end
		if revision ~= started then note("Editor", "Project changed while Gemini was working. Ask again to use the current layout."); return end
		local validated, why = pcall(function()
			local staged = stageEdits(data, selectedID, plan.operations)
			staged:Destroy()
		end)
		if not validated then note("Editor", "Rejected the edit batch; nothing changed: " .. tostring(why)); return end
		local summary = editSummary(plan.operations)
		guarded(function()
			reviewPlan(data, plan.operations, function()
				check(revision == started and token == cancelToken, "This edit plan is no longer current. Ask Gemini again.")
				local t = os.clock()
				local nextRoot, nextSelected = stageEdits(data, selectedID, plan.operations)
				replaceRoot(nextRoot, nextSelected); changed(); remember("applied")
				note("Editor", string.format("Applied in %.2fs. %s", os.clock() - t, summary))
			end)
		end)
	end)
end

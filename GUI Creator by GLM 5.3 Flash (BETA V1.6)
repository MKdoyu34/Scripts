-- Pagination bounds the number of live text rows without truncating the file.
local function codeViewer(parent, pos, size)
	local pane = round(frame(parent, C.panel, pos, size))
	local prev = button(pane, "‹", xy(6, 4), xy(30, 27))
	local nextPage = button(pane, "›", xy(41, 4), xy(30, 27))
	local where = label(pane, "", xy(79, 4), dim(1, -87, 0, 27), { TextColor3 = C.dim, TextSize = 12 })
	local scroll = scroller(pane, xy(4, 37), dim(1, -8, 1, -43), false)
	local gutter = label(scroll, "", xy(3, 0), xy(51, 1), { Font = Enum.Font.Code, TextSize = 14,
		TextColor3 = C.dim, TextYAlignment = Enum.TextYAlignment.Top, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.None })
	local code = new("TextBox", scroll, { TextEditable = false, MultiLine = true, ClearTextOnFocus = false,
		TextWrapped = false, BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 14, TextColor3 = C.text,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		Position = xy(62, 0), Size = xy(200, 1), Text = "" })
	local page, perPage, lines = 1, 120, { "" }
	local function render()
		local pages = math.max(1, math.ceil(#lines / perPage))
		page = math.clamp(page, 1, pages)
		local a, b = (page - 1) * perPage + 1, math.min(page * perPage, #lines)
		local nums, chunk, w = {}, {}, 200
		for i = a, b do
			local line = lines[i]
			nums[#nums + 1], chunk[#chunk + 1] = tostring(i), line
			local extent = TextService:GetTextSize(line, 14, Enum.Font.Code, Vector2.new(1000000, 1000000))
			w = math.max(w, extent.X + 24)
		end
		local h = (#chunk + 1) * 18
		gutter.Text, code.Text = table.concat(nums, "\n"), table.concat(chunk, "\n")
		gutter.Size, code.Size, scroll.CanvasSize = xy(51, h), xy(w, h), xy(w + 70, h)
		scroll.CanvasPosition = Vector2.zero
		where.Text = "Page " .. page .. " / " .. pages .. "  ·  " .. #lines .. " lines"
	end
	prev.Activated:Connect(function() page -= 1; render() end)
	nextPage.Activated:Connect(function() page += 1; render() end)
	return function(text)
		lines, page = string.split(text, "\n"), 1
		render()
	end
end


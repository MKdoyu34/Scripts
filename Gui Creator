    local function sanitizeFileName(raw)
        local name = tostring(raw or "")
            :gsub("%.lua$", "")
            :gsub("[^%w%-_ ]", "")
            :gsub("^%s+", "")
            :gsub("%s+$", "")
        if #name > 48 then
            name = name:sub(1, 48)
        end
        if name == "" then
            return nil
        end
        return name
    end

    local function fileNameFor(name)
        return name .. ".lua"
    end

    local function listSaveNames()
        local names = {}
        if FS.available and FS.list then
            local ok, files = pcall(FS.list, SAVES_DIR)
            if ok and type(files) == "table" then
                for _, path in ipairs(files) do
                    local base = tostring(path):match("[^/\\]+$") or tostring(path)
                    if base:sub(-4) == ".lua" then
                        names[#names + 1] = base:sub(1, -5)
                    end
                end
            end
        else
            for name in pairs(memoryFiles) do
                names[#names + 1] = name
            end
        end
        table.sort(names, function(a, b)
            return a:lower() < b:lower()
        end)
        return names
    end

    local function saveExists(name)
        if FS.available then
            if FS.exists then
                local ok, res = pcall(FS.exists, SAVES_DIR .. "/" .. fileNameFor(name))
                return ok and res == true
            end
            for _, existing in ipairs(listSaveNames()) do
                if existing == name then
                    return true
                end
            end
            return false
        end
        return memoryFiles[name] ~= nil
    end

    local function saveRead(name)
        if FS.available then
            local ok, content = pcall(FS.read, SAVES_DIR .. "/" .. fileNameFor(name))
            return ok and content or nil
        end
        return memoryFiles[name]
    end

    local function saveWrite(name, content)
        if FS.available then
            if FS.mkdir then
                pcall(FS.mkdir, SAVES_DIR)
            end
            return pcall(FS.write, SAVES_DIR .. "/" .. fileNameFor(name), content)
        end
        memoryFiles[name] = content
        return true
    end

    local function saveDelete(name)
        if FS.available then
            if not FS.del then
                return false, "delfile is not available on this executor."
            end
            return pcall(FS.del, SAVES_DIR .. "/" .. fileNameFor(name))
        end
        memoryFiles[name] = nil
        return true
    end

    local function saveRename(oldName, newName)
        if FS.available then
            local content = saveRead(oldName)
            if type(content) ~= "string" then
                return false, "Could not read the original file."
            end
            if FS.mkdir then
                pcall(FS.mkdir, SAVES_DIR)
            end
            local okWrite = pcall(FS.write, SAVES_DIR .. "/" .. fileNameFor(newName), content)
            if not okWrite then
                return false, "writefile failed."
            end
            if FS.del then
                pcall(FS.del, SAVES_DIR .. "/" .. fileNameFor(oldName))
            end
            return true
        end
        memoryFiles[newName] = memoryFiles[oldName]
        memoryFiles[oldName] = nil
        return true

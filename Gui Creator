local function makeFloatingDraggable(handle, frame)
    local dragState
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragState = {
                startMouse = inputScreenPos(input),
                startPosition = frame.Position,
            }
        end
    end)
    trackConnection(UserInputService.InputChanged:Connect(function(input)
        if not dragState then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local delta = inputScreenPos(input) - dragState.startMouse
        frame.Position = UDim2.fromOffset(
            dragState.startPosition.X.Offset + delta.X,
            dragState.startPosition.Y.Offset + delta.Y
        )
    end))
    trackConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragState = nil
        end
    end))
end


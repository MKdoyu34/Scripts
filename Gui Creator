    -- Fetch Models (populates the +/- dropdown from the provider API).
    aiFetchModels = function()
        if AISettings.apiKey == "" then
            notify("Put your Google AI Gemini API key first.", "warn", 3)
            showSettings(true)
            return
        end
        fetchButton.Text = "Fetching..."
        task.spawn(function()
            local url = aiTrimBase(AISettings.baseURL) .. "/models?key=" .. AISettings.apiKey
            local okHttp, resp = httpRequest({ Url = url, Method = "GET" })
            fetchButton.Text = "Fetch Models"
            if not okHttp or type(resp) ~= "table" or not resp.Success then
                local detail = (type(resp) == "table" and tostring(resp.Body or ""):sub(1, 140)) or tostring(resp)
                notify("Fetch Models failed: " .. detail, "error", 4.5)
                return
            end
            local okJson, data = pcall(HttpService.JSONDecode, HttpService, resp.Body)
            if not okJson or type(data) ~= "table" or type(data.models) ~= "table" then
                notify("Fetch Models failed: unexpected API response.", "error", 4)
                return
            end
            local list = {}
            for _, m in ipairs(data.models) do
                if type(m) == "table" and type(m.name) == "string" then
                    local usable = true
                    if type(m.supportedGenerationMethods) == "table" then
                        usable = false
                        for _, method in ipairs(m.supportedGenerationMethods) do
                            if method == "generateContent" then
                                usable = true
                                break
                            end
                        end
                    end
                    if usable then
                        local id = m.name:gsub("^models/", "")
                        local pretty = (type(m.displayName) == "string" and m.displayName ~= "") and m.displayName or id
                        list[#list + 1] = { id = id, name = pretty }
                    end
                end
            end
            table.sort(list, function(a, b)
                return a.id < b.id
            end)
            AISettings.models = list
            aiSaveSettings()
            modelsOpen = true
            syncModelsPanel()
            if #list == 0 then
                notify("0 Models have been Fetched — none support generateContent.", "warn", 4)
            else
                notify(("%d Models have been Fetched."):format(#list), "success", 3.5)
            end
        end)
    end

    -- Chat request / response round-trip.
    local function aiRequestReply(history)
        local url = aiTrimBase(AISettings.baseURL)
            .. "/models/" .. AISettings.modelID .. ":generateContent?key=" .. AISettings.apiKey
        local contents = {}
        for _, m in ipairs(history) do
            contents[#contents + 1] = { role = m.role, parts = { { text = m.text } } }
        end
        local body = {
            contents = contents,
            systemInstruction = { parts = { { text = AI_SYSTEM_PROMPT } } },
        }
        local okHttp, resp = httpRequest({
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(body),
        })
        if not okHttp then
            return { ok = false, text = "HTTP request failed (" .. tostring(resp) .. "). Enable HTTP requests on your executor." }
        end
        if type(resp) ~= "table" or not resp.Success then
            local status = (type(resp) == "table" and resp.StatusCode) or 0
            local snippet = (type(resp) == "table" and tostring(resp.Body or "") or tostring(resp))
            snippet = snippet:gsub("%s+", " "):sub(1, 180)
            local extra = ""
            if status == 400 or status == 404 then
                extra = "\nTip: open Settings, click 'Fetch Models', then pick an available model."
            end
            return { ok = false, text = ("HTTP %d — %s%s"):format(status, snippet, extra) }
        end
        local okJson, data = pcall(HttpService.JSONDecode, HttpService, resp.Body)
        if not okJson or type(data) ~= "table" then
            return { ok = false, text = "Could not decode the AI response." }
        end
        if type(data.error) == "table" and type(data.error.message) == "string" then
            return { ok = false, text = data.error.message }
        end
        local out = {}
        if type(data.candidates) == "table" and type(data.candidates[1]) == "table"
            and type(data.candidates[1].content) == "table"
            and type(data.candidates[1].content.parts) == "table" then
            for _, part in ipairs(data.candidates[1].content.parts) do
                if type(part.text) == "string" then
                    out[#out + 1] = part.text
                end
            end
        end
        if #out == 0 then
            return { ok = false, text = "The model returned no text (the request may have been blocked)." }
        end
        return { ok = true, text = table.concat(out, "\n") }
    end

    local function sendMessage(rawText)
        local text = tostring(rawText):gsub("^%s+", ""):gsub("%s+$", "")
        if text == "" then return end
        if AISettings.apiKey == "" then
            notify("Set your Gemini API key in Settings first.", "warn", 3)
            showSettings(true)
            return
        end
        addBubble("user", text)
        AIChat.history[#AIChat.history + 1] = { role = "user", text = text }
        local pending = addBubble("model", "Thinking...")
        inputBox.Text = ""
        task.spawn(function()
            local reply = aiRequestReply(AIChat.history)
            if pending and pending.Parent then
                if reply.ok then
                    pending.Text = reply.text
                    AIChat.history[#AIChat.history + 1] = { role = "model", text = reply.text }
                else
                    pending.Text = "Error: " .. reply.text
                end
            end
            task.defer(function()
                pcall(function() messagesScroll.CanvasPosition = Vector2.new(0, 1000000) end)
            end)
        end)
    end

    sendButton.Activated:Connect(function()
        sendMessage(inputBox.Text)
    end)
    inputBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            sendMessage(inputBox.Text)
        end
    end)

    table.insert(UI.windows, window)
end


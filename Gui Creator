            notify("Select a save file in the list first.", "warn", 2.5)
            return false
        end
        return true
    end

    savesButton("Add File", 1, -72, function()
        openNameDialog("Add File — save current project as", "", function(raw)
            local name = sanitizeFileName(raw)
            if not name then
                notify("Invalid file name.", "error", 2.5)
                return
            end
            if saveExists(name) then
                notify("A file named '" .. name .. "' already exists — use Overwrite.", "warn", 3.5)
                return
            end
            local code = generateExportCode()
            if not code then
                notify("Nothing to save — build a GUI first.", "warn", 3)
                return
            end
            local ok, err = saveWrite(name, code)
            if ok then
                selectedFile = name
                refreshList()
                notify("Saved '" .. name .. "'.", "success", 3)
            else
                notify("Save failed: " .. tostring(err), "error", 4)
            end
        end)
    end)

    savesButton("Rename", 2, -72, function()
        if not requireSelection() then return end
        local oldName = selectedFile
        openNameDialog("Rename '" .. oldName .. "'", oldName, function(raw)
            local newName = sanitizeFileName(raw)
            if not newName then
                notify("Invalid file name.", "error", 2.5)
                return
            end
            if newName == oldName then
                return
            end
            if saveExists(newName) then
                notify("A file named '" .. newName .. "' already exists.", "error", 3.5)
                return
            end
            local ok, err = saveRename(oldName, newName)
            if ok then
                if selectedFile == oldName then
                    selectedFile = newName
                end
                refreshList()
                notify("Renamed to '" .. newName .. "'.", "success", 3)
            else
                notify("Rename failed: " .. tostring(err), "error", 4)
            end
        end)
    end)

    savesButton("Load", 3, -72, function()
        if not requireSelection() then return end
        local code = saveRead(selectedFile)
        if type(code) ~= "string" or code == "" then
            notify("Could not read '" .. selectedFile .. "'.", "error", 3)
            return
        end
        if not FS.loadstring then
            notify("loadstring is unavailable here — use 'View Code' and run it manually.", "warn", 4.5)
            return
        end
        local okFn, fn = pcall(FS.loadstring, code)
        if not okFn or type(fn) ~= "function" then
            notify("The saved code failed to compile: " .. tostring(fn), "error", 4.5)
            return
        end
        notify("Loading '" .. selectedFile .. "'...", "info", 2.5)
        task.spawn(function()
            pcall(fn)
            task.wait(0.3)
            pcall(function()
                ensureProjectIntegrity()
                invalidateExplorer()
                local guis = getProjectScreenGuis()
                if guis[1] then
                    Editor.select(guis[1])
                end
            end)
        end)
    end)

    savesButton("Overwrite", 1, -40, function()
        if not requireSelection() then return end
        local code = generateExportCode()
        if not code then
            notify("Nothing to save — build a GUI first.", "warn", 3)
            return
        end
        local ok, err = saveWrite(selectedFile, code)
        if ok then
            refreshList()
            notify("Overwritten '" .. selectedFile .. "'.", "success", 3)
        else
            notify("Overwrite failed: " .. tostring(err), "error", 4)
        end
    end)

    savesButton("View Code", 2, -40, function()
        if not requireSelection() then return end
        local code = saveRead(selectedFile)
        if type(code) ~= "string" then
            notify("Could not read '" .. selectedFile .. "'.", "error", 3)
            return
        end
        openViewer(selectedFile, code)
    end)

    savesButton("Delete", 3, -40, function()
        if not requireSelection() then return end
        local target = selectedFile
        openConfirmDialog("Are you sure you want to Delete this File?", function()
            local ok, err = saveDelete(target)
            if ok then
                if selectedFile == target then
                    selectedFile = nil
                end
                refreshList()
                notify("Deleted '" .. target .. "'.", "info", 2.5)
            else
                notify("Delete failed: " .. tostring(err), "error", 4)
            end
        end)
    end)

    function Saves.open()
        updateStorageLabel()
        refreshList()
        window.Visible = true
    end

    table.insert(UI.windows, window)
    table.insert(UI.windows, nameDialog)
    table.insert(UI.windows, confirmDialog)
    table.insert(UI.windows, viewer)
end

-- //////////////////////////////////////////////////////////////////////////
-- EDITOR ACTIONS
-- //////////////////////////////////////////////////////////////////////////

function Editor.select(inst)
    if inst ~= nil and (typeof(inst) ~= "Instance" or inst.Parent == nil) then
        inst = nil
    end
    State.selected = inst
    refreshExplorerSelection()
    PropPanel.build(inst)
    updateStatus()
end

function Editor.deleteSelected()
    local inst = State.selected
    if not isValidTarget(inst) then
        notify("Nothing selected.", "warn", 2)
        return
    end
    -- ScreenGui protection: the last remaining ScreenGui cannot be deleted.
    if inst:IsA("ScreenGui") then
        local remaining = 0
        for _, sg in ipairs(getProjectScreenGuis()) do
            if sg ~= inst then
                remaining += 1
            end
        end
        if remaining == 0 then
            notify("Protected: the project must keep at least one ScreenGui.", "error", 3.5)
            return
        end
    end
    local name = inst.Name
    local ok = pcall(function() inst:Destroy() end)
    if ok then
        Editor.select(nil)
        invalidateExplorer()
        notify(("Deleted '%s'"):format(name), "info", 2)
    else
        notify("Failed to delete instance.", "error", 2.5)
    end
end

function Editor.duplicateSelected()
    local inst = State.selected
    if not isValidTarget(inst) then
        notify("Nothing selected.", "warn", 2)
        return
    end
    local ok, clone = pcall(function() return inst:Clone() end)
    if not ok or not clone then
        notify("Cannot duplicate this instance.", "error", 2.5)
        return
    end
    clone.Name = uniqueName(inst.Name)
    pcall(function() clone.Parent = inst.Parent end)
    if clone:IsA("GuiObject") then
        pcall(function()
            local p = clone.Position
            clone.Position = UDim2.new(p.X.Scale, p.X.Offset + 14, p.Y.Scale, p.Y.Offset + 14)
        end)
    end
    invalidateExplorer()
    Editor.select(clone)
end

function Editor.setEditMode(enabled)
    State.editMode = enabled and true or false
    if UI.modeButton then
        UI.modeButton.Text = State.editMode and "Mode: Edit" or "Mode: Test"
    end
    syncSelectionVisuals()
    updateStatus()
    notify(State.editMode and "Edit mode enabled" or "Test mode enabled — click your GUI to interact", "info")
end

function Editor.destroy()
    for _, connection in ipairs(Connections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(Connections)
    pcall(function() Overlay:Destroy() end)
    print("[StudioGUI Creator] Editor closed. Your GUI instances remain in PlayerGui.")
end


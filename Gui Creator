local AI_SETTINGS_FILE = "StudioGUICreator/ai_settings.json"
local AI_KEY_LINK = "https://aistudio.google.com/app/apikey"

local function aiTrimBase(url)
    return tostring(url or ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("/+$", "")
end

local function aiSaveSettings()
    if not FS.available then return end
    pcall(function()
        FS.write(AI_SETTINGS_FILE, HttpService:JSONEncode({
            baseURL   = AISettings.baseURL,
            apiKey    = AISettings.apiKey,
            modelName = AISettings.modelName,
            modelID   = AISettings.modelID,
            models    = AISettings.models,
        }))
    end)
end

local function aiLoadSettings()
    if not FS.available or not FS.exists then return end
    pcall(function()
        if not FS.exists(AI_SETTINGS_FILE) then return end
        local data = HttpService:JSONDecode(FS.read(AI_SETTINGS_FILE))
        if type(data) ~= "table" then return end
        if type(data.baseURL) == "string" and data.baseURL ~= "" then AISettings.baseURL = data.baseURL end
        if type(data.apiKey) == "string" then AISettings.apiKey = data.apiKey end
        if type(data.modelName) == "string" and data.modelName ~= "" then AISettings.modelName = data.modelName end
        if type(data.modelID) == "string" and data.modelID ~= "" then AISettings.modelID = data.modelID end
        if type(data.models) == "table" then AISettings.models = data.models end
    end)
end

-- HttpService first, then executor-native request functions as a fallback.
local function httpRequest(params)
    local ok, resp = pcall(function()
        return HttpService:RequestAsync(params)
    end)
    if ok then
        return true, resp
    end
    local requestFn = (type(request) == "function" and request)
        or (type(http_request) == "function" and http_request)
        or nil
    if requestFn then
        local okReq, respReq = pcall(requestFn, params)
        if okReq and type(respReq) == "table" then
            local code = tonumber(respReq.StatusCode or respReq.status_code) or 0
            respReq.StatusCode = code
            if respReq.Success == nil then
                respReq.Success = (code >= 200 and code < 300)
            end
            if respReq.Body == nil then
                respReq.Body = respReq.body or respReq.ResponseBody or ""
            end
            return true, respReq
        end
    end
    return false, tostring(resp)
end


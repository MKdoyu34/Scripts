-- Optional: drag the floating button so it never obstructs Roblox's own controls.
do
	local dragging, dragStart, startPos = false, nil, nil
	toggleButton.InputBegan:Connect(function(inputObj)
		if inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = inputObj.Position
			startPos = toggleButton.Position
			inputObj.Changed:Connect(function()
				if inputObj.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(inputObj)
		if dragging and startPos and dragStart then
			if inputObj.UserInputType == Enum.UserInputType.MouseMovement or inputObj.UserInputType == Enum.UserInputType.Touch then
				local delta = inputObj.Position - dragStart
				toggleButton.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end
	end)
end

-- Clicking anywhere closes lightweight popups (never the Settings modal).
UserInputService.InputBegan:Connect(function(inputObj)
	if inputObj.UserInputType ~= Enum.UserInputType.MouseButton1 and inputObj.UserInputType ~= Enum.UserInputType.Touch then return end
	if not openPopup then return end
	local pos = inputObj.Position
	local p = openPopup.AbsolutePosition
	local s = openPopup.AbsoluteSize
	local inside = pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y
	if not inside then closePopup() end
end)


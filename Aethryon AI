local function recomposeHeight()
	local w = math.max(input.AbsoluteSize.X, 60)
	local text = input.Text
	if text == "" then text = " " end
	local size = TextService:GetTextSize(text, 15, FONT, Vector2.new(w, 100000))
	local want = math.clamp(size.Y + 26, COMPOSER_MIN, COMPOSER_MAX)
	if math.abs(want - composerH) > 1 then
		composerH = want
		tw(composerHolder, 0.16, { Size = UDim2.new(1, 0, 0, composerH) })
		tw(chatBody, 0.16, { Size = UDim2.new(1, 0, 1, -58 - composerH - 28) })
	end
	input.Scrollable = (size.Y + 6) > (composerH - 16)
	requestFade()
end

input:GetPropertyChangedSignal("Text"):Connect(recomposeHeight)
input:GetPropertyChangedSignal("AbsoluteSize"):Connect(recomposeHeight)


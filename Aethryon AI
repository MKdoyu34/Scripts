local function resolveEnv(): {[string]: any}
	local fe: any = rawget(_G :: any, "getfenv")
	if typeof(fe) == "function" then
		local ok, env = pcall(function() return (fe :: any)() end)
		if ok and typeof(env) == "table" then return env :: any end
	end
	return _G :: any
end
local ENV: {[string]: any} = resolveEnv()

local function execFn(...: string): any
	for i = 1, select("#", ...) do
		local name = (select(i, ...)) :: string
		local f = rawget(ENV, name)
		if f == nil then f = rawget(_G :: any, name) end
		if typeof(f) == "function" then return f end
	end
	return nil
end

local function executorName(): string
	local f = execFn("identifyexecutor", "getexecutorname")
	if f then
		local ok, name = pcall(f)
		if ok and typeof(name) == "string" and name ~= "" then return name end
	end
	return "Unknown"
end
local EXECUTOR_NAME: string = executorName()

local function copyToClipboard(text: string): (boolean, string)
	local f = execFn("setclipboard", "toclipboard")
	if f then
		local ok = pcall(f, text)
		if ok then return true, "Copied!" end
		return false, "Clipboard function failed."
	end
	return false, "No clipboard API available. Select the code and press Ctrl/Cmd+C."
end


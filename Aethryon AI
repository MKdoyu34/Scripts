local function selectModel(providerId: string, modelId: string)
	local p = Config.providers[providerId]
	if not p then return end
	p.model = modelId
	local spec = thinkingSpec(providerId)
	if not spec.supported then
		p.thinking = (spec.levels[spec.defaultIndex] or spec.levels[1]).label
	else
		local valid = false
		for _, l in ipairs(spec.levels) do
			if l.label == p.thinking then valid = true end
		end
		if not valid then p.thinking = (spec.levels[spec.defaultIndex] or spec.levels[1]).label end
	end
	refreshProviderButton()
	persist()
	notify({ title = "Model selected", desc = p.name .. " → " .. modelId, kind = "info", duration = 3 })
end


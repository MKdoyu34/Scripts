local function buildProvidersTab()
	local scroll = categoryContent()
	zindex(scroll, Z.modal + 2)
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	makeCaption(scroll,
		"<b>Security notice:</b> a Roblox LocalScript runs on the client. Anything you type here (including API keys) "
		.. "is visible to the client and is never a secure secret store. Keys are kept in memory only and are never written to "
		.. "saved configuration, logs, notifications or chat history. Production integrations must proxy requests through a secure server.",
		nextOrder())

	local function providerCard(pid: string)
		local p = Config.providers[pid]
		local card = makeRow(scroll, 0, { order = nextOrder(), auto = true })
		local cardList = vlist(card, 10)
		local head = new("Frame", { Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = card.ZIndex + 1, Parent = card })
		hlist(head, 10)
		local mark = new("TextLabel", {
			Size = UDim2.new(0, 38, 0, 38), BackgroundColor3 = T.input, BorderSizePixel = 0,
			Font = FONT_BOLD, TextSize = 14, TextColor3 = T.accent, Text = p.mark,
			ZIndex = card.ZIndex + 2, Parent = head,
		})
		corner(mark, 10)
		stroke(mark, T.border, 0.4)
		local nameCol = new("Frame", { Size = UDim2.new(1, -140, 1, 0), BackgroundTransparency = 1, LayoutOrder = 2, ZIndex = card.ZIndex + 2, Parent = head })
		vlist(nameCol, 2, Enum.VerticalAlignment.Center)
		new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Font = FONT_BOLD, TextSize = 14,
			TextColor3 = T.text, Text = p.name, TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = card.ZIndex + 3, Parent = nameCol,
		})
		local statusLabel = new("TextLabel", {
			Name = "Status", Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, Font = FONT,
			TextSize = 11, TextColor3 = T.textMuted, Text = "", TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = card.ZIndex + 3, Parent = nameCol,
		})
		local selectBtn = new("TextButton", {
			Size = UDim2.new(0, 92, 0, 30), BackgroundColor3 = T.input, BorderSizePixel = 0,
			AutoButtonColor = false, Font = FONT_MED, TextSize = 12, TextColor3 = T.textSub,
			Text = "Select", ZIndex = card.ZIndex + 2, Parent = head,
		})
		corner(selectBtn, 8)

		local function refreshStatus()
			local isActive = Config.activeProvider == pid
			selectBtn.Text = isActive and "Selected" or "Select"
			selectBtn.TextColor3 = isActive and T.accentHover or T.textSub
			stroke(card, isActive and T.accent or T.border, isActive and 0.15 or 0.45)
			local state
			if p.apiKey == "" then
				state = "Not configured — no key entered"
			elseif #p.models == 0 then
				state = "Key entered — models not fetched"
			elseif p.model == "" then
				state = "Key entered, " .. #p.models .. " models fetched — no model selected"
			else
				state = "Configured — key entered, model " .. p.model
			end
			statusLabel.Text = state
			statusLabel.TextColor3 = (p.apiKey == "") and T.textMuted or T.warn
		end

		selectBtn.Activated:Connect(function()
			Config.activeProvider = pid
			persist()
			refreshProviderButton()
			buildProvidersTab()
			notify({ title = "Provider selected", desc = p.name .. " is now active.", kind = "info", duration = 3 })
		end)

		makeCaption(card, "Base URL", 2)
		local urlBox = makeTextField(card, { Size = UDim2.new(1, 0, 0, 34), text = p.baseUrl, placeholder = "https://…" })
		urlBox.LayoutOrder = 3
		urlBox.FocusLost:Connect(function()
			local v = urlBox.Text
			if v:match("^https?://") then
				p.baseUrl = trimSlash(v)
				urlBox.Text = p.baseUrl
				persist()
			else
				urlBox.Text = p.baseUrl
				notify({ title = "Invalid URL", desc = "Base URL must start with http:// or https://", kind = "warn" })
			end
		end)

		makeCaption(card, "Selected Model", 4)
		local modelBtn = new("TextButton", {
			Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.input, BorderSizePixel = 0,
			AutoButtonColor = false, Font = FONT_MED, TextSize = 13, TextColor3 = T.text,
			Text = (p.model ~= "" and p.model) or "No model selected", TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 5, ZIndex = card.ZIndex + 2, Parent = card,
		})
		corner(modelBtn, 8)
		stroke(modelBtn, T.border, 0.4)
		pad(modelBtn, 10, 0, 26, 0)
		modelBtn.Activated:Connect(function()
			if #p.models == 0 then
				notify({ title = "No models yet", desc = "Press “Fetch AI Models” to retrieve the model list from " .. p.name .. ".", kind = "warn" })
				return
			end
			local panel, sc = makePopup(modelBtn, 280, 260)
			panel:SetAttribute("Owner", tostring(modelBtn))
			buildModelList(sc, pid, function(modelId)
				selectModel(pid, modelId)
				modelBtn.Text = modelId
				refreshStatus()
				closePopup()
			end)
		end)

		makeCaption(card, "Fetch AI Models", 6)
		local fetchRow = new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = 7, ZIndex = card.ZIndex + 1, Parent = card })
		hlist(fetchRow, 8)
		local fetchBtn = makeButton(fetchRow, "Fetch AI Models", { Size = UDim2.new(0, 150, 0, 34), bg = T.accent, textColor = T.bg, hover = T.accentHover })
		local fetchState = new("TextLabel", {
			Size = UDim2.new(1, -162, 1, 0), BackgroundTransparency = 1, Font = FONT, TextSize = 11,
			TextColor3 = T.textMuted, Text = #p.models .. " model(s) in list",
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = card.ZIndex + 2, Parent = fetchRow,
		})
		local fetching = false
		fetchBtn.Activated:Connect(function()
			if fetching then return end
			if p.apiKey == "" then
				notify({ title = "API key required", desc = "Enter an API key for " .. p.name .. " before fetching models.", kind = "warn" })
				return
			end
			fetching = true
			fetchBtn.Text = "Fetching…"
			fetchState.Text = "Contacting " .. p.name .. "…"
			task.spawn(function()
				local impl = Providers[pid]
				local ok, models, err = false, nil, "Unsupported provider."
				if impl then ok, models, err = impl.listModels(p) end
				if ok and typeof(models) == "table" and #models > 0 then
					p.models = models
					persist()
					fetchState.Text = #models .. " model(s) fetched"
					modelBtn.Text = (p.model ~= "" and p.model) or "No model selected"
					refreshStatus()
					notify({ title = p.name .. " models fetched", desc = #models .. " model identifiers retrieved from the provider API.", kind = "success" })
				else
					fetchState.Text = "Fetch failed"
					notify({
						title = "Fetch failed",
						desc = (typeof(err) == "string" and err ~= "" and sanitize(err)) or "No models were returned.",
						kind = "error",
					})
				end
				fetching = false
				fetchBtn.Text = "Fetch AI Models"
			end)
		end)

		makeCaption(card, "API Key", 8)
		local keyRow = new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = 9, ZIndex = card.ZIndex + 1, Parent = card })
		hlist(keyRow, 8)
		local keyDisplay = new("TextLabel", {
			Size = UDim2.new(1, -178, 1, 0), BackgroundColor3 = T.input, BorderSizePixel = 0,
			Font = FONT_CODE, TextSize = 14, TextColor3 = T.textSub,
			Text = (p.apiKey ~= "" and "••••••") or "No key set", TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = card.ZIndex + 2, Parent = keyRow,
		})
		corner(keyDisplay, 8)
		stroke(keyDisplay, T.border, 0.4)
		pad(keyDisplay, 10, 0, 10, 0)
		local keyEdit = makeButton(keyRow, "Set key", { Size = UDim2.new(0, 84, 0, 34) })
		local keyClear = makeButton(keyRow, "Clear", { Size = UDim2.new(0, 78, 0, 34) })
		local editing = false
		local keyBox: any = nil
		keyEdit.Activated:Connect(function()
			if not editing then
				editing = true
				keyDisplay.Visible = false
				keyBox = makeTextField(keyRow, { Size = UDim2.new(1, -178, 1, 0), text = "", placeholder = "Paste key (never stored to disk)" })
				keyBox.LayoutOrder = 0
				keyBox:CaptureFocus()
				keyEdit.Text = "Save"
				keyBox.FocusLost:Connect(function(enterPressed)
					if not editing then return end
					editing = false
					local v = keyBox.Text or ""
					if v ~= "" then
						p.apiKey = v
						keyDisplay.Text = "••••••"
					else
						keyDisplay.Text = p.apiKey ~= "" and "••••••" or "No key set"
					end
					if keyBox and keyBox.Parent then keyBox:Destroy() end
					keyBox = nil
					keyDisplay.Visible = true
					keyEdit.Text = "Set key"
					refreshStatus()
				end)
			else
				if keyBox then keyBox:CaptureFocus() end
			end
		end)
		keyClear.Activated:Connect(function()
			p.apiKey = ""
			keyDisplay.Text = "No key set"
			if keyBox and keyBox.Parent then keyBox:Destroy() end
			keyBox = nil
			editing = false
			keyEdit.Text = "Set key"
			keyDisplay.Visible = true
			refreshStatus()
			notify({ title = "Key cleared", desc = p.name .. " key removed from memory.", kind = "info", duration = 3 })
		end)

		makeCaption(card, "Keys stay in memory for this session only and are never written to saved configuration.", 10)
		refreshStatus()
		return card
	end

	for _, pid in ipairs(providerOrder()) do
		providerCard(pid)
	end

	makeButton(scroll, "Add Provider", {
		Size = UDim2.new(1, 0, 0, 38), LayoutOrder = 99,
		onClick = function()
			notify({
				title = "Work in progress",
				desc = "🚧 Feature is still Work In Progress! 🚧",
				kind = "warn",
			})
		end,
	})
	makeCaption(scroll, "Storage: " .. Store.note, 100)
end


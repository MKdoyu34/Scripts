local function newId(): string
	return HttpService:GenerateGUID(false)
end

local function activeConversation(): any
	for _, c in ipairs(Config.conversations) do
		if c.id == Config.activeId then return c end
	end
	return nil
end

local function ensureConversation(): any
	local c = activeConversation()
	if c then return c end
	if #Config.conversations == 0 then
		c = { id = newId(), title = "New Chat", messages = {}, updatedAt = os.time() }
		table.insert(Config.conversations, c)
	end
	c = Config.conversations[1]
	Config.activeId = c.id
	return c
end

local function conversationTitle(c: any): string
	for _, m in ipairs(c.messages) do
		if m.role == "user" then
			local p = plainOf(m.content or "")
			p = p:gsub("^%s+", "")
			if #p > 0 then return (#p > 38) and (p:sub(1, 38) .. "…") or p end
		end
	end
	return "New Chat"
end

local renderMaid = maid()
local function clearFeed()
	renderMaid.clean()
	for _, c in ipairs(feed:GetChildren()) do
		if c:IsA("Frame") then
			fadeMap[c] = nil
			c:Destroy()
		end
	end
	fadeMap = {}
end

local function scrollFeedToBottom()
	local target = math.max(0, feedList.AbsoluteContentSize.Y - feed.AbsoluteSize.Y)
	feed.CanvasPosition = Vector2.new(0, target)
	requestFade()
end

local function renderConversation()
	clearFeed()
	local c = ensureConversation()
	local maxW = math.max(feed.AbsoluteSize.X - 44, 220)
	for _, m in ipairs(c.messages) do
		local wrap = makeBubble(m, maxW)
		wrap.Parent = feed
		zindex(wrap, Z.msg)
		registerFade(wrap)
		-- per-message expand wiring (only this message is affected)
		local showBtn = nil
		for _, d in ipairs(wrap:GetDescendants()) do
			if d:IsA("TextButton") and (d.Text == "Show More" or d.Text == "Show Less") then showBtn = d end
		end
		if showBtn then
			showBtn.Activated:Connect(function()
				m.expanded = not (m.expanded == true)
				local keepScroll = feed.CanvasPosition
				renderConversation()
				task.defer(function()
					feed.CanvasPosition = keepScroll
					requestFade()
				end)
			end)
		end
		renderMaid.add(wrap:GetPropertyChangedSignal("AbsoluteSize"):Connect(requestFade))
	end
	emptyState.Visible = (#c.messages == 0)
	task.defer(function()
		scrollFeedToBottom()
		updateFades()
	end)
	renderHistory()
end

function renderHistory() end -- forward: defined in section 21

local function persist()
	saveConfig()
end

local function addMessage(role: string, content: string, flags: any?): any
	local c = ensureConversation()
	local msg: any = { role = role, content = content, ts = os.time() }
	if flags then
		for k, v in pairs(flags) do msg[k] = v end
	end
	table.insert(c.messages, msg)
	c.title = conversationTitle(c)
	c.updatedAt = os.time()
	-- Keep local history bounded.
	if #c.messages > 200 then
		table.remove(c.messages, 1)
	end
	while #Config.conversations > 30 do
		table.remove(Config.conversations, 1)
	end
	persist()
	return msg
end

local function requestParams(): any
	local spec, chosen = resolveThinking(Config.activeProvider)
	return {
		maxTokens = Config.maxTokens,
		temperature = Config.temperature,
		systemPrompt = Config.systemPrompt,
		thinkingSupported = spec.supported,
		thinkingParam = spec.param,
		thinkingValue = chosen.value,
	}
end

local function previewReply(userText: string, missing: {string}): string
	local p = Config.providers[Config.activeProvider]
	local name = p and p.name or "the selected provider"
	return string.format(
		"**Preview response — no request was sent to any provider.**\n\n"
		.. "Aethryon AI is running in UI preview mode: %s is missing for %s.\n"
		.. "Open **Settings → Providers**, add a key, press **Fetch AI Models**, pick a model, then send again for a real response.\n\n"
		.. "Your message was received locally (%d characters) and is stored in this conversation only.",
		table.concat(missing, " and "), name, #userText
	)
end

local function sendCurrentMessage()
	local text = input.Text
	if text:gsub("%s", "") == "" then return end
	input.Text = ""
	composerH = COMPOSER_MIN
	tw(composer, 0.14, { Size = UDim2.new(1, 0, 1, 0) })
	composerHolder.Size = UDim2.new(1, 0, 0, composerH)
	feed.Size = UDim2.new(1, 0, 1, -(composerH + 28))
	chatBody.Size = UDim2.new(1, 0, 1, -58 - composerH - 28)

	addMessage("user", text)
	renderConversation()

	local p = Config.providers[Config.activeProvider]
	local missing: {string} = {}
	if not p or p.apiKey == "" then table.insert(missing, "an API key") end
	if not p or p.model == "" then table.insert(missing, "a selected model") end

	if #missing > 0 then
		addMessage("assistant", previewReply(text, missing), { preview = true })
		renderConversation()
		notify({
			title = "Preview response",
			desc = "No request was sent — " .. table.concat(missing, " and ") .. " is not configured.",
			kind = "warn",
		})
		return
	end

	local pending = addMessage("assistant", "Sending request…", { pending = true })
	renderConversation()

	task.spawn(function()
		local history = {}
		local c = ensureConversation()
		for _, m in ipairs(c.messages) do
			if not m.pending and not m.preview and m.role ~= "system" then
				table.insert(history, { role = (m.role == "assistant") and "assistant" or "user", content = m.content })
			end
		end
		local params = requestParams()
		local impl = Providers[Config.activeProvider]
		local ok, text2, err = false, "", "Unsupported provider."
		if impl then
			ok, text2, err = impl.chat(p, history, params)
		end
		if ok then
			pending.content = text2
			pending.pending = nil
		else
			pending.content = "**Request failed — no AI response was produced.**\n\n"
				.. sanitize(err) .. "\n\n"
				.. "This is an honest failure report, not a model response. Check the Base URL, API key and model in **Settings → Providers**."
			pending.pending = nil
			pending.failed = true
			notify({ title = "Request failed", desc = sanitize(err), kind = "error" })
		end
		persist()
		renderConversation()
	end)
end


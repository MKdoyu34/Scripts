-- Connection bookkeeping: everything is disconnected when its UI is destroyed/replaced.
local function maid(): any
	local m: any = { _conns = {} }
	function m.add(conn: RBXScriptConnection): RBXScriptConnection
		table.insert(m._conns, conn)
		return conn
	end
	function m.clean()
		for _, c in ipairs(m._conns) do pcall(function() c:Disconnect() end) end
		table.clear(m._conns)
	end
	return m
end


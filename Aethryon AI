-- Enter sends, Shift+Enter inserts a newline.
UserInputService.InputBegan:Connect(function(inputObj, gameProcessed)
	if inputObj.UserInputType ~= Enum.UserInputType.Keyboard then return end
	if inputObj.KeyCode ~= Enum.KeyCode.Return and inputObj.KeyCode ~= Enum.KeyCode.KeypadEnter then return end
	if not input:IsFocused() then return end
	local shiftDown = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
	if shiftDown then
		-- Native MultiLine behaviour already inserts the newline; keep the caret at the end.
		return
	end
	sendCurrentMessage()
end)


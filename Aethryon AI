local notifications: any = {}
local MAX_NOTIFS = 4

local function notify(opts: any)
	local kind = opts.kind or "info"
	local accent = T.accent
	if kind == "success" then accent = T.success
	elseif kind == "warn" then accent = T.warn
	elseif kind == "error" then accent = T.error end

	local card = new("CanvasGroup", {
		Name = "Notification",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.surface,
		GroupTransparency = 1,
		ZIndex = Z.notif,
		Parent = notifLayer,
	})
	corner(card, 10)
	stroke(card, T.border, 0.3)
	local bar = new("Frame", { Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = accent, BorderSizePixel = 0, ZIndex = Z.notif, Parent = card })
	corner(bar, 2)
	local body = new("Frame", {
		Size = UDim2.new(1, -3, 0, 0), Position = UDim2.new(0, 3, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = Z.notif, Parent = card,
	})
	pad(body, 12, 10, 12, 10)
	vlist(body, 4)
	local title = new("TextLabel", {
		Size = UDim2.new(1, opts.close and -20 or 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, Font = FONT_BOLD, TextSize = 14, TextColor3 = T.text,
		Text = opts.title or "", TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
		RichText = true, ZIndex = Z.notif, Parent = body,
	})
	local desc = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, Font = FONT, TextSize = 12, TextColor3 = T.textSub,
		Text = opts.desc or "", TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true, RichText = true, LineHeight = 1.35, ZIndex = Z.notif, Parent = body,
	})
	if opts.close ~= false then
		local x = new("ImageButton", {
			Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(1, -6, 0, 6), AnchorPoint = Vector2.new(1, 0),
			BackgroundTransparency = 1, Image = ICONS.close, ImageColor3 = T.textMuted,
			ScaleType = Enum.ScaleType.Fit, AutoButtonColor = false, ZIndex = Z.notif + 2, Parent = card,
		})
		x.Activated:Connect(function() card:Destroy() end)
	end

	table.insert(notifications, card)
	while #notifications > MAX_NOTIFS do
		local oldest = table.remove(notifications, 1)
		if oldest and oldest.Parent then
			tw(oldest, 0.2, { GroupTransparency = 1 })
			task.delay(0.2, function() if oldest.Parent then oldest:Destroy() end end)
		end
	end
	tw(card, 0.25, { GroupTransparency = 0 })

	local life = opts.duration or (kind == "error" and 7 or 5)
	task.delay(life, function()
		if not card.Parent then return end
		tw(card, 0.35, { GroupTransparency = 1 })
		task.delay(0.4, function()
			if card.Parent then card:Destroy() end
			for i, n in ipairs(notifications) do
				if n == card then table.remove(notifications, i) break end
			end
		end)
	end)
	return card
end


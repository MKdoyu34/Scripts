local function isLetter(c: string): boolean
	return c:match("[%a_]") ~= nil
end
local function isDigit(c: string): boolean
	return c:match("%d") ~= nil
end

-- Matches Luau-style long brackets: "--[[", "--[==[", "[[", "[=["
local function matchLongOpen(src: string, i: number, prefix: string): (number?, number?)
	local p = i
	if prefix ~= "" then
		if src:sub(p, p + #prefix - 1) ~= prefix then return nil, nil end
		p += #prefix
	end
	if src:sub(p, p) ~= "[" then return nil, nil end
	local q, eqs = p + 1, 0
	while src:sub(q, q) == "=" do
		eqs += 1
		q += 1
	end
	if src:sub(q, q) ~= "[" then return nil, nil end
	return eqs, q + 1
end

local function tokenize(src: string, def: any): any
	local tokens: any = {}
	local i, n = 1, #src
	local function push(kind: string, text: string)
		if text ~= "" then tokens[#tokens + 1] = { kind = kind, text = text } end
	end
	while i <= n do
		local c = src:sub(i, i)
		local advanced = false

		-- whitespace
		if c:match("%s") then
			local j = i
			while j <= n and src:sub(j, j):match("%s") do j += 1 end
			push("plain", src:sub(i, j - 1))
			i = j
			advanced = true

		-- long bracket comment (Luau)
		elseif def.longBrackets and def.lineComment and src:sub(i, i + #def.lineComment - 1) == def.lineComment then
			local eqs, contentStart = matchLongOpen(src, i, def.lineComment)
			if eqs then
				local close = "]" .. string.rep("=", eqs :: number) .. "]"
				local rel = src:find(close, contentStart :: number, true)
				local stop = rel and ((rel :: number) + #close - 1) or n
				push("comment", src:sub(i, stop))
				i = stop + 1
				advanced = true
			end
		end

		if not advanced then
			-- line comment
			if def.lineComment and src:sub(i, i + #def.lineComment - 1) == def.lineComment then
				local rel = src:find("\n", i, true)
				local stop = rel and ((rel :: number) - 1) or n
				push("comment", src:sub(i, stop))
				i = stop + 1

			-- block comment
			elseif def.blockOpen and src:sub(i, i + #def.blockOpen - 1) == def.blockOpen then
				local rel = src:find(def.blockClose, i + #def.blockOpen, true)
				local stop = rel and ((rel :: number) + #def.blockClose - 1) or n
				push("comment", src:sub(i, stop))
				i = stop + 1

			-- long bracket string (Luau)
			elseif def.longBrackets and c == "[" then
				local eqs, contentStart = matchLongOpen(src, i, "")
				if eqs then
					local close = "]" .. string.rep("=", eqs :: number) .. "]"
					local rel = src:find(close, contentStart :: number, true)
					local stop = rel and ((rel :: number) + #close - 1) or n
					push("string", src:sub(i, stop))
					i = stop + 1
				else
					push("operator", c)
					i += 1
				end

			-- triple quoted string (Python)
			elseif def.tripleQuotes then
				local matched = false
				for _, tq in ipairs(def.tripleQuotes) do
					if src:sub(i, i + #tq - 1) == tq then
						local rel = src:find(tq, i + #tq, true)
						local stop = rel and ((rel :: number) + #tq - 1) or n
						push("string", src:sub(i, stop))
						i = stop + 1
						matched = true
						break
					end
				end
				if not matched then
					i = i + 0 -- fallthrough handled below
				end
				if not matched then
					-- not a triple quote; continue to other checks
				end
			end
		end

		if i <= n and not advanced then
			local handled = false
			-- triple quote retry (kept separate to keep the branch readable)
			if def.tripleQuotes and not handled then
				for _, tq in ipairs(def.tripleQuotes) do
					if src:sub(i, i + #tq - 1) == tq then
						local rel = src:find(tq, i + #tq, true)
						local stop = rel and ((rel :: number) + #tq - 1) or n
						push("string", src:sub(i, stop))
						i = stop + 1
						handled = true
						break
					end
				end
			end
			if not handled and def.lineComment and src:sub(i, i + #def.lineComment - 1) == def.lineComment then
				local rel = src:find("\n", i, true)
				local stop = rel and ((rel :: number) - 1) or n
				push("comment", src:sub(i, stop))
				i = stop + 1
				handled = true
			end
			if not handled and def.blockOpen and src:sub(i, i + #def.blockOpen - 1) == def.blockOpen then
				local rel = src:find(def.blockClose, i + #def.blockOpen, true)
				local stop = rel and ((rel :: number) + #def.blockClose - 1) or n
				push("comment", src:sub(i, stop))
				i = stop + 1
				handled = true
			end
			if not handled and def.longBrackets and src:sub(i, i) == "[" then
				local eqs, contentStart = matchLongOpen(src, i, "")
				if eqs then
					local close = "]" .. string.rep("=", eqs :: number) .. "]"
					local rel = src:find(close, contentStart :: number, true)
					local stop = rel and ((rel :: number) + #close - 1) or n
					push("string", src:sub(i, stop))
					i = stop + 1
					handled = true
				end
			end
			if not handled then
				local q = src:sub(i, i)
				local isQuote = false
				if def.quotes then
					for _, qq in ipairs(def.quotes) do
						if q == qq then isQuote = true end
					end
				end
				if isQuote then
					local j = i + 1
					while j <= n do
						local ch = src:sub(j, j)
						if def.escapes and ch == "\\" then
							j += 2
						elseif ch == q then
							j += 1
							break
						elseif ch == "\n" and q ~= "`" then
							break
						else
							j += 1
						end
					end
					push("string", src:sub(i, math.min(j - 1, n)))
					i = j
					handled = true
				end
			end
			if not handled and (isDigit(c) or (c == "." and isDigit(src:sub(i + 1, i + 1) or ""))) then
				local numpat = src:match("^0[xXbBoO][%da-fA-F_.]+", i)
					or src:match("^%d+%.?%d*[eE][%+%-]?%d+", i)
					or src:match("^%d+[%._]?[%d_]*", i)
					or src:match("^%.%d+", i)
				if numpat then
					push("number", numpat)
					i += #numpat
					handled = true
				end
			end
			if not handled and isLetter(c) then
				local j = i
				while j <= n and (isLetter(src:sub(j, j)) or isDigit(src:sub(j, j))) do j += 1 end
				local word = src:sub(i, j - 1)
				local lookup = (def.caseInsensitiveKeywords and word:upper()) or word
				if def.keywords[lookup] or def.keywords[word] then
					push("keyword", word)
				else
					-- function-call detection
					local k = j
					while k <= n and src:sub(k, k):match("%s") do k += 1 end
					local nc = src:sub(k, k)
					if nc == "(" or nc == '"' or nc == "'" or nc == "{" or nc == "`" then
						push("func", word)
					elseif def.api[word] then
						push("api", word)
					elseif def.builtins[word] then
						push("builtin", word)
					else
						push("plain", word)
					end
				end
				i = j
				handled = true
			end
			if not handled then
				local opset = def.opChars or "+-*/%%=~<>^&|;:,.?()[]{}!#"
				local j = i
				while j <= n and opset:find(src:sub(j, j), 1, true) do j += 1 end
				if j == i then j = i + 1 end
				push("operator", src:sub(i, j - 1))
				i = j
			end
		end
	end
	return tokens
end

local KIND_COLOR: {[string]: string?} = {
	keyword = HL.keyword, string = HL.str, comment = HL.comment, number = HL.number,
	operator = HL.operator, func = HL.func, api = HL.api, builtin = HL.api, plain = nil,
}

local function highlight(src: string, langKey: string): string
	local def = LANGS[langKey]
	if not def then return esc(src) end
	local tokens = tokenize(src, def)
	local lines: {string} = {}
	local cur = ""
	local function emit(text: string, color: string?)
		local startIdx = 1
		while true do
			local nl = text:find("\n", startIdx, true)
			local chunk = text:sub(startIdx, nl and ((nl :: number) - 1) or nil)
			if color then
				cur ..= '<font color="' .. color .. '">' .. esc(chunk) .. "</font>"
			else
				cur ..= esc(chunk)
			end
			if not nl then break end
			table.insert(lines, cur)
			cur = ""
			startIdx = (nl :: number) + 1
		end
	end
	for _, tk in ipairs(tokens) do
		emit(tk.text, KIND_COLOR[tk.kind])
	end
	table.insert(lines, cur)
	return table.concat(lines, "\n")
end


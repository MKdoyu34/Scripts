local Providers: {[string]: any} = {}

Providers.openai = {
	label = "OpenAI",
	listModels = function(p: any): (boolean, any, string)
		local ok, res, err = httpRequest({
			Url = trimSlash(p.baseUrl) .. "/models",
			Method = "GET",
			Headers = { ["Authorization"] = "Bearer " .. p.apiKey, ["Content-Type"] = "application/json" },
		})
		if not ok then return false, nil, err end
		local dok, data = jsonDecode(res.Body or "")
		if not dok then return false, nil, "Could not parse the response from the models endpoint." end
		local out = {}
		for _, m in ipairs((data :: any).data or {}) do
			if typeof(m) == "table" and typeof(m.id) == "string" then
				local st, why = statusForModel("openai", m.id)
				table.insert(out, { id = m.id, status = st, reason = why })
			end

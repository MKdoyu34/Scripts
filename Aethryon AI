	["json"]       = { title = "JSON",       key = "json" },
	["html"]       = { title = "HTML",       key = "html" },
	["css"]        = { title = "CSS",        key = "css" },
	["sql"]        = { title = "SQL",        key = "sql" },
	["bash"]       = { title = "Bash",       key = "bash" },
	["sh"]         = { title = "Shell",      key = "bash" },
	["shell"]      = { title = "Shell",      key = "bash" },
	["xml"]        = { title = "XML",        key = "html" },
	["plaintext"]  = { title = "Plaintext",  key = "plain" },
	["text"]       = { title = "Plaintext",  key = "plain" },
}

local function langInfo(tag: string): (string, string)
	local key = (tag or ""):lower()
	local info = LANG_TITLE[key]
	if info then return info.title, info.key end
	if key == "" then return "Luau", "luau" end
	return key:sub(1, 1):upper() .. key:sub(2), key
end

local function parseBlocks(text: string): any
	local blocks: any = {}
	local lines: {string} = {}
	for line in (text .. "\n"):gmatch("([^\n]*)\n") do
		lines[#lines + 1] = line
	end
	local i, buf = 1, {}
	local function flush()
		if #buf > 0 then
			local joined = table.concat(buf, "\n")
			if joined:gsub("%s", "") ~= "" then
				blocks[#blocks + 1] = { kind = "text", value = joined }
			end
			buf = {}
		end
	end
	while i <= #lines do
		local line = lines[i]
		local lang = line:match("^%s*```%s*([%w_%+%.#%-]*)%s*$")
		if lang then
			flush()
			local code: {string} = {}
			i += 1
			while i <= #lines and not lines[i]:match("^%s*```%s*$") do
				code[#code + 1] = lines[i]
				i += 1
			end
			i += 1
			blocks[#blocks + 1] = { kind = "code", value = table.concat(code, "\n"), lang = lang or "" }
		else
			buf[#buf + 1] = line
			i += 1
		end
	end
	flush()
	return blocks
end

local function mdInline(s: string): string
	s = esc(s)
	s = s:gsub("`([^`\n]+)`", '<font face="Code" color="#C4B5FD">%1</font>')
	s = s:gsub("%*%*(.-)%*%*", "<b>%1</b>")
	s = s:gsub("%*(.-)%*", "<i>%1</i>")
	s = s:gsub("~~(.-)~~", "<s>%1</s>")
	return s
end


local function modelOptions(providerId: string): (any, any)
	local p = Config.providers[providerId]
	local working, broken = {}, {}
	for _, m in ipairs(p and p.models or {}) do
		local entry = {
			id = m.id,
			status = m.status or "unknown",
			reason = m.reason,
			disabled = (m.status == "deprecated" or m.status == "unavailable"),
		}
		if entry.disabled then table.insert(broken, entry) else table.insert(working, entry) end
	end
	table.sort(working, function(a, b) return a.id < b.id end)
	table.sort(broken, function(a, b) return a.id < b.id end)
	return working, broken
end

local function statusLabel(entry: any): string
	if entry.status == "deprecated" then return entry.reason or "Deprecated" end
	if entry.status == "unavailable" then return entry.reason or "Unavailable" end
	return "Unknown"
end


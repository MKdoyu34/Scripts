local function plainOf(text: string): string
	local out = text:gsub("```.-```", " ")
	out = out:gsub("`", "")
	out = out:gsub("%*", "")
	out = out:gsub("#+", "")
	out = out:gsub("\n+", " ")
	return out
end

-- Collapse preview for long USER messages (>= 300 chars).
local function previewOf(text: string): string?
	if #text < 300 then return nil end
	local cut = text:sub(1, 285)
	local lastSpace = cut:match("^.*()%s")
	if lastSpace and (lastSpace :: number) > 180 then
		cut = cut:sub(1, (lastSpace :: number) - 1)
	end
	local fenceCount = select(2, cut:gsub("```", ""))
	if fenceCount % 2 == 1 then cut ..= "\n```" end
	return cut .. "…"
end

local function makeBubble(msg: any, maxWidth: number): any
	local isUser = msg.role == "user"
	local wrap = new("Frame", {
		Name = "Message", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = Z.msg, Parent = nil,
	})
	local wrapList = vlist(wrap, 6)

	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = Z.msg + 1, Parent = wrap,
	})
	hlist(row, 0, isUser and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Left)

	local displayText = msg.content or ""
	local collapsed = false
	if isUser and msg.expanded ~= true then
		local prev = previewOf(displayText)
		if prev then
			displayText = prev
			collapsed = true
		end
	end

	local blocks = parseBlocks(displayText)
	local hasCode = false
	for _, b in ipairs(blocks) do
		if b.kind == "code" then hasCode = true end
	end

	local bubbleWidth
	if hasCode then
		bubbleWidth = maxWidth
	else
		local measured = TextService:GetTextSize(plainOf(displayText), 15, FONT, Vector2.new(maxWidth - 28, 100000))
		bubbleWidth = math.clamp(math.ceil(measured.X) + 30, 110, maxWidth)
	end

	local bubble = new("Frame", {
		Name = "Bubble", Size = UDim2.new(0, bubbleWidth, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = isUser and T.secondary or T.secondary,
		BorderSizePixel = 0, ZIndex = Z.msg + 2, Parent = row,
	})
	corner(bubble, 12)
	stroke(bubble, isUser and T.accent or T.border, isUser and 0.45 or 0.35)
	if isUser then
		local tint = new("Frame", {
			Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = T.accent, BackgroundTransparency = 0.9,
			BorderSizePixel = 0, ZIndex = Z.msg + 2, Parent = bubble,
		})
		corner(tint, 12)
	end
	pad(bubble, 13, 11, 13, 11)
	vlist(bubble, 8)

	local roleTag = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, Font = FONT_BOLD, TextSize = 10,
		TextColor3 = isUser and T.accentHover or T.textMuted,
		Text = isUser and "YOU" or "AETHRYON", TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = Z.msg + 3, Parent = bubble,
	})

	for _, b in ipairs(blocks) do
		if b.kind == "code" then
			local cb = makeCodeBlock(b.value, b.lang, bubbleWidth - 26)
			cb.Parent = bubble
			cb.ZIndex = Z.msg + 3
			for _, d in ipairs(cb:GetDescendants()) do
				if d:IsA("GuiObject") then (d :: any).ZIndex = (d :: any).ZIndex end
			end
		else
			local para = new("TextLabel", {
				Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1, Font = FONT, TextSize = 15, TextColor3 = T.text,
				Text = mdInline(b.value), RichText = true, TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
				LineHeight = 1.4, ZIndex = Z.msg + 3, Parent = bubble,
			})
		end
	end

	if collapsed or (isUser and msg.expanded == true and previewOf(msg.content or "") ~= nil) then
		local btnRow = new("Frame", {
			Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = 2,
			ZIndex = Z.msg + 1, Parent = wrap,
		})
		hlist(btnRow, 0, Enum.HorizontalAlignment.Right)
		local showLabel = (msg.expanded == true) and "Show Less" or "Show More"
		local showBtn = new("TextButton", {
			Size = UDim2.new(0, 92, 0, 22), BackgroundColor3 = T.input, BorderSizePixel = 0,
			AutoButtonColor = false, Font = FONT_MED, TextSize = 11, TextColor3 = T.accentHover,
			Text = showLabel, ZIndex = Z.msg + 2, Parent = btnRow,
		})
		corner(showBtn, 7)
		stroke(showBtn, T.border, 0.4)
		showBtn.MouseEnter:Connect(function() tw(showBtn, 0.12, { BackgroundColor3 = T.hover }) end)
		showBtn.MouseLeave:Connect(function() tw(showBtn, 0.12, { BackgroundColor3 = T.input }) end)
		wrap:SetAttribute("ShowMoreButton", true)
		showBtn.Activated:Connect(function()
			msg.expanded = not (msg.expanded == true)
			if wrap:FindFirstAncestorOfClass("ScreenGui") then
				-- handled by the caller through the re-render hook below
			end
			if wrap:GetAttribute("OnToggle") == nil then
				wrap:SetAttribute("ToggleExpand", not (msg.expanded == true))
			end
			wrap:SetAttribute("RequestExpand", true)
			if wrap:GetAttribute("ExpandCallback") ~= nil then end
			if wrap:FindFirstChild("__toggle") then end
			-- The chat controller listens for this attribute.
			wrap:SetAttribute("ExpandSignal", (wrap:GetAttribute("ExpandSignal") or 0) + 1)
		end)
	end

	return wrap
end


		for _, pt in ipairs(parts) do
			if typeof(pt) == "table" and typeof(pt.text) == "string" then table.insert(buf, pt.text) end
		end
		if #buf == 0 then return false, "", "The response contained no text." end
		return true, table.concat(buf, "\n"), ""
	end,

local Z = {
	shadow = 0, window = 1, side = 10, conv = 10, msg = 20, fade = 60,
	composer = 70, toggle = 150, backdrop = 200, modal = 210, confirm = 260,
	popup = 500, notif = 900,
}
-- Assigns increasing ZIndex by depth so children always render above their ancestors.
local function zindex(root: any, base: number)
	local function walk(inst: Instance, depth: number)
		for _, c in ipairs(inst:GetChildren()) do
			if c:IsA("GuiObject") then
				(c :: any).ZIndex = base + depth
			elseif c:IsA("UIStroke") or c:IsA("UICorner") or c:IsA("UIGradient") then
				-- no ZIndex on these; nothing to do
			end
			walk(c, math.min(depth + 1, 40))
		end
	end
	if root:IsA("GuiObject") then root.ZIndex = base end
	walk(root, 1)
end


-- 16. FADE ENGINE (event-driven, per-message transparency)
----------------------------------------------------------------------------------------------------
local FADE_SIZE = 46
local fadeMap: {[any]: any} = {}
local feedMaids: {[any]: any} = {}
local fadeDirty = false

local function registerFade(root: any)
	local entries: any = {}
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("TextLabel") or d:IsA("TextButton") then
			table.insert(entries, { obj = d, prop = "TextTransparency", base = (d :: any).TextTransparency })
		elseif d:IsA("TextBox") then
			table.insert(entries, { obj = d, prop = "TextTransparency", base = (d :: any).TextTransparency })
		elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then
			table.insert(entries, { obj = d, prop = "ImageTransparency", base = (d :: any).ImageTransparency })
		elseif d:IsA("UIStroke") then
			table.insert(entries, { obj = d, prop = "Transparency", base = (d :: any).Transparency })
		elseif d:IsA("GuiObject") then
			table.insert(entries, { obj = d, prop = "BackgroundTransparency", base = (d :: any).BackgroundTransparency })
		end
		if d:IsA("GuiObject") and not d:IsA("TextLabel") and not d:IsA("TextBox") then
			-- frames/Images also fade their background
			if d:IsA("ImageLabel") or d:IsA("ImageButton") then
				table.insert(entries, { obj = d, prop = "BackgroundTransparency", base = (d :: any).BackgroundTransparency })
			end
		end
	end
	fadeMap[root] = entries
end

local function applyFade(root: any, alpha: number)
	local entries = fadeMap[root]
	if not entries then return end
	for _, e in ipairs(entries) do
		(e.obj :: any)[e.prop] = 1 - (1 - e.base) * alpha
	end
end

local function updateFades()
	local view = feed.AbsoluteSize.Y
	if view <= 0 then return end
	for _, child in ipairs(feed:GetChildren()) do
		if child:IsA("Frame") and fadeMap[child] then
			local top = child.AbsolutePosition.Y - feed.AbsolutePosition.Y
			local h = child.AbsoluteSize.Y
			local d = math.min(top, view - (top + h))
			local a = math.clamp(d / FADE_SIZE, 0, 1)
			a = a * a * (3 - 2 * a) -- smoothstep: content fully inside stays fully visible
			applyFade(child, a)
		end
	end
end

local function requestFade()
	if fadeDirty then return end
	fadeDirty = true
	task.defer(function()
		fadeDirty = false
		updateFades()
	end)
end


local Store: any = { backend = "session", note = "" }
local STORE_KEY = "aethryon_config_v1"

local function detectStore()
	-- (1) LocalStorageService: exists as a service, but its members are RobloxScriptSecurity-only.
	--     We attempt it safely; if it is not callable we fall through.
	local okSvc, svc = pcall(function() return game:GetService("LocalStorageService") end)
	if okSvc and svc and typeof((svc :: any).SetItem) == "function" then
		local okW = pcall(function() (svc :: any):SetItem("aethryon_probe", "1") end)
		local okR = pcall(function() return (svc :: any):GetItem("aethryon_probe") end)
		if okW and okR then
			Store.backend = "localStorage"
			Store.note = "Saved with LocalStorageService (this device)."
			return
		end
	end
	-- (2) Executor file API, only if it genuinely exists (configuration only — never API keys).
	local wf, rf = execFn("writefile"), execFn("readfile")
	if wf and rf then
		Store.backend = "file"
		Store.note = "Saved with an executor file API (this device). API keys are never stored."
		return
	end
	-- (3) Session-only fallback.
	Store.backend = "session"
	Store.note = "No supported local storage available — settings last for this session only."
end

local function trimSlash(s: string): string
	return (s:gsub("/+$", ""))
end

local function serializeConfig(): string
	local payload: any = {
		version = 1,
		displayName = Config.displayName,
		systemPrompt = Config.systemPrompt,
		activeProvider = Config.activeProvider,
		maxTokens = Config.maxTokens,
		temperature = Config.temperature,
		ui = Config.ui,
		providers = {},
		conversations = Config.conversations,
		activeId = Config.activeId,
	}
	for id, p in pairs(Config.providers) do
		payload.providers[id] = {
			id = id, baseUrl = p.baseUrl, model = p.model,
			models = p.models, thinking = p.thinking,
			-- apiKey intentionally omitted: secrets are never persisted.
		}
	end
	local ok, json = pcall(function() return HttpService:JSONEncode(payload) end)
	return ok and json or ""
end

local saveQueued = false
local function saveConfig()
	if Store.backend == "session" then return false end
	if saveQueued then return true end
	saveQueued = true
	task.delay(1.0, function()
		saveQueued = false
		local json = serializeConfig()
		if json == "" then return end
		if Store.backend == "localStorage" then
			pcall(function()
				local svc: any = game:GetService("LocalStorageService")
				svc:SetItem(STORE_KEY, json)
			end)
		elseif Store.backend == "file" then
			local mk, isf = execFn("makefolder"), execFn("isfolder")
			pcall(function()
				if mk and isf and not isf("aethryon") then mk("aethryon") end
			end)
			local wf = execFn("writefile")
			if wf then pcall(wf, "aethryon/config.json", json) end
		end
	end)
	return true
end

local function loadConfig(): boolean
	local json: string? = nil
	if Store.backend == "localStorage" then
		local ok, val = pcall(function()
			return (game:GetService("LocalStorageService") :: any):GetItem(STORE_KEY)
		end)
		if ok and typeof(val) == "string" and val ~= "" then json = val end
	elseif Store.backend == "file" then
		local isf = execFn("isfile")
		local okExists = isf and (select(2, pcall(isf, "aethryon/config.json")) == true)
		if okExists then
			local rf = execFn("readfile")
			if rf then
				local ok, val = pcall(rf, "aethryon/config.json")
				if ok and typeof(val) == "string" then json = val end
			end
		end
	end
	if not json then return false end
	local ok, data = pcall(function() return HttpService:JSONDecode(json :: string) end)
	if not ok or typeof(data) ~= "table" then return false end
	local d: any = data
	local fresh = defaults()
	Config.displayName = typeof(d.displayName) == "string" and d.displayName or ""
	Config.systemPrompt = typeof(d.systemPrompt) == "string" and d.systemPrompt or ""
	Config.activeProvider = fresh.providers[d.activeProvider] and d.activeProvider or "openai"
	Config.maxTokens = typeof(d.maxTokens) == "number" and math.clamp(math.floor(d.maxTokens), 1, 1000000) or 1024
	Config.temperature = typeof(d.temperature) == "number" and math.clamp(d.temperature, 0, 2) or 0.7
	if typeof(d.ui) == "table" then
		Config.ui.animate = d.ui.animate ~= false
		Config.ui.sidebarCollapsed = d.ui.sidebarCollapsed == true
	end
	if typeof(d.providers) == "table" then
		for id, saved in pairs(d.providers) do
			if fresh.providers[id] and typeof(saved) == "table" then
				local p = fresh.providers[id]
				if typeof(saved.baseUrl) == "string" then p.baseUrl = saved.baseUrl end
				if typeof(saved.model) == "string" then p.model = saved.model end
				if typeof(saved.thinking) == "string" then p.thinking = saved.thinking end
				if typeof(saved.models) == "table" then
					p.models = {}
					for _, m in ipairs(saved.models) do
						if typeof(m) == "table" and typeof(m.id) == "string" then
							table.insert(p.models, {
								id = m.id,
								status = typeof(m.status) == "string" and m.status or "unknown",
								reason = typeof(m.reason) == "string" and m.reason or nil,
							})
						elseif typeof(m) == "string" then
							table.insert(p.models, { id = m, status = "unknown", reason = nil })
						end
					end
				end
			end
		end
	end
	if typeof(d.conversations) == "table" then
		for _, c in ipairs(d.conversations) do
			if typeof(c) == "table" and typeof(c.id) == "string" and typeof(c.messages) == "table" then
				table.insert(Config.conversations, {
					id = c.id,
					title = typeof(c.title) == "string" and c.title or "New Chat",
					messages = c.messages,
					updatedAt = typeof(c.updatedAt) == "number" and c.updatedAt or os.time(),
				})
			end
		end
	end
	Config.activeId = typeof(d.activeId) == "string" and d.activeId or nil
	return true
end


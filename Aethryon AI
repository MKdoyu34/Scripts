local function layoutForComposer(height: number)
	composerHolder.Size = UDim2.new(1, 0, 0, height)
	chatBody.Size = UDim2.new(1, 0, 1, -58 - height - 28)
	tw(feed, 0.16, { Size = UDim2.new(1, 0, 1, 0) })

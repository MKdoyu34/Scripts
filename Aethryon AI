local paramsBuilt = false
local paramRefresh: any = nil
local function buildParamPanel()
	for _, c in ipairs(paramPanel:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	makeSectionTitle(paramPanel, "Generation parameters", nextOrder())
	makeCaption(paramPanel, "Applied to the next request sent to the active provider.", nextOrder())

	-- Max Tokens
	local mtRow = makeRow(paramPanel, 58, { order = nextOrder() })
	local mtTitle = new("TextLabel", {
		Size = UDim2.new(0.5, 0, 0, 18), BackgroundTransparency = 1, Font = FONT_MED, TextSize = 12,
		TextColor3 = T.text, Text = "Max Tokens", TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = mtRow.ZIndex + 1, Parent = mtRow,
	})
	local mtBox = makeTextField(mtRow, { Size = UDim2.new(0, 110, 0, 30), text = tostring(Config.maxTokens), align = Enum.TextXAlignment.Center })
	mtBox.Position = UDim2.new(1, 0, 1, -30)
	mtBox.AnchorPoint = Vector2.new(0, 0)
	mtBox.FocusLost:Connect(function()
		local n = tonumber(mtBox.Text)
		if n and n >= 1 and math.floor(n) == n then
			Config.maxTokens = math.floor(math.clamp(n, 1, 1000000))
			persist()
		else
			mtBox.Text = tostring(Config.maxTokens)
			notify({ title = "Invalid value", desc = "Max Tokens must be a positive integer.", kind = "warn" })
		end
	end)

	-- Temperature
	local tempSlider = makeSlider(paramPanel, {
		label = "Temperature", min = 0, max = 1, value = Config.temperature, decimals = 2, step = 0.01,
		order = nextOrder(), onChange = function(v: number)
			Config.temperature = v
			persist()
		end,
	})
	makeCaption(paramPanel, "Controls response variability: lower values are more deterministic.", nextOrder())

	-- Thinking level
	local p = Config.providers[Config.activeProvider]
	local spec, chosen = resolveThinking(Config.activeProvider)
	local thinkRow = makeRow(paramPanel, 74, { order = nextOrder() })
	local thinkTitle = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Font = FONT_MED, TextSize = 12,
		TextColor3 = spec.supported and T.text or T.textMuted,
		Text = "Thinking Level — " .. p.name,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = thinkRow.ZIndex + 1, Parent = thinkRow,
	})
	local options = {}
	for _, l in ipairs(spec.levels) do
		table.insert(options, { label = l.label, value = l.value, disabled = not spec.supported })
	end
	local thinkDropdown = makeDropdown(thinkRow, {
		Size = UDim2.new(1, 0, 0, 32), Position = UDim2.new(0, 0, 0, 34), selected = chosen.label,
		options = options, popupWidth = 280,
		onSelect = function(o: any)
			p.thinking = o.label
			persist()
		end,
	})
	for _, c in ipairs(thinkRow:GetChildren()) do
		if c:IsA("TextButton") then c.Position = UDim2.new(0, 0, 0, 34) end
	end
	local thinkNote = makeCaption(paramPanel, spec.note, nextOrder())

	paramRefresh = function()
		buildParamPanel()
	end
	paramsBuilt = true
end

local paramOpen = false
local function setParamPanel(open: boolean)
	paramOpen = open
	if open and not paramsBuilt then buildParamPanel() end
	if open then
		buildParamPanel()
		paramPanel.Visible = true
		tw(paramPanel, 0.18, { GroupTransparency = 0 })
	else
		tw(paramPanel, 0.16, { GroupTransparency = 1 })
		task.delay(0.18, function() if not paramOpen then paramPanel.Visible = false end end)
	end
end

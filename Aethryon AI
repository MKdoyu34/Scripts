local function makePopup(anchor: any, width: number, maxHeight: number): any
	closePopup()
	local ap = anchor.AbsolutePosition
	local as = anchor.AbsoluteSize
	local vps = screenGui.AbsoluteSize
	local w = math.min(width, vps.X - 24)
	local x = math.clamp(ap.X, 12, vps.X - w - 12)
	local belowSpace = vps.Y - (ap.Y + as.Y) - 12
	local aboveSpace = ap.Y - 12
	local height = math.min(maxHeight, math.max(belowSpace, aboveSpace))
	local y
	if belowSpace >= math.min(maxHeight, 180) or belowSpace >= aboveSpace then
		y = ap.Y + as.Y + 6
	else
		y = ap.Y - 6 - height
	end
	y = math.clamp(y, 12, vps.Y - height - 12)

	local panel = new("CanvasGroup", {
		Name = "Popup", Size = UDim2.new(0, w, 0, height), Position = UDim2.new(0, x, 0, y),
		BackgroundColor3 = T.secondary, GroupTransparency = 1, ZIndex = Z.popup,
		BorderSizePixel = 0, Parent = popupLayer,
	})
	corner(panel, 12)
	stroke(panel, T.border, 0.25)
	local scroll = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 5, ScrollBarImageColor3 = T.border, ScrollBarImageTransparency = 0.4,
		ScrollingDirection = Enum.ScrollingDirection.Y, AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0), ZIndex = Z.popup + 1, Parent = panel,
	})
	vlist(scroll, 2)
	pad(scroll, 6, 6, 6, 6)
	tw(panel, 0.16, { GroupTransparency = 0 })
	openPopup = panel
	return panel, scroll
end

local function makeDropdown(parent: any, opts: any): any
	local options = opts.options or {}
	local selectedIndex = 1
	for i, o in ipairs(options) do
		if o.label == opts.selected then selectedIndex = i end
	end
	local btn = new("TextButton", {
		Name = opts.Name or "Dropdown",
		Size = opts.Size or UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = opts.bg or T.input,
		BorderSizePixel = 0, AutoButtonColor = false,
		Font = FONT_MED, TextSize = 13, TextColor3 = opts.textColor or T.text,
		Text = options[selectedIndex] and options[selectedIndex].label or "—",
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = (parent.ZIndex or 10) + 2, Parent = parent,
	})
	corner(btn, 8)
	stroke(btn, T.border, 0.4)
	pad(btn, 10, 0, 26, 0)
	local chev = new("TextLabel", {
		Size = UDim2.new(0, 12, 0, 12), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
		BackgroundTransparency = 1, Font = FONT_BOLD, TextSize = 10, TextColor3 = T.textMuted,
		Text = "▼", ZIndex = (parent.ZIndex or 10) + 3, Parent = btn,
	})

	local api: any = {}
	function api.setOptions(newOptions: any, keepLabel: string?)
		options = newOptions
		local idx = 1
		for i, o in ipairs(options) do
			if o.label == (keepLabel or api.current) then idx = i end
		end
		api.current = options[idx] and options[idx].label
		btn.Text = api.current or "—"
	end
	api.current = options[selectedIndex] and options[selectedIndex].label
	btn.Activated:Connect(function()
		if openPopup and openPopup.Name == "Popup" and openPopup:GetAttribute("Owner") == tostring(btn) then
			closePopup()
			return
		end
		local panel, scroll = makePopup(btn, opts.popupWidth or 260, opts.popupHeight or 240)
		panel:SetAttribute("Owner", tostring(btn))
		for _, o in ipairs(options) do
			local isSel = o.label == api.current
			local row = new("TextButton", {
				Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = isSel and T.input or T.secondary,
				BorderSizePixel = 0, AutoButtonColor = false, Font = isSel and FONT_BOLD or FONT,
				TextSize = 13, TextColor3 = o.disabled and T.textMuted or (isSel and T.accentHover or T.text),
				Text = o.label, TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = Z.popup + 2, Parent = scroll,
			})
			corner(row, 8)
			pad(row, 10, 0, 10, 0)
			if o.disabled then row.Active = false end
			row.Activated:Connect(function()
				if o.disabled then return end
				api.current = o.label
				btn.Text = o.label
				closePopup()
				if opts.onSelect then opts.onSelect(o) end
			end)
		end
		if #options == 0 then
			new("TextLabel", {
				Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Font = FONT, TextSize = 12,
				TextColor3 = T.textMuted, Text = opts.emptyText or "No options available.",
				TextWrapped = true, ZIndex = Z.popup + 2, Parent = scroll,
			})
		end
	end)
	return api
end


local function makeSlider(parent: any, opts: any): any
	local min, max, value = opts.min or 0, opts.max or 1, opts.value or 0
	local row = makeRow(parent, 64, { order = opts.order or 0 })
	local title = new("TextLabel", {
		Size = UDim2.new(0.5, 0, 0, 18), BackgroundTransparency = 1, Font = FONT_MED, TextSize = 13,
		TextColor3 = T.text, Text = opts.label or "", TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = row.ZIndex + 1, Parent = row,
	})
	local readout = new("TextLabel", {
		Size = UDim2.new(0.5, 0, 0, 18), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1, Font = FONT_BOLD, TextSize = 13, TextColor3 = T.accentHover,
		Text = tostring(value), TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = row.ZIndex + 1, Parent = row,
	})
	local track = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 6), Position = UDim2.new(0, 0, 0, 42), BackgroundColor3 = T.input,
		BorderSizePixel = 0, AutoButtonColor = false, Text = "", ZIndex = row.ZIndex + 1, Parent = row,
	})
	corner(track, 3)
	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.accent, BorderSizePixel = 0,
		ZIndex = row.ZIndex + 2, Parent = track,
	})
	corner(fill, 3)
	local knob = new("Frame", {
		Size = UDim2.new(0, 16, 0, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = T.accentHover, BorderSizePixel = 0, ZIndex = row.ZIndex + 3, Parent = track,
	})
	corner(knob, 8)

	local decimals = opts.decimals or 2
	local function fmt(v: number): string
		if decimals <= 0 then return tostring(math.floor(v + 0.5)) end
		return string.format("%." .. tostring(decimals) .. "f", v)
	end
	local current = value
	local function paint(v: number)
		local ratio = math.clamp((v - min) / (max - min), 0, 1)
		fill.Size = UDim2.new(ratio, 0, 1, 0)
		knob.Position = UDim2.new(ratio, 0, 0.5, 0)
		readout.Text = (opts.prefix or "") .. fmt(v) .. (opts.suffix or "")
	end
	local function setFromX(absX: number)
		local ratio = math.clamp((absX - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local raw = min + ratio * (max - min)
		local stepped = raw
		if opts.step and opts.step > 0 then
			stepped = math.floor(raw / opts.step + 0.5) * opts.step
		end
		current = math.clamp(stepped, min, max)
		paint(current)
		if opts.onChange then opts.onChange(current) end
	end
	local dragging = false
	track.InputBegan:Connect(function(inputObj)
		if inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(inputObj.Position.X)
		end
	end)
	local moveConn = UserInputService.InputChanged:Connect(function(inputObj)
		if not dragging then return end
		if inputObj.UserInputType == Enum.UserInputType.MouseMovement or inputObj.UserInputType == Enum.UserInputType.Touch then
			setFromX(inputObj.Position.X)
		end
	end)
	local endConn = UserInputService.InputEnded:Connect(function(inputObj)
		if inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	paint(current)

	local api: any = {}
	function api.set(v: number)
		current = math.clamp(v, min, max)
		paint(current)
	end
	function api.get(): number return current end
	function api.destroy()
		moveConn:Disconnect()
		endConn:Disconnect()
	end
	return api
end


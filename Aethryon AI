		local body: any = { model = p.model, messages = messages }
		if isReasoning then body.max_completion_tokens = params.maxTokens else body.max_tokens = params.maxTokens end
		if not isReasoning then body.temperature = params.temperature end
		if params.thinkingValue ~= nil and params.thinkingSupported then body.reasoning_effort = params.thinkingValue end

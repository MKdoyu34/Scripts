local function statusForModel(providerId: string, modelId: string, apiStatus: string?, apiReason: string?): (string, string?)
	if apiStatus == "deprecated" then
		return "deprecated", apiReason or "Deprecated by provider"
	end
	local known = KNOWN_DEPRECATED[providerId]
	if known and known[modelId] then return "deprecated", known[modelId] end
	return "unknown", nil
end

local function sanitize(msg: string): string
	local out = tostring(msg)
	for _, p in pairs(Config.providers) do
		local key = p.apiKey
		if typeof(key) == "string" and #key >= 8 then
			out = out:gsub(key:gsub("([%p%c])", "%%%1"), "[redacted]")
		end
	end
	out = out:gsub("\n", " ")
	if #out > 220 then out = out:sub(1, 220) .. "…" end
	return out
end

local function httpEnabled(): boolean
	local ok, enabled = pcall(function() return HttpService.HttpEnabled end)
	return ok and enabled ~= false
end

local function httpRequest(opts: any): (boolean, any, string)
	if not httpEnabled() then
		return false, nil, "HttpService is disabled for this place (HttpEnabled = false); requests cannot be sent."
	end
	local ok, res = pcall(function() return HttpService:RequestAsync(opts) end)
	if not ok then return false, nil, tostring(res) end
	if typeof(res) ~= "table" then return false, nil, "Malformed response." end
	if res.Success == false then
		return false, res, "HTTP " .. tostring(res.StatusCode) .. " " .. tostring(res.StatusMessage or "")
	end
	return true, res, ""
end

local function jsonEncode(tbl: any): (boolean, string)
	local ok, s = pcall(function() return HttpService:JSONEncode(tbl) end)
	return ok, ok and s or ""
end
local function jsonDecode(s: string): (boolean, any)
	local ok, d = pcall(function() return HttpService:JSONDecode(s) end)
	return ok and typeof(d) == "table", d
end

-- Thinking/reasoning support, per provider documentation.
-- Default is always the LOWEST supported level where a documented minimum exists.
local THINKING_SPEC: {[string]: any} = {
	openai = function(model: string): any
		local levels = {
			{ label = "Low",    value = "low" },
			{ label = "Medium", value = "medium" },
			{ label = "High",   value = "high" },
		}
		if model == "" then
			return { supported = false, param = "reasoning_effort", levels = levels, defaultIndex = 1,
				note = "Select a model first." }
		end
		if model:match("^gpt%-5") or model:match("^o%d") then
			return { supported = true, param = "reasoning_effort", levels = levels, defaultIndex = 1,
				note = "OpenAI reasoning models: reasoning_effort (low/medium/high; newer models may also accept none/minimal/xhigh). Temperature is not sent for reasoning models." }
		end
		return { supported = false, param = "reasoning_effort", levels = levels, defaultIndex = 1,
			note = "Unverified for this model — Aethryon will not send a reasoning parameter unless the model is a documented reasoning model." }
	end,
	gemini = function(model: string): any
		if model == "" then
			return { supported = false, param = "thinkingConfig", levels = { { label = "Low", value = "low" } }, defaultIndex = 1,
				note = "Select a model first." }
		end
		if model:match("^gemini%-[3-9]") then
			return { supported = true, param = "thinkingConfig.thinkingLevel", levels = {
					{ label = "Low", value = "low" }, { label = "Medium", value = "medium" }, { label = "High", value = "high" },
				}, defaultIndex = 1,
				note = "Gemini 3+: thinkingLevel. Thinking cannot be turned off on Gemini 3; lowest level is 'low'." }
		end
		if model:match("2%.5%-pro") then
			return { supported = true, param = "thinkingConfig.thinkingBudget", levels = {
					{ label = "Low (128)", value = 128 }, { label = "Medium (4096)", value = 4096 }, { label = "High (16384)", value = 16384 },
				}, defaultIndex = 1,
				note = "Gemini 2.5 Pro: thinkingBudget 128–32768. Thinking cannot be disabled." }
		end
		if model:match("2%.5%-flash%-lite") then
			return { supported = true, param = "thinkingConfig.thinkingBudget", levels = {
					{ label = "Off (0)", value = 0 }, { label = "Low (512)", value = 512 }, { label = "Medium (4096)", value = 4096 }, { label = "High (16384)", value = 16384 },
				}, defaultIndex = 1,
				note = "Gemini 2.5 Flash-Lite: thinkingBudget 512–24576; 0 disables thinking." }
		end
		if model:match("2%.5%-flash") then
			return { supported = true, param = "thinkingConfig.thinkingBudget", levels = {
					{ label = "Off (0)", value = 0 }, { label = "Low (1024)", value = 1024 }, { label = "Medium (8192)", value = 8192 }, { label = "High (24576)", value = 24576 },
				}, defaultIndex = 1,
				note = "Gemini 2.5 Flash: thinkingBudget 0–24576; 0 disables thinking." }
		end
		return { supported = false, param = "thinkingConfig", levels = {
				{ label = "Off", value = 0 }, { label = "Low (1024)", value = 1024 }, { label = "Medium (8192)", value = 8192 },
			}, defaultIndex = 1,
			note = "Unverified for this model — no thinking parameter is sent. (Use thinkingBudget for 2.5, thinkingLevel for 3+.)" }
	end,
	claude = function(model: string): any
		local levels = {
			{ label = "Off", value = nil },
			{ label = "Low (1024)", value = 1024 },
			{ label = "Medium (4096)", value = 4096 },
			{ label = "High (10000)", value = 10000 },
		}
		if model == "" then
			return { supported = false, param = "thinking.budget_tokens", levels = levels, defaultIndex = 1,
				note = "Select a model first." }
		end
		if model:match("^claude") then
			return { supported = true, param = "thinking.budget_tokens", levels = levels, defaultIndex = 1,
				note = "Anthropic extended thinking: thinking.budget_tokens (minimum 1024). Temperature is omitted when thinking is enabled. Newer models may also expose an 'effort' parameter, which this UI does not send." }
		end
		return { supported = false, param = "thinking.budget_tokens", levels = levels, defaultIndex = 1,
			note = "Unverified for this model — no thinking parameter is sent." }
	end,
}

local function thinkingSpec(providerId: string): any
	local p = Config.providers[providerId]
	local fn = THINKING_SPEC[providerId]
	if not p or not fn then
		return { supported = false, param = "", levels = { { label = "Off", value = nil } }, defaultIndex = 1,
			note = "This provider does not expose a documented thinking-level control." }
	end
	return fn(p.model or "")
end

-- Resolves the stored label against the current spec, clamping to the lowest level when invalid.
local function resolveThinking(providerId: string): (any, any)
	local spec = thinkingSpec(providerId)
	local p = Config.providers[providerId]
	local chosen: any = nil
	for _, lvl in ipairs(spec.levels) do
		if lvl.label == (p and p.thinking or nil) then chosen = lvl end
	end
	if not chosen then
		chosen = spec.levels[spec.defaultIndex] or spec.levels[1]
		if p then p.thinking = chosen.label end
	end
	return spec, chosen
end

